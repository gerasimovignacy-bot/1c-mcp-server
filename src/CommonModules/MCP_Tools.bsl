// ---- Schema helpers ---------------------------------------------

Функция _Tool(Имя, Title, Описание, Properties, Required = Неопределено, РежимРезультата = "")

	Описание = Описание + " Read-only; для неизвестных имен используйте discovery.";
	ОписаниеМаскирования = MCP_Config.ОписаниеМаскированияLLM();
	Если НЕ ПустаяСтрока(ОписаниеМаскирования) Тогда
		Описание = Описание + " Privacy-маскирование может применяться; подробности в get_current_user_context.";
	КонецЕсли;

	ВходнаяСхема = Новый Структура;
	ВходнаяСхема.Вставить("type", "object");
	ВходнаяСхема.Вставить("properties", Properties);
	ВходнаяСхема.Вставить("additionalProperties", Ложь);
	Если Required <> Неопределено Тогда
		ВходнаяСхема.Вставить("required", Required);
	КонецЕсли;

	Tool = Новый Структура;
	Tool.Вставить("name", Имя);
	Tool.Вставить("title", Title);
	Tool.Вставить("description", Описание);
	Tool.Вставить("inputSchema", ВходнаяСхема);
	Если НормализоватьРежимРезультата(РежимРезультата) <> "text_only" Тогда
		Tool.Вставить("outputSchema", _ОбщаяСхемаВыхода());
	КонецЕсли;
	Возврат Tool;

КонецФункции

Функция _ОбщаяСхемаВыхода()

	AuthProps = Новый Структура;
	AuthProps.Вставить("user_name", _Схема("string"));
	AuthProps.Вставить("identity_key", _Схема("string"));
	AuthProps.Вставить("cache_policy", _СхемаОбъект());
	AuthSchema = Новый Структура;
	AuthSchema.Вставить("type", "object");
	AuthSchema.Вставить("properties", AuthProps);
	AuthSchema.Вставить("required", _МассивСтрок("user_name,identity_key,cache_policy"));
	AuthSchema.Вставить("additionalProperties", Истина);

	Props = Новый Структура;
	Props.Вставить("ok", _Схема("boolean"));
	Props.Вставить("auth_context", AuthSchema);
	Props.Вставить("privacy", _СхемаОбъект());
	Props.Вставить("error", _СхемаОбъект());
	Props.Вставить("authorization", _СхемаОбъект());
	Props.Вставить("warnings", _Схема("array"));
	Props.Вставить("columns", _СхемаМассивЛюбых());
	Props.Вставить("rows", _СхемаМассивЛюбых());
	Props.Вставить("next_cursor", _Схема("string"));
	Props.Вставить("truncated", _Схема("boolean"));

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Props);
	Схема.Вставить("required", _МассивСтрок("ok,auth_context"));
	Схема.Вставить("additionalProperties", Истина);
	Возврат Схема;

КонецФункции

Функция _СхемаМассивЛюбых()
	Стр = Новый Структура;
	Стр.Вставить("type", "array");
	Стр.Вставить("items", Новый Структура);
	Возврат Стр;
КонецФункции

Функция _Схема(Тип, Items = Неопределено, Описание = "")
	Стр = Новый Структура;
	Стр.Вставить("type", Тип);
	Если Items <> Неопределено Тогда
		Стр.Вставить("items", Items);
	ИначеЕсли Тип = "array" Тогда
		Item = Новый Структура("type", "string");
		Стр.Вставить("items", Item);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Описание) Тогда
		Стр.Вставить("description", Описание);
	КонецЕсли;
	Возврат Стр;
КонецФункции

Функция _СхемаGuidance(Описание = "")
	Если ПустаяСтрока(Описание) Тогда
		Описание = "Включить блок query_guidance/domain_guidance в успешный ответ. По умолчанию false. При ошибке выполнения guidance возвращается принудительно независимо от этого флага.";
	Иначе
		Описание = Описание + " По умолчанию false. При ошибке выполнения query_guidance/domain_guidance возвращается принудительно независимо от этого флага.";
	КонецЕсли;
	Стр = _Схема("boolean", , Описание);
	Стр.Вставить("default", Ложь);
	Возврат Стр;
КонецФункции

