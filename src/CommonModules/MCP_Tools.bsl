// MCP_Tools.bsl
// ====================================================================
// Каталог MCP tools и их dispatcher.
// Содержит описания всех read-only tools (name, title, description, inputSchema)
// и единую точку вызова MCP_Tools_Impl.
// ====================================================================

Функция СписокTools(РежимРезультата = "") Экспорт

	Результат = Новый Массив;

	РежимРезультата = НормализоватьРежимРезультата(РежимРезультата);

	Результат.Добавить(Tool_list_metadata_objects(РежимРезультата));
	Результат.Добавить(Tool_get_metadata_structure(РежимРезультата));
	Результат.Добавить(Tool_search_metadata_fields(РежимРезультата));
	Результат.Добавить(Tool_count_event_subscriptions_by_event(РежимРезультата));
	Результат.Добавить(Tool_list_event_subscriptions(РежимРезультата));
	Результат.Добавить(Tool_run_1c_query(РежимРезультата));
	Результат.Добавить(Tool_validate_1c_query(РежимРезультата));
	Результат.Добавить(Tool_get_1c_query_guidance(РежимРезультата));
	Результат.Добавить(Tool_list_1c_language_doc_topics(РежимРезультата));
	Результат.Добавить(Tool_search_1c_language_docs(РежимРезультата));
	Результат.Добавить(Tool_read_1c_language_doc_section(РежимРезультата));
	Результат.Добавить(Tool_get_1c_language_doc_provenance(РежимРезультата));
	Результат.Добавить(Tool_list_registers(РежимРезультата));
	Результат.Добавить(Tool_get_accounting_accounts_map(РежимРезультата));
	Результат.Добавить(Tool_get_accounting_balances(РежимРезультата));
	Результат.Добавить(Tool_get_accounting_balances_by_subconto_age(РежимРезультата));
	Результат.Добавить(Tool_compare_accounting_balances_by_subconto(РежимРезультата));
	Результат.Добавить(Tool_get_accounting_entries(РежимРезультата));
	Результат.Добавить(Tool_get_inventory_balances_by_item(РежимРезультата));
	Результат.Добавить(Tool_check_inventory_and_order_status(РежимРезультата));
	Результат.Добавить(Tool_get_calculation_types_map(РежимРезультата));
	Результат.Добавить(Tool_get_database_passport(РежимРезультата));
	Результат.Добавить(Tool_get_object_by_ref(РежимРезультата));
	Результат.Добавить(Tool_find_object_by_id(РежимРезультата));
	Результат.Добавить(Tool_search_objects(РежимРезультата));
	Результат.Добавить(Tool_get_link_of_object(РежимРезультата));
	Результат.Добавить(Tool_find_references_to_object(РежимРезультата));
	Результат.Добавить(Tool_get_enum_values(РежимРезультата));
	Результат.Добавить(Tool_get_register_records(РежимРезультата));
	Результат.Добавить(Tool_get_document_movements(РежимРезультата));
	Результат.Добавить(Tool_list_reports(РежимРезультата));
	Результат.Добавить(Tool_get_report_info(РежимРезультата));
	Результат.Добавить(Tool_run_1c_report(РежимРезультата));
	Результат.Добавить(Tool_get_object_history(РежимРезультата));
	Результат.Добавить(Tool_get_current_user_context(РежимРезультата));
	Результат.Добавить(Tool_get_query_examples(РежимРезультата));
	Результат.Добавить(Tool_list_legal_sources(РежимРезультата));
	Результат.Добавить(Tool_get_legal_source_guide(РежимРезультата));

	Возврат Результат;

КонецФункции

// Главный dispatcher.
// ВключитьКонтекстАвторизации — Булево из JSON-RPC-параметра _include_auth_context
// (не из arguments тула); Неопределено = не передан.
Функция ВыполнитьИнструмент(ИмяТула, Аргументы, РежимРезультата = "", ВключитьКонтекстАвторизации = Неопределено) Экспорт

	CorrelationID = Строка(Новый УникальныйИдентификатор);
	РежимРезультата = НормализоватьРежимРезультата(РежимРезультата);

	Если НЕ MCP_Security.ToolРазрешен(ИмяТула) Тогда
		Возврат СформироватьОшибкуРезультата(
			MCP_Errors.Код_AccessDenied(),
			"Tool недоступен текущему пользователю.",
			Новый Структура("tool", ИмяТула),
			CorrelationID,
			РежимРезультата);
	КонецЕсли;

	// Privacy инструменты не блокирует: любой вызов выполняется, закрытые
	// значения подменяются при сборке ответа. Нечитаемая политика — тоже не
	// отказ: включается максимальная маска, причина уходит в privacy.config_errors
	// (решение 05.08.2026, снятие HR-07 fail-closed).
	Попытка
		Данные = Неопределено;

		Если ИмяТула = "list_metadata_objects" Тогда
			Данные = MCP_Tools_Impl.ListMetadataObjects(Аргументы);
		ИначеЕсли ИмяТула = "get_metadata_structure" Тогда
			Данные = MCP_Tools_Impl.GetMetadataStructure(Аргументы);
		ИначеЕсли ИмяТула = "search_metadata_fields" Тогда
			Данные = MCP_Tools_Impl.SearchMetadataFields(Аргументы);
		ИначеЕсли ИмяТула = "count_event_subscriptions_by_event" Тогда
			Данные = MCP_Tools_Impl.CountEventSubscriptionsByEvent(Аргументы);
		ИначеЕсли ИмяТула = "list_event_subscriptions" Тогда
			Данные = MCP_Tools_Impl.ListEventSubscriptions(Аргументы);
		ИначеЕсли ИмяТула = "run_1c_query" Тогда
			Данные = MCP_Tools_Impl.Run1CQuery(Аргументы, CorrelationID);
		ИначеЕсли ИмяТула = "validate_1c_query" Тогда
			Данные = MCP_Tools_Impl.Validate1CQuery(Аргументы);
		ИначеЕсли ИмяТула = "get_1c_query_guidance" Тогда
			Данные = MCP_Tools_Impl.Get1CQueryGuidance(Аргументы);
		ИначеЕсли ИмяТула = "list_1c_language_doc_topics" Тогда
			Данные = MCP_Tools_Impl.List1CLanguageDocTopics(Аргументы);
		ИначеЕсли ИмяТула = "search_1c_language_docs" Тогда
			Данные = MCP_Tools_Impl.Search1CLanguageDocs(Аргументы);
		ИначеЕсли ИмяТула = "read_1c_language_doc_section" Тогда
			Данные = MCP_Tools_Impl.Read1CLanguageDocSection(Аргументы);
		ИначеЕсли ИмяТула = "get_1c_language_doc_provenance" Тогда
			Данные = MCP_Tools_Impl.Get1CLanguageDocProvenance(Аргументы);
		ИначеЕсли ИмяТула = "list_registers" Тогда
			Данные = MCP_Tools_Impl.ListRegisters(Аргументы);
		ИначеЕсли ИмяТула = "get_accounting_accounts_map" Тогда
			Данные = MCP_Tools_Impl.GetAccountingAccountsMap(Аргументы);
		ИначеЕсли ИмяТула = "get_accounting_balances" Тогда
			Данные = MCP_Tools_Impl.GetAccountingBalances(Аргументы);
		ИначеЕсли ИмяТула = "get_accounting_balances_by_subconto_age" Тогда
			Данные = MCP_Tools_Impl.GetAccountingBalancesBySubcontoAge(Аргументы);
		ИначеЕсли ИмяТула = "compare_accounting_balances_by_subconto" Тогда
			Данные = MCP_Tools_Impl.CompareAccountingBalancesBySubconto(Аргументы);
		ИначеЕсли ИмяТула = "get_accounting_entries" Тогда
			Данные = MCP_Tools_Impl.GetAccountingEntries(Аргументы);
		ИначеЕсли ИмяТула = "get_inventory_balances_by_item" Тогда
			Данные = MCP_Tools_Impl.GetInventoryBalancesByItem(Аргументы);
		ИначеЕсли ИмяТула = "check_inventory_and_order_status" Тогда
			Данные = MCP_Tools_Impl.CheckInventoryAndOrderStatus(Аргументы);
		ИначеЕсли ИмяТула = "get_calculation_types_map" Тогда
			Данные = MCP_Tools_Impl.GetCalculationTypesMap(Аргументы);
		ИначеЕсли ИмяТула = "get_database_passport" Тогда
			Данные = MCP_Tools_Impl.GetDatabasePassport(Аргументы);
		ИначеЕсли ИмяТула = "get_object_by_ref" Тогда
			Данные = MCP_Tools_Impl.GetObjectByRef(Аргументы);
		ИначеЕсли ИмяТула = "find_object_by_id" Тогда
			Данные = MCP_Tools_Impl.FindObjectByID(Аргументы);
		ИначеЕсли ИмяТула = "search_objects" Тогда
			Данные = MCP_Tools_Impl.SearchObjects(Аргументы);
		ИначеЕсли ИмяТула = "get_link_of_object" Тогда
			Данные = MCP_Tools_Impl.GetLinkOfObject(Аргументы);
		ИначеЕсли ИмяТула = "find_references_to_object" Тогда
			Данные = MCP_Tools_Impl.FindReferencesToObject(Аргументы);
		ИначеЕсли ИмяТула = "get_enum_values" Тогда
			Данные = MCP_Tools_Impl.GetEnumValues(Аргументы);
		ИначеЕсли ИмяТула = "get_register_records" Тогда
			Данные = MCP_Tools_Impl.GetRegisterRecords(Аргументы);
		ИначеЕсли ИмяТула = "get_document_movements" Тогда
			Данные = MCP_Tools_Impl.GetDocumentMovements(Аргументы);
		ИначеЕсли ИмяТула = "list_reports" Тогда
			Данные = MCP_Tools_Impl.ListReports(Аргументы);
		ИначеЕсли ИмяТула = "get_report_info" Тогда
			Данные = MCP_Tools_Impl.GetReportInfo(Аргументы);
		ИначеЕсли ИмяТула = "run_1c_report" Тогда
			Данные = MCP_Tools_Impl.Run1CReport(Аргументы);
		ИначеЕсли ИмяТула = "get_object_history" Тогда
			Данные = MCP_Tools_Impl.GetObjectHistory(Аргументы);
		ИначеЕсли ИмяТула = "get_current_user_context" Тогда
			Данные = MCP_Tools_Impl.GetCurrentUserContext(Аргументы);
		ИначеЕсли ИмяТула = "get_query_examples" Тогда
			Данные = MCP_Tools_Impl.GetQueryExamples(Аргументы);
		ИначеЕсли ИмяТула = "list_legal_sources" Тогда
			Данные = MCP_Tools_Impl.ListLegalSources(Аргументы);
		ИначеЕсли ИмяТула = "get_legal_source_guide" Тогда
			Данные = MCP_Tools_Impl.GetLegalSourceGuide(Аргументы);
		Иначе
			Возврат СформироватьОшибкуРезультата(
				MCP_Errors.Код_UnknownTool(),
				"Unknown tool: " + ИмяТула,
				Новый Структура("tool", ИмяТула),
				CorrelationID,
				РежимРезультата);
		КонецЕсли;

		// Импл-функции должны возвращать Структуру. Если кто-то вернул иное —
		// конвертируем в пустую структуру, чтобы Данные.Вставить ниже не упало.
		Если ТипЗнч(Данные) <> Тип("Структура") Тогда
			Данные = Новый Структура;
		КонецЕсли;
		Данные.Вставить("ok", Истина);
		ДобавитьКонтекстАвторизации(Данные, ПолныйКонтекстАвторизацииНужен(ИмяТула, ВключитьКонтекстАвторизации));
		ДобавитьИнформациюОМаскированииLLM(Данные);
		ДанныеДляLLM = MCP_Security.МаскироватьПоляДляLLM(Данные);
		ПроверитьРазмерРезультата(ДанныеДляLLM);
		БезопасноЗаписатьАудитУспеха(CorrelationID, ИмяТула, Аргументы, ДанныеДляLLM);
		Возврат СформироватьУспешныйРезультат(ДанныеДляLLM, Истина, РежимРезультата);

	Исключение
		ТекстИскл = ОписаниеОшибки();
		Ошибка = MCP_Errors.РазобратьИсключение(ТекстИскл, CorrelationID);
		БезопасноЗаписатьАудитОшибки(CorrelationID, ИмяТула, Аргументы, Ошибка);
		Возврат СформироватьОшибкуРезультата(Ошибка.code, Ошибка.message, Ошибка.details, CorrelationID, РежимРезультата);
	КонецПопытки;

КонецФункции

// ---- Сериализация tool result -------------------------------------

Функция СформироватьУспешныйРезультат(Данные, ДанныеУжеМаскированы = Ложь, РежимРезультата = "") Экспорт

	Если ДанныеУжеМаскированы Тогда
		ДанныеДляLLM = Данные;
	Иначе
		ДанныеДляLLM = MCP_Security.МаскироватьПоляДляLLM(Данные);
	КонецЕсли;

	РежимРезультата = НормализоватьРежимРезультата(РежимРезультата);
	Контент = Новый Массив;
	Блок = Новый Структура;
	Блок.Вставить("type", "text");
	Если РежимРезультата = "text_only" ИЛИ MCP_Config.LegacyFullJSONContent() Тогда
		Блок.Вставить("text", MCP_JSONRPC.СохранитьJSON(ДанныеДляLLM));
	ИначеЕсли РежимРезультата = "both" Тогда
		Блок.Вставить("text", ТекстУспешногоРезультата(ДанныеДляLLM));
	Иначе
		Блок.Вставить("text", СводкаУспешногоРезультата(ДанныеДляLLM));
	КонецЕсли;
	Контент.Добавить(Блок);

	Результат = Новый Структура;
	Результат.Вставить("content", Контент);
	Если РежимРезультата <> "text_only" Тогда
		Результат.Вставить("structuredContent", ДанныеДляLLM);
	КонецЕсли;
	Результат.Вставить("isError", Ложь);
	Возврат Результат;

КонецФункции

Функция СформироватьОшибкуРезультата(Код, Сообщение, Детали, CorrelationID, РежимРезультата = "") Экспорт

	Данные = Новый Структура;
	Данные.Вставить("ok", Ложь);
	Данные.Вставить("message", Сообщение);
	ДобавитьКонтекстАвторизации(Данные, Ложь);
	Диагностика = ИзвлечьДиагностикуОшибки(Детали);
	ОшибкиВалидации = ИзвлечьОшибкиВалидации(Детали);
	Авторизация = АвторизацияИзОшибки(Код, Детали);

	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	Ошибка.Вставить("details", ?(Детали = Неопределено, Новый Структура, Детали));
	Ошибка.Вставить("correlation_id", CorrelationID);
	Если Авторизация <> Неопределено Тогда
		Данные.Вставить("authorization", Авторизация);
		Ошибка.Вставить("authorization", Авторизация);
	КонецЕсли;
	Если Диагностика <> Неопределено Тогда
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "error_code");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "hint");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "available_fields");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "available_fields_source");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "available_fields_sample");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "see_also");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "platform_message");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "field");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "field_path");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "object");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "source_table");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "fix_options");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "original_expression");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "account_code");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "chart");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "suggestion");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "details");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "suggestions");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "warnings");
		// Pre-flight валидация источников и полей обычных таблиц: новые поля
		// добавляются рядом с существующими, прежние сохраняются (NF-04).
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "did_you_mean");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "available_fields_total");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "available_fields_truncated");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "available_tabular_parts");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "tabular_part");
		СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, "alias");
	КонецЕсли;
	Если ОшибкиВалидации <> Неопределено Тогда
		Данные.Вставить("validation_errors", ОшибкиВалидации);
		Ошибка.Вставить("validation_errors", ОшибкиВалидации);
		СкопироватьПолеДеталей(Детали, Данные, Ошибка, "detected_objects");
		СкопироватьПолеДеталей(Детали, Данные, Ошибка, "detected_parameters");
		СкопироватьПолеДеталей(Детали, Данные, Ошибка, "estimated_risk");
	КонецЕсли;
	// Предупреждения валидации переносятся независимо от наличия ошибок валидации:
	// на стадии падения движка их нет, а предупреждение о коллизии псевдонима
	// (F-04) обязано доходить до клиента именно там — это вероятная причина отказа.
	// stage — первичный признак «движок не вызывался» в методике приёмки, поэтому
	// он обязан быть виден клиенту, а не только лежать внутри details.
	СкопироватьПолеДеталей(Детали, Данные, Ошибка, "stage");
	СкопироватьПолеДеталей(Детали, Данные, Ошибка, "pre_flight_stage");
	СкопироватьПолеДеталей(Детали, Данные, Ошибка, "validation_warnings");
	СкопироватьПолеДеталей(Детали, Данные, Ошибка, "query_guidance");
	СкопироватьПолеДеталей(Детали, Данные, Ошибка, "domain_guidance");
	СкопироватьПолеДеталей(Детали, Данные, Ошибка, "pre_flight_resolutions");
	Данные.Вставить("error", Ошибка);
	ДобавитьИнформациюОМаскированииLLM(Данные);
	ДанныеДляLLM = MCP_Security.МаскироватьПоляДляLLM(Данные);
	РежимРезультата = НормализоватьРежимРезультата(РежимРезультата);

	Контент = Новый Массив;
	Блок = Новый Структура;
	Блок.Вставить("type", "text");
	Если РежимРезультата = "text_only" Тогда
		Блок.Вставить("text", MCP_JSONRPC.СохранитьJSON(ДанныеДляLLM));
	Иначе
		Блок.Вставить("text", "Ошибка: " + Код + ". " + Сообщение + " correlation_id=" + CorrelationID);
	КонецЕсли;
	Контент.Добавить(Блок);
	Если РежимРезультата = "both" ИЛИ MCP_Config.LegacyFullJSONContent() Тогда
		ДиагностическийБлок = Новый Структура;
		ДиагностическийБлок.Вставить("type", "text");
		ДиагностическийБлок.Вставить("text", "Диагностика JSON: " + MCP_JSONRPC.СохранитьJSON(ДанныеДляLLM));
		Контент.Добавить(ДиагностическийБлок);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("content", Контент);
	Если РежимРезультата <> "text_only" Тогда
		Результат.Вставить("structuredContent", ДанныеДляLLM);
	КонецЕсли;
	Результат.Вставить("isError", Истина);
	Возврат Результат;

КонецФункции

Процедура ДобавитьКонтекстАвторизации(Данные, ПолныйКонтекст = Ложь)

	Контекст = Новый Структура;
	ИмяПользователя = MCP_Security.ИмяТекущегоПользователя();
	ИмяБазы = "";
	ВерсияКонфигурации = "";
	Попытка
		ИмяБазы = Метаданные.Имя;
		ВерсияКонфигурации = Метаданные.Версия;
	Исключение
	КонецПопытки;
	Контекст.Вставить("identity_key", ИмяПользователя + "@" + ИмяБазы + "#" + ВерсияКонфигурации);
	Контекст.Вставить("user_name", ИмяПользователя);
	Если ПолныйКонтекст Тогда
		Контекст.Вставить("infobase_name", ИмяБазы);
		Контекст.Вставить("configuration_version", ВерсияКонфигурации);
		Контекст.Вставить("generated_at", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	КонецЕсли;

	ПолитикаКэша = Новый Структура;
	ПолитикаКэша.Вставить("cacheable", Ложь);
	ПолитикаКэша.Вставить("revalidate_each_call", Истина);
	Контекст.Вставить("cache_policy", ПолитикаКэша);

	Данные.Вставить("auth_context", Контекст);

КонецПроцедуры

Функция ПолныйКонтекстАвторизацииНужен(ИмяТула, ВключитьКонтекстАвторизации)

	Если ИмяТула = "get_current_user_context" Тогда
		Возврат Истина;
	КонецЕсли;

	Если MCP_Config.IncludeFullAuthContextByDefault() Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(ВключитьКонтекстАвторизации) = Тип("Булево") Тогда
		Возврат ВключитьКонтекстАвторизации;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция НормализоватьРежимРезультата(РежимРезультата)

	Если РежимРезультата = Неопределено ИЛИ РежимРезультата = Null Тогда
		РежимРезультата = "";
	КонецЕсли;

	Если ПустаяСтрока(РежимРезультата) Тогда
		РежимРезультата = MCP_Config.ToolResultMode();
	Иначе
		РежимРезультата = НРег(СокрЛП(Строка(РежимРезультата)));
	КонецЕсли;

	Если РежимРезультата <> "text_only"
		И РежимРезультата <> "structured_only"
		И РежимРезультата <> "both" Тогда
		РежимРезультата = MCP_Config.ToolResultMode();
	КонецЕсли;

	Возврат РежимРезультата;

КонецФункции

Функция ТекстУспешногоРезультата(Данные)

	Текст = СводкаУспешногоРезультата(Данные);
	Возврат Текст + Символы.ПС + "structuredContent=" + MCP_JSONRPC.СохранитьJSON(Данные);

КонецФункции

Функция СводкаУспешногоРезультата(Данные)

	Части = Новый Массив;
	Части.Добавить("ok=true");

	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "rows", "rows");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "objects", "objects");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "fields", "fields");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "subscriptions", "subscriptions");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "registers", "registers");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "accounts", "accounts");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "calculation_types", "calculation_types");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "matches", "matches");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "reports", "reports");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "values", "values");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "events", "events");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "references", "references");
	ДобавитьРазмерКоллекцииВСводку(Части, Данные, "movements", "movements");

	Если ЗначениеПоляБулево(Данные, "truncated", Ложь) Тогда
		Части.Добавить("truncated=true");
	КонецЕсли;

	NextCursor = ЗначениеПоляСтрока(Данные, "next_cursor", "");
	Если НЕ ПустаяСтрока(NextCursor) Тогда
		Части.Добавить("next_cursor=" + NextCursor);
	КонецЕсли;

	Возврат СтрСоединить(Части, ", ");

КонецФункции

Процедура ДобавитьРазмерКоллекцииВСводку(Части, Данные, ИмяПоля, Метка)

	Значение = Неопределено;
	Попытка
		Если Данные.Свойство(ИмяПоля, Значение)
			И (ТипЗнч(Значение) = Тип("Массив") ИЛИ ТипЗнч(Значение) = Тип("ФиксированныйМассив")) Тогда
			Части.Добавить(Метка + "=" + Строка(Значение.Количество()));
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция ЗначениеПоляБулево(Данные, ИмяПоля, ПоУмолчанию)

	Значение = Неопределено;
	Попытка
		Если Данные.Свойство(ИмяПоля, Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ПоУмолчанию;

КонецФункции

Функция ЗначениеПоляСтрока(Данные, ИмяПоля, ПоУмолчанию)

	Значение = Неопределено;
	Попытка
		Если Данные.Свойство(ИмяПоля, Значение) И Значение <> Null И Значение <> Неопределено Тогда
			Возврат Строка(Значение);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ПоУмолчанию;

КонецФункции

Функция АвторизацияИзОшибки(Код, Детали)

	Авторизация = АвторизацияИзДеталей(Детали);
	Если Авторизация <> Неопределено Тогда
		Возврат НормализоватьАвторизациюОтказа(Авторизация, Код, Детали);
	КонецЕсли;

	Если Код <> MCP_Errors.Код_AccessDenied()
		И Код <> MCP_Errors.Код_TypeNotAllowed()
		И Код <> MCP_Errors.Код_FieldNotAllowed() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Авторизация = Новый Структура;
	Если Код = MCP_Errors.Код_TypeNotAllowed() Тогда
		Авторизация.Вставить("reason_code", "mcp_type_not_allowed");
	ИначеЕсли Код = MCP_Errors.Код_FieldNotAllowed() Тогда
		Авторизация.Вставить("reason_code", "mcp_field_not_allowed");
	ИначеЕсли Детали <> Неопределено И ЗначениеДеталей(Детали, "tool", "") <> "" Тогда
		Авторизация.Вставить("reason_code", "mcp_tool_not_allowed");
	Иначе
		Авторизация.Вставить("reason_code", "1c_access_denied");
	КонецЕсли;
	Авторизация.Вставить("denied_operation", "tool_call");
	Авторизация.Вставить("retry_policy", "do_not_retry_same_request_without_reauth_or_permission_change");
	Если ЗначениеДеталей(Детали, "type", "") <> "" Тогда
		Авторизация.Вставить("denied_type", ЗначениеДеталей(Детали, "type", ""));
	КонецЕсли;
	Если ЗначениеДеталей(Детали, "field", "") <> "" Тогда
		Авторизация.Вставить("denied_field", ЗначениеДеталей(Детали, "field", ""));
	КонецЕсли;
	Если ЗначениеДеталей(Детали, "tool", "") <> "" Тогда
		Авторизация.Вставить("denied_tool", ЗначениеДеталей(Детали, "tool", ""));
	КонецЕсли;
	Возврат Авторизация;

КонецФункции

Функция АвторизацияИзДеталей(Детали)

	Если Детали = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Авторизация = Неопределено;
	Попытка
		Если Детали.Свойство("authorization", Авторизация) Тогда
			Возврат Авторизация;
		КонецЕсли;
	Исключение
	КонецПопытки;

	ParsedDetails = Неопределено;
	Попытка
		Если Детали.Свойство("parsed_details", ParsedDetails) Тогда
			Если ParsedDetails.Свойство("authorization", Авторизация) Тогда
				Возврат Авторизация;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция НормализоватьАвторизациюОтказа(Авторизация, Код, Детали)

	Если ТипЗнч(Авторизация) <> Тип("Структура") Тогда
		Возврат Авторизация;
	КонецЕсли;
	Значение = Неопределено;
	Если НЕ Авторизация.Свойство("retry_policy", Значение) Тогда
		Авторизация.Вставить("retry_policy", "do_not_retry_same_request_without_reauth_or_permission_change");
	КонецЕсли;
	Если НЕ Авторизация.Свойство("reason_code", Значение) Тогда
		Авторизация.Вставить("reason_code", ?(Код = MCP_Errors.Код_AccessDenied(), "1c_access_denied", "mcp_type_not_allowed"));
	КонецЕсли;
	Возврат Авторизация;

КонецФункции

Функция ЗначениеДеталей(Детали, ИмяПоля, ПоУмолчанию)

	Если Детали = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Значение = Неопределено;
	Попытка
		Если Детали.Свойство(ИмяПоля, Значение) Тогда
			Если Значение = Null ИЛИ Значение = Неопределено Тогда
				Возврат ПоУмолчанию;
			КонецЕсли;
			Возврат Строка(Значение);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ПоУмолчанию;

КонецФункции

Процедура ДобавитьИнформациюОМаскированииLLM(Данные)

	Информация = MCP_Config.ИнформацияМаскированияLLM();
	// Непринятая privacy-запись означает незамаскированные данные, поэтому
	// config_warnings и config_errors отдаём даже когда маскирование в итоге
	// не включилось.
	Если Информация.enabled
		ИЛИ Информация.config_warnings.Количество() > 0
		ИЛИ Информация.config_errors.Количество() > 0 Тогда
		Данные.Вставить("privacy", Информация);
	КонецЕсли;

КонецПроцедуры

Функция ИзвлечьОшибкиВалидации(Детали)

	Если Детали = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ParsedDetails = Неопределено;
	Попытка
		Если Детали.Свойство("parsed_details", ParsedDetails) Тогда
			Ошибки = Неопределено;
			Попытка
				Если ParsedDetails.Свойство("validation_errors", Ошибки) Тогда
					Возврат НормализованныеОшибкиВалидации(Ошибки);
				КонецЕсли;
			Исключение
			КонецПопытки;
			Возврат НормализованныеОшибкиВалидации(ParsedDetails);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ИзвлечьДиагностикуОшибки(Детали)

	Если Детали = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Диагностика = Неопределено;
	Попытка
		Если Детали.Свойство("diagnostics", Диагностика) Тогда
			Возврат Диагностика;
		КонецЕсли;
	Исключение
	КонецПопытки;

	ParsedDetails = Неопределено;
	Попытка
		Если Детали.Свойство("parsed_details", ParsedDetails) Тогда
			Попытка
				Если ParsedDetails.Свойство("diagnostics", Диагностика) Тогда
					Возврат Диагностика;
				КонецЕсли;
			Исключение
			КонецПопытки;
			Ошибки = Неопределено;
			Попытка
				Если ParsedDetails.Свойство("validation_errors", Ошибки) Тогда
					Диагностика = ДиагностикаИзОшибокВалидации(Ошибки);
					Если Диагностика <> Неопределено Тогда
						Возврат Диагностика;
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;
			Диагностика = ДиагностикаИзОшибокВалидации(ParsedDetails);
			Если Диагностика <> Неопределено Тогда
				Возврат Диагностика;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция НормализованныеОшибкиВалидации(ОшибкиВалидации)

	Если ТипЗнч(ОшибкиВалидации) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого ОшибкаВалидации Из ОшибкиВалидации Цикл
		Код = "";
		Сообщение = "";
		Локация = "";
		Попытка
			ОшибкаВалидации.Свойство("code", Код);
			ОшибкаВалидации.Свойство("message", Сообщение);
			ОшибкаВалидации.Свойство("location", Локация);
		Исключение
			Продолжить;
		КонецПопытки;
		Если Код = Null Тогда Код = ""; КонецЕсли;
		Если Сообщение = Null Тогда Сообщение = ""; КонецЕсли;
		Если Локация = Null Тогда Локация = ""; КонецЕсли;
		Код = Строка(Код);
		Сообщение = Строка(Сообщение);
		Локация = Строка(Локация);

		Стр = Новый Структура;
		Стр.Вставить("code", Код);
		Стр.Вставить("message", Сообщение);
		Стр.Вставить("location", ?(ПустаяСтрока(Локация), Null, Локация));
		Подсказка = ПодсказкаОшибкиВалидации(Код, Сообщение, Локация);
		Если НЕ ПустаяСтрока(Подсказка.hint) Тогда
			Стр.Вставить("hint", Подсказка.hint);
		КонецЕсли;
		Если НЕ ПустаяСтрока(Подсказка.see_also) Тогда
			Стр.Вставить("see_also", Подсказка.see_also);
		КонецЕсли;
		Результат.Добавить(Стр);
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ДиагностикаИзОшибокВалидации(ОшибкиВалидации)

	Нормализованные = НормализованныеОшибкиВалидации(ОшибкиВалидации);
	Если Нормализованные = Неопределено ИЛИ Нормализованные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПерваяОшибка = Нормализованные[0];
	Код = ПерваяОшибка.code;
	Сообщение = ПерваяОшибка.message;
	Локация = ПолучитьПолеСтруктуры(ПерваяОшибка, "location", "");

	Результат = Новый Структура;
	Результат.Вставить("kind", "query_validation");
	Результат.Вставить("error_code", Код);
	Результат.Вставить("hint", Сообщение);
	Подсказка = ПодсказкаОшибкиВалидации(Код, Сообщение, Локация);
	Если НЕ ПустаяСтрока(Подсказка.hint) Тогда
		Результат.Вставить("hint", Подсказка.hint);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Локация) Тогда
		Результат.Вставить("see_also", Локация);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Подсказка.see_also) Тогда
		Результат.Вставить("see_also", Подсказка.see_also);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПодсказкаОшибкиВалидации(Код, Сообщение, Локация)

	Результат = Новый Структура;
	Результат.Вставить("hint", "");
	Результат.Вставить("see_also", "");
	Если Код = "subconto_wrong_table" Тогда
		Результат.hint = "Используйте таблицу " + Локация + " с полями: Период, Регистратор, НомерСтроки, ВидДвижения, Вид, Значение. Соединяйте с основной таблицей по Регистратор и НомерСтроки.";
		Результат.see_also = Локация;
	ИначеЕсли Код = "invalid_1c_query_keyword" И СтрНайти(ВРег(Сообщение), "ИМЕЯ") > 0 Тогда
		Результат.hint = "В языке запросов 1С для условий по агрегатным функциям используется ИМЕЮЩИЕ, не ИМЕЯ и не SQL-слово HAVING.";
		Результат.see_also = "query_guidance:grouping-and-having";
	ИначеЕсли Код = "temporary_table_package_required"
		ИЛИ Код = "batch_query_forbidden"
		ИЛИ Код = "batch_query_final_select_required" Тогда
		Результат.hint = "Пакетные запросы через ; разрешены только при использовании временных таблиц через ПОМЕСТИТЬ. Финальная команда пакета — ВЫБРАТЬ.";
		Результат.see_also = "query_guidance:temporary-tables";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПолучитьПолеСтруктуры(СтруктураЗначений, ИмяПоля, ЗначениеПоУмолчанию)

	Значение = Неопределено;
	Попытка
		Если СтруктураЗначений.Свойство(ИмяПоля, Значение) Тогда
			Если Значение = Null Тогда
				Возврат ЗначениеПоУмолчанию;
			КонецЕсли;
			Возврат Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Процедура СкопироватьПолеДиагностики(Диагностика, Данные, Ошибка, ИмяПоля)

	Значение = Неопределено;
	Попытка
		Если Диагностика.Свойство(ИмяПоля, Значение) Тогда
			Данные.Вставить(ИмяПоля, Значение);
			Ошибка.Вставить(ИмяПоля, Значение);
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура СкопироватьПолеДеталей(Детали, Данные, Ошибка, ИмяПоля)

	Если Детали = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ParsedDetails = Неопределено;
	Значение = Неопределено;
	Попытка
		Если Детали.Свойство("parsed_details", ParsedDetails) Тогда
			Если ParsedDetails.Свойство(ИмяПоля, Значение) Тогда
				Данные.Вставить(ИмяПоля, Значение);
				Ошибка.Вставить(ИмяПоля, Значение);
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Аудит — best-effort. Любой сбой (журнал, сериализация JSON и т.п.) не должен
// конвертировать успешный tool-вызов в ошибку или прятать оригинальную ошибку tool'а
// под "audit failed".
Процедура БезопасноЗаписатьАудитУспеха(CorrelationID, ИмяТула, Аргументы, Данные)
	Попытка
		MCP_Audit.ЗаписатьУспех(CorrelationID, ИмяТула, Аргументы, Данные);
	Исключение
		Попытка
			ЗаписьЖурналаРегистрации("MCP.audit.failed",
				УровеньЖурналаРегистрации.Предупреждение, , , ОписаниеОшибки());
		Исключение
		КонецПопытки;
	КонецПопытки;
КонецПроцедуры

Процедура БезопасноЗаписатьАудитОшибки(CorrelationID, ИмяТула, Аргументы, Ошибка)
	Попытка
		MCP_Audit.ЗаписатьОшибку(CorrelationID, ИмяТула, Аргументы, Ошибка);
	Исключение
		Попытка
			ЗаписьЖурналаРегистрации("MCP.audit.failed",
				УровеньЖурналаРегистрации.Предупреждение, , , ОписаниеОшибки());
		Исключение
		КонецПопытки;
	КонецПопытки;
КонецПроцедуры

Процедура ПроверитьРазмерРезультата(Данные)

	МаксРазмер = MCP_Config.Лимиты().max_result_json_bytes;
	Если МаксРазмер = Неопределено ИЛИ МаксРазмер <= 0 Тогда
		Возврат;
	КонецЕсли;

	ТекстДанных = MCP_JSONRPC.СохранитьJSON(Данные);
	// Лимит измеряется в байтах JSON-сериализации (max_result_json_bytes).
	// СтрДлина возвращает количество символов Unicode — для кириллицы в UTF-8
	// фактический размер ответа может быть в 2 раза больше. Считаем реальные байты.
	ФактическийРазмер = БайтUTF8(ТекстДанных);
	Если ФактическийРазмер > МаксРазмер Тогда
		Детали = Новый Структура;
		Детали.Вставить("max_result_json_bytes", МаксРазмер);
		Детали.Вставить("actual_bytes", ФактическийРазмер);
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ResultTooLarge(),
			"Результат превышает max_result_json_bytes.", Детали);
	КонецЕсли;

КонецПроцедуры

Функция БайтUTF8(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		ДД = ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8", Ложь);
		Возврат ДД.Размер();
	Исключение
		// Если кодирование недоступно — пессимистическая оценка: 4 байта на символ.
		// Лучше отвергнуть подозрительно большой ответ, чем превысить лимит транспорта.
		Возврат СтрДлина(Текст) * 4;
	КонецПопытки;

КонецФункции

