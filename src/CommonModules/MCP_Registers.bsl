// MCP_Registers.bsl
// ====================================================================
// Чтение регистров 1С: records, slice_first, slice_last, balance, turnovers, balance_and_turnovers.
// А также движения документа по регистрам (get_document_movements).
// ====================================================================

// T-5. Короткое имя регистра из полного: «РегистрБухгалтерии.Хозрасчетный» при
// register_type = «РегистрБухгалтерии» даёт «Хозрасчетный». Отсекается только
// СВОЙ вид — чужой префикс остаётся как есть и будет отвергнут проверкой имени,
// иначе несогласованная пара «вид + имя» проходила бы молча.
Функция ИмяРегистраБезВида(RegisterName, RegisterType)

	Имя = СокрЛП(Строка(RegisterName));
	Если ПустаяСтрока(Имя) ИЛИ ПустаяСтрока(RegisterType) Тогда
		Возврат Имя;
	КонецЕсли;

	Префикс = СокрЛП(Строка(RegisterType)) + ".";
	Если Лев(ВРег(Имя), СтрДлина(Префикс)) = ВРег(Префикс) Тогда
		Возврат СокрЛП(Сред(Имя, СтрДлина(Префикс) + 1));
	КонецЕсли;

	Возврат Имя;

КонецФункции

Функция ПрочитатьЗаписи(ПараметрыВызова) Экспорт

	RegisterType = ПолучитьПараметр(ПараметрыВызова, "register_type", "");
	RegisterName = ПолучитьПараметр(ПараметрыВызова, "register", "");
	Mode = ПолучитьПараметр(ПараметрыВызова, "mode", "");
	// T-5. Имя принимается и коротким, и полным: полное отдаёт сам list_registers
	// в full_name, и get_accounting_balances его принимает — а здесь оно
	// склеивалось с видом ещё раз и отвергалось как некорректное. Клиент не
	// обязан помнить, какой инструмент какую форму ждёт.
	RegisterName = ИмяРегистраБезВида(RegisterName, RegisterType);
	ПолноеИмя = RegisterType + "." + RegisterName;

	Если ПустаяСтрока(RegisterType) ИЛИ ПустаяСтрока(RegisterName) ИЛИ ПустаяСтрока(Mode) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"register_type, register и mode обязательны.");
	КонецЕсли;

	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмя) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Некорректное имя регистра: " + ПолноеИмя);
	КонецЕсли;

	MCP_Security.ПроверитьДоступКТипу(ПолноеИмя);

	ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
			"Регистр не найден: " + ПолноеИмя);
	КонецЕсли;

	// Проверка совместимости режима и типа регистра.
	ПроверитьРежим(RegisterType, Mode);
	ПроверитьПериодыРежима(ПараметрыВызова, Mode, ОМД, ПолноеИмя);

	// Срезы/остатки/обороты требуют периодического измерения.
	Если (Mode = "slice_first" ИЛИ Mode = "slice_last" ИЛИ Mode = "balance"
		ИЛИ Mode = "turnovers" ИЛИ Mode = "balance_and_turnovers")
		И RegisterType = "РегистрСведений"
		И НЕ РегистрИмеетПериод(ОМД) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_RegisterModeNotSupported(),
			"Режим " + Mode + " не применим к непериодическому регистру " + ПолноеИмя);
	КонецЕсли;

	Попытка
		Лимит = Цел(Число(ПолучитьПараметр(ПараметрыВызова, "limit", 100)));
	Исключение
		Лимит = 100;
	КонецПопытки;
	МаксЛимит = MCP_Config.Лимиты().max_register_rows;
	Если Лимит < 1 Тогда
		Лимит = 100;
	КонецЕсли;
	Если Лимит > МаксЛимит Тогда
		Лимит = МаксЛимит;
	КонецЕсли;
	Смещение = ЦелоеИзСтроки(ПолучитьПараметр(ПараметрыВызова, "cursor", ""), 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;

	ЛимитЗапроса = Смещение + Лимит + 1;
	Если ЛимитЗапроса > МаксЛимит Тогда
		ЛимитЗапроса = МаксЛимит;
	КонецЕсли;

	ТекстЗапроса = СформироватьЗапросРегистра(ПараметрыВызова, ОМД);
	ТекстЗапроса = ПрименитьЛимитКЗапросуРегистра(ТекстЗапроса, ЛимитЗапроса);
	Запрос = Новый Запрос(ТекстЗапроса);
	УстановитьПараметрыФильтра(Запрос, ПараметрыВызова, ПолноеИмя);

	Старт = ТекущиеМиллисекундыUTC();
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		Если MCP_Errors.ЭтоОтказДоступаПлатформы(ОписаниеОшибки()) Тогда
			Доступ = MCP_Security.ДоступКТипу(ПолноеИмя);
			Доступ.code = MCP_Errors.Код_AccessDenied();
			Доступ.reason_code = "1c_access_denied";
			Доступ.operation = "register_read";
			Доступ.message = "Недостаточно прав 1С на чтение регистра: " + ПолноеИмя;
			Доступ.platform_message = ОписаниеОшибки();
			MCP_Errors.ВозбудитьОшибку(Доступ.code, Доступ.message, MCP_Security.ДеталиОтказаДоступа(Доступ));
		КонецЕсли;
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
	Длительность = ТекущиеМиллисекундыUTC() - Старт;
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();

	Колонки = Новый Массив;
	Для Каждого К Из ТаблицаРезультата.Колонки Цикл
		КС = Новый Структура;
		КС.Вставить("name", К.Имя);
		КС.Вставить("type_description", Строка(К.ТипЗначения));
		Колонки.Добавить(КС);
	КонецЦикла;

	Строки = Новый Массив;
	Усечено = Ложь;
	Счетчик = 0;
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	ОпцииВалью.include_navigation_url = ПолучитьПараметр(ПараметрыВызова, "include_navigation_url", Ложь);
	КонецСтраницы = Мин(Смещение + Лимит, ТаблицаРезультата.Количество());
	Если Смещение < ТаблицаРезультата.Количество() Тогда
		Для Индекс = Смещение По КонецСтраницы - 1 Цикл
			СтрокаТаблицы = ТаблицаРезультата[Индекс];
			СтрокаJSON = Новый Структура;
			Для Каждого К Из ТаблицаРезультата.Колонки Цикл
				СтрокаJSON.Вставить(К.Имя, MCP_Values.Кодировать(СтрокаТаблицы[К.Имя], ОпцииВалью));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;

	Если ТаблицаРезультата.Количество() > Смещение + Счетчик Тогда
		Если Счетчик >= Лимит Тогда
			Усечено = Истина;
		КонецЕсли;
	КонецЕсли;

	NextCursor = Null;
	Если Усечено Тогда
		NextCursor = Строка(Смещение + Счетчик);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("register", ПолноеИмя);
	Результат.Вставить("mode", Mode);
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("row_count", Счетчик);
	Результат.Вставить("truncated", Усечено);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("query_used", ТекстЗапроса);
	Результат.Вставить("duration_ms", Длительность);
	Возврат Результат;

КонецФункции

Процедура ПроверитьРежим(RegisterType, Mode)

	Совместимы = Истина;

	Если RegisterType = "РегистрСведений" Тогда
		Совместимы = (Mode = "records" ИЛИ Mode = "slice_first" ИЛИ Mode = "slice_last");
	ИначеЕсли RegisterType = "РегистрНакопления" Тогда
		Совместимы = (Mode = "records" ИЛИ Mode = "balance" ИЛИ Mode = "turnovers" ИЛИ Mode = "balance_and_turnovers");
	ИначеЕсли RegisterType = "РегистрБухгалтерии" Тогда
		Совместимы = (Mode = "records" ИЛИ Mode = "balance" ИЛИ Mode = "turnovers"
			ИЛИ Mode = "balance_and_turnovers" ИЛИ Mode = "turnovers_debit_credit");
	ИначеЕсли RegisterType = "РегистрРасчета" Тогда
		Совместимы = (Mode = "records");
	КонецЕсли;

	Если НЕ Совместимы Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_RegisterModeNotSupported(),
			"Режим " + Mode + " не поддерживается для " + RegisterType);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПериодыРежима(Параметры, Mode, ОМД, ПолноеИмя)

	Период = ПолучитьПараметр(Параметры, "period", Неопределено);
	ПериодОт = ПолучитьПараметр(Параметры, "period_from", Неопределено);
	ПериодДо = ПолучитьПараметр(Параметры, "period_to", Неопределено);

	Если (Mode = "slice_first" ИЛИ Mode = "slice_last" ИЛИ Mode = "balance")
		И Период = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Для режима " + Mode + " обязателен параметр period.");
	КонецЕсли;

	Если (Mode = "turnovers" ИЛИ Mode = "balance_and_turnovers" ИЛИ Mode = "turnovers_debit_credit")
		И (ПериодОт = Неопределено ИЛИ ПериодДо = Неопределено) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Для режима " + Mode + " обязательны параметры period_from и period_to.");
	КонецЕсли;

	Если Mode = "records"
		И (Период <> Неопределено ИЛИ ПериодОт <> Неопределено ИЛИ ПериодДо <> Неопределено)
		И НЕ РегистрИмеетПериод(ОМД) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Регистр " + ПолноеИмя + " непериодический: period/period_from/period_to неприменимы.");
	КонецЕсли;

КонецПроцедуры

Функция СформироватьЗапросРегистра(Параметры, ОМД)

	RegisterType = ПолучитьПараметр(Параметры, "register_type", "");
	// T-5: та же нормализация, что во входной точке, — иначе полное имя
	// склеивалось бы с видом повторно уже при сборке текста запроса.
	RegisterName = ИмяРегистраБезВида(ПолучитьПараметр(Параметры, "register", ""), RegisterType);
	Mode = ПолучитьПараметр(Параметры, "mode", "");
	ПолноеИмя = RegisterType + "." + RegisterName;

	Виртуальная = "";
	WHERE = "";
	Фильтр = ПолучитьФильтрСтрокой(Параметры, ПолноеИмя);
	Если Mode = "slice_first" Тогда
		Виртуальная = ?(ПустаяСтрока(Фильтр), ".СрезПервых(&Период)", ".СрезПервых(&Период, " + Фильтр + ")");
	ИначеЕсли Mode = "slice_last" Тогда
		Виртуальная = ?(ПустаяСтрока(Фильтр), ".СрезПоследних(&Период)", ".СрезПоследних(&Период, " + Фильтр + ")");
	ИначеЕсли Mode = "balance" Тогда
		Если RegisterType = "РегистрБухгалтерии" Тогда
			Виртуальная = ".Остатки(&Период)";
			WHERE = WHEREИзФильтра(Фильтр);
		Иначе
			Виртуальная = ?(ПустаяСтрока(Фильтр), ".Остатки(&Период)", ".Остатки(&Период, " + Фильтр + ")");
		КонецЕсли;
	ИначеЕсли Mode = "turnovers" Тогда
		Если RegisterType = "РегистрБухгалтерии" Тогда
			Виртуальная = ".Обороты(&ПериодНачало, &ПериодКонец)";
			WHERE = WHEREИзФильтра(Фильтр);
		Иначе
			Виртуальная = ?(ПустаяСтрока(Фильтр), ".Обороты(&ПериодНачало, &ПериодКонец)", ".Обороты(&ПериодНачало, &ПериодКонец, , " + Фильтр + ")");
		КонецЕсли;
	ИначеЕсли Mode = "turnovers_debit_credit" Тогда
		Виртуальная = ".ОборотыДтКт(&ПериодНачало, &ПериодКонец)";
		WHERE = WHEREИзФильтра(Фильтр);
	ИначеЕсли Mode = "balance_and_turnovers" Тогда
		Если RegisterType = "РегистрБухгалтерии" Тогда
			Виртуальная = ".ОстаткиИОбороты(&ПериодНачало, &ПериодКонец)";
			WHERE = WHEREИзФильтра(Фильтр);
		Иначе
			Виртуальная = ?(ПустаяСтрока(Фильтр), ".ОстаткиИОбороты(&ПериодНачало, &ПериодКонец)", ".ОстаткиИОбороты(&ПериодНачало, &ПериодКонец, , , " + Фильтр + ")");
		КонецЕсли;
	Иначе
		// records: фильтры идут как WHERE, плюс при необходимости — ограничение по периоду.
		Условия = Новый Массив;
		Если НЕ ПустаяСтрока(Фильтр) Тогда
			Условия.Добавить(Фильтр);
		КонецЕсли;
		ХочетФильтрПоПериоду = ПолучитьПараметр(Параметры, "period", Неопределено) <> Неопределено
			ИЛИ ПолучитьПараметр(Параметры, "period_from", Неопределено) <> Неопределено
			ИЛИ ПолучитьПараметр(Параметры, "period_to", Неопределено) <> Неопределено;
		Если ХочетФильтрПоПериоду И НЕ РегистрИмеетПериод(ОМД) Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
				"Регистр " + ПолноеИмя + " непериодический: period/period_from/period_to неприменимы.");
		КонецЕсли;
		Если ПолучитьПараметр(Параметры, "period", Неопределено) <> Неопределено Тогда
			Условия.Добавить("Период = &Период");
		КонецЕсли;
		Если ПолучитьПараметр(Параметры, "period_from", Неопределено) <> Неопределено Тогда
			Условия.Добавить("Период >= &ПериодНачало");
		КонецЕсли;
		Если ПолучитьПараметр(Параметры, "period_to", Неопределено) <> Неопределено Тогда
			Условия.Добавить("Период <= &ПериодКонец");
		КонецЕсли;
		Если Условия.Количество() > 0 Тогда
			WHERE = Символы.ПС + "ГДЕ " + СтрСоединить(Условия, " И ");
		КонецЕсли;
	КонецЕсли;

	Поля = СформироватьСписокПолей(Параметры, ОМД);

	Текст = "ВЫБРАТЬ " + Поля + Символы.ПС
		+ "ИЗ " + ПолноеИмя + Виртуальная + WHERE;

	OrderBy = БезопасныйСписокПолей(ПолучитьПараметр(Параметры, "order_by", Неопределено), ПолноеИмя);
	Если OrderBy.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО " + СтрСоединить(OrderBy, ", ");
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция WHEREИзФильтра(Фильтр)

	Если ПустаяСтрока(Фильтр) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Символы.ПС + "ГДЕ " + Фильтр;

КонецФункции

Функция ПрименитьЛимитКЗапросуРегистра(ТекстЗапроса, Лимит)

	ВерхнийТекст = ВРег(ТекстЗапроса);
	Если НЕ СтрНачинаетсяС(ВерхнийТекст, "ВЫБРАТЬ ") Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	Возврат "ВЫБРАТЬ ПЕРВЫЕ " + MCP_Query.ЦелоеДляТекстаЗапроса(Лимит) + " "
		+ Сред(ТекстЗапроса, СтрДлина("ВЫБРАТЬ ") + 1);

КонецФункции

Функция СформироватьСписокПолей(Параметры, ОМД)

	Поля = Новый Массив;

	Dimensions = ПолучитьПараметр(Параметры, "dimensions", Неопределено);
	Resources = ПолучитьПараметр(Параметры, "resources", Неопределено);
	Attributes = ПолучитьПараметр(Параметры, "attributes", Неопределено);
	Mode = ПолучитьПараметр(Параметры, "mode", "records");

	// T-5: нормализация имени и здесь — состав полей считается по тому же
	// полному имени, каким выполняется запрос.
	ВидРегистра = ПолучитьПараметр(Параметры, "register_type", "");
	ПолноеИмя = ВидРегистра + "."
		+ ИмяРегистраБезВида(ПолучитьПараметр(Параметры, "register", ""), ВидРегистра);
	ДобавитьБезопасныеПоля(Поля, Dimensions, ПолноеИмя);
	ДобавитьБезопасныеРесурсыПоРежиму(Поля, Resources, ПолноеИмя, ОМД, Mode);
	ДобавитьБезопасныеПоля(Поля, Attributes, ПолноеИмя);

	Если Поля.Количество() = 0 Тогда
		Если ЕстьЗапрошенныеПоля(Dimensions) ИЛИ ЕстьЗапрошенныеПоля(Resources) ИЛИ ЕстьЗапрошенныеПоля(Attributes) Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_FieldNotAllowed(),
				"Не осталось разрешённых полей регистра после проверки.");
		КонецЕсли;
		ПоляПоУмолчанию = БезопасныеПоляРегистраПоРежиму(ПолноеИмя, ОМД, Mode);
		Если ПоляПоУмолчанию.Количество() = 0 Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_FieldNotAllowed(),
				"Не осталось разрешённых полей регистра после проверки.");
		КонецЕсли;
		Возврат СтрСоединить(ПоляПоУмолчанию, ", ");
	КонецЕсли;
	Возврат СтрСоединить(Поля, ", ");

КонецФункции

Процедура ДобавитьБезопасныеРесурсыПоРежиму(Поля, Список, ПолноеИмя, ОМД, Mode)

	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Если Список.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ИмяПоля Из Список Цикл
		Если НЕ MCP_Security.ИмяБезопасноДляЗапроса(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		РазрешенныеИмена = ИменаРесурсаДляРежима(Строка(ИмяПоля), ОМД, Mode, ПолноеИмя);
		Для Каждого ИмяРежима Из РазрешенныеИмена Цикл
			Если Поля.Найти(ИмяРежима) = Неопределено Тогда
				Поля.Добавить(ИмяРежима);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ИменаРесурсаДляРежима(ИмяПоля, ОМД, Mode, ПолноеИмя)

	Результат = Новый Массив;
	БазовоеИмя = БазовоеИмяРесурсаПоРежиму(ИмяПоля, Mode);
	Если НЕ ПустаяСтрока(БазовоеИмя) И MCP_Security.ПолеРазрешено(ПолноеИмя, БазовоеИмя) Тогда
		Результат.Добавить(ИмяПоля);
		Возврат Результат;
	КонецЕсли;

	Если MCP_Security.ПолеРазрешено(ПолноеИмя, ИмяПоля) Тогда
		Если Mode = "records" Тогда
			Результат.Добавить(ИмяПоля);
		ИначеЕсли Mode = "turnovers" Тогда
			Результат.Добавить(ИмяПоля + "Оборот");
		ИначеЕсли Mode = "balance" Тогда
			Результат.Добавить(ИмяПоля + "Остаток");
		ИначеЕсли Mode = "balance_and_turnovers" Тогда
			Результат.Добавить(ИмяПоля + "НачальныйОстаток");
			Результат.Добавить(ИмяПоля + "Оборот");
			Результат.Добавить(ИмяПоля + "КонечныйОстаток");
		Иначе
			Результат.Добавить(ИмяПоля);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция БазовоеИмяРесурсаПоРежиму(ИмяПоля, Mode)

	Если Mode = "turnovers" И MCPРегистрыСтрЗаканчиваетсяНа(ИмяПоля, "Оборот") Тогда
		Возврат Лев(ИмяПоля, СтрДлина(ИмяПоля) - СтрДлина("Оборот"));
	ИначеЕсли Mode = "balance" И MCPРегистрыСтрЗаканчиваетсяНа(ИмяПоля, "Остаток") Тогда
		Возврат Лев(ИмяПоля, СтрДлина(ИмяПоля) - СтрДлина("Остаток"));
	ИначеЕсли Mode = "balance_and_turnovers" Тогда
		Если MCPРегистрыСтрЗаканчиваетсяНа(ИмяПоля, "НачальныйОстаток") Тогда
			Возврат Лев(ИмяПоля, СтрДлина(ИмяПоля) - СтрДлина("НачальныйОстаток"));
		ИначеЕсли MCPРегистрыСтрЗаканчиваетсяНа(ИмяПоля, "КонечныйОстаток") Тогда
			Возврат Лев(ИмяПоля, СтрДлина(ИмяПоля) - СтрДлина("КонечныйОстаток"));
		ИначеЕсли MCPРегистрыСтрЗаканчиваетсяНа(ИмяПоля, "Оборот") Тогда
			Возврат Лев(ИмяПоля, СтрДлина(ИмяПоля) - СтрДлина("Оборот"));
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция MCPРегистрыСтрЗаканчиваетсяНа(Текст, Суффикс)

	Если СтрДлина(Текст) < СтрДлина(Суффикс) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Прав(Текст, СтрДлина(Суффикс)) = Суффикс;

КонецФункции

Функция ПолучитьФильтрСтрокой(Параметры, ПолноеИмя)

	Фильтры = ПолучитьПараметр(Параметры, "filters", Неопределено);
	Если Фильтры = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Условия = Новый Массив;
	БылиФильтры = Ложь;
	ТипФильтров = ТипЗнч(Фильтры);
	Если ТипФильтров = Тип("Структура") ИЛИ ТипФильтров = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипФильтров = Тип("Соответствие") ИЛИ ТипФильтров = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого КЗ Из Фильтры Цикл
			БылиФильтры = Истина;
			ИмяПоля = Строка(КЗ.Ключ);
			Если MCP_Security.ИмяБезопасноДляЗапроса(ИмяПоля)
				И MCP_Security.ПолеРазрешено(ПолноеИмя, ИмяПоля) Тогда
				Условия.Добавить(ИмяПоля + " = &Filter_" + ИмяПоля);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если БылиФильтры И Условия.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_FieldNotAllowed(),
			"Не осталось разрешённых фильтров регистра после проверки.");
	КонецЕсли;

	Возврат СтрСоединить(Условия, " И ");

КонецФункции

Процедура ДобавитьБезопасныеПоля(Поля, Список, ПолноеИмя)

	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Если Список.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ИмяПоля Из Список Цикл
		Если MCP_Security.ИмяБезопасноДляЗапроса(ИмяПоля)
			И MCP_Security.ПолеРазрешено(ПолноеИмя, ИмяПоля) Тогда
			Поля.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция БезопасныйСписокПолей(Список, ПолноеИмя)

	Результат = Новый Массив;
	ДобавитьБезопасныеПоля(Результат, Список, ПолноеИмя);
	Возврат Результат;

КонецФункции

Функция ЕстьЗапрошенныеПоля(Список)

	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Список.Количество() > 0;

КонецФункции

Функция ПолучитьПараметр(Параметры, Имя, ПоУмолчанию)

	Если Параметры = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	ТипКонтейнера = ТипЗнч(Параметры);
	Если (ТипКонтейнера = Тип("Структура") ИЛИ ТипКонтейнера = Тип("ФиксированнаяСтруктура"))
		И Параметры.Свойство(Имя, Значение) Тогда
		Если Значение = Null Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	Если ТипКонтейнера = Тип("Соответствие") ИЛИ ТипКонтейнера = Тип("ФиксированноеСоответствие") Тогда
		Значение = Параметры.Получить(Имя);
		Если Значение <> Неопределено И Значение <> Null Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

Функция ЦелоеИзСтроки(Текст, ПоУмолчанию)
	Попытка
		Возврат ?(ПустаяСтрока(Текст), ПоУмолчанию, Цел(Число(Текст)));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Процедура УстановитьПараметрыФильтра(Запрос, Параметры, ПолноеИмя) Экспорт

	// Период.
	Период = ПолучитьПараметр(Параметры, "period", Неопределено);
	Если Период <> Неопределено Тогда
		Запрос.УстановитьПараметр("Период", MCP_Values.ДекодироватьПараметр(СтруктураDate(Период)));
	КонецЕсли;
	ПериодОт = ПолучитьПараметр(Параметры, "period_from", Неопределено);
	Если ПериодОт <> Неопределено Тогда
		Запрос.УстановитьПараметр("ПериодНачало", MCP_Values.ДекодироватьПараметр(СтруктураDate(ПериодОт)));
	КонецЕсли;
	ПериодДо = ПолучитьПараметр(Параметры, "period_to", Неопределено);
	Если ПериодДо <> Неопределено Тогда
		Запрос.УстановитьПараметр("ПериодКонец", MCP_Values.ДекодироватьПараметр(СтруктураDate(ПериодДо)));
	КонецЕсли;

	// Фильтры по измерениям.
	Фильтры = ПолучитьПараметр(Параметры, "filters", Неопределено);
	Если Фильтры <> Неопределено Тогда
		ТипФильтров = ТипЗнч(Фильтры);
		Если ТипФильтров = Тип("Структура") ИЛИ ТипФильтров = Тип("ФиксированнаяСтруктура")
			ИЛИ ТипФильтров = Тип("Соответствие") ИЛИ ТипФильтров = Тип("ФиксированноеСоответствие") Тогда
			Для Каждого КЗ Из Фильтры Цикл
				ИмяПоля = Строка(КЗ.Ключ);
				Если MCP_Security.ИмяБезопасноДляЗапроса(ИмяПоля)
					И MCP_Security.ПолеРазрешено(ПолноеИмя, ИмяПоля) Тогда
					Запрос.УстановитьПараметр("Filter_" + ИмяПоля,
						MCP_Values.ДекодироватьПараметр(КЗ.Значение));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция СтруктураDate(Значение)

	// Идемпотентно: уже структурированное {kind, value} пропускаем как есть.
	// JSON-объекты могут прийти как Структура или Соответствие — учитываем оба варианта.
	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Запас = Неопределено;
		Если Значение.Свойство("kind", Запас) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Если Значение.Получить("kind") <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Стр = Новый Структура;
	Стр.Вставить("kind", "datetime");
	Стр.Вставить("value", Строка(Значение));
	Возврат Стр;

КонецФункции

Функция ТекущиеМиллисекундыUTC()
	Возврат (ТекущаяУниверсальнаяДата() - '19700101') * 1000;
КонецФункции

Функция РегистрИмеетПериод(ОМД)

	// Непериодический РегистрСведений не имеет реквизита Период в стандартных
	// реквизитах. Это самый надёжный универсальный признак.
	Попытка
		Возврат ОМД.СтандартныеРеквизиты.Найти("Период") <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// ---- Движения документа ------------------------------------------

Функция ДвиженияДокумента(ТипДокумента, UUID, СписокРегистров, RowLimitPerRegister, IncludeEmpty, Курсор = "", RowCursor = "") Экспорт

	MCP_Security.ПроверитьДоступКТипу(ТипДокумента);

	СсылкаДокумента = MCP_Values.СсылкаПоТипуИUUID(ТипДокумента, UUID);

	Если СсылкаДокумента = Неопределено ИЛИ СсылкаДокумента.Пустая() Тогда
		Возврат Новый Структура("found, document, movements, truncated, next_cursor",
			Ложь, Null, Новый Массив, Ложь, Null);
	КонецЕсли;

	// Определяем потенциальные регистры.
	РегистрыЗаданыЯвно = СписокРегистров <> Неопределено
		И ТипЗнч(СписокРегистров) = Тип("Массив")
		И СписокРегистров.Количество() > 0;
	Если СписокРегистров = Неопределено ИЛИ ТипЗнч(СписокРегистров) <> Тип("Массив")
		ИЛИ СписокРегистров.Количество() = 0 Тогда
		СписокРегистров = СписокРегистраторовДляДокумента(ТипДокумента);
	КонецЕсли;

	Movements = Новый Массив;
	SkippedRegisters = Новый Массив;
	СмещениеРегистров = ЦелоеИзСтроки(Курсор, 0);
	Если СмещениеРегистров < 0 Тогда
		СмещениеРегистров = 0;
	КонецЕсли;
	ВсегоРегистров = СписокРегистров.Количество();
	// Размер страницы по регистрам — отдельная величина, не путать с лимитом строк
	// в каждом регистре. По умолчанию документ затрагивает единицы регистров,
	// поэтому берём общесерверный лимит max_register_rows как верхнюю границу.
	РегистровНаСтраницу = MCP_Config.Лимиты().max_register_rows;
	КонецРегистров = Мин(СмещениеРегистров + РегистровНаСтраницу, ВсегоРегистров);
	Если СмещениеРегистров < ВсегоРегистров Тогда
		Для ИндексРегистра = СмещениеРегистров По КонецРегистров - 1 Цикл
			ПолноеИмяРегистра = СписокРегистров[ИндексРегистра];
			Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмяРегистра) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ MCP_Security.ТипРазрешен(ПолноеИмяРегистра) Тогда
				ДоступРегистра = MCP_Security.ДоступКТипу(ПолноеИмяРегистра);
				Если РегистрыЗаданыЯвно Тогда
					MCP_Security.ПроверитьДоступКТипу(ПолноеИмяРегистра);
				КонецЕсли;
				Пропуск = Новый Структура;
				Пропуск.Вставить("register", ПолноеИмяРегистра);
				Пропуск.Вставить("reason_code", ДоступРегистра.reason_code);
				Пропуск.Вставить("message", ДоступРегистра.message);
				SkippedRegisters.Добавить(Пропуск);
				Продолжить;
			КонецЕсли;
			Строки = ПрочитатьДвиженияРегистра(ПолноеИмяРегистра, СсылкаДокумента, RowLimitPerRegister, RowCursor);
			Если ЗначениеПоляСтруктуры(Строки, "access_denied", Ложь) Тогда
				Если РегистрыЗаданыЯвно Тогда
					MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_AccessDenied(),
						"Недостаточно прав 1С на чтение движений регистра: " + ПолноеИмяРегистра,
						Строки.details);
				КонецЕсли;
				Пропуск = Новый Структура;
				Пропуск.Вставить("register", ПолноеИмяРегистра);
				Пропуск.Вставить("reason_code", "1c_access_denied");
				Пропуск.Вставить("message", "Движения регистра недоступны текущему пользователю 1С.");
				SkippedRegisters.Добавить(Пропуск);
				Продолжить;
			КонецЕсли;
			Если Строки.row_count = 0 И НЕ IncludeEmpty Тогда
				Продолжить;
			КонецЕсли;

			Стр = Новый Структура;
			Стр.Вставить("register", ПолноеИмяРегистра);
			Стр.Вставить("register_type", MCP_Security.ВидМетаданныхИзПолногоИмени(ПолноеИмяРегистра));
			Стр.Вставить("rows", Строки.rows);
			Стр.Вставить("row_count", Строки.row_count);
			Стр.Вставить("truncated", Строки.truncated);
			Стр.Вставить("next_row_cursor", Строки.next_cursor);
			Movements.Добавить(Стр);
		КонецЦикла;
	КонецЕсли;

	NextCursor = Null;
	Если КонецРегистров < ВсегоРегистров Тогда
		NextCursor = Строка(КонецРегистров);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("found", Истина);
	Результат.Вставить("document", MCP_Values.Кодировать(СсылкаДокумента));
	Результат.Вставить("movements", Movements);
	Результат.Вставить("skipped_registers", SkippedRegisters);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("truncated", NextCursor <> Null);
	Возврат Результат;

КонецФункции

Функция СписокРегистраторовДляДокумента(ТипДокумента)

	Результат = Новый Массив;
	ИмяДокумента = MCP_Security.ИмяОбъектаИзПолногоИмени(ТипДокумента);
	ОМДДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если ОМДДокумента = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Регистр Из ОМДДокумента.Движения Цикл
		Вид = MCP_Metadata.ВидПоОбъектуМетаданных(Регистр);
		Если НЕ ПустаяСтрока(Вид) Тогда
			Результат.Добавить(Вид + "." + Регистр.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрочитатьДвиженияРегистра(ПолноеИмяРегистра, СсылкаДокумента, Лимит, Курсор = "")

	Поля = ПоляДляЧтенияДвиженийРегистра(ПолноеИмяРегистра);
	Если Лимит = Неопределено ИЛИ Лимит < 1 Тогда
		Лимит = 200;
	КонецЕсли;
	Если Лимит > MCP_Config.Лимиты().max_register_rows Тогда
		Лимит = MCP_Config.Лимиты().max_register_rows;
	КонецЕсли;

	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;

	ЛимитЗапроса = Смещение + Лимит + 1;
	Если ЛимитЗапроса > MCP_Config.Лимиты().max_register_rows Тогда
		ЛимитЗапроса = MCP_Config.Лимиты().max_register_rows;
	КонецЕсли;

	Текст = "ВЫБРАТЬ ПЕРВЫЕ " + MCP_Query.ЦелоеДляТекстаЗапроса(ЛимитЗапроса) + " " + Поля
		+ " ИЗ " + ПолноеИмяРегистра + " КАК Т ГДЕ Т.Регистратор = &Регистратор";
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Регистратор", СсылкаДокумента);

	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		Если MCP_Errors.ЭтоОтказДоступаПлатформы(ОписаниеОшибки()) Тогда
			Доступ = MCP_Security.ДоступКТипу(ПолноеИмяРегистра);
			Доступ.code = MCP_Errors.Код_AccessDenied();
			Доступ.reason_code = "1c_access_denied";
			Доступ.operation = "document_movements";
			Доступ.message = "Недостаточно прав 1С на чтение движений регистра: " + ПолноеИмяРегистра;
			Доступ.platform_message = ОписаниеОшибки();
			Возврат Новый Структура("rows, row_count, truncated, next_cursor, access_denied, details",
				Новый Массив, 0, Ложь, Null, Истина, MCP_Security.ДеталиОтказаДоступа(Доступ));
		КонецЕсли;
		Возврат Новый Структура("rows, row_count, truncated, next_cursor", Новый Массив, 0, Ложь, Null);
	КонецПопытки;
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();

	Строки = Новый Массив;
	Усечено = Ложь;
	Счетчик = 0;
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	ОпцииВалью.include_navigation_url = Ложь;
	КонецСтраницы = Мин(Смещение + Лимит, ТаблицаРезультата.Количество());
	Если Смещение < ТаблицаРезультата.Количество() Тогда
		Для Индекс = Смещение По КонецСтраницы - 1 Цикл
			СтрокаТаблицы = ТаблицаРезультата[Индекс];
			СтрокаJSON = Новый Структура;
			Для Каждого К Из ТаблицаРезультата.Колонки Цикл
				СтрокаJSON.Вставить(К.Имя, MCP_Values.Кодировать(СтрокаТаблицы[К.Имя], ОпцииВалью));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;

	Если ТаблицаРезультата.Количество() > Смещение + Счетчик Тогда
		Если Счетчик >= Лимит Тогда
			Усечено = Истина;
		КонецЕсли;
	КонецЕсли;

	NextCursor = Null;
	Если Усечено Тогда
		NextCursor = Строка(Смещение + Счетчик);
	КонецЕсли;

	Возврат Новый Структура("rows, row_count, truncated, next_cursor", Строки, Счетчик, Усечено, NextCursor);

КонецФункции

Функция ЗначениеПоляСтруктуры(СтруктураЗначений, ИмяПоля, ЗначениеПоУмолчанию)

	Значение = Неопределено;
	Попытка
		Если СтруктураЗначений.Свойство(ИмяПоля, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ПоляДляЧтенияДвиженийРегистра(ПолноеИмяРегистра)

	ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяРегистра);
	Если ОМД = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
			"Регистр не найден: " + ПолноеИмяРегистра);
	КонецЕсли;

	Поля = БезопасныеПоляРегистра(ПолноеИмяРегистра, ОМД);

	Если Поля.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_FieldNotAllowed(),
			"Не осталось разрешённых полей регистра после проверки.");
	КонецЕсли;

	Возврат СтрСоединить(Поля, ", ");

КонецФункции

Функция БезопасныеПоляРегистраПоРежиму(ПолноеИмяРегистра, ОМД, Mode)

	Если Mode = "records" ИЛИ ПустаяСтрока(Mode) Тогда
		Возврат БезопасныеПоляРегистра(ПолноеИмяРегистра, ОМД);
	КонецЕсли;

	Поля = Новый Массив;
	Найденные = Новый Соответствие;
	RegisterType = Лев(ПолноеИмяРегистра, СтрНайти(ПолноеИмяРегистра, ".") - 1);

	Если RegisterType = "РегистрСведений" Тогда
		ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "СтандартныеРеквизиты");
		ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "Измерения");
		ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "Ресурсы");
		ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "Реквизиты");
		Возврат Поля;
	КонецЕсли;

	Если RegisterType = "РегистрНакопления" Тогда
		ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "Измерения");
		ДобавитьРесурсыРегистраПоРежиму(Поля, Найденные, ПолноеИмяРегистра, ОМД, Mode);
		Возврат Поля;
	КонецЕсли;

	Если RegisterType = "РегистрБухгалтерии" Тогда
		Если Mode = "turnovers_debit_credit" Тогда
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "СчетДт");
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "СчетКт");
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "СубконтоДт1");
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "СубконтоДт2");
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "СубконтоДт3");
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "СубконтоКт1");
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "СубконтоКт2");
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "СубконтоКт3");
		Иначе
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "Счет");
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "Субконто1");
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "Субконто2");
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, "Субконто3");
		КонецЕсли;
		ДобавитьРесурсыРегистраПоРежиму(Поля, Найденные, ПолноеИмяРегистра, ОМД, Mode);
		Возврат Поля;
	КонецЕсли;

	Возврат БезопасныеПоляРегистра(ПолноеИмяРегистра, ОМД);

КонецФункции

// T-2 (Д-5). Состав ресурсов берётся из ОПУБЛИКОВАННОЙ схемы конкретной
// виртуальной таблицы, а не склейкой суффикса. Прежнее правило считало суффикс
// «Оборот» годным и для `Обороты`, и для `ОборотыДтКт`, а у второй таблицы
// небалансовые ресурсы (валютные, количественные) существуют ТОЛЬКО в формах
// `…ОборотДт`/`…ОборотКт`. Запрос падал с internal_error, причём ошибка
// называла лишь первое несуществующее поле — после точечного фикса вылезало
// следующее, поэтому правило заменено целиком, а не пополнено.
//
// Суффиксы остаются источником КАНДИДАТОВ; решает наличие имени в составе ВТ.
// Если состав прочитать не удалось (supported = Ложь), действует прежнее
// поведение по суффиксу: сузить набор молча хуже, чем оставить как было.
Процедура ДобавитьРесурсыРегистраПоРежиму(Поля, Найденные, ПолноеИмяРегистра, ОМД, Mode)

	Попытка
		Коллекция = ОМД.Ресурсы;
	Исключение
		Возврат;
	КонецПопытки;

	СоставВТ = СоставВиртуальнойТаблицыПоРежиму(ПолноеИмяРегистра, Mode);

	Для Каждого Ресурс Из Коллекция Цикл
		Имя = Ресурс.Имя;
		// ПолеРазрешено — проверка allowlist, а НЕ проверка существования поля
		// (T-2 п. 3): подменять один вопрос другим нельзя.
		Если НЕ MCP_Security.ПолеРазрешено(ПолноеИмяРегистра, Имя) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Кандидат Из КандидатыРесурсаПоРежиму(Имя, Mode) Цикл
			Если НЕ ПолеЕстьВСоставеВТ(СоставВТ, Кандидат) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, Кандидат);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Формы имени ресурса, возможные в виртуальной таблице режима. Для ОборотыДтКт
// перечисляются все три: балансовый ресурс даёт `…Оборот`, небалансовый —
// `…ОборотДт`/`…ОборотКт`; какая из форм существует, решает состав таблицы.
Функция КандидатыРесурсаПоРежиму(Имя, Mode)

	Результат = Новый Массив;
	Если Mode = "turnovers" Тогда
		Результат.Добавить(Имя + "Оборот");
	ИначеЕсли Mode = "turnovers_debit_credit" Тогда
		Результат.Добавить(Имя + "Оборот");
		Результат.Добавить(Имя + "ОборотДт");
		Результат.Добавить(Имя + "ОборотКт");
	ИначеЕсли Mode = "balance" Тогда
		Результат.Добавить(Имя + "Остаток");
	ИначеЕсли Mode = "balance_and_turnovers" Тогда
		Результат.Добавить(Имя + "НачальныйОстаток");
		Результат.Добавить(Имя + "Оборот");
		Результат.Добавить(Имя + "КонечныйОстаток");
	Иначе
		Результат.Добавить(Имя);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Состав полей виртуальной таблицы режима — тем же механизмом, каким сервер
// публикует register_schema.virtual_tables и диагностику полей ВТ.
Функция СоставВиртуальнойТаблицыПоРежиму(ПолноеИмяРегистра, Mode)

	ИмяВТ = ИмяВиртуальнойТаблицыПоРежиму(Mode);
	Если ПустаяСтрока(ИмяВТ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат MCP_Query.ПолныйНаборПолейВиртуальнойТаблицыКэшированный(
			ПолноеИмяРегистра, ИмяВТ, Неопределено);
	Исключение
		// Диагностика состава не должна ронять сборку полей.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ИмяВиртуальнойТаблицыПоРежиму(Mode)

	Если Mode = "turnovers" Тогда
		Возврат "Обороты";
	ИначеЕсли Mode = "turnovers_debit_credit" Тогда
		Возврат "ОборотыДтКт";
	ИначеЕсли Mode = "balance" Тогда
		Возврат "Остатки";
	ИначеЕсли Mode = "balance_and_turnovers" Тогда
		Возврат "ОстаткиИОбороты";
	КонецЕсли;

	Возврат "";

КонецФункции

// Пустой либо непрочитанный состав означает «не знаем», а не «поля нет»:
// в этом случае кандидат пропускается дальше по прежнему правилу суффикса.
Функция ПолеЕстьВСоставеВТ(СоставВТ, ИмяПоля)

	Если СоставВТ = Неопределено ИЛИ НЕ СоставВТ.supported Тогда
		Возврат Истина;
	КонецЕсли;
	ВерхИмя = ВРег(СокрЛП(Строка(ИмяПоля)));
	Для Каждого Поле Из СоставВТ.fields Цикл
		Если ВРег(СокрЛП(Строка(Поле))) = ВерхИмя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьПолеЕслиРазрешено(Поля, Найденные, ПолноеИмяРегистра, ИмяПоля)

	Если ПустаяСтрока(ИмяПоля)
		ИЛИ Найденные.Получить(ИмяПоля) <> Неопределено
		ИЛИ НЕ MCP_Security.ИмяБезопасноДляЗапроса(ИмяПоля)
		ИЛИ НЕ MCP_Security.ПолеРазрешено(ПолноеИмяРегистра, ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	Поля.Добавить(ИмяПоля);
	Найденные.Вставить(ИмяПоля, Истина);

КонецПроцедуры

Функция БезопасныеПоляРегистра(ПолноеИмяРегистра, ОМД)

	Поля = Новый Массив;
	Найденные = Новый Соответствие;
	ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "СтандартныеРеквизиты");
	ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "Измерения");
	ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "Ресурсы");
	ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, "Реквизиты");
	Возврат Поля;

КонецФункции

Процедура ДобавитьКоллекциюПолейРегистра(Поля, Найденные, ПолноеИмяРегистра, ОМД, ИмяКоллекции)

	Попытка
		Если ИмяКоллекции = "СтандартныеРеквизиты" Тогда
			Коллекция = ОМД.СтандартныеРеквизиты;
		ИначеЕсли ИмяКоллекции = "Измерения" Тогда
			Коллекция = ОМД.Измерения;
		ИначеЕсли ИмяКоллекции = "Ресурсы" Тогда
			Коллекция = ОМД.Ресурсы;
		ИначеЕсли ИмяКоллекции = "Реквизиты" Тогда
			Коллекция = ОМД.Реквизиты;
		Иначе
			Возврат;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Реквизит Из Коллекция Цикл
		ИмяПоля = Реквизит.Имя;
		Если Найденные.Получить(ИмяПоля) = Неопределено
			И MCP_Security.ИмяБезопасноДляЗапроса(ИмяПоля)
			И MCP_Security.ПолеРазрешено(ПолноеИмяРегистра, ИмяПоля) Тогда
			Поля.Добавить(ИмяПоля);
			Найденные.Вставить(ИмяПоля, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
