// ----------------------------------------------------------------------
// 6. list_registers
// ----------------------------------------------------------------------
Функция ListRegisters(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	RegisterTypes = МассивСтрокИзАргумента(Получить(Аргументы, "register_types", Неопределено));
	Query = СокрЛП(Строка(Получить(Аргументы, "query", "")));
	ModeSupport = СокрЛП(Строка(Получить(Аргументы, "mode_support", "")));
	HasPeriodFilter = Получить(Аргументы, "has_period", Неопределено);
	IncludeFieldsSummary = Получить(Аргументы, "include_fields_summary", Ложь);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 50, MCP_Config.Лимиты().max_limit);
	Курсор = ЦелоеИзСтроки(Получить(Аргументы, "cursor", ""), 0);
	Если Курсор < 0 Тогда Курсор = 0; КонецЕсли;

	Если RegisterTypes.Количество() = 0 Тогда
		RegisterTypes.Добавить("РегистрСведений");
		RegisterTypes.Добавить("РегистрНакопления");
		RegisterTypes.Добавить("РегистрБухгалтерии");
		RegisterTypes.Добавить("РегистрРасчета");
	КонецЕсли;

	ВсеРегистры = Новый Массив;
	Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
	Для Каждого Стр Из Все Цикл
		Если НЕ МассивСодержитСтрокуБезРегистра(RegisterTypes, Стр.Вид) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ MCP_Security.ТипРазрешен(Стр.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПустаяСтрока(Query) Тогда
			Q = ВРег(Query);
			Если СтрНайти(ВРег(Стр.Имя), Q) = 0 И СтрНайти(ВРег(Стр.Синоним), Q) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		ОМД = Метаданные.НайтиПоПолномуИмени(Стр.ПолноеИмя);
		Если ОМД = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		HasPeriod = РегистрИмеетПериодМетаданных(ОМД);
		Если HasPeriodFilter <> Неопределено И ТипЗнч(HasPeriodFilter) = Тип("Булево")
			И HasPeriod <> HasPeriodFilter Тогда
			Продолжить;
		КонецЕсли;

		Modes = ПоддерживаемыеРежимыРегистра(Стр.Вид, HasPeriod);
		Если НЕ ПустаяСтрока(ModeSupport) И НЕ МассивСодержитСтрокуБезРегистра(Modes, ModeSupport) Тогда
			Продолжить;
		КонецЕсли;

		Рег = Новый Структура;
		Рег.Вставить("register_type", Стр.Вид);
		Рег.Вставить("name", Стр.Имя);
		Рег.Вставить("full_name", Стр.ПолноеИмя);
		Рег.Вставить("synonym", Стр.Синоним);
		Рег.Вставить("has_period", HasPeriod);
		Рег.Вставить("supported_modes", Modes);
		Если IncludeFieldsSummary Тогда
			Рег.Вставить("fields_summary", КраткаяСхемаРегистра(ОМД));
		КонецЕсли;
		ВсеРегистры.Добавить(Рег);
	КонецЦикла;

	Страница = СтраницаМассива(ВсеРегистры, Курсор, Лимит);
	Результат = Новый Структура;
	Результат.Вставить("registers", Страница.items);
	Результат.Вставить("register_count", Страница.items.Количество());
	Результат.Вставить("truncated", Страница.truncated);
	Результат.Вставить("next_cursor", Страница.next_cursor);
	Результат.Вставить("total_estimated", ВсеРегистры.Количество());
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 7. get_accounting_accounts_map
// ----------------------------------------------------------------------
Функция GetAccountingAccountsMap(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Chart = Получить(Аргументы, "chart", "");
	AccountCodePrefix = Получить(Аргументы, "account_code_prefix", "");
	IncludeEmptySubconto = Получить(Аргументы, "include_empty_subconto", Ложь);
	Если ТипЗнч(IncludeEmptySubconto) <> Тип("Булево") Тогда
		IncludeEmptySubconto = Ложь;
	КонецЕсли;
	IncludeQuery = Получить(Аргументы, "include_query", Ложь);
	Если ТипЗнч(IncludeQuery) <> Тип("Булево") Тогда
		IncludeQuery = Ложь;
	КонецЕсли;
	IncludeGuidance = Получить(Аргументы, "include_guidance", Ложь);
	Если ТипЗнч(IncludeGuidance) <> Тип("Булево") Тогда
		IncludeGuidance = Ложь;
	КонецЕсли;
	IncludeRawRows = Получить(Аргументы, "include_raw_rows", Ложь);
	Если ТипЗнч(IncludeRawRows) <> Тип("Булево") Тогда
		IncludeRawRows = Ложь;
	КонецЕсли;
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 500, MCP_Config.Лимиты().max_query_rows);
	Курсор = Получить(Аргументы, "cursor", "");

	Кандидаты = ДоступныеПланыСчетов();
	Если ПустаяСтрока(Chart) Тогда
		Если Кандидаты.Количество() = 0 Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
				"В доступных метаданных нет ПланСчетов.*.");
		ИначеЕсли Кандидаты.Количество() > 1 Тогда
			РезультатВыбора = Новый Структура;
			РезультатВыбора.Вставить("needs_chart", Истина);
			РезультатВыбора.Вставить("charts", Кандидаты);
			РезультатВыбора.Вставить("guidance",
				"Укажите chart полным именем одного из доступных планов счетов. Tool не выбирает план счетов наугад.");
			Возврат РезультатВыбора;
		Иначе
			Chart = Кандидаты[0].full_name;
		КонецЕсли;
	ИначеЕсли СтрНайти(Chart, ".") = 0 Тогда
		Chart = "ПланСчетов." + Chart;
	КонецЕсли;

	MCP_Security.ПроверитьДоступКТипу(Chart);

	СтруктураПлана = MCP_Metadata.СтруктураОбъекта(Chart, MCP_Metadata.ОпцииСтруктурыПоУмолчанию());
	Если СтруктураПлана = Неопределено ИЛИ СтруктураПлана.kind <> "ПланСчетов" Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(), "План счетов не найден: " + Chart);
	КонецЕсли;

	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;
	ЛимитЗапроса = Смещение + Лимит + 1;
	Если ЛимитЗапроса > MCP_Config.Лимиты().max_query_rows Тогда
		ЛимитЗапроса = MCP_Config.Лимиты().max_query_rows;
	КонецЕсли;

	Параметры = Новый Структура;
	Если НЕ ПустаяСтрока(AccountCodePrefix) Тогда
		Параметры.Вставить("КодПрефикс", Строка(AccountCodePrefix) + "%");
	КонецЕсли;

	ТекстЗапроса = ЗапросКартыСчетов(Chart, ЛимитЗапроса, AccountCodePrefix, Истина);
	Попытка
		Результат = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Параметры, Лимит,
			MCP_Config.Лимиты().query_timeout_seconds, Курсор, Ложь, Ложь, IncludeGuidance);
	Исключение
		// В разных конфигурациях набор флагов строки ВидыСубконто может отличаться.
		// Минимальная карта остаётся полезной и не должна зависеть от этих полей.
		ТекстЗапроса = ЗапросКартыСчетов(Chart, ЛимитЗапроса, AccountCodePrefix, Ложь);
		Результат = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Параметры, Лимит,
			MCP_Config.Лимиты().query_timeout_seconds, Курсор, Ложь, Ложь, IncludeGuidance);
		Результат.warnings.Добавить("Часть флагов ВидыСубконто недоступна в этой конфигурации; возвращена минимальная карта счётов и видов субконто.");
	КонецПопытки;
	Результат.Вставить("chart", Chart);
	Результат.Вставить("filter", ?(ПустаяСтрока(AccountCodePrefix), Null, AccountCodePrefix));
	Результат.Вставить("tabular_section", "ВидыСубконто");
	Результат.Вставить("tabular_section_found", Истина);
	Результат.Вставить("source_of_truth", Chart + ".ВидыСубконто");
	Результат.Вставить("accounts", СгруппироватьСтрокиКартыСчетов(Результат.rows));
	Результат.Вставить("total_accounts", КоличествоСчетовПлана(Chart, AccountCodePrefix));
	Результат.Вставить("include_empty_subconto", IncludeEmptySubconto);
	Если IncludeEmptySubconto Тогда
		ДобавитьСчетаБезСубконтоВКарту(Результат.accounts, Chart, AccountCodePrefix, Лимит, Курсор, Результат.warnings);
	КонецЕсли;
	Результат.Вставить("configuration_agnostic", Истина);
	Если IncludeGuidance Тогда
		Результат.Вставить("guidance",
			"position = НомерСтроки из live-таблицы ВидыСубконто. Это номер Субконто1/2/3 для конкретного счёта; не угадывайте его, пользователь мог изменить порядок аналитик в 1С:Предприятии.");
	КонецЕсли;
	Если IncludeQuery Тогда
		Результат.Вставить("query_used", ТекстЗапроса);
	КонецЕсли;
	Если НЕ IncludeRawRows Тогда
		УдалитьПолеЕслиЕсть(Результат, "rows");
		УдалитьПолеЕслиЕсть(Результат, "columns");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 8. get_accounting_balances
// ----------------------------------------------------------------------
Функция GetAccountingBalances(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	AccountingRegister = ВыбратьБухгалтерскийРегистр(Получить(Аргументы, "accounting_register", ""));
	Mode = Получить(Аргументы, "mode", "balance");
	Если Mode <> "balance" И Mode <> "turnovers" И Mode <> "balance_and_turnovers" И Mode <> "turnovers_debit_credit" Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Некорректный mode для бухгалтерских остатков: " + Mode);
	КонецЕсли;

	ИмяРегистра = MCP_Security.ИмяОбъектаИзПолногоИмени(AccountingRegister);
	Параметры = Новый Структура;
	Параметры.Вставить("register_type", "РегистрБухгалтерии");
	Параметры.Вставить("register", ИмяРегистра);
	Параметры.Вставить("mode", Mode);
	Параметры.Вставить("period", Получить(Аргументы, "period", Неопределено));
	Параметры.Вставить("period_from", Получить(Аргументы, "period_from", Неопределено));
	Параметры.Вставить("period_to", Получить(Аргументы, "period_to", Неопределено));
	Параметры.Вставить("filters", Получить(Аргументы, "filters", Неопределено));
	Параметры.Вставить("dimensions", Получить(Аргументы, "dimensions", Неопределено));
	Параметры.Вставить("resources", Получить(Аргументы, "resources", Неопределено));
	Параметры.Вставить("order_by", Получить(Аргументы, "order_by", Неопределено));
	Параметры.Вставить("limit", ЦелоеИзАргумента(Аргументы, "limit", 100, MCP_Config.Лимиты().max_register_rows));
	Параметры.Вставить("cursor", Получить(Аргументы, "cursor", ""));
	Параметры.Вставить("include_query", Получить(Аргументы, "include_query", Ложь));
	Параметры.Вставить("include_column_types", Получить(Аргументы, "include_column_types", Ложь));
	Параметры.Вставить("include_navigation_url", Получить(Аргументы, "include_navigation_url", Ложь));

	Результат = MCP_Registers.ПрочитатьЗаписи(Параметры);
	Результат.Вставить("accounting_register", AccountingRegister);
	Результат.Вставить("configuration_agnostic", Истина);
	Если НЕ Получить(Аргументы, "include_query", Ложь) Тогда
		УдалитьПолеЕслиЕсть(Результат, "query_used");
	КонецЕсли;
	Если НЕ Получить(Аргументы, "include_column_types", Ложь) Тогда
		УпроститьКолонки(Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 9. get_accounting_balances_by_subconto_age
// ----------------------------------------------------------------------
Функция GetAccountingBalancesBySubcontoAge(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	AccountingRegister = ВыбратьБухгалтерскийРегистр(Получить(Аргументы, "accounting_register", ""));
	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(AccountingRegister) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Некорректное имя бухгалтерского регистра: " + AccountingRegister);
	КонецЕсли;
	MCP_Security.ПроверитьДоступКТипу(AccountingRegister);

	AsOfArg = Получить(Аргументы, "as_of", "");
	ДатаОстатков = ?(ПустаяСтрока(AsOfArg), ТекущаяДата(), MCP_Values.ДекодироватьПараметр(СтруктураDate(AsOfArg)));
	AccountPrefixes = МассивСтрокИзАргумента(Получить(Аргументы, "account_code_prefixes", Неопределено));
	Если AccountPrefixes.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Укажите account_code_prefixes.");
	КонецЕсли;
	BalanceSide = НормализоватьСторонуОстатка(Получить(Аргументы, "balance_side", ""));
	SubcontoKinds = РазрешитьВидыСубконто(Получить(Аргументы, "subconto_kinds", Неопределено));
	Если SubcontoKinds.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Укажите subconto_kinds из get_accounting_accounts_map.");
	КонецЕсли;

	GroupIndex = ИндексСубконтоИзАргумента(Аргументы, "group_subconto_index", 1);
	AgeIndex = ИндексСубконтоИзАргумента(Аргументы, "age_subconto_index", 3);
	ExtraIndexes = МассивИндексовСубконто(Получить(Аргументы, "extra_subconto_indexes", Неопределено));
	MinAgeDays = ЦелоеИзАргумента(Аргументы, "min_age_days", 0, 100000);
	MinAmount = ЧислоИзАргумента(Аргументы, "min_amount", 0);
	AgeBuckets = МассивЧиселИзАргумента(Получить(Аргументы, "age_buckets", Неопределено));
	Если AgeBuckets.Количество() = 0 Тогда
		AgeBuckets.Добавить(90);
		AgeBuckets.Добавить(180);
		AgeBuckets.Добавить(365);
	КонецЕсли;
	AgeBuckets = ОтсортироватьЧислаПоУбыванию(AgeBuckets);

	OrderBy = НРег(Строка(Получить(Аргументы, "order_by", "amount_desc")));
	Если OrderBy <> "amount_desc" И OrderBy <> "age_desc" И OrderBy <> "account" Тогда
		OrderBy = "amount_desc";
	КонецЕсли;
	IncludeQuery = Получить(Аргументы, "include_query", Ложь);
	Если ТипЗнч(IncludeQuery) <> Тип("Булево") Тогда
		IncludeQuery = Ложь;
	КонецЕсли;
	IncludeGuidance = Получить(Аргументы, "include_guidance", Ложь);
	Если ТипЗнч(IncludeGuidance) <> Тип("Булево") Тогда
		IncludeGuidance = Ложь;
	КонецЕсли;
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 100, MCP_Config.Лимиты().max_query_rows);
	Курсор = Получить(Аргументы, "cursor", "");

	Параметры = Новый Структура;
	Параметры.Вставить("ДатаОстатков", ДатаОстатков);
	Параметры.Вставить("ВидыСубконто", SubcontoKinds);
	Параметры.Вставить("MinAmount", MinAmount);
	Параметры.Вставить("MinAgeDays", MinAgeDays);
	Параметры.Вставить("СписокСчетов", СсылкиСчетовПоПрефиксам(Получить(Аргументы, "chart", ""), AccountPrefixes));

	ТекстДетализации = ЗапросОстатковПоВозрастуСубконто(AccountingRegister, BalanceSide,
		AccountPrefixes, GroupIndex, AgeIndex, ExtraIndexes, OrderBy);
	Детализация = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстДетализации, Параметры, Лимит,
		MCP_Config.Лимиты().query_timeout_seconds, Курсор, Ложь, Ложь, IncludeGuidance);

	ТекстБакетов = ЗапросБакетовВозрастныхОстатков(AccountingRegister, BalanceSide,
		AccountPrefixes, GroupIndex, AgeIndex, AgeBuckets);
	Бакеты = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстБакетов, Параметры, 100,
		MCP_Config.Лимиты().query_timeout_seconds, "", Ложь, Ложь, IncludeGuidance);

	Результат = Новый Структура;
	Результат.Вставить("accounting_register", AccountingRegister);
	Результат.Вставить("as_of", Формат(ДатаОстатков, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Результат.Вставить("balance_side", BalanceSide);
	Результат.Вставить("account_code_prefixes", AccountPrefixes);
	Результат.Вставить("group_subconto_index", GroupIndex);
	Результат.Вставить("age_subconto_index", AgeIndex);
	Результат.Вставить("bucket_rows", Бакеты.rows);
	Результат.Вставить("rows", Детализация.rows);
	Результат.Вставить("row_count", Детализация.row_count);
	Результат.Вставить("truncated", Детализация.truncated);
	Результат.Вставить("next_cursor", Детализация.next_cursor);
	Результат.Вставить("duration_ms", Детализация.duration_ms + Бакеты.duration_ms);
	Результат.Вставить("warnings", Детализация.warnings);
	Для Каждого Предупреждение Из Бакеты.warnings Цикл
		Результат.warnings.Добавить(Предупреждение);
	КонецЦикла;
	Результат.Вставить("configuration_agnostic", Истина);
	Если IncludeGuidance Тогда
		Результат.Вставить("guidance",
			"Tool не знает бизнес-смысл счетов: вызывающая сторона выбирает account_code_prefixes, balance_side и порядок subconto_kinds после get_accounting_accounts_map. Возраст считается по реквизиту Дата выбранного СубконтоN.");
	КонецЕсли;
	Если IncludeQuery Тогда
		Queries = Новый Структура;
		Queries.Вставить("detail", ТекстДетализации);
		Queries.Вставить("buckets", ТекстБакетов);
		Результат.Вставить("query_used", Queries);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 10. compare_accounting_balances_by_subconto
// ----------------------------------------------------------------------
Функция CompareAccountingBalancesBySubconto(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	AccountingRegister = ВыбратьБухгалтерскийРегистр(Получить(Аргументы, "accounting_register", ""));
	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(AccountingRegister) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Некорректное имя бухгалтерского регистра: " + AccountingRegister);
	КонецЕсли;
	MCP_Security.ПроверитьДоступКТипу(AccountingRegister);

	AsOfArg = Получить(Аргументы, "as_of", "");
	ДатаОстатков = ?(ПустаяСтрока(AsOfArg), ТекущаяДата(), MCP_Values.ДекодироватьПараметр(СтруктураDate(AsOfArg)));
	SubcontoKinds = РазрешитьВидыСубконто(Получить(Аргументы, "subconto_kinds", Неопределено));
	Если SubcontoKinds.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Укажите subconto_kinds из get_accounting_accounts_map.");
	КонецЕсли;

	MatchIndex = ИндексСубконтоИзАргумента(Аргументы, "match_subconto_index", 1);
	LeftPrefixes = МассивСтрокИзАргумента(Получить(Аргументы, "left_account_code_prefixes", Неопределено));
	RightPrefixes = МассивСтрокИзАргумента(Получить(Аргументы, "right_account_code_prefixes", Неопределено));
	Если LeftPrefixes.Количество() = 0 ИЛИ RightPrefixes.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Укажите left_account_code_prefixes и right_account_code_prefixes.");
	КонецЕсли;
	LeftSide = НормализоватьСторонуОстатка(Получить(Аргументы, "left_balance_side", ""));
	RightSide = НормализоватьСторонуОстатка(Получить(Аргументы, "right_balance_side", ""));
	MinAmount = ЧислоИзАргумента(Аргументы, "min_amount", 0);
	IncludeQuery = Получить(Аргументы, "include_query", Ложь);
	Если ТипЗнч(IncludeQuery) <> Тип("Булево") Тогда
		IncludeQuery = Ложь;
	КонецЕсли;
	IncludeGuidance = Получить(Аргументы, "include_guidance", Ложь);
	Если ТипЗнч(IncludeGuidance) <> Тип("Булево") Тогда
		IncludeGuidance = Ложь;
	КонецЕсли;
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 100, MCP_Config.Лимиты().max_query_rows);
	Курсор = Получить(Аргументы, "cursor", "");

	Параметры = Новый Структура;
	Параметры.Вставить("ДатаОстатков", ДатаОстатков);
	Параметры.Вставить("ВидыСубконто", SubcontoKinds);
	Параметры.Вставить("MinAmount", MinAmount);
	ChartСчетов = Получить(Аргументы, "chart", "");
	Параметры.Вставить("СписокСчетовЛево", СсылкиСчетовПоПрефиксам(ChartСчетов, LeftPrefixes));
	Параметры.Вставить("СписокСчетовПраво", СсылкиСчетовПоПрефиксам(ChartСчетов, RightPrefixes));

	ТекстЗапроса = ЗапросСравненияОстатковПоСубконто(AccountingRegister, MatchIndex,
		LeftPrefixes, LeftSide, RightPrefixes, RightSide);
	Данные = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Параметры, Лимит,
		MCP_Config.Лимиты().query_timeout_seconds, Курсор, Ложь, Ложь, IncludeGuidance);

	Результат = Новый Структура;
	Результат.Вставить("accounting_register", AccountingRegister);
	Результат.Вставить("as_of", Формат(ДатаОстатков, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Результат.Вставить("match_subconto_index", MatchIndex);
	Результат.Вставить("left_balance_side", LeftSide);
	Результат.Вставить("right_balance_side", RightSide);
	Результат.Вставить("left_account_code_prefixes", LeftPrefixes);
	Результат.Вставить("right_account_code_prefixes", RightPrefixes);
	Результат.Вставить("rows", Данные.rows);
	Результат.Вставить("row_count", Данные.row_count);
	Результат.Вставить("truncated", Данные.truncated);
	Результат.Вставить("next_cursor", Данные.next_cursor);
	Результат.Вставить("duration_ms", Данные.duration_ms);
	Результат.Вставить("warnings", Данные.warnings);
	Результат.Вставить("configuration_agnostic", Истина);
	Если IncludeGuidance Тогда
		Результат.Вставить("guidance",
			"Tool сравнивает два произвольных набора остатков по UUID выбранного СубконтоN. Он не интерпретирует счета как дебиторку, кредиторку или авансы.");
	КонецЕсли;
	Если IncludeQuery Тогда
		Результат.Вставить("query_used", ТекстЗапроса);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 11. get_accounting_entries
// ----------------------------------------------------------------------
Функция GetAccountingEntries(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	AccountingRegister = ВыбратьБухгалтерскийРегистр(Получить(Аргументы, "accounting_register", ""));
	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(AccountingRegister) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Некорректное имя бухгалтерского регистра: " + AccountingRegister);
	КонецЕсли;
	MCP_Security.ПроверитьДоступКТипу(AccountingRegister);

	PeriodFrom = Получить(Аргументы, "period_from", Неопределено);
	PeriodTo = Получить(Аргументы, "period_to", Неопределено);
	DebitPrefixes = МассивСтрокИзАргумента(Получить(Аргументы, "debit_account_code_prefixes", Неопределено));
	CreditPrefixes = МассивСтрокИзАргумента(Получить(Аргументы, "credit_account_code_prefixes", Неопределено));
	GroupBy = МассивСтрокИзАргумента(Получить(Аргументы, "group_by", Неопределено));
	SubcontoSide = НРег(Строка(Получить(Аргументы, "subconto_side", "")));
	SubcontoKindArg = Получить(Аргументы, "subconto_kind", Неопределено);
	SubcontoValueArg = Получить(Аргументы, "subconto_value", Неопределено);
	IncludeZero = Получить(Аргументы, "include_zero", Ложь);
	Если ТипЗнч(IncludeZero) <> Тип("Булево") Тогда
		IncludeZero = Ложь;
	КонецЕсли;
	IncludeQuery = Получить(Аргументы, "include_query", Ложь);
	Если ТипЗнч(IncludeQuery) <> Тип("Булево") Тогда
		IncludeQuery = Ложь;
	КонецЕсли;
	IncludeGuidance = Получить(Аргументы, "include_guidance", Ложь);
	Если ТипЗнч(IncludeGuidance) <> Тип("Булево") Тогда
		IncludeGuidance = Ложь;
	КонецЕсли;
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 100, MCP_Config.Лимиты().max_query_rows);
	Курсор = Получить(Аргументы, "cursor", "");

	Если НЕ ПустаяСтрока(SubcontoSide) И SubcontoSide <> "debit" И SubcontoSide <> "credit" Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"subconto_side должен быть debit или credit.");
	КонецЕсли;

	ЕстьФильтрВидаСубконто = SubcontoKindArg <> Неопределено;
	ЕстьФильтрЗначенияСубконто = SubcontoValueArg <> Неопределено;
	ЕстьФильтрСубконто = ЕстьФильтрВидаСубконто ИЛИ ЕстьФильтрЗначенияСубконто;
	Если ЕстьФильтрСубконто И ПустаяСтрока(SubcontoSide) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Для subconto_kind/subconto_value укажите subconto_side: debit или credit.");
	КонецЕсли;
	Если ЕстьФильтрЗначенияСубконто И НЕ ЕстьФильтрВидаСубконто Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"subconto_value без subconto_kind неоднозначен: одна проводка может иметь несколько аналитик с разными видами. Сначала вызовите get_accounting_accounts_map и передайте выбранный вид субконто в subconto_kind.");
	КонецЕсли;

	SubcontoKindInfo = Неопределено;
	Если ЕстьФильтрВидаСубконто Тогда
		Если НужноПроверятьВидСубконтоПроводок(SubcontoKindArg, DebitPrefixes, CreditPrefixes, GroupBy, SubcontoValueArg) Тогда
			Chart = ВыбратьПланСчетов(Получить(Аргументы, "chart", ""));
			Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(Chart) Тогда
				MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
					"Некорректное имя плана счетов: " + Chart);
			КонецЕсли;
			SubcontoKindInfo = ПроверитьВидСубконтоПроводокПередЗапросом(Chart, SubcontoKindArg, DebitPrefixes, CreditPrefixes);
		Иначе
			SubcontoKindInfo = РазрешитьВидСубконтоПроводок(SubcontoKindArg);
		КонецЕсли;
	КонецЕсли;

	Параметры = Новый Структура;
	Если PeriodFrom <> Неопределено Тогда
		Параметры.Вставить("ПериодНачало", MCP_Values.ДекодироватьПараметр(СтруктураDate(PeriodFrom)));
	КонецЕсли;
	Если PeriodTo <> Неопределено Тогда
		Параметры.Вставить("ПериодКонец", MCP_Values.ДекодироватьПараметр(СтруктураDate(PeriodTo)));
	КонецЕсли;
	Если SubcontoKindArg <> Неопределено Тогда
		Параметры.Вставить("ВидСубконто", SubcontoKindInfo.ref);
	КонецЕсли;
	Если SubcontoValueArg <> Неопределено Тогда
		Параметры.Вставить("ЗначениеСубконто", MCP_Values.ДекодироватьПараметр(SubcontoValueArg));
	КонецЕсли;
	ДобавитьПараметрыПрефиксовСчетовПроводок(Параметры, DebitPrefixes, "DebitPrefix");
	ДобавитьПараметрыПрефиксовСчетовПроводок(Параметры, CreditPrefixes, "CreditPrefix");

	ТекстЗапроса = ЗапросБухгалтерскихПроводок(AccountingRegister, GroupBy, SubcontoSide,
		ЕстьФильтрВидаСубконто, ЕстьФильтрЗначенияСубконто, PeriodFrom <> Неопределено, PeriodTo <> Неопределено,
		DebitPrefixes, CreditPrefixes, IncludeZero);

	Результат = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Параметры, Лимит,
		MCP_Config.Лимиты().query_timeout_seconds, Курсор, Ложь, Ложь, IncludeGuidance);
	Результат.Вставить("accounting_register", AccountingRegister);
	Результат.Вставить("mode", ?(GroupBy.Количество() = 0, "entries", "entries_grouped"));
	Результат.Вставить("group_by", GroupBy);
	Результат.Вставить("subconto_side", ?(ПустаяСтрока(SubcontoSide), Null, SubcontoSide));
	Результат.Вставить("configuration_agnostic", Истина);
	Если IncludeGuidance Тогда
		Результат.Вставить("guidance",
			"Tool строит read-only запрос к основной таблице бухгалтерского регистра и к .Субконто только когда нужны фильтры или группировки по субконто. Это общий слой для любых предметных сценариев.");
	КонецЕсли;
	Если IncludeQuery Тогда
		Результат.Вставить("query_used", ТекстЗапроса);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 8. get_inventory_balances_by_item
// ----------------------------------------------------------------------
Функция GetInventoryBalancesByItem(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);

	ItemType = Получить(Аргументы, "item_type", "Справочник.Номенклатура");
	ItemQuery = Получить(Аргументы, "item_query", "");
	ItemRefArg = Получить(Аргументы, "item_ref", Неопределено);
	AsOfArg = Получить(Аргументы, "as_of", "");
	AccountingRegister = ВыбратьБухгалтерскийРегистр(Получить(Аргументы, "accounting_register", ""));
	Chart = ВыбратьПланСчетов(Получить(Аргументы, "chart", ""));
	AccountPrefixes = МассивПрефиксовСчетов(Получить(Аргументы, "account_code_prefixes", Неопределено));
	ItemSubcontoName = Получить(Аргументы, "item_subconto_name", "Номенклатура");
	WarehouseSubcontoName = Получить(Аргументы, "warehouse_subconto_name", "Склады");
	IncludeZero = Получить(Аргументы, "include_zero", Ложь);
	Если ТипЗнч(IncludeZero) <> Тип("Булево") Тогда
		IncludeZero = Ложь;
	КонецЕсли;
	IncludeQuery = Получить(Аргументы, "include_query", Ложь);
	Если ТипЗнч(IncludeQuery) <> Тип("Булево") Тогда
		IncludeQuery = Ложь;
	КонецЕсли;
	IncludeGuidance = Получить(Аргументы, "include_guidance", Ложь);
	Если ТипЗнч(IncludeGuidance) <> Тип("Булево") Тогда
		IncludeGuidance = Ложь;
	КонецЕсли;
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 100, MCP_Config.Лимиты().max_query_rows);

	MCP_Security.ПроверитьДоступКТипу(ItemType);
	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(AccountingRegister) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Некорректное имя бухгалтерского регистра: " + AccountingRegister);
	КонецЕсли;
	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(Chart) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Некорректное имя плана счетов: " + Chart);
	КонецЕсли;

	Warnings = Новый Массив;
	ItemSearch = РазрешитьНоменклатуруДляОстатков(ItemType, ItemRefArg, ItemQuery, Warnings);
	ItemRef = ItemSearch.ref;
	ItemSearch.ref = MCP_Values.Кодировать(ItemRef);

	SubcontoMap = НайтиВидыСубконтоОстатков(Chart, AccountPrefixes, ItemSubcontoName, WarehouseSubcontoName);
	Если SubcontoMap.item_subconto = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
			"Не найден вид субконто номенклатуры в " + Chart + ".ВидыСубконто: " + ItemSubcontoName);
	КонецЕсли;
	Если SubcontoMap.warehouse_subconto = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
			"Не найден вид субконто склада в " + Chart + ".ВидыСубконто: " + WarehouseSubcontoName);
	КонецЕсли;
	Для Каждого W Из SubcontoMap.warnings Цикл
		Warnings.Добавить(W);
	КонецЦикла;

	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(SubcontoMap.item_subconto);
	ВидыСубконто.Добавить(SubcontoMap.warehouse_subconto);

	ДатаОстатков = ?(ПустаяСтрока(AsOfArg), ТекущаяДата(), MCP_Values.ДекодироватьПараметр(СтруктураDate(AsOfArg)));

	ТекстЗапроса = ЗапросОстатковТовара(AccountingRegister, Лимит, IncludeZero, AccountPrefixes);
	Параметры = Новый Структура;
	Параметры.Вставить("ДатаОстатков", ДатаОстатков);
	Параметры.Вставить("Номенклатура", ItemRef);
	Параметры.Вставить("ВидыСубконто", ВидыСубконто);
	Параметры.Вставить("СписокСчетов", СсылкиСчетовПоПрефиксам(Получить(Аргументы, "chart", ""), AccountPrefixes));

	Результат = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Параметры, Лимит,
		MCP_Config.Лимиты().query_timeout_seconds, "", Ложь, Ложь, IncludeGuidance);
	Для Каждого W Из Warnings Цикл
		Результат.warnings.Добавить(W);
	КонецЦикла;

	Результат.Вставить("item", MCP_Values.Кодировать(ItemRef));
	Результат.Вставить("item_search", ItemSearch);
	Результат.Вставить("as_of", MCP_Values.Кодировать(ДатаОстатков));
	Результат.Вставить("accounting_register", AccountingRegister);
	Результат.Вставить("chart", Chart);
	Результат.Вставить("account_code_prefixes", AccountPrefixes);
	Результат.Вставить("subconto", SubcontoMap.summary);
	Результат.Вставить("totals", ИтогиСтрокОстатков(Результат.rows));
	Результат.Вставить("configuration_agnostic", Истина);
	Если IncludeGuidance Тогда
		Результат.Вставить("guidance",
			"Tool выполняет быстрый путь внутри одного MCP-вызова: поиск номенклатуры, чтение видов субконто из плана счетов и агрегированный запрос к бухгалтерской виртуальной таблице Остатки.");
	КонецЕсли;
	Если IncludeQuery Тогда
		Результат.Вставить("query_used", ТекстЗапроса);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 9. check_inventory_and_order_status
// ----------------------------------------------------------------------
// Универсальный конфигурационно-агностичный инструмент для проверки
// наличия остатков на складе и статуса заказа покупателя.
// Принимает:
//   - item_query / item_ref / item_type — номенклатура для проверки остатков
//   - order_type — полное имя документа заказа (напр. Документ.ЗаказПокупателя)
//   - order_uuid — UUID заказа
//   - as_of — дата остатков (опционально)
//   - accounting_register, chart, account_code_prefixes — для запроса остатков
//   - item_subconto_name, warehouse_subconto_name — имена субконто
//   - required_quantity — необходимое количество для сравнения с остатком
//   - include_query, include_guidance — флаги отладки
// Возвращает сводку: остатки по складам, статус заказа, достаточно ли остатка.
// ----------------------------------------------------------------------
Функция CheckInventoryAndOrderStatus(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);

	// --- Параметры номенклатуры ---
	ItemType = Получить(Аргументы, "item_type", "Справочник.Номенклатура");
	ItemQuery = Получить(Аргументы, "item_query", "");
	ItemRefArg = Получить(Аргументы, "item_ref", Неопределено);
	AsOfArg = Получить(Аргументы, "as_of", "");

	// --- Параметры учётной системы ---
	AccountingRegister = ВыбратьБухгалтерскийРегистр(Получить(Аргументы, "accounting_register", ""));
	Chart = ВыбратьПланСчетов(Получить(Аргументы, "chart", ""));
	AccountPrefixes = МассивПрефиксовСчетов(Получить(Аргументы, "account_code_prefixes", Неопределено));
	ItemSubcontoName = Получить(Аргументы, "item_subconto_name", "Номенклатура");
	WarehouseSubcontoName = Получить(Аргументы, "warehouse_subconto_name", "Склады");
	IncludeZero = Получить(Аргументы, "include_zero", Ложь);
	Если ТипЗнч(IncludeZero) <> Тип("Булево") Тогда IncludeZero = Ложь; КонецЕсли;
	RequiredQuantity = Получить(Аргументы, "required_quantity", 0);
	Если ТипЗнч(RequiredQuantity) <> Тип("Число") Тогда RequiredQuantity = Число(RequiredQuantity); КонецЕсли;

	// --- Параметры заказа ---
	OrderType = Получить(Аргументы, "order_type", "");
	OrderUUID = Получить(Аргументы, "order_uuid", "");

	// --- Флаги отладки ---
	IncludeQuery = Получить(Аргументы, "include_query", Ложь);
	Если ТипЗнч(IncludeQuery) <> Тип("Булево") Тогда IncludeQuery = Ложь; КонецЕсли;
	IncludeGuidance = Получить(Аргументы, "include_guidance", Ложь);
	Если ТипЗнч(IncludeGuidance) <> Тип("Булево") Тогда IncludeGuidance = Ложь; КонецЕсли;
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 100, MCP_Config.Лимиты().max_query_rows);

	// --- Валидация ---
	MCP_Security.ПроверитьДоступКТипу(ItemType);
	Если НЕ ПустаяСтрока(OrderType) Тогда
		MCP_Security.ПроверитьДоступКТипу(OrderType);
	КонецЕсли;
	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(AccountingRegister) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Некорректное имя бухгалтерского регистра: " + AccountingRegister);
	КонецЕсли;
	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(Chart) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Некорректное имя плана счетов: " + Chart);
	КонецЕсли;

	Warnings = Новый Массив;
	Результат = Новый Структура;
	Результат.Вставить("inventory", Неопределено);
	Результат.Вставить("order", Неопределено);
	Результат.Вставить("summary", Неопределено);

	// === 1. ОСТАТКИ ===
	ItemSearch = РазрешитьНоменклатуруДляОстатков(ItemType, ItemRefArg, ItemQuery, Warnings);
	ItemRef = ItemSearch.ref;
	Попытка
		ItemSearch.Вставить("presentation", Строка(ItemRef));
	Исключение
		ItemSearch.Вставить("presentation", ItemSearch.input);
	КонецПопытки;

	SubcontoMap = НайтиВидыСубконтоОстатков(Chart, AccountPrefixes, ItemSubcontoName, WarehouseSubcontoName);
	Если SubcontoMap.item_subconto = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
			"Не найден вид субконто номенклатуры в " + Chart + ".ВидыСубконто: " + ItemSubcontoName);
	КонецЕсли;
	Если SubcontoMap.warehouse_subconto = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
			"Не найден вид субконто склада в " + Chart + ".ВидыСубконто: " + WarehouseSubcontoName);
	КонецЕсли;
	Для Каждого W Из SubcontoMap.warnings Цикл
		Warnings.Добавить(W);
	КонецЦикла;

	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(SubcontoMap.item_subconto);
	ВидыСубконто.Добавить(SubcontoMap.warehouse_subconto);

	ДатаОстатков = ?(ПустаяСтрока(AsOfArg), ТекущаяДата(), MCP_Values.ДекодироватьПараметр(СтруктураDate(AsOfArg)));

	ТекстЗапросаОстатки = ЗапросОстатковТовара(AccountingRegister, Лимит, IncludeZero, AccountPrefixes);
	ПараметрыОстатки = Новый Структура;
	ПараметрыОстатки.Вставить("ДатаОстатков", ДатаОстатков);
	ПараметрыОстатки.Вставить("Номенклатура", ItemRef);
	ПараметрыОстатки.Вставить("ВидыСубконто", ВидыСубконто);
	ПараметрыОстатки.Вставить("СписокСчетов", СсылкиСчетовПоПрефиксам(Получить(Аргументы, "chart", ""), AccountPrefixes));

	РезультатОстатки = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапросаОстатки, ПараметрыОстатки, Лимит,
		MCP_Config.Лимиты().query_timeout_seconds, "", Ложь, Ложь, IncludeGuidance);
	Для Каждого W Из Warnings Цикл
		РезультатОстатки.warnings.Добавить(W);
	КонецЦикла;

	// Итоги по остаткам
	ТоталКоличество = 0;
	ТоталСумма = 0;
	Склады = Новый Массив;
	Для Каждого Строка Из РезультатОстатки.rows Цикл
		Кол = Число(Получить(Строка, "КоличествоОстаток", 0));
		Сум = Число(Получить(Строка, "СуммаОстаток", 0));
		ТоталКоличество = ТоталКоличество + Кол;
		ТоталСумма = ТоталСумма + Сум;
		Склад = Получить(Строка, "Склад", Неопределено);
		Если Склад <> Неопределено Тогда
			Склады.Добавить(Склад);
		КонецЕсли;
	КонецЦикла;

	Инвентарь = Новый Структура;
	Инвентарь.Вставить("item", MCP_Values.Кодировать(ItemRef));
	Инвентарь.Вставить("item_search", ItemSearch);
	Инвентарь.Вставить("as_of", MCP_Values.Кодировать(ДатаОстатков));
	Инвентарь.Вставить("rows", РезультатОстатки.rows);
	Инвентарь.Вставить("total_quantity", ТоталКоличество);
	Инвентарь.Вставить("total_amount", ТоталСумма);
	Инвентарь.Вставить("warehouses_count", Склады.Количество());
	Инвентарь.Вставить("enough_stock", (RequiredQuantity <= 0) ИЛИ (ТоталКоличество >= RequiredQuantity));
	Инвентарь.Вставить("required_quantity", RequiredQuantity);
	Инвентарь.Вставить("accounting_register", AccountingRegister);
	Инвентарь.Вставить("chart", Chart);
	Инвентарь.Вставить("subconto", SubcontoMap.summary);
	Если IncludeQuery Тогда
		Инвентарь.Вставить("query_used", ТекстЗапросаОстатки);
	КонецЕсли;
	Результат.Вставить("inventory", Инвентарь);

	// === 2. СТАТУС ЗАКАЗА ===
	Если НЕ ПустаяСтрока(OrderType) И НЕ ПустаяСтрока(OrderUUID) Тогда
		ИнфоЗаказа = ПолучитьСтатусЗаказа(OrderType, OrderUUID, Лимит);
		Результат.Вставить("order", ИнфоЗаказа);
	Иначе
		Результат.Вставить("order", Новый Структура("checked", Ложь));
	КонецЕсли;

	// === 3. СВОДКА ===
	Сводка = Новый Структура;
	Попытка
		Сводка.Вставить("item_presentation", Строка(ItemRef));
	Исключение
		Сводка.Вставить("item_presentation", ItemSearch.input);
	КонецПопытки;
	Сводка.Вставить("as_of", MCP_Values.Кодировать(ДатаОстатков));
	Сводка.Вставить("total_quantity_available", ТоталКоличество);
	Сводка.Вставить("required_quantity", RequiredQuantity);
	Сводка.Вставить("enough_stock", (RequiredQuantity <= 0) ИЛИ (ТоталКоличество >= RequiredQuantity));
	Если RequiredQuantity > 0 И ТоталКоличество < RequiredQuantity Тогда
		Сводка.Вставить("shortage", RequiredQuantity - ТоталКоличество);
	КонецЕсли;
	Сводка.Вставить("warehouses_with_stock", Склады.Количество());
	Результат.Вставить("summary", Сводка);

	Результат.Вставить("configuration_agnostic", Истина);
	Результат.Вставить("warnings", Warnings);

	Если IncludeGuidance Тогда
		Результат.Вставить("guidance",
			"Tool выполняет за один MCP-вызов: поиск номенклатуры, чтение видов субконто из плана счетов, "
			+ "агрегированный запрос к бухгалтерской виртуальной таблице Остатки, а также чтение движений документа-заказа "
			+ "для определения его статуса. Результат содержит сводку достаточно_ли_остатка и информацию о заказе.");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Вспомогательная функция: получает статус заказа по его движениям в регистрах.
// Определяет флаг проведённости и собирает движения по всем регистрам.
Функция ПолучитьСтатусЗаказа(ТипДокумента, UUID, Лимит)

	Результат = Новый Структура;
	Результат.Вставить("document_type", ТипДокумента);
	Результат.Вставить("uuid", UUID);
	Результат.Вставить("checked", Истина);

	// Проверяем существование документа через прямую ссылку
	Попытка
		ДокСсылка = MCP_Values.ДекодироватьПараметр(Новый Структура("kind,type,uuid", "ref", ТипДокумента, UUID));
	Исключение
		Результат.Вставить("error", "Не удалось декодировать ссылку на документ: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Если ДокСсылка = Неопределено Тогда
		Результат.Вставить("exists", Ложь);
		Результат.Вставить("error", "Документ не найден по указанному UUID.");
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("exists", Истина);

	// Получаем объект документа для проверки статуса
	Попытка
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		Если ДокОбъект = Неопределено Тогда
			Результат.Вставить("posted", Ложь);
			Результат.Вставить("status", "Не получен");
		Иначе
			Результат.Вставить("posted", ДокОбъект.Проведен);
			Результат.Вставить("status", ?(ДокОбъект.Проведен, "Проведён", "Не проведён"));
			Результат.Вставить("date", MCP_Values.Кодировать(ДокОбъект.Дата));
			Результат.Вставить("number", ДокОбъект.Номер);
			Результат.Вставить("deletion_mark", ДокОбъект.ПометкаУдаления);
		КонецЕсли;
	Исключение
		Результат.Вставить("posted", Неопределено);
		Результат.Вставить("status", "Не удалось прочитать: " + ОписаниеОшибки());
	КонецПопытки;

	// Движения по регистрам (через существующий механизм)
	Попытка
		Движения = MCP_Registers.ДвиженияДокумента(ТипДокумента, UUID, Неопределено, Лимит, Ложь, "", "");
		Результат.Вставить("movements", Движения);
	Исключение
		Результат.Вставить("movements_error", ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 10. get_calculation_types_map
// ----------------------------------------------------------------------
Функция GetCalculationTypesMap(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Plan = Получить(Аргументы, "plan", "");
	CodePrefix = Получить(Аргументы, "code_prefix", "");
	IncludeQuery = Получить(Аргументы, "include_query", Ложь);
	Если ТипЗнч(IncludeQuery) <> Тип("Булево") Тогда
		IncludeQuery = Ложь;
	КонецЕсли;
	IncludeRawRows = Получить(Аргументы, "include_raw_rows", Ложь);
	Если ТипЗнч(IncludeRawRows) <> Тип("Булево") Тогда
		IncludeRawRows = Ложь;
	КонецЕсли;
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 500, MCP_Config.Лимиты().max_query_rows);
	Курсор = Получить(Аргументы, "cursor", "");

	Кандидаты = ДоступныеПланыВидовРасчета();
	Если ПустаяСтрока(Plan) Тогда
		Если Кандидаты.Количество() = 0 Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
				"В доступных метаданных нет ПланВидовРасчета.*.");
		ИначеЕсли Кандидаты.Количество() > 1 Тогда
			РезультатВыбора = Новый Структура;
			РезультатВыбора.Вставить("needs_plan", Истина);
			РезультатВыбора.Вставить("plans", Кандидаты);
			РезультатВыбора.Вставить("guidance",
				"Укажите plan полным именем одного из доступных ПланВидовРасчета.*. Tool не выбирает план видов расчёта наугад.");
			Возврат РезультатВыбора;
		Иначе
			Plan = Кандидаты[0].full_name;
		КонецЕсли;
	ИначеЕсли СтрНайти(Plan, ".") = 0 Тогда
		Plan = "ПланВидовРасчета." + Plan;
	КонецЕсли;

	MCP_Security.ПроверитьДоступКТипу(Plan);

	СтруктураПлана = MCP_Metadata.СтруктураОбъекта(Plan, MCP_Metadata.ОпцииСтруктурыПоУмолчанию());
	Если СтруктураПлана = Неопределено ИЛИ СтруктураПлана.kind <> "ПланВидовРасчета" Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(), "План видов расчёта не найден: " + Plan);
	КонецЕсли;

	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;
	ЛимитЗапроса = Смещение + Лимит + 1;
	Если ЛимитЗапроса > MCP_Config.Лимиты().max_query_rows Тогда
		ЛимитЗапроса = MCP_Config.Лимиты().max_query_rows;
	КонецЕсли;

	Параметры = Новый Структура;
	Если НЕ ПустаяСтрока(CodePrefix) Тогда
		Параметры.Вставить("КодПрефикс", Строка(CodePrefix) + "%");
	КонецЕсли;

	ТекстЗапроса = ЗапросКартыВидовРасчета(Plan, ЛимитЗапроса, CodePrefix, Истина);
	Попытка
		Результат = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Параметры, Лимит,
			MCP_Config.Лимиты().query_timeout_seconds, Курсор);
	Исключение
		ТекстЗапроса = ЗапросКартыВидовРасчета(Plan, ЛимитЗапроса, CodePrefix, Ложь);
		Результат = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Параметры, Лимит,
			MCP_Config.Лимиты().query_timeout_seconds, Курсор);
		Результат.warnings.Добавить("Часть стандартных полей плана видов расчёта недоступна в этой конфигурации; возвращена минимальная карта.");
	КонецПопытки;

	Результат.Вставить("plan", Plan);
	Результат.Вставить("filter", ?(ПустаяСтрока(CodePrefix), Null, CodePrefix));
	Результат.Вставить("calculation_types", СтрокиКартыВидовРасчета(Результат.rows));
	Результат.Вставить("total_calculation_types", КоличествоЭлементовПлана(Plan, CodePrefix));
	Результат.Вставить("configuration_agnostic", Истина);
	Результат.Вставить("guidance",
		"Используйте реальные виды расчёта из этого ответа при запросах к РегистрРасчета.*. Не угадывайте начисления, удержания и показатели по названию; UUID можно передавать как ссылочный параметр.");
	Если IncludeQuery Тогда
		Результат.Вставить("query_used", ТекстЗапроса);
	КонецЕсли;
	Если НЕ IncludeRawRows Тогда
		УдалитьПолеЕслиЕсть(Результат, "rows");
		УдалитьПолеЕслиЕсть(Результат, "columns");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 8. get_database_passport
// ----------------------------------------------------------------------
Функция GetDatabasePassport(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	AccountingRegisterArg = Получить(Аргументы, "accounting_register", "");
	IncludeOrganizations = Получить(Аргументы, "include_organizations", Ложь);
	IncludePeriod = Получить(Аргументы, "include_period", Получить(Аргументы, "include_accounting_registers", Истина));
	IncludeClosedPeriods = Получить(Аргументы, "include_closed_periods", Ложь);
	IncludeAccumulationRegisters = Получить(Аргументы, "include_accumulation_registers", Ложь);
	IncludeInformationRegisters = Получить(Аргументы, "include_information_registers", Ложь);
	IncludeCalculationRegisters = Получить(Аргументы, "include_calculation_registers", Ложь);
	IncludeEmptyRegisters = Получить(Аргументы, "include_empty_registers", Ложь);
	ForceRefresh = Получить(Аргументы, "force_refresh", Ложь);
	Если ТипЗнч(IncludeOrganizations) <> Тип("Булево") Тогда IncludeOrganizations = Ложь; КонецЕсли;
	Если ТипЗнч(IncludePeriod) <> Тип("Булево") Тогда IncludePeriod = Истина; КонецЕсли;
	Если ТипЗнч(IncludeClosedPeriods) <> Тип("Булево") Тогда IncludeClosedPeriods = Ложь; КонецЕсли;
	Если ТипЗнч(IncludeAccumulationRegisters) <> Тип("Булево") Тогда IncludeAccumulationRegisters = Ложь; КонецЕсли;
	Если ТипЗнч(IncludeInformationRegisters) <> Тип("Булево") Тогда IncludeInformationRegisters = Ложь; КонецЕсли;
	Если ТипЗнч(IncludeCalculationRegisters) <> Тип("Булево") Тогда IncludeCalculationRegisters = Ложь; КонецЕсли;
	Если ТипЗнч(IncludeEmptyRegisters) <> Тип("Булево") Тогда IncludeEmptyRegisters = Ложь; КонецЕсли;
	Если ТипЗнч(ForceRefresh) <> Тип("Булево") Тогда ForceRefresh = Ложь; КонецЕсли;

	OrganizationLimit = ЦелоеИзАргумента(Аргументы, "organization_limit", 50, 200);
	AccountingRegisterLimit = ЦелоеИзАргумента(Аргументы, "accounting_register_limit", 10, 50);
	AccumulationRegisterLimit = ЦелоеИзАргумента(Аргументы, "accumulation_register_limit", 100, 200);
	InformationRegisterLimit = ЦелоеИзАргумента(Аргументы, "information_register_limit", 50, 200);
	CalculationRegisterLimit = ЦелоеИзАргумента(Аргументы, "calculation_register_limit", 50, 200);

	КэшРегистров = ПолучитьПаспортБазыИзКэша("", ForceRefresh);

	Warnings = Новый Массив;
	СписокРегистровБухгалтерии = ДоступныеОбъектыМетаданныхПоВиду("РегистрБухгалтерии");
	Если НЕ ПустаяСтрока(AccountingRegisterArg) Тогда
		Если СтрНайти(AccountingRegisterArg, ".") = 0 Тогда
			AccountingRegisterArg = "РегистрБухгалтерии." + AccountingRegisterArg;
		КонецЕсли;
		Отобранные = Новый Массив;
		Для Каждого Рег Из СписокРегистровБухгалтерии Цикл
			Если ВРег(Рег.full_name) = ВРег(AccountingRegisterArg) Тогда
				Отобранные.Добавить(Рег);
			КонецЕсли;
		КонецЦикла;
		СписокРегистровБухгалтерии = Отобранные;
		Если СписокРегистровБухгалтерии.Количество() = 0 Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(),
				"Бухгалтерский регистр не найден или запрещён: " + AccountingRegisterArg);
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("generated_at", Строка(ТекущаяУниверсальнаяДата()));
	Результат.Вставить("configuration_agnostic", Истина);
	Результат.Вставить("read_only", Истина);
	Результат.Вставить("cache_hit", Ложь);
	Результат.Вставить("cache_age_seconds", 0);
	Результат.Вставить("warnings", Warnings);

	Organizations = Новый Массив;
	OrganizationKeys = Новый Соответствие;
	AccountingSummaries = Новый Массив;
	PrimaryPeriod = Новый Структура;
	PrimaryPeriod.Вставить("first_entry", Null);
	PrimaryPeriod.Вставить("last_entry", Null);
	PrimaryPeriod.Вставить("total_entries", 0);
	PrimaryPeriod.Вставить("source_register", Null);

	СчетчикРегистров = 0;
	Для Каждого Рег Из СписокРегистровБухгалтерии Цикл
		Если СчетчикРегистров >= AccountingRegisterLimit Тогда
			Warnings.Добавить("Список бухгалтерских регистров усечён accounting_register_limit=" + AccountingRegisterLimit + ".");
			Прервать;
		КонецЕсли;
		СчетчикРегистров = СчетчикРегистров + 1;

		ПаспортРегистра = ПаспортБухгалтерскогоРегистра(Рег.full_name, OrganizationLimit, IncludeOrganizations, Organizations, OrganizationKeys, Warnings);
		Если IncludePeriod Тогда
			AccountingSummaries.Добавить(ПаспортРегистра);
		КонецЕсли;
		Если PrimaryPeriod.first_entry = Null И ПаспортРегистра.first_entry <> Null Тогда
			PrimaryPeriod.first_entry = ПаспортРегистра.first_entry;
			PrimaryPeriod.last_entry = ПаспортРегистра.last_entry;
			PrimaryPeriod.total_entries = Получить(ПаспортРегистра, "total_entries", 0);
			PrimaryPeriod.source_register = Рег.full_name;
		ИначеЕсли ПаспортРегистра.first_entry <> Null Тогда
			PrimaryPeriod.total_entries = PrimaryPeriod.total_entries + Получить(ПаспортРегистра, "total_entries", 0);
		КонецЕсли;
	КонецЦикла;

	Если IncludeOrganizations Тогда
		Результат.Вставить("organizations", Organizations);
	КонецЕсли;
	Если IncludePeriod Тогда
		Результат.Вставить("data_period", PrimaryPeriod);
		Результат.Вставить("accounting_registers", AccountingSummaries);
	КонецЕсли;
	Если IncludeClosedPeriods Тогда
		Результат.Вставить("closed_periods", ЗакрытыеПериоды(OrganizationLimit, Warnings));
	КонецЕсли;

	Если IncludeAccumulationRegisters Тогда
		Если НЕ ДобавитьРазделРегистровИзКэша(Результат, КэшРегистров, "accumulation_registers") Тогда
			СписокРегистровНакопления = ДоступныеОбъектыМетаданныхПоВиду("РегистрНакопления");
			AccumulationSummaries = Новый Массив;
			AccumulationWithData = Новый Массив;
			AccumulationEmpty = Новый Массив;
			Checked = 0;
			Для Каждого РегНак Из СписокРегистровНакопления Цикл
				Если Checked >= AccumulationRegisterLimit Тогда
					Warnings.Добавить("Список регистров накопления усечён accumulation_register_limit=" + AccumulationRegisterLimit + ".");
					Прервать;
				КонецЕсли;
				Checked = Checked + 1;
				СводкаРегистраНакопления = ПаспортРегистраНакопления(РегНак.full_name);
				Если СводкаРегистраНакопления.has_data Тогда
					AccumulationWithData.Добавить(РегНак.name);
				Иначе
					AccumulationEmpty.Добавить(РегНак.name);
				КонецЕсли;
				Если IncludeEmptyRegisters ИЛИ СводкаРегистраНакопления.has_data Тогда
					AccumulationSummaries.Добавить(СводкаРегистраНакопления);
				КонецЕсли;
			КонецЦикла;
			AccumulationResult = Новый Структура;
			AccumulationResult.Вставить("cache_hit", Ложь);
			AccumulationResult.Вставить("cache_age_seconds", 0);
			AccumulationResult.Вставить("checked", Checked);
			AccumulationResult.Вставить("with_data", AccumulationWithData);
			AccumulationResult.Вставить("empty", AccumulationEmpty);
			Результат.Вставить("accumulation_registers", AccumulationResult);
			Результат.Вставить("accumulation_registers_detail", AccumulationSummaries);
			Результат.Вставить("accumulation_registers_checked", Checked);
		КонецЕсли;
	КонецЕсли;

	Если IncludeInformationRegisters Тогда
		Если НЕ ДобавитьРазделРегистровИзКэша(Результат, КэшРегистров, "information_registers") Тогда
			ДобавитьПаспортРегистровДанных(Результат, "РегистрСведений", "information_registers",
				InformationRegisterLimit, IncludeEmptyRegisters, IncludeOrganizations,
				Organizations, OrganizationKeys, Warnings);
		КонецЕсли;
	КонецЕсли;

	Если IncludeCalculationRegisters Тогда
		ДобавитьПаспортРегистровДанных(Результат, "РегистрРасчета", "calculation_registers",
			CalculationRegisterLimit, IncludeEmptyRegisters, IncludeOrganizations,
			Organizations, OrganizationKeys, Warnings);
	КонецЕсли;

	СохранитьПаспортБазыВКэш("", Результат);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 8. get_object_by_ref
// ----------------------------------------------------------------------
Функция GetObjectByRef(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Тип = Получить(Аргументы, "type", "");
	UUID = Получить(Аргументы, "uuid", "");
	Поля = Получить(Аргументы, "fields", Неопределено);
	IncludeStandard = Получить(Аргументы, "include_standard_fields", Истина);
	IncludeTS = Получить(Аргументы, "include_tabular_sections", Ложь);
	TSImena = Получить(Аргументы, "tabular_sections", Неопределено);
	TSLimit = ЦелоеИзАргумента(Аргументы, "tabular_section_row_limit", 100, MCP_Config.Лимиты().max_tabular_section_rows);
	TSCursor = ЦелоеИзСтроки(Получить(Аргументы, "tabular_section_cursor", ""), 0);
	Если TSCursor < 0 Тогда
		TSCursor = 0;
	КонецЕсли;
	IncludeNav = Получить(Аргументы, "include_navigation_url", Ложь);

	Если ПустаяСтрока(Тип) ИЛИ ПустаяСтрока(UUID) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Требуются type и uuid.");
	КонецЕсли;
	MCP_Security.ПроверитьДоступКТипу(Тип);

	Ссылка = MCP_Values.СсылкаПоТипуИUUID(Тип, UUID);
	Если Ссылка = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_ObjectNotFound(), "Объект не найден.");
	КонецЕсли;

	// Проверка существования. СсылкаСуществует выполняет тот же запрос в Попытке —
	// сырое 1С-исключение не пробивается наружу клиенту, а ушло бы в журнал.
	Существует = СсылкаСуществует(Ссылка, Тип);

	Результат = Новый Структура;
	Результат.Вставить("found", Существует);

	Если НЕ Существует Тогда
		Результат.Вставить("object", Null);
		Возврат Результат;
	КонецЕсли;

	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	ОпцииВалью.include_navigation_url = IncludeNav;

	Об = Новый Структура;
	Об.Вставить("ref", MCP_Values.Кодировать(Ссылка, ОпцииВалью));

	StandardFields = Новый Структура;
	Fields = Новый Структура;
	TabularSections = Новый Структура;
	TabularSectionsPaging = Новый Структура;

	// ПолучитьОбъект() недоступен для перечислений. Отказ прав должен быть
	// явной ошибкой, иначе LLM примет пустые поля за реальные данные.
	Объект = Неопределено;
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
	Исключение
		Если MCP_Errors.ЭтоОтказДоступаПлатформы(ОписаниеОшибки()) Тогда
			Доступ = MCP_Security.ДоступКТипу(Тип);
			Доступ.code = MCP_Errors.Код_AccessDenied();
			Доступ.reason_code = "1c_access_denied";
			Доступ.operation = "get_object_by_ref";
			Доступ.message = "Недостаточно прав 1С на чтение объекта: " + Тип;
			Доступ.platform_message = ОписаниеОшибки();
			MCP_Errors.ВозбудитьОшибку(Доступ.code, Доступ.message, MCP_Security.ДеталиОтказаДоступа(Доступ));
		КонецЕсли;
		Объект = Неопределено;
	КонецПопытки;
	Если Объект <> Неопределено Тогда

		ОМД = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
		Если IncludeStandard Тогда
			Попытка
				Для Каждого СА Из ОМД.СтандартныеРеквизиты Цикл
					Если MCP_Security.ПолеРазрешено(Тип, СА.Имя) Тогда
						Значение = Объект[СА.Имя];
						StandardFields.Вставить(СА.Имя, MCP_Values.Кодировать(Значение, ОпцииВалью));
					КонецЕсли;
				КонецЦикла;
			Исключение
				// Стандартные реквизиты могут быть недоступны.
			КонецПопытки;
		КонецЕсли;

		// Поля.
		СписокПолей = Поля;
		Если СписокПолей = Неопределено ИЛИ ТипЗнч(СписокПолей) <> Тип("Массив") ИЛИ СписокПолей.Количество() = 0 Тогда
			СписокПолей = MCP_Security.ПоляПоУмолчанию(Тип);
		КонецЕсли;

		Для Каждого ИмяПоля Из СписокПолей Цикл
			Если НЕ MCP_Security.ПолеРазрешено(Тип, ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Fields.Вставить(ИмяПоля, MCP_Values.Кодировать(Объект[ИмяПоля], ОпцииВалью));
			Исключение
				// Поле не существует — пропускаем.
			КонецПопытки;
		КонецЦикла;

		// Табличные части.
		Если IncludeTS Тогда
			Попытка
				Для Каждого ТЧ Из ОМД.ТабличныеЧасти Цикл
					Если TSImena <> Неопределено И ТипЗнч(TSImena) = Тип("Массив") И TSImena.Количество() > 0 Тогда
						Подходит = Ложь;
						ВРегТЧ = ВРег(ТЧ.Имя);
						Для Каждого Инкл Из TSImena Цикл
							Если ВРег(Строка(Инкл)) = ВРегТЧ Тогда
								Подходит = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если НЕ Подходит Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					Если НЕ MCP_Security.ПолеРазрешено(Тип, ТЧ.Имя) Тогда
						Продолжить;
					КонецЕсли;
					СтрокиТЧ = Новый Массив;
					Счетчик = 0;
					Пропущено = 0;
					УсеченоТЧ = Ложь;
					Для Каждого СтрокаТЧ Из Объект[ТЧ.Имя] Цикл
						Если Пропущено < TSCursor Тогда
							Пропущено = Пропущено + 1;
							Продолжить;
						КонецЕсли;
						Если Счетчик >= TSLimit Тогда
							УсеченоТЧ = Истина;
							Прервать;
						КонецЕсли;
						С = Новый Структура;
						Для Каждого Р Из ТЧ.Реквизиты Цикл
							Если MCP_Security.ПолеРазрешено(Тип + "." + ТЧ.Имя, Р.Имя) Тогда
								С.Вставить(Р.Имя, MCP_Values.Кодировать(СтрокаТЧ[Р.Имя], ОпцииВалью));
							КонецЕсли;
						КонецЦикла;
						СтрокиТЧ.Добавить(С);
						Счетчик = Счетчик + 1;
					КонецЦикла;
					TabularSections.Вставить(ТЧ.Имя, СтрокиТЧ);
					ПейджингТЧ = Новый Структура;
					ПейджингТЧ.Вставить("row_count", Счетчик);
					ПейджингТЧ.Вставить("truncated", УсеченоТЧ);
					ПейджингТЧ.Вставить("next_cursor", ?(УсеченоТЧ, Строка(TSCursor + Счетчик), Null));
					TabularSectionsPaging.Вставить(ТЧ.Имя, ПейджингТЧ);
				КонецЦикла;
			Исключение
				// Нет ТЧ.
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Об.Вставить("standard_fields", StandardFields);
	Об.Вставить("fields", Fields);
	Об.Вставить("tabular_sections", TabularSections);
	Об.Вставить("tabular_sections_paging", TabularSectionsPaging);

	Результат.Вставить("object", Об);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 8. find_object_by_id
// ----------------------------------------------------------------------
Функция FindObjectByID(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	UUID = Получить(Аргументы, "uuid", "");
	Типы = Получить(Аргументы, "types", Неопределено);
	Виды = Получить(Аргументы, "kinds", Неопределено);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 10, 100);
	IncludeDeleted = Получить(Аргументы, "include_deleted", Ложь);
	Если ТипЗнч(IncludeDeleted) <> Тип("Булево") Тогда
		IncludeDeleted = Ложь;
	КонецЕсли;
	Курсор = ЦелоеИзСтроки(Получить(Аргументы, "cursor", ""), 0);
	Если Курсор < 0 Тогда
		Курсор = 0;
	КонецЕсли;

	Если ПустаяСтрока(UUID) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан UUID.");
	КонецЕсли;
	Попытка
		ПроверкаUUID = Новый УникальныйИдентификатор(UUID);
	Исключение
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Некорректный UUID: " + UUID);
	КонецПопытки;

	// Собираем список разрешённых ссылочных типов для перебора.
	КандидатыТипов = Новый Массив;
	Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
	Для Каждого Стр Из Все Цикл
		Если НЕ Стр.SupportsRef Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ MCP_Security.ТипРазрешен(Стр.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		// Перечисления имеют ссылки, но UUID-based поиск к ним не применим.
		Если Стр.Вид = "Перечисление" Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Типы) = Тип("Массив") И Типы.Количество() > 0 Тогда
			Найден = Ложь;
			Для Каждого Т Из Типы Цикл
				Если ВРег(Т) = ВРег(Стр.ПолноеИмя) Тогда
					Найден = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(Виды) = Тип("Массив") И Виды.Количество() > 0 Тогда
			Найден = Ложь;
			Для Каждого В Из Виды Цикл
				Если ВРег(В) = ВРег(Стр.Вид) Тогда
					Найден = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		КандидатыТипов.Добавить(Стр.ПолноеИмя);
	КонецЦикла;

	МаксТипов = MCP_Config.Лимиты().max_searched_types_per_call;
	ИсходноеКоличествоТипов = КандидатыТипов.Количество();
	ТипыУсеченыЛимитом = Ложь;
	Если КандидатыТипов.Количество() > МаксТипов Тогда
		Усеченные = Новый Массив;
		Для Индекс = 0 По МаксТипов - 1 Цикл
			Усеченные.Добавить(КандидатыТипов[Индекс]);
		КонецЦикла;
		КандидатыТипов = Усеченные;
		ТипыУсеченыЛимитом = Истина;
	КонецЕсли;

	Совпадения = Новый Массив;
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	Усечено = Ложь;
	NextCursor = Null;
	Warnings = Новый Массив;
	Если ТипыУсеченыЛимитом Тогда
		Warnings.Добавить("Перебор ограничен max_searched_types_per_call=" + МаксТипов
			+ ". Уточните types/kinds или увеличьте лимит на сервере. Всего разрешённых типов: "
			+ ИсходноеКоличествоТипов + ".");
	КонецЕсли;

	Если Курсор < КандидатыТипов.Количество() Тогда
		Для ИндексТипа = Курсор По КандидатыТипов.Количество() - 1 Цикл
			ПолноеИмя = КандидатыТипов[ИндексТипа];
			Если Совпадения.Количество() >= Лимит Тогда
				Усечено = Истина;
				NextCursor = Строка(ИндексТипа);
				Прервать;
			КонецЕсли;
			Попытка
				Ссылка = MCP_Values.СсылкаПоТипуИUUID(ПолноеИмя, UUID);
				ЗапросТекст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ " + ПолноеИмя + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
				Если НЕ IncludeDeleted И ТипИмеетПометкуУдаления(ПолноеИмя) Тогда
					ЗапросТекст = ЗапросТекст + " И НЕ Т.ПометкаУдаления";
				КонецЕсли;
				Запрос = Новый Запрос(ЗапросТекст);
				Запрос.УстановитьПараметр("Ссылка", Ссылка);
				Результат = Запрос.Выполнить();
				Если НЕ Результат.Пустой() Тогда
					Выборка = Результат.Выбрать();
					Выборка.Следующий();
					Совпадение = Новый Структура;
					Совпадение.Вставить("ref", MCP_Values.Кодировать(Выборка.Ссылка, ОпцииВалью));

					// Стандартные поля.
					StandardFields = Новый Структура;
					// Для перечислений ПолучитьОбъект() недоступен — заворачиваем в Попытку,
					// чтобы один тип не валил весь перебор.
					Объект = Неопределено;
					Попытка
						Объект = Выборка.Ссылка.ПолучитьОбъект();
					Исключение
						Объект = Неопределено;
					КонецПопытки;
					Если Объект <> Неопределено Тогда
						ОМД = Метаданные.НайтиПоТипу(ТипЗнч(Выборка.Ссылка));
						Попытка
							Для Каждого СА Из ОМД.СтандартныеРеквизиты Цикл
								Если СА.Имя = "Код" ИЛИ СА.Имя = "Наименование" ИЛИ СА.Имя = "Номер" ИЛИ СА.Имя = "Дата" Тогда
									StandardFields.Вставить(СА.Имя, MCP_Values.Кодировать(Объект[СА.Имя], ОпцииВалью));
								КонецЕсли;
							КонецЦикла;
						Исключение
						КонецПопытки;
					КонецЕсли;
					Совпадение.Вставить("standard_fields", StandardFields);
					Совпадения.Добавить(Совпадение);
				КонецЕсли;
			Исключение
				// Невалидный UUID для типа — пропускаем.
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("found", Совпадения.Количество() > 0);
	Результат.Вставить("matches", Совпадения);
	Результат.Вставить("searched_types_count", КандидатыТипов.Количество());
	Результат.Вставить("types_truncated", ТипыУсеченыЛимитом);
	Результат.Вставить("truncated", Усечено);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("warnings", Warnings);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 9. search_objects
// ----------------------------------------------------------------------
Функция SearchObjects(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	ПоисковыйЗапрос = Получить(Аргументы, "query", "");
	Типы = Получить(Аргументы, "types", Неопределено);
	Виды = Получить(Аргументы, "kinds", Неопределено);
	ПоисковыеПоля = Получить(Аргументы, "search_fields", Неопределено);
	DateFrom = Получить(Аргументы, "date_from", Неопределено);
	DateTo = Получить(Аргументы, "date_to", Неопределено);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 20, 100);
	Курсор = ЦелоеИзСтроки(Получить(Аргументы, "cursor", ""), 0);
	Если Курсор < 0 Тогда
		Курсор = 0;
	КонецЕсли;
	IncludeDeleted = Получить(Аргументы, "include_deleted", Ложь);
	Если ТипЗнч(IncludeDeleted) <> Тип("Булево") Тогда
		IncludeDeleted = Ложь;
	КонецЕсли;
	IncludeFields = Получить(Аргументы, "include_fields", Неопределено);
	IncludeMatchedFields = Получить(Аргументы, "include_matched_fields", Ложь);
	Если ТипЗнч(IncludeMatchedFields) <> Тип("Булево") Тогда
		IncludeMatchedFields = Ложь;
	КонецЕсли;
	IncludeNav = Получить(Аргументы, "include_navigation_url", Ложь);
	Если ТипЗнч(IncludeNav) <> Тип("Булево") Тогда
		IncludeNav = Ложь;
	КонецЕсли;
	MatchMode = НРег(Строка(Получить(Аргументы, "match_mode", "auto")));
	Если MatchMode <> "auto" И MatchMode <> "exact"
		И MatchMode <> "prefix" И MatchMode <> "contains" Тогда
		MatchMode = "auto";
	КонецЕсли;

	Если ПустаяСтрока(ПоисковыйЗапрос) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан query.");
	КонецЕсли;

	// Собираем список целевых типов.
	ЦелевыеТипы = СформироватьЦелевыеТипы(Типы, Виды);

	Совпадения = Новый Массив;
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	ОпцииВалью.include_navigation_url = IncludeNav;
	ГлобальныйИндекс = 0;
	Усечено = Ложь;
	NextCursor = Null;

	Для Каждого ПолноеИмя Из ЦелевыеТипы Цикл
		Если Усечено Тогда
			Прервать;
		КонецЕсли;

		ПоляДляТипа = ПоисковыеПоля;
		Если ПоляДляТипа = Неопределено ИЛИ ТипЗнч(ПоляДляТипа) <> Тип("Массив") ИЛИ ПоляДляТипа.Количество() = 0 Тогда
			ПоляДляТипа = MCP_Security.ПоляПоискаПоУмолчанию(ПолноеИмя);
		КонецЕсли;
		Если ПоляДляТипа.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Условия = Новый Массив;
		// Список реально опрашиваемых (после security-фильтра) полей нужен для отчёта в matched_fields.
		ПроверяемыеПоля = Новый Массив;
		ТекстПодстановки = ПодготовитьПодстановку(ПоисковыйЗапрос, MatchMode);
		Для Каждого Поле Из ПоляДляТипа Цикл
			Если НЕ MCP_Security.ИмяБезопасноДляЗапроса(Поле)
				ИЛИ НЕ MCP_Security.ПолеРазрешено(ПолноеИмя, Поле) Тогда
				Продолжить;
			КонецЕсли;
			Условия.Добавить("Т." + Поле + " ПОДОБНО &Шаблон");
			ПроверяемыеПоля.Добавить(Поле);
		КонецЦикла;
		Если Условия.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ПолноеУсловие = "(" + СтрСоединить(Условия, " ИЛИ ") + ")";

		// Период для документов.
		Если СтрНачинаетсяС(ПолноеИмя, "Документ.") Тогда
			Если DateFrom <> Неопределено Тогда
				ПолноеУсловие = ПолноеУсловие + " И Т.Дата >= &DateFrom";
			КонецЕсли;
			Если DateTo <> Неопределено Тогда
				ПолноеУсловие = ПолноеУсловие + " И Т.Дата <= &DateTo";
			КонецЕсли;
		КонецЕсли;

		Если НЕ IncludeDeleted И ТипИмеетПометкуУдаления(ПолноеИмя) Тогда
			ПолноеУсловие = "(" + ПолноеУсловие + ") И НЕ Т.ПометкаУдаления";
		КонецЕсли;

		ЛимитЗапроса = Курсор + Лимит + 1;
		Если ЛимитЗапроса > MCP_Config.Лимиты().max_query_rows Тогда
			ЛимитЗапроса = MCP_Config.Лимиты().max_query_rows;
		КонецЕсли;
		// УПОРЯДОЧИТЬ ПО Т.Ссылка обязательно для стабильной пагинации: без него
		// каждое выполнение запроса может возвращать строки в разном порядке,
		// и cursor "global offset" будет указывать на разные записи.
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + MCP_Query.ЦелоеДляТекстаЗапроса(ЛимитЗапроса) + " Т.Ссылка КАК Ссылка ИЗ " + ПолноеИмя
			+ " КАК Т ГДЕ " + ПолноеУсловие + " УПОРЯДОЧИТЬ ПО Т.Ссылка";
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Шаблон", ТекстПодстановки);
		Если СтрНачинаетсяС(ПолноеИмя, "Документ.") Тогда
			Если DateFrom <> Неопределено Тогда
				Запрос.УстановитьПараметр("DateFrom", MCP_Values.ДекодироватьПараметр(СтруктураDate(DateFrom)));
			КонецЕсли;
			Если DateTo <> Неопределено Тогда
				Запрос.УстановитьПараметр("DateTo", MCP_Values.ДекодироватьПараметр(СтруктураDate(DateTo)));
			КонецЕсли;
		КонецЕсли;

		Попытка
			Результат = Запрос.Выполнить();
		Исключение
			Продолжить;
		КонецПопытки;

		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ГлобальныйИндекс < Курсор Тогда
				ГлобальныйИндекс = ГлобальныйИндекс + 1;
				Продолжить;
			КонецЕсли;
			Если Совпадения.Количество() >= Лимит Тогда
				Усечено = Истина;
				// Сохраняем глобальный индекс ПОСЛЕ уже отданных совпадений.
				NextCursor = Строка(ГлобальныйИндекс);
				Прервать;
			КонецЕсли;
			М = Новый Структура;
			М.Вставить("ref", MCP_Values.Кодировать(Выборка.Ссылка, ОпцииВалью));
			М.Вставить("score", 0.7);
			// matched_fields отчитывается о полях, по которым реально проверялся ПОДОБНО:
			// поля, отсечённые ИмяБезопасноДляЗапроса/ПолеРазрешено, сюда не попадают,
			// иначе клиент получал бы заведомо ложную статистику совпадений.
			Если IncludeMatchedFields Тогда
				MatchedFields = Новый Массив;
				Для Каждого П Из ПроверяемыеПоля Цикл
					MatchedFields.Добавить(П);
				КонецЦикла;
				М.Вставить("matched_fields", MatchedFields);
			КонецЕсли;
			М.Вставить("fields", ПолучитьПоляОбъекта(Выборка.Ссылка, ПолноеИмя, IncludeFields, ОпцииВалью));
			Совпадения.Добавить(М);
			ГлобальныйИндекс = ГлобальныйИндекс + 1;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("matches", Совпадения);
	Результат.Вставить("truncated", Усечено);
	Результат.Вставить("next_cursor", NextCursor);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 10. get_link_of_object
// ----------------------------------------------------------------------
Функция GetLinkOfObject(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Тип = Получить(Аргументы, "type", "");
	UUID = Получить(Аргументы, "uuid", "");
	BaseURLАргумента = НормализоватьBaseURL(Получить(Аргументы, "base_url", ""));
	BaseURL = ?(ПустаяСтрока(BaseURLАргумента), MCP_Config.БазовыйURLWebКлиента(), BaseURLАргумента);
	LinkType = Получить(Аргументы, "link_type", "");
	Если ПустаяСтрока(LinkType) Тогда
		LinkType = ?(ПустаяСтрока(BaseURL), "e1cib", "web_client");
	КонецЕсли;
	IncludePresentation = Получить(Аргументы, "include_presentation", Истина);

	Если ПустаяСтрока(Тип) ИЛИ ПустаяСтрока(UUID) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Требуются type и uuid.");
	КонецЕсли;
	MCP_Security.ПроверитьДоступКТипу(Тип);
	Если НЕ ПустаяСтрока(BaseURL) И НЕ MCP_Security.BaseURLРазрешен(BaseURL) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_AccessDenied(), "base_url не входит в allowlist.");
	КонецЕсли;
	Если LinkType <> "auto" И LinkType <> "e1cib" И LinkType <> "web_client" И LinkType <> "thin_client" Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Некорректный link_type: " + LinkType);
	КонецЕсли;

	Ссылка = MCP_Values.СсылкаПоТипуИUUID(Тип, UUID);

	Существует = СсылкаСуществует(Ссылка, Тип);

	Ссылки = Новый Массив;
	Warnings = Новый Массив;

	Если Существует Тогда

		E1 = "";
		Попытка
			E1 = ПолучитьНавигационнуюСсылку(Ссылка);
		Исключение
			E1 = "";
		КонецПопытки;

		Если LinkType = "auto" ИЛИ LinkType = "e1cib" Тогда
			Если НЕ ПустаяСтрока(E1) Тогда
				Стр = Новый Структура;
				Стр.Вставить("type", "e1cib");
				Стр.Вставить("url", E1);
				Стр.Вставить("description", "Навигационная ссылка 1С");
				Ссылки.Добавить(Стр);
			КонецЕсли;
		КонецЕсли;

		// web_client
		Если (LinkType = "auto" ИЛИ LinkType = "web_client") И НЕ ПустаяСтрока(BaseURL) Тогда
			Стр = Новый Структура;
			Стр.Вставить("type", "web_client");
			Стр.Вставить("url", MCP_Values.ВебURLНавигационнойСсылки(BaseURL, E1, Тип, UUID));
			Стр.Вставить("description", "Ссылка для web-клиента");
			Ссылки.Добавить(Стр);
		КонецЕсли;

		Если LinkType = "thin_client" Тогда
			Warnings.Добавить("link_type=thin_client пока не поддержан универсальной реализацией.");
		КонецЕсли;

	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("found", Существует);
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	ОпцииВалью.navigation_base_url = BaseURL;
	Результат.Вставить("ref", MCP_Values.Кодировать(Ссылка, ОпцииВалью));
	Если IncludePresentation Тогда
		Результат.Вставить("presentation", ?(Существует, Строка(Ссылка), ""));
	КонецЕсли;
	Результат.Вставить("links", Ссылки);
	Результат.Вставить("warnings", Warnings);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 11. find_references_to_object
// ----------------------------------------------------------------------
Функция FindReferencesToObject(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Target = Получить(Аргументы, "target", Неопределено);
	Если Target = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан target.");
	КонецЕсли;
	Target = НормализоватьСтруктуру(Target);

	ТипЦели = Получить(Target, "type", "");
	UUIDЦели = Получить(Target, "uuid", "");
	Если ПустаяСтрока(ТипЦели) ИЛИ ПустаяСтрока(UUIDЦели) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "target.type и target.uuid обязательны.");
	КонецЕсли;
	MCP_Security.ПроверитьДоступКТипу(ТипЦели);

	SearchInTypes = Получить(Аргументы, "search_in_types", Неопределено);
	SearchInKinds = Получить(Аргументы, "search_in_kinds", Неопределено);
	LimitPerType = ЦелоеИзАргумента(Аргументы, "limit_per_type", 20, 100);
	MaxTypes = ЦелоеИзАргумента(Аргументы, "max_types", 50, 200);
	Курсор = ЦелоеИзСтроки(Получить(Аргументы, "cursor", ""), 0);
	Если Курсор < 0 Тогда
		Курсор = 0;
	КонецЕсли;
	IncludeCounts = Получить(Аргументы, "include_counts", Истина);
	IncludeSamples = Получить(Аргументы, "include_samples", Ложь);

	СсылкаЦели = MCP_Values.СсылкаПоТипуИUUID(ТипЦели, UUIDЦели);
	Warnings = Новый Массив;
	Если НЕ СсылкаСуществует(СсылкаЦели, ТипЦели) Тогда
		Результат = Новый Структура;
		Результат.Вставить("target", MCP_Values.Кодировать(СсылкаЦели));
		Результат.Вставить("references", Новый Массив);
		Результат.Вставить("searched_types_count", 0);
		Результат.Вставить("truncated", Ложь);
		Результат.Вставить("next_cursor", Null);
		Результат.Вставить("warnings", Warnings);
		Возврат Результат;
	КонецЕсли;

	// Используем штатный механизм 1С: НайтиПоСсылкам.
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(СсылкаЦели);

	НайденныеСсылки = Новый Массив;
	Попытка
		НайденныеСсылки = НайтиПоСсылкам(МассивСсылок);
	Исключение
		// Метод недоступен в HTTP-сервисе без прав — fallback пока не реализован.
		// Возвращаем пустой результат с явным предупреждением: молчаливое 0 ссылок
		// ввело бы клиента в заблуждение ("на объект никто не ссылается").
		НайденныеСсылки = ПоискСсылокЗапросами(СсылкаЦели, SearchInTypes, SearchInKinds, MaxTypes, LimitPerType);
		Warnings.Добавить("НайтиПоСсылкам недоступен текущему пользователю; результат может быть неполным.");
	КонецПопытки;

	// Группируем по source_type + поле.
	// НайтиПоСсылкам возвращает ТЗ с колонками: Ссылка (искомая), Данные (источник),
	// Метаданные (объект метаданных). Берём Данные/Метаданные.
	Группы = Новый Соответствие;
	Для Каждого СтрокаНаход Из НайденныеСсылки Цикл
		ИсточникСсылка = Неопределено;
		МетаОписание = "";
		Если ТипЗнч(СтрокаНаход) = Тип("СтрокаТаблицыЗначений") Тогда
			Попытка
				ИсточникСсылка = СтрокаНаход.Данные;
				МетаОписание = СтрокаНаход.Метаданные;
			Исключение
				ИсточникСсылка = СтрокаНаход[1];
				МетаОписание = СтрокаНаход[2];
			КонецПопытки;
		Иначе
			// На случай нестандартного fallback-формата.
			ИсточникСсылка = СтрокаНаход[1];
			МетаОписание = СтрокаНаход[2];
		КонецЕсли;
		ТипИсточника = MCP_Values.Кодировать(ИсточникСсылка);
		Если ТипИсточника = Неопределено ИЛИ ТипИсточника = Null Тогда
			Продолжить;
		КонецЕсли;
		// MCP_Values.Кодировать для несссылочных значений возвращает строку/число —
		// у них нет поля type. Защищаемся, чтобы один битый источник не свалил весь tool.
		ИмяТипа = "";
		Если ТипЗнч(ТипИсточника) = Тип("Структура")
			И ТипИсточника.Свойство("type") Тогда
			ИмяТипа = Строка(ТипИсточника.type);
		КонецЕсли;
		Если ПустаяСтрока(ИмяТипа) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ MCP_Security.ТипРазрешен(ИмяТипа) Тогда
			Продолжить;
		КонецЕсли;

		Если SearchInTypes <> Неопределено И ТипЗнч(SearchInTypes) = Тип("Массив") И SearchInTypes.Количество() > 0 Тогда
			Найден = Ложь;
			Для Каждого Т Из SearchInTypes Цикл
				Если ВРег(Т) = ВРег(ИмяТипа) Тогда Найден = Истина; Прервать; КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда Продолжить; КонецЕсли;
		КонецЕсли;
		Если SearchInKinds <> Неопределено И ТипЗнч(SearchInKinds) = Тип("Массив") И SearchInKinds.Количество() > 0 Тогда
			ВидИсточника = MCP_Security.ВидМетаданныхИзПолногоИмени(ИмяТипа);
			Найден = Ложь;
			Для Каждого В Из SearchInKinds Цикл
				Если ВРег(В) = ВРег(ВидИсточника) Тогда Найден = Истина; Прервать; КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда Продолжить; КонецЕсли;
		КонецЕсли;

		Ключ = ИмяТипа + "|" + Строка(МетаОписание);
		Запись = Группы.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = Новый Структура;
			Запись.Вставить("source_type", ИмяТипа);
			Запись.Вставить("field_path", Строка(МетаОписание));
			Запись.Вставить("count", 0);
			Запись.Вставить("samples", Новый Массив);
			Запись.Вставить("truncated", Ложь);
			Группы.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.count = Запись.count + 1;
		Если IncludeSamples И Запись.samples.Количество() < LimitPerType Тогда
			Стр = Новый Структура;
			Стр.Вставить("ref", ТипИсточника);
			Запись.samples.Добавить(Стр);
		ИначеЕсли Запись.samples.Количество() >= LimitPerType Тогда
			Запись.truncated = Истина;
		КонецЕсли;
	КонецЦикла;

	// Сортируем группы по source_type + field_path: cursor — это offset в массиве,
	// а Соответствие не гарантирует стабильный порядок обхода между вызовами,
	// поэтому без сортировки разные страницы могли бы вернуть разные группы.
	ВсеГруппыТЗ = Новый ТаблицаЗначений;
	ВсеГруппыТЗ.Колонки.Добавить("sort_key");
	ВсеГруппыТЗ.Колонки.Добавить("row");
	Для Каждого КЗ Из Группы Цикл
		СтрокаТЗГруппы = ВсеГруппыТЗ.Добавить();
		СтрокаТЗГруппы.sort_key = КЗ.Значение.source_type + "|" + КЗ.Значение.field_path;
		СтрокаТЗГруппы.row = КЗ.Значение;
	КонецЦикла;
	ВсеГруппыТЗ.Сортировать("sort_key");
	ВсеГруппы = Новый Массив;
	Для Каждого СтрокаТЗГруппы Из ВсеГруппыТЗ Цикл
		ВсеГруппы.Добавить(СтрокаТЗГруппы.row);
	КонецЦикла;

	Ссылки = Новый Массив;
	Конец = Мин(Курсор + MaxTypes, ВсеГруппы.Количество());
	Если Курсор < ВсеГруппы.Количество() Тогда
		Для Индекс = Курсор По Конец - 1 Цикл
			Ссылки.Добавить(ВсеГруппы[Индекс]);
		КонецЦикла;
	КонецЕсли;

	NextCursor = Null;
	Если Конец < ВсеГруппы.Количество() Тогда
		NextCursor = Строка(Конец);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("target", MCP_Values.Кодировать(СсылкаЦели));
	Результат.Вставить("references", Ссылки);
	Результат.Вставить("searched_types_count", ВсеГруппы.Количество());
	Результат.Вставить("truncated", NextCursor <> Null);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("warnings", Warnings);
	Возврат Результат;

КонецФункции

