Функция ПоддерживаемыеРежимыРегистра(Вид, HasPeriod)

	Результат = Новый Массив;
	Результат.Добавить("records");
	Если Вид = "РегистрСведений" Тогда
		Если HasPeriod Тогда
			Результат.Добавить("slice_first");
			Результат.Добавить("slice_last");
		КонецЕсли;
	ИначеЕсли Вид = "РегистрНакопления" Тогда
		Результат.Добавить("balance");
		Результат.Добавить("turnovers");
		Результат.Добавить("balance_and_turnovers");
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Результат.Добавить("balance");
		Результат.Добавить("turnovers");
		Результат.Добавить("balance_and_turnovers");
		Результат.Добавить("turnovers_debit_credit");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция КраткаяСхемаРегистра(ОМД)

	Результат = Новый Структура;
	Результат.Вставить("dimensions", ИменаКоллекцииМетаданных(ОМД, "Измерения", 20));
	Результат.Вставить("resources", ИменаКоллекцииМетаданных(ОМД, "Ресурсы", 20));
	Результат.Вставить("attributes", ИменаКоллекцииМетаданных(ОМД, "Реквизиты", 20));
	Возврат Результат;

КонецФункции

Функция ИменаКоллекцииМетаданных(ОМД, ИмяКоллекции, Лимит)

	Результат = Новый Массив;
	Попытка
		Если ИмяКоллекции = "Измерения" Тогда
			Коллекция = ОМД.Измерения;
		ИначеЕсли ИмяКоллекции = "Ресурсы" Тогда
			Коллекция = ОМД.Ресурсы;
		ИначеЕсли ИмяКоллекции = "Реквизиты" Тогда
			Коллекция = ОМД.Реквизиты;
		Иначе
			Возврат Результат;
		КонецЕсли;
	Исключение
		Возврат Результат;
	КонецПопытки;

	Счетчик = 0;
	Для Каждого Реквизит Из Коллекция Цикл
		Если Счетчик >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Реквизит.Имя);
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПолучитьПоляОбъекта(Ссылка, ПолноеИмя, IncludeFields, ОпцииВалью)

	Поля = Новый Структура;
	Если Ссылка = Неопределено ИЛИ Ссылка.Пустая() Тогда
		Возврат Поля;
	КонецЕсли;

	Список = IncludeFields;
	Если Список = Неопределено ИЛИ ТипЗнч(Список) <> Тип("Массив") ИЛИ Список.Количество() = 0 Тогда
		Список = MCP_Security.ПоляПоУмолчанию(ПолноеИмя);
	КонецЕсли;
	Если Список.Количество() = 0 Тогда
		Возврат Поля;
	КонецЕсли;

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
	Исключение
		Возврат Поля;
	КонецПопытки;

	Если Объект = Неопределено Тогда
		Возврат Поля;
	КонецЕсли;

	Для Каждого П Из Список Цикл
		Если НЕ MCP_Security.ПолеРазрешено(ПолноеИмя, П) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Поля.Вставить(П, MCP_Values.Кодировать(Объект[П], ОпцииВалью));
		Исключение
			// Поле может отсутствовать в стандартных реквизитах.
		КонецПопытки;
	КонецЦикла;

	Возврат Поля;

КонецФункции

Функция СтруктураDate(Знач Значение)

	// Если значение уже в виде {kind, value} — пропускаем без повторного оборачивания,
	// иначе Строка(Структура/Соответствия) вернёт текст-описание и парсинг даты сломается.
	// JSON-объекты могут прийти как Структура или как Соответствие — учитываем оба варианта.
	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Запас = Неопределено;
		Если Значение.Свойство("kind", Запас) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Если Значение.Получить("kind") <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;

	Стр = Новый Структура;
	Стр.Вставить("kind", "datetime");
	Стр.Вставить("value", Строка(Значение));
	Возврат Стр;

КонецФункции

Функция СсылкаСуществует(Ссылка, ПолноеИмя)

	Если Ссылка = Неопределено ИЛИ Ссылка.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмя) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ЗапросТекст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ " + ПолноеИмя + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
		Запрос = Новый Запрос(ЗапросТекст);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Возврат НЕ Запрос.Выполнить().Пустой();
	Исключение
		Если MCP_Errors.ЭтоОтказДоступаПлатформы(ОписаниеОшибки()) Тогда
			Доступ = MCP_Security.ДоступКТипу(ПолноеИмя);
			Доступ.code = MCP_Errors.Код_AccessDenied();
			Доступ.reason_code = "1c_access_denied";
			Доступ.operation = "object_exists";
			Доступ.message = "Недостаточно прав 1С на проверку существования объекта: " + ПолноеИмя;
			Доступ.platform_message = ОписаниеОшибки();
			MCP_Errors.ВозбудитьОшибку(Доступ.code, Доступ.message, MCP_Security.ДеталиОтказаДоступа(Доступ));
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция НормализоватьBaseURL(BaseURL)

	BaseURL = СокрЛП(Строка(BaseURL));
	Пока СтрДлина(BaseURL) > СтрДлина("https://") И Прав(BaseURL, 1) = "/" Цикл
		BaseURL = Лев(BaseURL, СтрДлина(BaseURL) - 1);
	КонецЦикла;
	Возврат BaseURL;

КонецФункции

Функция ВерсияПлатформы()
	Попытка
		СистемнаяИнформация = Новый СистемнаяИнформация;
		Возврат Строка(СистемнаяИнформация.ВерсияПриложения);
	Исключение
		Возврат "";
	КонецПопытки;
