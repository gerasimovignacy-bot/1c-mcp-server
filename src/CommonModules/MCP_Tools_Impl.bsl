	ДнейНазад = ЦелоеИзАргумента(Аргументы, "days_back", Настройки.default_days_back, 365);
	ТолькоСоСтроками = Получить(Аргументы, "only_with_rows", Истина);
	Если ТипЗнч(ТолькоСоСтроками) <> Тип("Булево") Тогда
		ТолькоСоСтроками = Истина;
	КонецЕсли;

	Возврат MCP_Examples.ПолучитьПримеры(ОбъектИмя, Лимит, ДнейНазад, ТолькоСоСтроками);

