	Если ПустаяСтрока(Отчет) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан report.");
	КонецЕсли;

	Результат = MCP_Reports.ИнфоОтчета(Отчет, Вариант, IncludeSchema, IncludeVariants, IncludeDefaults);
	ПагинироватьПолеМассива(Результат, "parameters", "parameters_paging", Курсор, Лимит);
	Если IncludeGuidance Тогда
		Синоним = Получить(Результат, "synonym", "");
		MCP_Query.БезопасноПрисоединитьДоменныеПодсказки(Результат, Отчет + " " + Синоним);
