Функция СгруппироватьСтрокиКартыСчетов(Строки)

	Результат = Новый Массив;
	ПоКлючу = Новый Соответствие;
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаКарты Из Строки Цикл
		Счет = Получить(СтрокаКарты, "Счет", Null);
		Код = Получить(СтрокаКарты, "КодСчета", Получить(СтрокаКарты, "Код", ""));
		Наименование = Получить(СтрокаКарты, "НаименованиеСчета", Получить(СтрокаКарты, "Наименование", ""));
		Ключ = КлючКодированногоЗначения(Счет);
		Если ПустаяСтрока(Ключ) Тогда
			Ключ = Строка(Код) + "|" + Строка(Наименование);
		КонецЕсли;

		Аккаунт = ПоКлючу.Получить(Ключ);
		Если Аккаунт = Неопределено Тогда
			Аккаунт = Новый Структура;
			Аккаунт.Вставить("account", Счет);
			Аккаунт.Вставить("code", Код);
			Аккаунт.Вставить("name", Наименование);
			Аккаунт.Вставить("uuid", Получить(СтрокаКарты, "UUIDСчета", Получить(Счет, "uuid", Null)));
			Аккаунт.Вставить("subconto", Новый Массив);
			Аккаунт.Вставить("subconto_count", 0);
			ПоКлючу.Вставить(Ключ, Аккаунт);
			Результат.Добавить(Аккаунт);
		КонецЕсли;

		Субконто = Новый Структура;
		Субконто.Вставить("position", Получить(СтрокаКарты, "НомерСтроки", Получить(СтрокаКарты, "Позиция", Null)));
		Субконто.Вставить("name", Получить(СтрокаКарты, "НаименованиеВидаСубконто", Null));
		Субконто.Вставить("uuid", Получить(СтрокаКарты, "UUIDВидаСубконто", Null));
		Субконто.Вставить("sum", Получить(СтрокаКарты, "Суммовой", Null));
		Субконто.Вставить("qty", Получить(СтрокаКарты, "Количественный", Null));
		Субконто.Вставить("currency", Получить(СтрокаКарты, "Валютный", Null));
		Субконто.Вставить("turnovers_only", Получить(СтрокаКарты, "ТолькоОбороты", Null));
		Субконто.Вставить("ref", Получить(СтрокаКарты, "ВидСубконто", Null));
		Для Каждого КЗ Из СтрокаКарты Цикл
			ИмяПоля = Строка(КЗ.Ключ);
			Если СтрНачинаетсяС(ИмяПоля, "Субконто_") Тогда
				Субконто.Вставить(Сред(ИмяПоля, СтрДлина("Субконто_") + 1), КЗ.Значение);
			КонецЕсли;
		КонецЦикла;
		Аккаунт.subconto.Добавить(Субконто);
		Аккаунт.subconto_count = Аккаунт.subconto.Количество();
	КонецЦикла;

	Возврат Результат;

КонецФункции

