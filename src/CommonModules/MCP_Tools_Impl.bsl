// MCP_Tools_Impl.bsl
// ====================================================================
// Реализация read-only tools MCP-сервера.
// Каждый Tool_* возвращает Структуру с прикладными данными.
// Поле "ok" добавляется в MCP_Tools.ВыполнитьИнструмент, не здесь.
// ====================================================================

#Область Tools

// ----------------------------------------------------------------------
// 1. list_metadata_objects
// ----------------------------------------------------------------------
Функция ListMetadataObjects(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);

	Виды = Получить(Аргументы, "kinds", Новый Массив);
	ПоисковыйЗапрос = Получить(Аргументы, "query", "");
	IncludeNotAllowed = Получить(Аргументы, "include_not_allowed", Ложь);
	Если IncludeNotAllowed И НЕ MCP_Security.ЯвляетсяАдминомMCP() Тогда
		IncludeNotAllowed = Ложь;
	КонецЕсли;
	IncludeDetails = Получить(Аргументы, "include_details", Ложь);
	ResponseProfile = НРег(Строка(Получить(Аргументы, "response_profile", "compact")));
	Если ResponseProfile <> "compact" И ResponseProfile <> "standard" И ResponseProfile <> "debug" Тогда
		ResponseProfile = "compact";
	КонецЕсли;
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 50, MCP_Config.Лимиты().max_limit);
	Курсор = Получить(Аргументы, "cursor", "");

	Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
	Все.Сортировать("ПолноеИмя");

	// Нормализуем фильтр по виду один раз — иначе на каждой итерации перебираем массив.
	ВидыФильтр = Новый Соответствие;
	ЕстьФильтрПоВиду = ТипЗнч(Виды) = Тип("Массив") И Виды.Количество() > 0;
	Если ЕстьФильтрПоВиду Тогда
		Для Каждого В Из Виды Цикл
			ВидыФильтр.Вставить(ВРег(Строка(В)), Истина);
		КонецЦикла;
	КонецЕсли;
	ФильтрВРег = ?(ПустаяСтрока(ПоисковыйЗапрос), "", ВРег(ПоисковыйЗапрос));

	// Кеш разрешений и search-flag внутри одного вызова: даже при кешированном
	// allowlist не повторяем проверку одного и того же типа на больших конфигурациях.
	КешРазрешен = Новый Соответствие;
	КешSearchable = Новый Соответствие;

	Подходящие = Новый Массив;
	Для Каждого Стр Из Все Цикл
		// Фильтр по виду.
		Если ЕстьФильтрПоВиду И ВидыФильтр.Получить(ВРег(Стр.Вид)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Фильтр по строке.
		Если НЕ ПустаяСтрока(ФильтрВРег) Тогда
			ПодходитПоПоиску = СтрНайти(ВРег(Стр.Имя), ФильтрВРег) > 0
				ИЛИ СтрНайти(ВРег(Стр.Синоним), ФильтрВРег) > 0
				ИЛИ СтрНайти(ВРег(Стр.Комментарий), ФильтрВРег) > 0;
			Если НЕ ПодходитПоПоиску Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Разрешен = КешРазрешен.Получить(Стр.ПолноеИмя);
		Если Разрешен = Неопределено Тогда
			Разрешен = MCP_Security.ТипРазрешен(Стр.ПолноеИмя);
			КешРазрешен.Вставить(Стр.ПолноеИмя, Разрешен);
		КонецЕсли;
		Если НЕ Разрешен И НЕ IncludeNotAllowed Тогда
			Продолжить;
		КонецЕсли;

		Подходящие.Добавить(Стр);
	КонецЦикла;

	// Пагинация.
	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;
	Конец = Мин(Смещение + Лимит, Подходящие.Количество());

	Объекты = Новый Массив;
	Если Смещение < Подходящие.Количество() Тогда
		Для Индекс = Смещение По Конец - 1 Цикл
			Стр = Подходящие[Индекс];
			Об = Новый Структура;
			Об.Вставить("kind", Стр.Вид);
			Об.Вставить("name", Стр.Имя);
			Об.Вставить("full_name", Стр.ПолноеИмя);
			Об.Вставить("synonym", Стр.Синоним);
			Если IncludeDetails Тогда
				Об.Вставить("comment", Стр.Комментарий);
			КонецЕсли;
			Разрешен = КешРазрешен.Получить(Стр.ПолноеИмя);
			Если Разрешен = Неопределено Тогда
				Разрешен = MCP_Security.ТипРазрешен(Стр.ПолноеИмя);
				КешРазрешен.Вставить(Стр.ПолноеИмя, Разрешен);
			КонецЕсли;
			Об.Вставить("allowed", Разрешен);
			Об.Вставить("supports_ref", Стр.SupportsRef);
			Об.Вставить("supports_query", Стр.SupportsQuery);
			Если ResponseProfile <> "compact" Тогда
				Об.Вставить("readable", Разрешен);
				Searchable = КешSearchable.Получить(Стр.ПолноеИмя);
				Если Searchable = Неопределено Тогда
					Searchable = MCP_Security.ПоляПоискаПоУмолчанию(Стр.ПолноеИмя).Количество() > 0;
					КешSearchable.Вставить(Стр.ПолноеИмя, Searchable);
				КонецЕсли;
				Об.Вставить("searchable", Searchable);
				Об.Вставить("resource_uri", "1c://metadata/" + Стр.ПолноеИмя);
			КонецЕсли;
			Объекты.Добавить(Об);
		КонецЦикла;
	КонецЕсли;

	NextCursor = Null;
	Если Конец < Подходящие.Количество() Тогда
		NextCursor = Строка(Конец);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("objects", Объекты);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("truncated", NextCursor <> Null);
	Результат.Вставить("total_estimated", Подходящие.Количество());
	MCP_Query.БезопасноПрисоединитьДоменныеПодсказки(Результат, ПоисковыйЗапрос);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 2. get_metadata_structure
// ----------------------------------------------------------------------
Функция GetMetadataStructure(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Тип = Получить(Аргументы, "type", "");
	Если ПустаяСтрока(Тип) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан type.");
	КонецЕсли;
	MCP_Security.ПроверитьДоступКТипу(Тип);
	Section = НРег(Строка(Получить(Аргументы, "section", "all")));

	Опции = MCP_Metadata.ОпцииСтруктурыПоУмолчанию();
	Опции.include_standard_attributes = Получить(Аргументы, "include_standard_attributes", Истина);
	Опции.include_tabular_sections = Получить(Аргументы, "include_tabular_sections", Ложь);
	Опции.include_forms = Получить(Аргументы, "include_forms", Ложь);
	Опции.include_commands = Получить(Аргументы, "include_commands", Ложь);
	Опции.include_query_names = Получить(Аргументы, "include_query_names", Ложь);
	Опции.include_sensitive_flags = Получить(Аргументы, "include_sensitive_flags", Ложь);
	Опции.include_virtual_tables = Получить(Аргументы, "include_virtual_tables", Ложь);
	Если Section = "tabular_sections" Тогда
		Опции.include_tabular_sections = Истина;
	КонецЕсли;
	Если Section = "virtual_tables" Тогда
		Опции.include_virtual_tables = Истина;
	КонецЕсли;

	Структура = MCP_Metadata.СтруктураОбъекта(Тип, Опции);
	Если Структура = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(), "Объект метаданных не найден: " + Тип);
	КонецЕсли;

	Если Section <> "all" Тогда
		Возврат СтраницаСекцииМетаданных(Структура, Section,
			ЦелоеИзАргумента(Аргументы, "limit", 100, MCP_Config.Лимиты().max_limit),
			Получить(Аргументы, "cursor", ""));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("metadata", Структура);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 3. search_metadata_fields
// ----------------------------------------------------------------------
Функция SearchMetadataFields(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Query = СокрЛП(Строка(Получить(Аргументы, "query", "")));
	Типы = МассивСтрокИзАргумента(Получить(Аргументы, "types", Неопределено));
	Виды = МассивСтрокИзАргумента(Получить(Аргументы, "kinds", Неопределено));
	FieldKinds = МассивСтрокИзАргумента(Получить(Аргументы, "field_kinds", Неопределено));
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 50, MCP_Config.Лимиты().max_limit);
	Курсор = ЦелоеИзСтроки(Получить(Аргументы, "cursor", ""), 0);
	Если Курсор < 0 Тогда Курсор = 0; КонецЕсли;

	ПоляСтраницы = Новый Массив;
	ВсегоПодходящих = 0;
	НужноПросмотреть = Курсор + Лимит + 1;
	Достаточно = Ложь;
	Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
	Для Каждого Стр Из Все Цикл
		Если Достаточно Тогда
			Прервать;
		КонецЕсли;
		Если НЕ MCP_Security.ТипРазрешен(Стр.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Если Типы.Количество() > 0 И НЕ МассивСодержитСтрокуБезРегистра(Типы, Стр.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Если Виды.Количество() > 0 И НЕ МассивСодержитСтрокуБезРегистра(Виды, Стр.Вид) Тогда
			Продолжить;
		КонецЕсли;

		ОМД = Метаданные.НайтиПоПолномуИмени(Стр.ПолноеИмя);
		Если ОМД = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПоляОбъекта = Новый Массив;
		ДобавитьПоляОбъектаМетаданных(ПоляОбъекта, Стр.ПолноеИмя, Стр.Вид, ОМД, Query, FieldKinds);
		Для Каждого Поле Из ПоляОбъекта Цикл
			Если ВсегоПодходящих >= Курсор И ПоляСтраницы.Количество() < Лимит Тогда
				ПоляСтраницы.Добавить(Поле);
			КонецЕсли;
			ВсегоПодходящих = ВсегоПодходящих + 1;
			Если ВсегоПодходящих >= НужноПросмотреть Тогда
				Достаточно = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Truncated = ВсегоПодходящих > Курсор + ПоляСтраницы.Количество();
	NextCursor = Null;
	Если Truncated Тогда
		NextCursor = Строка(Курсор + ПоляСтраницы.Количество());
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("fields", ПоляСтраницы);
	Результат.Вставить("field_count", ПоляСтраницы.Количество());
	Результат.Вставить("truncated", Truncated);
	Результат.Вставить("next_cursor", NextCursor);
	Результат.Вставить("total_estimated", ВсегоПодходящих);
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 3a. count_event_subscriptions_by_event
// ----------------------------------------------------------------------
Функция CountEventSubscriptionsByEvent(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	IncludeTopHandlers = Получить(Аргументы, "include_top_handlers", Ложь);
	Если ТипЗнч(IncludeTopHandlers) <> Тип("Булево") Тогда
		IncludeTopHandlers = Ложь;
	КонецЕсли;
	TopHandlersLimit = ЦелоеВДиапазонеИзАргумента(Аргументы, "top_handlers_limit", 5, 1, 20);

	Счетчики = Новый Соответствие;
	МодулиПоСобытиям = Новый Соответствие;
	ВсегоПодписок = 0;
	Для Каждого Подписка Из ПолучитьВсеПодпискиНаСобытия() Цикл
		Event = Получить(Подписка, "event", "");
		Если ПустаяСтрока(Event) Тогда
			Продолжить;
		КонецЕсли;

		УвеличитьСчетчикСоответствия(Счетчики, Event);
		ВсегоПодписок = ВсегоПодписок + 1;

		Если IncludeTopHandlers Тогда
			Module = Получить(Подписка, "handler_module", "");
			Если ПустаяСтрока(Module) Тогда
				Module = "<unknown>";
			КонецЕсли;
			СчетчикиМодулей = МодулиПоСобытиям.Получить(Event);
			Если СчетчикиМодулей = Неопределено Тогда
				СчетчикиМодулей = Новый Соответствие;
				МодулиПоСобытиям.Вставить(Event, СчетчикиМодулей);
			КонецЕсли;
			УвеличитьСчетчикСоответствия(СчетчикиМодулей, Module);
		КонецЕсли;
	КонецЦикла;

	ТаблицаСобытий = Новый ТаблицаЗначений;
	ТаблицаСобытий.Колонки.Добавить("event");
	ТаблицаСобытий.Колонки.Добавить("count");
	Для Каждого КЗ Из Счетчики Цикл
		СтрокаСобытия = ТаблицаСобытий.Добавить();
		СтрокаСобытия.event = КЗ.Ключ;
		СтрокаСобытия.count = КЗ.Значение;
	КонецЦикла;
	ТаблицаСобытий.Сортировать("count Убыв, event");

	Events = Новый Массив;
	Для Каждого СтрокаСобытия Из ТаблицаСобытий Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("event", СтрокаСобытия.event);
		Элемент.Вставить("count", СтрокаСобытия.count);
		Если IncludeTopHandlers Тогда
			Элемент.Вставить("top_handlers",
				ТопМодулейПодписок(МодулиПоСобытиям.Получить(СтрокаСобытия.event), TopHandlersLimit));
		КонецЕсли;
		Events.Добавить(Элемент);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("events", Events);
	Результат.Вставить("event_count", Events.Количество());
	Результат.Вставить("subscription_count", ВсегоПодписок);
	Результат.Вставить("include_top_handlers", IncludeTopHandlers);
	Если IncludeTopHandlers Тогда
		Результат.Вставить("top_handlers_limit", TopHandlersLimit);
	КонецЕсли;
	Результат.Вставить("guidance", "Use list_event_subscriptions with event and handler_contains for targeted details.");
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 3b. list_event_subscriptions
// ----------------------------------------------------------------------
Функция ListEventSubscriptions(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	EventFilter = СокрЛП(Строка(Получить(Аргументы, "event", "")));
	HandlerContains = СокрЛП(Строка(Получить(Аргументы, "handler_contains", "")));
	HandlerContainsLower = НРег(HandlerContains);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 50, MCP_Config.Лимиты().max_limit);
	Курсор = ЦелоеИзСтроки(Получить(Аргументы, "cursor", ""), 0);
	Если Курсор < 0 Тогда
		Курсор = 0;
	КонецЕсли;

	Подходящие = Новый Массив;
	Для Каждого Подписка Из ПолучитьВсеПодпискиНаСобытия() Цикл
		Event = Получить(Подписка, "event", "");
		Если НЕ ПустаяСтрока(EventFilter) И Event <> EventFilter Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПустаяСтрока(HandlerContainsLower) Тогда
			Handler = НРег(Получить(Подписка, "handler", ""));
			Если СтрНайти(Handler, HandlerContainsLower) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Подходящие.Добавить(Подписка);
	КонецЦикла;

	Страница = СтраницаМассива(Подходящие, Курсор, Лимит);
	Filters = Новый Структура;
	Если НЕ ПустаяСтрока(EventFilter) Тогда
		Filters.Вставить("event", EventFilter);
	КонецЕсли;
	Если НЕ ПустаяСтрока(HandlerContains) Тогда
		Filters.Вставить("handler_contains", HandlerContains);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("subscriptions", Страница.items);
	Результат.Вставить("subscription_count", Страница.items.Количество());
	Результат.Вставить("total_estimated", Подходящие.Количество());
	Результат.Вставить("truncated", Страница.truncated);
	Результат.Вставить("next_cursor", Страница.next_cursor);
	Результат.Вставить("filters", Filters);
	Результат.Вставить("guidance", "For large configurations call count_event_subscriptions_by_event before listing details.");
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 4. run_1c_query
// ----------------------------------------------------------------------
Функция Run1CQuery(Аргументы, CorrelationID = "") Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	ТекстЗапроса = Получить(Аргументы, "query", "");
	Параметры = Получить(Аргументы, "parameters", Неопределено);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 100, MCP_Config.Лимиты().max_query_rows);
	Курсор = Получить(Аргументы, "cursor", "");
	Timeout = ЦелоеИзАргумента(Аргументы, "timeout_seconds", MCP_Config.Лимиты().query_timeout_seconds, 60);
	IncludeColumnTypes = Получить(Аргументы, "include_column_types", Ложь);
	IncludeGuidance = Получить(Аргументы, "include_guidance", Ложь);
	Если ТипЗнч(IncludeGuidance) <> Тип("Булево") Тогда
		IncludeGuidance = Ложь;
	КонецЕсли;
	IncludeNavigationURL = Получить(Аргументы, "include_navigation_url", Ложь);
	ValidateBeforeRun = Получить(Аргументы, "validate_before_run", Истина);
	Если ТипЗнч(ValidateBeforeRun) <> Тип("Булево") Тогда
		ValidateBeforeRun = Истина;
	КонецЕсли;

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан текст запроса.");
	КонецЕсли;

	Результат = MCP_Query.ВыполнитьЗапросСОграничениями(
		ТекстЗапроса, Параметры, Лимит, Timeout, Курсор,
		IncludeNavigationURL, Истина, IncludeGuidance, CorrelationID, ValidateBeforeRun);
	Если НЕ ValidateBeforeRun Тогда
		Результат.warnings.Добавить("validate_before_run=false проигнорирован: проверка безопасности всегда выполняется сервером.");
	КонецЕсли;
	Если НЕ IncludeColumnTypes Тогда
		УпроститьКолонки(Результат);
	КонецЕсли;
	Если IncludeGuidance
		ИЛИ (Получить(Результат, "row_count", 0) = 0 И НЕ MCP_Query.ЕстьЯвныйЛимит(ТекстЗапроса)) Тогда
		ПодсказкиЗапроса = MCP_Knowledge.ПодсказкиДляЗапроса(ТекстЗапроса);
		Если ПодсказкиЗапроса.Количество() > 0 Тогда
			Результат.Вставить("query_guidance", ПодсказкиЗапроса);
		КонецЕсли;
	КонецЕсли;

	// Самообучение: запись обезличенного шаблона успешного запроса.
	// Только первая страница (пустой cursor): пагинация — не новое использование.
	// ЗаписатьПример полностью защищён (Попытка внутри) и никогда не роняет запрос.
	Если ПустаяСтрока(Курсор) Тогда
		MCP_Examples.ЗаписатьПример(ТекстЗапроса, Результат, CorrelationID);
	КонецЕсли;

	Возврат Результат;

КонецФункции

