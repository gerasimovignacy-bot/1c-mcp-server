// ----------------------------------------------------------------------
// 17. run_1c_report
// ----------------------------------------------------------------------
Функция Run1CReport(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	Отчет = Получить(Аргументы, "report", "");
	Вариант = Получить(Аргументы, "variant", Null);
	Параметры = Получить(Аргументы, "parameters", Неопределено);
	OutputFormat = Получить(Аргументы, "output_format", "table");
	МаксСтрокОтчета = MCP_Config.Лимиты().max_report_rows;
	Если МаксСтрокОтчета = Неопределено ИЛИ МаксСтрокОтчета <= 0 ИЛИ МаксСтрокОтчета > 1000 Тогда
		МаксСтрокОтчета = 1000;
	КонецЕсли;
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 200, МаксСтрокОтчета);
	Курсор = Получить(Аргументы, "cursor", "");
	Timeout = ЦелоеИзАргумента(Аргументы, "timeout_seconds", 60, 180);
	// include_totals по умолчанию выключен: универсальный адаптер не извлекает итоги,
	// и Истина по умолчанию приводила к шумному warning на каждый run_1c_report.
	IncludeTotals = Получить(Аргументы, "include_totals", Ложь);
	IncludeParametersUsed = Получить(Аргументы, "include_parameters_used", Ложь);
	IncludeGuidance = Получить(Аргументы, "include_guidance", Ложь);

	Если ПустаяСтрока(Отчет) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан report.");
	КонецЕсли;

	Результат = MCP_Reports.ВыполнитьОтчет(Отчет, Вариант, Параметры, OutputFormat, Лимит, Timeout,
		IncludeTotals, Курсор, Получить(Аргументы, "include_navigation_url", Ложь));
	ОставитьТолькоКолонки(Результат, МассивСтрокИзАргумента(Получить(Аргументы, "columns", Неопределено)));
	Если IncludeParametersUsed Тогда
		Результат.Вставить("parameters_used", ?(Параметры = Неопределено, Новый Структура, Параметры));
	КонецЕсли;
	Если IncludeGuidance Тогда
		MCP_Query.БезопасноПрисоединитьДоменныеПодсказки(Результат, Отчет);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// ----------------------------------------------------------------------
// 18. get_object_history
// ----------------------------------------------------------------------
Функция GetObjectHistory(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	// Сначала достаём target из Аргументов: если он отсутствует, нормализатор
	// вернул бы пустую Структуру и проверка "= Неопределено" никогда не сработала бы.
	Target = Получить(Аргументы, "target", Неопределено);
	Если Target = Неопределено Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Не указан target.");
	КонецЕсли;
	Target = НормализоватьСтруктуру(Target);

	Тип = Получить(Target, "type", "");
	UUID = Получить(Target, "uuid", "");
	Mode = Получить(Аргументы, "mode", "auto");
	ПериодОт = Получить(Аргументы, "period_from", Неопределено);
	ПериодДо = Получить(Аргументы, "period_to", Неопределено);
	IncludeDiff = Получить(Аргументы, "include_diff", Ложь);
	Лимит = ЦелоеИзАргумента(Аргументы, "limit", 20, 500);
	Курсор = Получить(Аргументы, "cursor", "");

	Если ПустаяСтрока(Тип) ИЛИ ПустаяСтрока(UUID) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"target.type и target.uuid обязательны.");
	КонецЕсли;

	Возврат MCP_History.ПолучитьИсторию(Тип, UUID, Mode, ПериодОт, ПериодДо, IncludeDiff, Лимит, Курсор);

