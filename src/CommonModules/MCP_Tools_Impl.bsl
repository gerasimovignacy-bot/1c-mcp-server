Функция ЗапросОстатковПоВозрастуСубконто(AccountingRegister, BalanceSide, AccountPrefixes,
	GroupIndex, AgeIndex, ExtraIndexes, OrderBy)

	ПолеСуммы = ПолеСуммыОстаткаПоСтороне(BalanceSide);

	ПоляВТ = Новый Массив;
	ГруппировкиВТ = Новый Массив;
	ПоляВТ.Добавить("Остатки.Счет.Код КАК Счет");
	ГруппировкиВТ.Добавить("Остатки.Счет.Код");
	ПоляВТ.Добавить("Остатки.Субконто" + Строка(GroupIndex) + " КАК ГруппировкаСубконто");
	ГруппировкиВТ.Добавить("Остатки.Субконто" + Строка(GroupIndex));
	ПоляВТ.Добавить("УникальныйИдентификатор(Остатки.Субконто" + Строка(GroupIndex) + ") КАК ГруппировкаUUID");
	ГруппировкиВТ.Добавить("УникальныйИдентификатор(Остатки.Субконто" + Строка(GroupIndex) + ")");
	ПоляВТ.Добавить("Остатки.Субконто" + Строка(AgeIndex) + " КАК ВозрастноеСубконто");
	ГруппировкиВТ.Добавить("Остатки.Субконто" + Строка(AgeIndex));
	ПоляВТ.Добавить("Остатки.Субконто" + Строка(AgeIndex) + ".Дата КАК ДатаВозрастногоСубконто");
	ГруппировкиВТ.Добавить("Остатки.Субконто" + Строка(AgeIndex) + ".Дата");

	Для Каждого ExtraIndex Из ExtraIndexes Цикл
		Если ExtraIndex <> GroupIndex И ExtraIndex <> AgeIndex Тогда
			ПоляВТ.Добавить("Остатки.Субконто" + Строка(ExtraIndex) + " КАК Субконто" + Строка(ExtraIndex));
			ГруппировкиВТ.Добавить("Остатки.Субконто" + Строка(ExtraIndex));
		КонецЕсли;
	КонецЦикла;
	ПоляВТ.Добавить("СУММА(Остатки." + ПолеСуммы + ") КАК Сумма");

	ПоляФинал = Новый Массив;
	ПоляФинал.Добавить("ВТ.Счет");
	ПоляФинал.Добавить("ВТ.ГруппировкаСубконто");
	ПоляФинал.Добавить("ВТ.ГруппировкаUUID");
	ПоляФинал.Добавить("ВТ.ВозрастноеСубконто");
	ПоляФинал.Добавить("ВТ.ДатаВозрастногоСубконто");
	ПоляФинал.Добавить("РАЗНОСТЬДАТ(ВТ.ДатаВозрастногоСубконто, &ДатаОстатков, ДЕНЬ) КАК ВозрастДней");
	Для Каждого ExtraIndex Из ExtraIndexes Цикл
		Если ExtraIndex <> GroupIndex И ExtraIndex <> AgeIndex Тогда
			ПоляФинал.Добавить("ВТ.Субконто" + Строка(ExtraIndex));
		КонецЕсли;
	КонецЦикла;
	ПоляФинал.Добавить("ВТ.Сумма");

	ТекстЗапроса = "ВЫБРАТЬ " + СтрСоединить(ПоляВТ, ", ") + " "
		+ "ПОМЕСТИТЬ ВТ_ВозрастныеОстатки "
		+ "ИЗ " + AccountingRegister + ".Остатки(&ДатаОстатков, Счет В (&СписокСчетов), &ВидыСубконто, ) КАК Остатки "
		+ "СГРУППИРОВАТЬ ПО " + СтрСоединить(ГруппировкиВТ, ", ") + " "
		+ "ИМЕЮЩИЕ СУММА(Остатки." + ПолеСуммы + ") > &MinAmount "
		+ "; "
		+ "ВЫБРАТЬ " + СтрСоединить(ПоляФинал, ", ") + " "
		+ "ИЗ ВТ_ВозрастныеОстатки КАК ВТ "
		+ "ГДЕ РАЗНОСТЬДАТ(ВТ.ДатаВозрастногоСубконто, &ДатаОстатков, ДЕНЬ) >= &MinAgeDays ";

	Если OrderBy = "age_desc" Тогда
		ТекстЗапроса = ТекстЗапроса + "УПОРЯДОЧИТЬ ПО ВозрастДней УБЫВ, Сумма УБЫВ";
	ИначеЕсли OrderBy = "account" Тогда
		ТекстЗапроса = ТекстЗапроса + "УПОРЯДОЧИТЬ ПО Счет, ГруппировкаСубконто";
	Иначе
		ТекстЗапроса = ТекстЗапроса + "УПОРЯДОЧИТЬ ПО Сумма УБЫВ, ВозрастДней УБЫВ";
	КонецЕсли;
	Возврат ТекстЗапроса;

КонецФункции

Функция ЗапросБакетовВозрастныхОстатков(AccountingRegister, BalanceSide, AccountPrefixes, GroupIndex, AgeIndex, AgeBuckets)

	ПолеСуммы = ПолеСуммыОстаткаПоСтороне(BalanceSide);
	CaseBucket = ВыражениеБакетаВозрастногоОстатка(AgeBuckets);

	ТекстЗапроса = "ВЫБРАТЬ "
		+ "Остатки.Счет.Код КАК Счет, "
		+ "УникальныйИдентификатор(Остатки.Субконто" + Строка(GroupIndex) + ") КАК ГруппировкаUUID, "
		+ "Остатки.Субконто" + Строка(AgeIndex) + " КАК ВозрастноеСубконто, "
		+ "Остатки.Субконто" + Строка(AgeIndex) + ".Дата КАК ДатаВозрастногоСубконто, "
		+ "СУММА(Остатки." + ПолеСуммы + ") КАК Сумма "
		+ "ПОМЕСТИТЬ ВТ_ВозрастныеОстатки "
		+ "ИЗ " + AccountingRegister + ".Остатки(&ДатаОстатков, Счет В (&СписокСчетов), &ВидыСубконто, ) КАК Остатки "
		+ "СГРУППИРОВАТЬ ПО Остатки.Счет.Код, УникальныйИдентификатор(Остатки.Субконто" + Строка(GroupIndex) + "), Остатки.Субконто" + Строка(AgeIndex) + ", Остатки.Субконто" + Строка(AgeIndex) + ".Дата "
		+ "ИМЕЮЩИЕ СУММА(Остатки." + ПолеСуммы + ") > &MinAmount "
		+ "; "
		+ "ВЫБРАТЬ "
		+ CaseBucket + " КАК ГруппаСтарения, "
		+ "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ.ГруппировкаUUID) КАК Группировок, "
		+ "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ УникальныйИдентификатор(ВТ.ВозрастноеСубконто)) КАК ВозрастныхСубконто, "
		+ "СУММА(ВТ.Сумма) КАК Сумма "
		+ "ИЗ ВТ_ВозрастныеОстатки КАК ВТ "
		+ "ГДЕ РАЗНОСТЬДАТ(ВТ.ДатаВозрастногоСубконто, &ДатаОстатков, ДЕНЬ) >= &MinAgeDays "
		+ "СГРУППИРОВАТЬ ПО " + CaseBucket + " "
		+ "УПОРЯДОЧИТЬ ПО ГруппаСтарения УБЫВ";
	Возврат ТекстЗапроса;

КонецФункции

Функция ВыражениеБакетаВозрастногоОстатка(AgeBuckets)

	Части = Новый Массив;
	Для Каждого Threshold Из AgeBuckets Цикл
		Части.Добавить("КОГДА РАЗНОСТЬДАТ(ВТ.ДатаВозрастногоСубконто, &ДатаОстатков, ДЕНЬ) > " + Строка(Threshold) + " ТОГДА "">" + Строка(Threshold) + """");
	КонецЦикла;
	Возврат "ВЫБОР " + СтрСоединить(Части, " ") + " ИНАЧЕ ""<="" КОНЕЦ";

КонецФункции

Функция ЗапросСравненияОстатковПоСубконто(AccountingRegister, MatchIndex,
	LeftPrefixes, LeftSide, RightPrefixes, RightSide)

	LeftAmount = ПолеСуммыОстаткаПоСтороне(LeftSide);
	RightAmount = ПолеСуммыОстаткаПоСтороне(RightSide);
	MatchField = "Субконто" + Строка(MatchIndex);

	ТекстЗапроса = "ВЫБРАТЬ "
		+ "УникальныйИдентификатор(Остатки." + MatchField + ") КАК СубконтоUUID, "
		+ "Остатки." + MatchField + " КАК Субконто, "
		+ "СУММА(Остатки." + LeftAmount + ") КАК ЛеваяСумма "
		+ "ПОМЕСТИТЬ ВТ_ЛевыеОстатки "
		+ "ИЗ " + AccountingRegister + ".Остатки(&ДатаОстатков, Счет В (&СписокСчетовЛево), &ВидыСубконто, ) КАК Остатки "
