КонецФункции

Функция МассивПрефиксовСчетов(Знач Значение)

	Результат = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если НЕ ПустаяСтрока(Элемент) Тогда
				Результат.Добавить(Строка(Элемент));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли НЕ ПустаяСтрока(Значение) Тогда
		Результат.Добавить(Строка(Значение));
	КонецЕсли;
	Если Результат.Количество() = 0 Тогда
		Результат.Добавить("41");
		Результат.Добавить("43");
	КонецЕсли;
	Возврат Результат;

КонецФункции

