КонецФункции

Функция НужноПроверятьВидСубконтоПроводок(SubcontoKindArg, DebitPrefixes, CreditPrefixes, GroupBy, SubcontoValueArg)

	Если SubcontoKindArg = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если DebitPrefixes.Количество() = 0 И CreditPrefixes.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат МассивСодержитСтроку(GroupBy, "debit_subconto")
		ИЛИ МассивСодержитСтроку(GroupBy, "credit_subconto")
		ИЛИ SubcontoValueArg <> Неопределено;

КонецФункции

Функция ПроверитьВидСубконтоПроводокПередЗапросом(Chart, SubcontoKindArg, DebitPrefixes, CreditPrefixes)

	AccountPrefixes = ОбъединитьПрефиксыСчетовПроводок(DebitPrefixes, CreditPrefixes);
	SubcontoKindInfo = ОписаниеВходногоВидаСубконто(SubcontoKindArg);
	AvailableKinds = ДоступныеВидыСубконтоПоПрефиксам(Chart, AccountPrefixes);

	MatchedKind = НайтиДоступныйВидСубконто(SubcontoKindInfo, AvailableKinds);
	Если MatchedKind <> Неопределено Тогда
		SubcontoKindInfo.ref = MatchedKind.ref;
		SubcontoKindInfo.uuid = MatchedKind.uuid;
		SubcontoKindInfo.name = MatchedKind.name;
		Возврат SubcontoKindInfo;
	КонецЕсли;

	ВозбудитьОшибкуНесовпаденияВидаСубконто(SubcontoKindInfo, AccountPrefixes, AvailableKinds);
	Возврат SubcontoKindInfo;

КонецФункции

Функция ОбъединитьПрефиксыСчетовПроводок(DebitPrefixes, CreditPrefixes)

	Результат = Новый Массив;
	Ключи = Новый Соответствие;
	ДобавитьУникальныеПрефиксыСчетов(Результат, Ключи, DebitPrefixes);
	ДобавитьУникальныеПрефиксыСчетов(Результат, Ключи, CreditPrefixes);
	Возврат Результат;

КонецФункции

Процедура ДобавитьУникальныеПрефиксыСчетов(Результат, Ключи, Prefixes)

	Для Каждого Prefix Из Prefixes Цикл
		PrefixString = СокрЛП(Строка(Prefix));
		Если ПустаяСтрока(PrefixString) Тогда
			Продолжить;
		КонецЕсли;
		Если Ключи.Получить(PrefixString) = Неопределено Тогда
			Ключи.Вставить(PrefixString, Истина);
			Результат.Добавить(PrefixString);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеВходногоВидаСубконто(SubcontoKindArg)

	Результат = Новый Структура;
	Результат.Вставить("ref", Неопределено);
	Результат.Вставить("uuid", "");
	Результат.Вставить("name", "");
	Результат.Вставить("type", "ПланВидовХарактеристик.ВидыСубконтоХозрасчетные");

	ТипАргумента = ТипЗнч(SubcontoKindArg);
	Если ТипАргумента = Тип("Структура")
		ИЛИ ТипАргумента = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипАргумента = Тип("Соответствие")
		ИЛИ ТипАргумента = Тип("ФиксированноеСоответствие") Тогда
		Результат.uuid = СокрЛП(Строка(Получить(SubcontoKindArg, "uuid", "")));
		Результат.name = СокрЛП(Строка(Получить(SubcontoKindArg, "presentation", Получить(SubcontoKindArg, "name", ""))));
		Результат.type = СокрЛП(Строка(Получить(SubcontoKindArg, "type", Результат.type)));
	ИначеЕсли ТипАргумента = Тип("Строка") Тогда
		Результат.name = СокрЛП(Строка(SubcontoKindArg));
	КонецЕсли;

	Если НЕ ПустаяСтрока(Результат.uuid) Тогда
		Результат.ref = MCP_Values.СсылкаПоТипуИUUID(Результат.type, Результат.uuid);
		Если ПустаяСтрока(Результат.name) Тогда
			Результат.name = Строка(Результат.ref);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Декодированное = MCP_Values.ДекодироватьПараметр(SubcontoKindArg);
	UUIDДекодированного = UUIDСсылочногоЗначения(Декодированное);
	Если НЕ ПустаяСтрока(UUIDДекодированного) Тогда
		Результат.ref = Декодированное;
		Результат.uuid = UUIDДекодированного;
		Если ПустаяСтрока(Результат.name) Тогда
			Результат.name = Строка(Декодированное);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция РазрешитьВидСубконтоПроводок(SubcontoKindArg)

	Результат = ОписаниеВходногоВидаСубконто(SubcontoKindArg);
	Если Результат.ref <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ПустаяСтрока(Результат.name) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"subconto_kind должен содержать uuid или presentation.");
	КонецЕсли;

	Имена = Новый Массив;
	Имена.Добавить(Результат.name);
	НайденныеСсылки = РазрешитьИменаВидовСубконтоХозрасчетные(Имена);
	Результат.ref = НайденныеСсылки.Получить(НормализованноеИмяСубконто(Результат.name));
	Результат.uuid = UUIDСсылочногоЗначения(Результат.ref);
	Возврат Результат;

КонецФункции

Функция UUIDСсылочногоЗначения(Значение)

	Попытка
		Возврат Строка(Значение.УникальныйИдентификатор());
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ДоступныеВидыСубконтоПоПрефиксам(Chart, AccountPrefixes)

	Результат = Новый Массив;
	Если AccountPrefixes.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Условия = Новый Массив;
	Параметры = Новый Структура;
	Индекс = 0;
	Для Каждого Prefix Из AccountPrefixes Цикл
		ИмяПараметра = "КодПрефикс" + Строка(Индекс);
		Условия.Добавить("Виды.Ссылка.Код ПОДОБНО &" + ИмяПараметра);
		Параметры.Вставить(ИмяПараметра, Строка(Prefix) + "%");
		Индекс = Индекс + 1;
	КонецЦикла;

	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ "
		+ "Виды.ВидСубконто КАК ВидСубконто, "
		+ "УникальныйИдентификатор(Виды.ВидСубконто) КАК UUIDВидаСубконто, "
		+ "Виды.ВидСубконто.Наименование КАК НаименованиеВидаСубконто "
		+ "ИЗ " + Chart + ".ВидыСубконто КАК Виды "
		+ "ГДЕ " + СтрСоединить(Условия, " ИЛИ ")
		+ " УПОРЯДОЧИТЬ ПО НаименованиеВидаСубконто";

	Запрос = Новый Запрос(ТекстЗапроса);
	Для Каждого КЗ Из Параметры Цикл
		Запрос.УстановитьПараметр(Строка(КЗ.Ключ), КЗ.Значение);
	КонецЦикла;
	Таблица = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Запись = Новый Структура;
		Запись.Вставить("ref", СтрокаТаблицы.ВидСубконто);
		Запись.Вставить("uuid", Строка(СтрокаТаблицы.UUIDВидаСубконто));
		Запись.Вставить("name", Строка(СтрокаТаблицы.НаименованиеВидаСубконто));
		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НайтиДоступныйВидСубконто(SubcontoKindInfo, AvailableKinds)

	ИскомыйUUID = ВРег(СокрЛП(Строка(SubcontoKindInfo.uuid)));
	ИскомоеИмя = НормализованноеИмяСубконто(SubcontoKindInfo.name);
	Для Каждого AvailableKind Из AvailableKinds Цикл
		Если НЕ ПустаяСтрока(ИскомыйUUID)
			И ВРег(Строка(AvailableKind.uuid)) = ИскомыйUUID Тогда
			Возврат AvailableKind;
		КонецЕсли;
		Если ПустаяСтрока(ИскомыйUUID)
			И НЕ ПустаяСтрока(ИскомоеИмя)
			И НормализованноеИмяСубконто(AvailableKind.name) = ИскомоеИмя Тогда
			Возврат AvailableKind;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Процедура ВозбудитьОшибкуНесовпаденияВидаСубконто(SubcontoKindInfo, AccountPrefixes, AvailableKinds)

	AvailableForDetails = Новый Массив;
	AvailableNames = Новый Массив;
	Для Каждого AvailableKind Из AvailableKinds Цикл
		KindDetails = Новый Структура;
		KindDetails.Вставить("name", AvailableKind.name);
		KindDetails.Вставить("uuid", AvailableKind.uuid);
		AvailableForDetails.Добавить(KindDetails);
		AvailableNames.Добавить(AvailableKind.name);
	КонецЦикла;

	Suggestions = Новый Массив;
	Suggestions.Добавить("Передайте subconto_kind из списка available_subconto_kinds.");
	ПервыйПрефикс = "";
	Если AccountPrefixes.Количество() > 0 Тогда
		ПервыйПрефикс = AccountPrefixes[0];
	КонецЕсли;
	Suggestions.Добавить("Вызовите get_accounting_accounts_map с account_code_prefix=""" + ПервыйПрефикс + """ для получения актуальной карты субконто.");

	KindName = ?(ПустаяСтрока(SubcontoKindInfo.name), "<без наименования>", SubcontoKindInfo.name);
	KindUUID = ?(ПустаяСтрока(SubcontoKindInfo.uuid), "<не указан>", SubcontoKindInfo.uuid);
	AvailableNamesText = "<нет>";
	Если AvailableNames.Количество() > 0 Тогда
		AvailableNamesText = СтрСоединить(AvailableNames, ", ");
	КонецЕсли;
	Message = "subconto_kind """ + KindName + """ (uuid: " + KindUUID + ") не найден в субконто счетов ["""
		+ СтрСоединить(AccountPrefixes, """, """) + """]. Доступные виды: "
		+ AvailableNamesText + ".";

	DiagnosticsDetails = Новый Структура;
	DiagnosticsDetails.Вставить("subconto_kind_uuid", ?(ПустаяСтрока(SubcontoKindInfo.uuid), Null, SubcontoKindInfo.uuid));
	DiagnosticsDetails.Вставить("subconto_kind_name", ?(ПустаяСтрока(SubcontoKindInfo.name), Null, SubcontoKindInfo.name));
	DiagnosticsDetails.Вставить("account_prefixes", AccountPrefixes);
	DiagnosticsDetails.Вставить("available_subconto_kinds", AvailableForDetails);
	DiagnosticsDetails.Вставить("cache_hit", Ложь);

	Diagnostics = Новый Структура;
	Diagnostics.Вставить("error_code", "subconto_kind_mismatch");
	Diagnostics.Вставить("details", DiagnosticsDetails);
	Diagnostics.Вставить("suggestions", Suggestions);

	Details = Новый Структура;
	Details.Вставить("diagnostics", Diagnostics);
	Details.Вставить("subconto_kind_uuid", ?(ПустаяСтрока(SubcontoKindInfo.uuid), Null, SubcontoKindInfo.uuid));
	Details.Вставить("subconto_kind_name", ?(ПустаяСтрока(SubcontoKindInfo.name), Null, SubcontoKindInfo.name));
	Details.Вставить("account_prefixes", AccountPrefixes);
	Details.Вставить("available_subconto_kinds", AvailableForDetails);
	Details.Вставить("suggestions", Suggestions);
	Details.Вставить("query_guidance", MCP_Knowledge.ПодсказкиДляЗапроса("РегистрБухгалтерии Субконто ПланСчетов ВидыСубконто"));
	Details.Вставить("cache_hit", Ложь);

	MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), Message, Details);

КонецПроцедуры

// Строка-маркер объявленного исключения для правила base_register_table_without_vt_check.
//
// Правило (предвалидатор MCP_Query) запрещает основную таблицу регистра без перебора
// виртуальных таблиц и предусматривает штатный обход: комментарий с кодом правила и
// содержательным обоснованием непосредственно перед источником. Внутренние запросы
// сервера, которым основная таблица нужна по существу (границы периода, число записей,
// субконто по виду), объявляют исключение через этот хелпер, иначе правило отклоняет
// собственные запросы сервера — get_accounting_entries падал целиком, а
// get_database_passport отдавал period_error вместо периода данных.
//
// Обоснование обязано быть содержательным: предвалидатор отбрасывает штампы и требует
// не меньше 15 значимых символов. Маркер обязан стоять на своей строке, источник — на
// следующей, поэтому строка завершается переводом строки.
Функция МаркерИсключенияОсновнойТаблицыРегистра(Обоснование)

	Возврат "// СТАНДАРТ-ИСКЛЮЧЕНИЕ: base_register_table_without_vt_check — "
		+ Обоснование + Символы.ПС;

КонецФункции

Функция ЗапросБухгалтерскихПроводок(AccountingRegister, GroupBy, SubcontoSide,
	HasSubcontoKindFilter, HasSubcontoValueFilter, HasPeriodFrom, HasPeriodTo, DebitPrefixes, CreditPrefixes, IncludeZero)

	ПроверитьГруппировкиПроводок(GroupBy, SubcontoSide, HasSubcontoKindFilter);

	JoinDebit = МассивСодержитСтроку(GroupBy, "debit_subconto")
		ИЛИ SubcontoSide = "debit" И (HasSubcontoKindFilter ИЛИ HasSubcontoValueFilter ИЛИ МассивСодержитСтроку(GroupBy, "subconto_kind"));
	JoinCredit = МассивСодержитСтроку(GroupBy, "credit_subconto")
		ИЛИ SubcontoSide = "credit" И (HasSubcontoKindFilter ИЛИ HasSubcontoValueFilter ИЛИ МассивСодержитСтроку(GroupBy, "subconto_kind"));

	Поля = Новый Массив;
	Группировки = Новый Массив;
	ЭтоАгрегат = GroupBy.Количество() > 0;

	Если ЭтоАгрегат Тогда
		Для Каждого ИмяГруппировки Из GroupBy Цикл
			ДобавитьГруппировкуПроводок(ИмяГруппировки, Поля, Группировки, SubcontoSide);
		КонецЦикла;
		Поля.Добавить("СУММА(Рег.Сумма) КАК Сумма");
		Поля.Добавить("КОЛИЧЕСТВО(Рег.Регистратор) КАК КоличествоСтрок");
	Иначе
		Поля.Добавить("Рег.Период КАК Период");
		Поля.Добавить("Рег.Регистратор КАК Регистратор");
		Поля.Добавить("Рег.НомерСтроки КАК НомерСтроки");
		Поля.Добавить("Рег.СчетДт КАК СчетДт");
		Поля.Добавить("Рег.СчетКт КАК СчетКт");
		Если JoinDebit Тогда
			Поля.Добавить("СубконтоДт.Вид КАК ВидСубконтоДт");
			Поля.Добавить("СубконтоДт.Значение КАК СубконтоДт");
		КонецЕсли;
		Если JoinCredit Тогда
			Поля.Добавить("СубконтоКт.Вид КАК ВидСубконтоКт");
			Поля.Добавить("СубконтоКт.Значение КАК СубконтоКт");
		КонецЕсли;
		Поля.Добавить("Рег.Сумма КАК Сумма");
	КонецЕсли;

	Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + Символы.ПС
		+ МаркерИсключенияОсновнойТаблицыРегистра(
			"нужны Регистратор и субконто ПО ВИДУ через таблицу-компаньон .Субконто; "
			+ "ДвиженияССубконто отдаёт субконто только по позиции, вид аналитики там не виден")
		+ "ИЗ " + AccountingRegister + " КАК Рег";
	Если JoinDebit Тогда
		Текст = Текст + Символы.ПС + СоединениеСубконтоПроводок(AccountingRegister, "СубконтоДт", "Дебет");
	КонецЕсли;
	Если JoinCredit Тогда
		Текст = Текст + Символы.ПС + СоединениеСубконтоПроводок(AccountingRegister, "СубконтоКт", "Кредит");
	КонецЕсли;

	Условия = Новый Массив;
	Если HasPeriodFrom Тогда
		Условия.Добавить("Рег.Период >= &ПериодНачало");
	КонецЕсли;
	Если HasPeriodTo Тогда
		Условия.Добавить("Рег.Период <= &ПериодКонец");
	КонецЕсли;
	ДобавитьУсловияПрефиксовПроводок(Условия, DebitPrefixes, "Рег.СчетДт.Код", "DebitPrefix");
	ДобавитьУсловияПрефиксовПроводок(Условия, CreditPrefixes, "Рег.СчетКт.Код", "CreditPrefix");
	Если HasSubcontoKindFilter ИЛИ HasSubcontoValueFilter Тогда
		АлиасСубконто = ?(SubcontoSide = "debit", "СубконтоДт", "СубконтоКт");
	КонецЕсли;
	Если HasSubcontoKindFilter Тогда
		Условия.Добавить(АлиасСубконто + ".Вид = &ВидСубконто");
	КонецЕсли;
	Если HasSubcontoValueFilter Тогда
		Условия.Добавить(АлиасСубконто + ".Значение = &ЗначениеСубконто");
	КонецЕсли;
	Если НЕ IncludeZero И НЕ ЭтоАгрегат Тогда
		Условия.Добавить("Рег.Сумма <> 0");
	КонецЕсли;
	Если Условия.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "ГДЕ " + СтрСоединить(Условия, " И ");
	КонецЕсли;

	Если ЭтоАгрегат Тогда
		Текст = Текст + Символы.ПС + "СГРУППИРОВАТЬ ПО " + СтрСоединить(Группировки, ", ");
		Если НЕ IncludeZero Тогда
			Текст = Текст + Символы.ПС + "ИМЕЮЩИЕ СУММА(Рег.Сумма) <> 0";
		КонецЕсли;
		Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО " + ПорядокГруппировокПроводок(GroupBy);
	Иначе
		Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО Рег.Период, Рег.Регистратор, Рег.НомерСтроки";
	КонецЕсли;

	Возврат Текст;

КонецФункции

Процедура ПроверитьГруппировкиПроводок(GroupBy, SubcontoSide, HasSubcontoKindFilter)

	Для Каждого ИмяГруппировки Из GroupBy Цикл
		Имя = НРег(Строка(ИмяГруппировки));
		Если Имя <> "period_month" И Имя <> "registrar"
			И Имя <> "debit_account" И Имя <> "credit_account"
			И Имя <> "debit_subconto" И Имя <> "credit_subconto"
			И Имя <> "subconto_kind" Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
				"Неподдерживаемая группировка get_accounting_entries: " + ИмяГруппировки);
		КонецЕсли;
	КонецЦикла;
	Если МассивСодержитСтроку(GroupBy, "subconto_kind") И ПустаяСтрока(SubcontoSide) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Для group_by=subconto_kind укажите subconto_side: debit или credit.");
	КонецЕсли;
	ГруппировкаПоЗначениюСубконто = МассивСодержитСтроку(GroupBy, "debit_subconto")
		ИЛИ МассивСодержитСтроку(GroupBy, "credit_subconto");
	Если ГруппировкаПоЗначениюСубконто
		И НЕ HasSubcontoKindFilter
		И НЕ МассивСодержитСтроку(GroupBy, "subconto_kind") Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Группировка по debit_subconto/credit_subconto без subconto_kind неоднозначна: в поле попадают разные виды аналитики, например Контрагенты, Договоры и Документы расчетов. Сначала вызовите get_accounting_accounts_map, выберите нужный вид субконто и передайте его в subconto_kind либо добавьте group_by=subconto_kind.");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьГруппировкуПроводок(ИмяГруппировки, Поля, Группировки, SubcontoSide)

	Имя = НРег(Строка(ИмяГруппировки));
	Если Имя = "period_month" Тогда
		Поля.Добавить("НАЧАЛОПЕРИОДА(Рег.Период, МЕСЯЦ) КАК ПериодМесяц");
		Группировки.Добавить("НАЧАЛОПЕРИОДА(Рег.Период, МЕСЯЦ)");
	ИначеЕсли Имя = "registrar" Тогда
		Поля.Добавить("Рег.Регистратор КАК Регистратор");
		Группировки.Добавить("Рег.Регистратор");
	ИначеЕсли Имя = "debit_account" Тогда
		Поля.Добавить("Рег.СчетДт КАК СчетДт");
		Группировки.Добавить("Рег.СчетДт");
	ИначеЕсли Имя = "credit_account" Тогда
		Поля.Добавить("Рег.СчетКт КАК СчетКт");
		Группировки.Добавить("Рег.СчетКт");
	ИначеЕсли Имя = "debit_subconto" Тогда
		Поля.Добавить("СубконтоДт.Значение КАК СубконтоДт");
		Группировки.Добавить("СубконтоДт.Значение");
	ИначеЕсли Имя = "credit_subconto" Тогда
		Поля.Добавить("СубконтоКт.Значение КАК СубконтоКт");
		Группировки.Добавить("СубконтоКт.Значение");
	ИначеЕсли Имя = "subconto_kind" Тогда
		АлиасСубконто = ?(SubcontoSide = "debit", "СубконтоДт", "СубконтоКт");
		Поля.Добавить(АлиасСубконто + ".Вид КАК ВидСубконто");
		Группировки.Добавить(АлиасСубконто + ".Вид");
	КонецЕсли;

КонецПроцедуры

// Соединение с компаньоном <Регистр>.Субконто — ВНУТРЕННЕЕ, не левое.
//
// Соединение добавляется только когда вызывающий сам просит субконто: группировкой по
// нему либо отбором по виду/значению. Строка проводки без субконто запрошенной стороны
// в такой отчёт не входит по смыслу, а при левом соединении она давала NULL в поле
// компаньона.
//
// При отборе по виду или значению левое соединение и так работало как внутреннее: условие
// стоит во ВНЕШНЕМ ГДЕ (Вид = &ВидСубконто), а условие со значением NULL считается
// невыполненным, поэтому строка молча исчезала. Внутреннее соединение делает это явным.
//
// Обёртка в ЕСТЬNULL здесь не подходит: поле Значение — составная ссылка (Контрагенты,
// Договоры, Документы расчётов), и значения «того же типа» для подстановки не существует
// (§4.4 стандартов), а чужой тип создал бы колонку составного типа.
Функция СоединениеСубконтоПроводок(AccountingRegister, Алиас, Направление)

	Возврат "ВНУТРЕННЕЕ СОЕДИНЕНИЕ " + AccountingRegister + ".Субконто КАК " + Алиас
		+ " ПО Рег.Период = " + Алиас + ".Период"
		+ " И Рег.Регистратор = " + Алиас + ".Регистратор"
		+ " И Рег.НомерСтроки = " + Алиас + ".НомерСтроки"
		+ " И " + Алиас + ".ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияБухгалтерии." + Направление + ")";

КонецФункции

Процедура ДобавитьУсловияПрефиксовПроводок(Условия, Prefixes, ПолеКода, ПрефиксПараметра)

	Если Prefixes.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УсловияПрефиксов = Новый Массив;
	Индекс = 0;
	Для Каждого Prefix Из Prefixes Цикл
		Если НЕ ПустаяСтрока(Prefix) Тогда
			УсловияПрефиксов.Добавить(ПолеКода + " ПОДОБНО &" + ПрефиксПараметра + Строка(Индекс));
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Если УсловияПрефиксов.Количество() > 0 Тогда
		Условия.Добавить("(" + СтрСоединить(УсловияПрефиксов, " ИЛИ ") + ")");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПараметрыПрефиксовСчетовПроводок(Параметры, Prefixes, ПрефиксПараметра)

	Индекс = 0;
	Для Каждого Prefix Из Prefixes Цикл
		Если НЕ ПустаяСтрока(Prefix) Тогда
			Параметры.Вставить(ПрефиксПараметра + Строка(Индекс), Строка(Prefix) + "%");
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПорядокГруппировокПроводок(GroupBy)

	Порядок = Новый Массив;
	Для Каждого ИмяГруппировки Из GroupBy Цикл
		Имя = НРег(Строка(ИмяГруппировки));
		Если Имя = "period_month" Тогда
			Порядок.Добавить("ПериодМесяц");
		ИначеЕсли Имя = "registrar" Тогда
			Порядок.Добавить("Регистратор");
		ИначеЕсли Имя = "debit_account" Тогда
			Порядок.Добавить("СчетДт");
		ИначеЕсли Имя = "credit_account" Тогда
			Порядок.Добавить("СчетКт");
		ИначеЕсли Имя = "debit_subconto" Тогда
			Порядок.Добавить("СубконтоДт");
		ИначеЕсли Имя = "credit_subconto" Тогда
			Порядок.Добавить("СубконтоКт");
		ИначеЕсли Имя = "subconto_kind" Тогда
			Порядок.Добавить("ВидСубконто");
		КонецЕсли;
	КонецЦикла;
	Если Порядок.Количество() = 0 Тогда
		Возврат "Сумма";
	КонецЕсли;
	Возврат СтрСоединить(Порядок, ", ");

КонецФункции

Функция МассивСодержитСтроку(МассивЗначений, Искомое)

	Если ТипЗнч(МассивЗначений) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	ИскомоеНРег = НРег(Строка(Искомое));
	Для Каждого ЗначениеМассива Из МассивЗначений Цикл
		Если НРег(Строка(ЗначениеМассива)) = ИскомоеНРег Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция РазрешитьНоменклатуруДляОстатков(ItemType, ItemRefArg, ItemQuery, Warnings)

	Результат = Новый Структура;
	Результат.Вставить("input", ?(ПустаяСтрока(ItemQuery), Null, ItemQuery));
	Результат.Вставить("matched_count", 0);
	Результат.Вставить("ambiguous", Ложь);

	Если ItemRefArg <> Неопределено Тогда
		ТипРеф = Получить(ItemRefArg, "type", ItemType);
		UUID = Получить(ItemRefArg, "uuid", "");
		Если ПустаяСтрока(UUID) Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "item_ref.uuid обязателен.");
		КонецЕсли;
		Ссылка = MCP_Values.СсылкаПоТипуИUUID(ТипРеф, UUID);
		Результат.Вставить("ref", Ссылка);
		Результат.Вставить("source", "item_ref");
		Результат.matched_count = 1;
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(ItemQuery) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Передайте item_query или item_ref.");
	КонецЕсли;

	Поиск = НайтиНоменклатуруДляОстатков(ItemType, ItemQuery);
	Если Поиск.matches.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(), "Номенклатура не найдена: " + ItemQuery);
	КонецЕсли;
	Если Поиск.matches.Количество() > 1 Тогда
		Результат.ambiguous = Истина;
		Warnings.Добавить("По item_query найдено несколько элементов; использован первый по упорядочиванию.");
	КонецЕсли;
	Первый = Поиск.matches[0];
	Результат.Вставить("ref", Первый.ref);
	Результат.Вставить("source", "item_query");
	Результат.matched_count = Поиск.matches.Количество();
	Результат.Вставить("candidates", Поиск.candidates);
	Возврат Результат;

КонецФункции

Функция НайтиНоменклатуруДляОстатков(ItemType, ItemQuery)

	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ItemType) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Некорректный тип номенклатуры: " + ItemType);
	КонецЕсли;

	Условия = Новый Массив;
	Если MCP_Security.ПолеРазрешено(ItemType, "Наименование") Тогда
		Условия.Добавить("Т.Наименование ПОДОБНО &Шаблон");
	КонецЕсли;
	Если MCP_Security.ПолеРазрешено(ItemType, "Код") Тогда
		Условия.Добавить("Т.Код ПОДОБНО &Шаблон");
	КонецЕсли;
	Если Условия.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_AccessDenied(),
			"Для типа недоступны поля поиска Наименование/Код: " + ItemType);
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 2 Т.Ссылка КАК Ссылка ИЗ " + ItemType
		+ " КАК Т ГДЕ (" + СтрСоединить(Условия, " ИЛИ ") + ")";
	Если ТипИмеетПометкуУдаления(ItemType) И MCP_Security.ПолеРазрешено(ItemType, "ПометкаУдаления") Тогда
		ТекстЗапроса = ТекстЗапроса + " И НЕ Т.ПометкаУдаления";
	КонецЕсли;
	Если MCP_Security.ПолеРазрешено(ItemType, "Наименование") Тогда
		ТекстЗапроса = ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Т.Наименование";
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Шаблон", ПодготовитьПодстановку(ItemQuery, "contains"));
	Таблица = Запрос.Выполнить().Выгрузить();

	Результат = Новый Структура;
	Результат.Вставить("matches", Новый Массив);
	Результат.Вставить("candidates", Новый Массив);
	ОпцииВалью = MCP_Values.ОпцииПоУмолчанию();
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Запись = Новый Структура;
		Запись.Вставить("ref", СтрокаТаблицы.Ссылка);
		Результат.matches.Добавить(Запись);
		Результат.candidates.Добавить(MCP_Values.Кодировать(СтрокаТаблицы.Ссылка, ОпцииВалью));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НайтиВидыСубконтоОстатков(Chart, AccountPrefixes, ItemSubcontoName, WarehouseSubcontoName)

	Результат = Новый Структура;
	Результат.Вставить("item_subconto", Неопределено);
	Результат.Вставить("warehouse_subconto", Неопределено);
	Результат.Вставить("warnings", Новый Массив);

	Условия = Новый Массив;
	Параметры = Новый Структура;
	Индекс = 0;
	Для Каждого Prefix Из AccountPrefixes Цикл
		ИмяПараметра = "КодПрефикс" + Строка(Индекс);
		Условия.Добавить("Виды.Ссылка.Код ПОДОБНО &" + ИмяПараметра);
		Параметры.Вставить(ИмяПараметра, Строка(Prefix) + "%");
		Индекс = Индекс + 1;
	КонецЦикла;

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 200 "
		+ "Виды.ВидСубконто КАК ВидСубконто, "
		+ "Виды.ВидСубконто.Наименование КАК НаименованиеВидаСубконто "
		+ "ИЗ " + Chart + ".ВидыСубконто КАК Виды";
	Если Условия.Количество() > 0 Тогда
		ТекстЗапроса = ТекстЗапроса + " ГДЕ " + СтрСоединить(Условия, " ИЛИ ");
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Для Каждого КЗ Из Параметры Цикл
		Запрос.УстановитьПараметр(Строка(КЗ.Ключ), КЗ.Значение);
	КонецЦикла;
	Таблица = Запрос.Выполнить().Выгрузить();

	ItemNameNorm = НормализованноеИмяСубконто(ItemSubcontoName);
	WarehouseNameNorm = НормализованноеИмяСубконто(WarehouseSubcontoName);
	ItemKeys = Новый Соответствие;
	WarehouseKeys = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Имя = НормализованноеИмяСубконто(СтрокаТаблицы.НаименованиеВидаСубконто);
		Если Имя = ItemNameNorm Тогда
			ItemKeys.Вставить(КлючКодированногоЗначения(MCP_Values.Кодировать(СтрокаТаблицы.ВидСубконто)), Истина);
			Если Результат.item_subconto = Неопределено Тогда
				Результат.item_subconto = СтрокаТаблицы.ВидСубконто;
			КонецЕсли;
		ИначеЕсли Имя = WarehouseNameNorm Тогда
			WarehouseKeys.Вставить(КлючКодированногоЗначения(MCP_Values.Кодировать(СтрокаТаблицы.ВидСубконто)), Истина);
			Если Результат.warehouse_subconto = Неопределено Тогда
				Результат.warehouse_subconto = СтрокаТаблицы.ВидСубконто;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ItemKeys.Количество() > 1 Тогда
		Результат.warnings.Добавить("Найдено несколько видов субконто '" + ItemSubcontoName + "'; использован первый.");
	КонецЕсли;
	Если WarehouseKeys.Количество() > 1 Тогда
		Результат.warnings.Добавить("Найдено несколько видов субконто '" + WarehouseSubcontoName + "'; использован первый.");
	КонецЕсли;

	Summary = Новый Структура;
	Summary.Вставить("source_of_truth", Chart + ".ВидыСубконто");
	Summary.Вставить("item_subconto_name", ItemSubcontoName);
	Summary.Вставить("warehouse_subconto_name", WarehouseSubcontoName);
	Summary.Вставить("item_subconto", ?(Результат.item_subconto = Неопределено, Null, MCP_Values.Кодировать(Результат.item_subconto)));
	Summary.Вставить("warehouse_subconto", ?(Результат.warehouse_subconto = Неопределено, Null, MCP_Values.Кодировать(Результат.warehouse_subconto)));
	Результат.Вставить("summary", Summary);
	Возврат Результат;

КонецФункции

Функция НормализованноеИмяСубконто(Знач Имя)
	Возврат ВРег(СокрЛП(Строка(Имя)));
