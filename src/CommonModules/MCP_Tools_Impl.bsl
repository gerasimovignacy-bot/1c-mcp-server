	КонецЕсли;

	Попытка
		Данные = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Параметры, 1,
			MCP_Config.Лимиты().query_timeout_seconds, "");
		Если Данные.rows.Количество() > 0 Тогда
