Функция ЗапросОстатковТовара(AccountingRegister, Лимит, IncludeZero, AccountPrefixes)


	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + MCP_Query.ЦелоеДляТекстаЗапроса(Лимит) + " "
		+ "Остатки.Организация КАК Организация, "
		+ "Остатки.Субконто2 КАК Склад, "
		+ "СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток, "
		+ "СУММА(Остатки.СуммаОстаток) КАК СуммаОстаток "
		+ "ИЗ " + AccountingRegister + ".Остатки(&ДатаОстатков, Счет В (&СписокСчетов), &ВидыСубконто, Субконто1 = &Номенклатура) КАК Остатки "
		+ "СГРУППИРОВАТЬ ПО Остатки.Организация, Остатки.Субконто2 ";
	Если НЕ IncludeZero Тогда
		ТекстЗапроса = ТекстЗапроса
			+ "ИМЕЮЩИЕ СУММА(Остатки.КоличествоОстаток) <> 0 "
			+ "ИЛИ СУММА(Остатки.СуммаОстаток) <> 0 ";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "УПОРЯДОЧИТЬ ПО Организация, Склад";
	Возврат ТекстЗапроса;

КонецФункции

// Разворачивает префиксы кодов счетов в массив ссылок на счёта.
//
// Позиция условия по счёту в параметрах виртуальной таблицы принимает только сам счёт:
// Счет В (...), Счет = ..., Счет В ИЕРАРХИИ(...). Разыменование Счет.Код там запрещено и
// даёт vt_param_field_error, поэтому префикс нельзя просто перенести в параметр — его
// нужно заранее развернуть по плану счетов, а в параметр отдать типизированный массив.
//
// Отбор по счёту обязан быть в параметрах ВТ, а не во внешнем ГДЕ (§2 стандартов):
// параметры применяются ДО агрегации, внешний ГДЕ — ПОСЛЕ.
//
// Усечение списка счетов — это порча результата, а не потеря производительности:
// молча пропали бы остатки по части счетов. Поэтому при достижении потолка выборки
// возбуждается ошибка, а не возвращается неполный список.
Функция СсылкиСчетовПоПрефиксам(Знач Chart, AccountPrefixes)

	Если AccountPrefixes.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ПланСчетов = ВыбратьПланСчетов(Chart);
	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПланСчетов) Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Некорректное имя плана счетов: " + ПланСчетов);
	КонецЕсли;
	// Прямое выполнение не проходит через MCP_Query.Валидировать, поэтому обе проверки,
	// которые она делала, повторяются здесь явно. Их именно две: Валидировать сверяет
	// тип по allowlist (type_not_allowed) И обращение к скрытым полям типа
	// (field_not_allowed). Одной проверки типа недостаточно: скрытый Код при разрешённом
	// плане счетов дал бы отбор по полю, которое сервер обязан не отдавать. Так же
	// поступает MCP_Query при прямом чтении плана счетов в pre-flight.
	MCP_Security.ПроверитьДоступКТипу(ПланСчетов);
	Если НЕ MCP_Security.ПолеРазрешено(ПланСчетов, "Код") Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_AccessDenied(),
			"Для плана счетов недоступно поле Код, отбор по префиксам счетов невозможен: " + ПланСчетов);
	КонецЕсли;

	Условия = Новый Массив;
	Параметры = Новый Структура;
	Индекс = 0;
	Для Каждого Prefix Из AccountPrefixes Цикл
		Если НЕ ПустаяСтрока(Prefix) Тогда
			Условия.Добавить("Счета.Код ПОДОБНО &ПрефиксСчета" + Строка(Индекс));
			Параметры.Вставить("ПрефиксСчета" + Строка(Индекс), Строка(Prefix) + "%");
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Если Условия.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Потолок = MCP_Config.Лимиты().max_query_rows;
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + MCP_Query.ЦелоеДляТекстаЗапроса(Потолок) + " "
		+ "Счета.Ссылка КАК Счет "
		+ "ИЗ " + ПланСчетов + " КАК Счета "
		+ "ГДЕ " + СтрСоединить(Условия, " ИЛИ ");

	// Запрос исполняется напрямую, а НЕ через MCP_Query.ВыполнитьЗапросСОграничениями:
	// та функция возвращает rows, уже прогнанные через MCP_Values.Кодировать для
	// JSON-ответа, то есть ссылка превращается в Структура{type, uuid, presentation}.
	// Массив структур в позиции условия по счёту виртуальной таблицы платформа
	// отвергает с «Неверные параметры» — сюда нужны сами ссылки плана счетов.
	// Текст запроса строит сервер: имя плана счетов уже проверено выше, префиксы
	// уходят параметрами, клиентской подстановки в текст нет. Тот же приём
	// (Новый Запрос + Выгрузить) применён в соседних внутренних подборах модуля,
	// в том числе в НайтиВидыСубконтоОстатков.
	Запрос = Новый Запрос(ТекстЗапроса);
	Для Каждого КлючЗначение Из Параметры Цикл
		Запрос.УстановитьПараметр(Строка(КлючЗначение.Ключ), КлючЗначение.Значение);
	КонецЦикла;
	Таблица = Запрос.Выполнить().Выгрузить();

	Если Таблица.Количество() >= Потолок Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Префиксам счетов соответствует не меньше " + Строка(Потолок) + " счетов: список счетов"
			+ " был бы усечён, а часть остатков молча потеряна. Сузьте account_code_prefixes.");
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Счет) Тогда
			Результат.Добавить(СтрокаТаблицы.Счет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НормализоватьСторонуОстатка(Знач BalanceSide)

	Side = НРег(Строка(BalanceSide));
	Если Side <> "debit" И Side <> "credit" Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"balance_side должен быть debit или credit.");
	КонецЕсли;
	Возврат Side;

КонецФункции

Функция ПолеСуммыОстаткаПоСтороне(BalanceSide)
	Возврат ?(BalanceSide = "credit", "СуммаОстатокКт", "СуммаОстатокДт");
КонецФункции

Функция ИндексСубконтоИзАргумента(Аргументы, ИмяПоля, ПоУмолчанию)

	Индекс = ЦелоеИзАргумента(Аргументы, ИмяПоля, ПоУмолчанию, 3);
	Если Индекс < 1 ИЛИ Индекс > 3 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			ИмяПоля + " должен быть от 1 до 3.");
	КонецЕсли;
	Возврат Индекс;

КонецФункции

Функция МассивИндексовСубконто(Знач Значение)

	Результат = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Попытка
				Индекс = Цел(Число(Элемент));
			Исключение
				Продолжить;
			КонецПопытки;
			Если Индекс >= 1 И Индекс <= 3 И НЕ МассивСодержитЧисло(Результат, Индекс) Тогда
				Результат.Добавить(Индекс);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция МассивСодержитЧисло(МассивЗначений, Знач ЧислоДляПоиска)
	Для Каждого ЗначениеМассива Из МассивЗначений Цикл
		Если ЗначениеМассива = ЧислоДляПоиска Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция МассивЧиселИзАргумента(Знач Значение)

	Результат = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Попытка
				ЧислоЭлемента = Цел(Число(Элемент));
			Исключение
				Продолжить;
			КонецПопытки;
			Если ЧислоЭлемента >= 0 И НЕ МассивСодержитЧисло(Результат, ЧислоЭлемента) Тогда
				Результат.Добавить(ЧислоЭлемента);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ОтсортироватьЧислаПоУбыванию(Знач Значения)

	Результат = Новый Массив;
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ЧислоКандидат Из Значения Цикл
		Позиция = Результат.Количество();
		Если Результат.Количество() > 0 Тогда
			Для Индекс = 0 По Результат.Количество() - 1 Цикл
				Если ЧислоКандидат > Результат[Индекс] Тогда
					Позиция = Индекс;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Результат.Вставить(Позиция, ЧислоКандидат);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДекодироватьМассивПараметров(Знач Значение)

	Если ЭтоОбъектСМаркеромПараметра(Значение) Тогда
		Декодированное = MCP_Values.ДекодироватьПараметр(Значение);
		Если ТипЗнч(Декодированное) = Тип("Массив") Тогда
			Возврат Декодированное;
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(MCP_Values.ДекодироватьПараметр(Элемент));
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция РазрешитьВидыСубконто(Знач Значение)

	Результат = ДекодироватьМассивПараметров(Значение);
	Если Результат.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ИменаДляРезолвинга = Новый Массив;
	КлючиИмен = Новый Соответствие;
	Для Каждого ВидСубконто Из Результат Цикл
		Если ТипЗнч(ВидСубконто) = Тип("Строка") Тогда
			Имя = СокрЛП(ВидСубконто);
			Ключ = НормализованноеИмяСубконто(Имя);
			Если КлючиИмен.Получить(Ключ) = Неопределено Тогда
				КлючиИмен.Вставить(Ключ, Истина);
				ИменаДляРезолвинга.Добавить(Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ИменаДляРезолвинга.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	НайденныеСсылки = РазрешитьИменаВидовСубконтоХозрасчетные(ИменаДляРезолвинга);
	НормализованныйРезультат = Новый Массив;
	Для Каждого ВидСубконто Из Результат Цикл
		Если ТипЗнч(ВидСубконто) = Тип("Строка") Тогда
			НормализованныйРезультат.Добавить(НайденныеСсылки.Получить(НормализованноеИмяСубконто(ВидСубконто)));
		Иначе
			НормализованныйРезультат.Добавить(ВидСубконто);
		КонецЕсли;
	КонецЦикла;

	Возврат НормализованныйРезультат;

КонецФункции

Функция РазрешитьИменаВидовСубконтоХозрасчетные(ИменаСубконто)

	ТипВидаСубконто = "ПланВидовХарактеристик.ВидыСубконтоХозрасчетные";
	MCP_Security.ПроверитьДоступКТипу(ТипВидаСубконто);

	ТекстЗапроса = "ВЫБРАТЬ "
		+ "ВидыСубконто.Ссылка КАК Ссылка, "
		+ "ВидыСубконто.Наименование КАК Наименование "
		+ "ИЗ " + ТипВидаСубконто + " КАК ВидыСубконто "
		+ "ГДЕ ВидыСубконто.Наименование В (&ИменаСубконто)";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ИменаСубконто", ИменаСубконто);
	Таблица = Запрос.Выполнить().Выгрузить();

	НайденныеСсылки = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ключ = НормализованноеИмяСубконто(СтрокаТаблицы.Наименование);
		Если НайденныеСсылки.Получить(Ключ) = Неопределено Тогда
			НайденныеСсылки.Вставить(Ключ, СтрокаТаблицы.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Ненайденные = Новый Массив;
	Для Каждого ИмяСубконто Из ИменаСубконто Цикл
		Если НайденныеСсылки.Получить(НормализованноеИмяСубконто(ИмяСубконто)) = Неопределено Тогда
			Ненайденные.Добавить(ИмяСубконто);
		КонецЕсли;
	КонецЦикла;

	Если Ненайденные.Количество() > 0 Тогда
		ДоступныеЗначения = ДоступныеИменаВидовСубконто(ТипВидаСубконто, 100);
		Детали = Новый Структура;
		Детали.Вставить("source_type", ТипВидаСубконто);
		Детали.Вставить("requested", ИменаСубконто);
		Детали.Вставить("missing", Ненайденные);
		Детали.Вставить("available", ДоступныеЗначения);
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Вид субконто """ + Строка(Ненайденные[0]) + """ не найден в "
			+ ТипВидаСубконто + ". Доступные значения: " + КраткийСписокСтрок(ДоступныеЗначения, 20) + ".",
			Детали);
	КонецЕсли;

	Возврат НайденныеСсылки;

КонецФункции

Функция ДоступныеИменаВидовСубконто(ТипВидаСубконто, Лимит)

	Результат = Новый Массив;
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + MCP_Query.ЦелоеДляТекстаЗапроса(Лимит) + " "
		+ "ВидыСубконто.Наименование КАК Наименование "
		+ "ИЗ " + ТипВидаСубконто + " КАК ВидыСубконто "
		+ "УПОРЯДОЧИТЬ ПО ВидыСубконто.Наименование";
	Запрос = Новый Запрос(ТекстЗапроса);
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Результат.Добавить(СтрокаТаблицы.Наименование);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КраткийСписокСтрок(Знач Строки, Максимум)

	Части = Новый Массив;
	Индекс = 0;
	Для Каждого СтрокаСписка Из Строки Цикл
		Если Индекс >= Максимум Тогда
			Прервать;
		КонецЕсли;
		Части.Добавить(Строка(СтрокаСписка));
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Строки.Количество() > Максимум Тогда
		Части.Добавить("...");
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

Функция ЭтоОбъектСМаркеромПараметра(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Kind = Неопределено;
		Возврат Значение.Свойство("kind", Kind);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Соответствие")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Возврат Значение.Получить("kind") <> Неопределено;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция ЧислоИзАргумента(Аргументы, ИмяПоля, ПоУмолчанию)

	Значение = Получить(Аргументы, ИмяПоля, ПоУмолчанию);
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;

