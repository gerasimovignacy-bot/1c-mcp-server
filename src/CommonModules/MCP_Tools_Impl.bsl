Функция СтрокаИсточникаПодпискиНаСобытие(Источник)

	Если Источник = Неопределено ИЛИ Источник = Null Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат СокрЛП(Строка(Источник));
