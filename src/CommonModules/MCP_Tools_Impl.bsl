Процедура ДобавитьСчетаБезСубконтоВКарту(Accounts, Chart, AccountCodePrefix, Лимит, Курсор, Warnings)

	Если ТипЗнч(Accounts) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(Chart) Тогда
		Возврат;
	КонецЕсли;

	Ключи = Новый Соответствие;
	Для Каждого Account Из Accounts Цикл
		Ключ = КлючКодированногоЗначения(Получить(Account, "account", Null));
		Если НЕ ПустаяСтрока(Ключ) Тогда
			Ключи.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;
	ЛимитЗапроса = Смещение + Лимит + 1;
	Если ЛимитЗапроса > MCP_Config.Лимиты().max_query_rows Тогда
		ЛимитЗапроса = MCP_Config.Лимиты().max_query_rows;
	КонецЕсли;

	Поля = Новый Массив;
	Поля.Добавить("Счета.Ссылка КАК Счет");
	Поля.Добавить("УникальныйИдентификатор(Счета.Ссылка) КАК UUIDСчета");
	Если MCP_Security.ПолеРазрешено(Chart, "Код") Тогда
		Поля.Добавить("Счета.Код КАК Код");
	КонецЕсли;
	Если MCP_Security.ПолеРазрешено(Chart, "Наименование") Тогда
		Поля.Добавить("Счета.Наименование КАК Наименование");
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + MCP_Query.ЦелоеДляТекстаЗапроса(ЛимитЗапроса) + " "
		+ СтрСоединить(Поля, ", ")
		+ " ИЗ " + Chart + " КАК Счета";
	Параметры = Новый Структура;
	Если НЕ ПустаяСтрока(AccountCodePrefix) Тогда
		ТекстЗапроса = ТекстЗапроса + " ГДЕ Счета.Код ПОДОБНО &КодПрефикс";
		Параметры.Вставить("КодПрефикс", Строка(AccountCodePrefix) + "%");
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Счета.Код";

	Попытка
		ДанныеСчетов = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Параметры, Лимит,
			MCP_Config.Лимиты().query_timeout_seconds, Курсор);
		Для Каждого СтрокаСчета Из ДанныеСчетов.rows Цикл
			Счет = Получить(СтрокаСчета, "Счет", Null);
			Ключ = КлючКодированногоЗначения(Счет);
			Если ПустаяСтрока(Ключ) ИЛИ Ключи.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Account = Новый Структура;
			Account.Вставить("account", Счет);
			Account.Вставить("code", Получить(СтрокаСчета, "Код", ""));
			Account.Вставить("name", Получить(СтрокаСчета, "Наименование", ""));
			Account.Вставить("uuid", Получить(СтрокаСчета, "UUIDСчета", Получить(Счет, "uuid", Null)));
			Account.Вставить("subconto", Новый Массив);
			Account.Вставить("subconto_count", 0);
			Account.Вставить("has_empty_subconto", Истина);
			Accounts.Добавить(Account);
			Ключи.Вставить(Ключ, Истина);
		КонецЦикла;
	Исключение
		Warnings.Добавить("include_empty_subconto=true: не удалось добавить счета без ВидыСубконто: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция ДоступныеОбъектыМетаданныхПоВиду(Вид)

	Результат = Новый Массив;
	Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
	Для Каждого Стр Из Все Цикл
		Если Стр.Вид = Вид И MCP_Security.ТипРазрешен(Стр.ПолноеИмя) Тогда
			Запись = Новый Структура;
			Запись.Вставить("name", Стр.Имя);
			Запись.Вставить("full_name", Стр.ПолноеИмя);
			Запись.Вставить("synonym", Стр.Синоним);
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПаспортБухгалтерскогоРегистра(ПолноеИмяРегистра, OrganizationLimit, IncludeOrganizations, Organizations, OrganizationKeys, Warnings)

	Результат = Новый Структура;
	Результат.Вставить("register", ПолноеИмяРегистра);
	Результат.Вставить("first_entry", Null);
	Результат.Вставить("last_entry", Null);
	Результат.Вставить("total_entries", Null);
	Результат.Вставить("has_organization_field", Ложь);

	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмяРегистра) Тогда
		Результат.Вставить("error", "unsafe_metadata_name");
		Возврат Результат;
	КонецЕсли;

	Попытка
		ТекстПериода = "ВЫБРАТЬ МИНИМУМ(Регистр.Период) КАК first_entry, "
			+ "МАКСИМУМ(Регистр.Период) КАК last_entry, "
			+ "КОЛИЧЕСТВО(*) КАК total_entries" + Символы.ПС
			+ МаркерИсключенияОсновнойТаблицыРегистра(
				"нужно точное число записей регистра любого вида: набор виртуальных таблиц "
				+ "различается по видам регистров, у сведений и расчёта таблицы движений нет вовсе")
			+ "ИЗ " + ПолноеИмяРегистра + " КАК Регистр";
		ДанныеПериода = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстПериода, Новый Структура, 1,
			MCP_Config.Лимиты().query_timeout_seconds, "");
		Если ДанныеПериода.rows.Количество() > 0 Тогда
			СтрокаПериода = ДанныеПериода.rows[0];
			Результат.first_entry = Получить(СтрокаПериода, "first_entry", Null);
			Результат.last_entry = Получить(СтрокаПериода, "last_entry", Null);
			Результат.total_entries = Получить(СтрокаПериода, "total_entries", Null);
		КонецЕсли;
	Исключение
		Результат.Вставить("period_error", ОписаниеОшибки());
	КонецПопытки;

	Если IncludeOrganizations Тогда
		СтруктураРегистра = СтруктураМетаданныхДляПаспорта(ПолноеИмяРегистра);
		ПолеОрганизации = НайтиПолеОрганизацииВСтруктуре(СтруктураРегистра);
		ПолеОрганизацииИзМетаданных = НЕ ПустаяСтрока(ПолеОрганизации);
		Если ПустаяСтрока(ПолеОрганизации) Тогда
			ПолеОрганизации = "Организация";
		КонецЕсли;
		КоличествоОрганизаций = ДобавитьОрганизацииИзРегистраСПолем(
			ПолноеИмяРегистра, ПолеОрганизации, OrganizationLimit, Organizations, OrganizationKeys,
			Warnings, ПолеОрганизацииИзМетаданных);
		Если КоличествоОрганизаций > 0 Тогда
			Результат.has_organization_field = Истина;
			Результат.Вставить("organization_source_field", ПолеОрганизации);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПаспортРегистраНакопления(ПолноеИмяРегистра)

	Результат = Новый Структура;
	Результат.Вставить("register", ПолноеИмяРегистра);
	Результат.Вставить("name", ПоследнийСегментПолногоИмени(ПолноеИмяРегистра));
	Результат.Вставить("has_data", Ложь);

	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмяРегистра) Тогда
		Результат.Вставить("error", "unsafe_metadata_name");
		Возврат Результат;
	КонецЕсли;

	Попытка
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК ЕстьДанные" + Символы.ПС
			+ МаркерИсключенияОсновнойТаблицыРегистра(
				"проверяется наличие хотя бы одной записи регистра любого вида одной пробой: "
				+ "виртуальные таблицы у разных видов регистров разные, у расчёта могут отсутствовать")
			+ "ИЗ " + ПолноеИмяРегистра + " КАК Регистр";
		Данные = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Новый Структура, 1,
			MCP_Config.Лимиты().query_timeout_seconds, "");
		Результат.has_data = Данные.rows.Количество() > 0;
	Исключение
		Результат.Вставить("error", ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

Процедура ДобавитьПаспортРегистровДанных(Результат, ВидМетаданных, ИмяПоля, Лимит,
	IncludeEmptyRegisters, IncludeOrganizations, Organizations, OrganizationKeys, Warnings)

	СписокРегистров = ДоступныеОбъектыМетаданныхПоВиду(ВидМетаданных);
	Detail = Новый Массив;
	WithData = Новый Массив;
	Empty = Новый Массив;
	Checked = 0;
	Для Каждого Рег Из СписокРегистров Цикл
		Если Checked >= Лимит Тогда
			Warnings.Добавить("Список " + ВидМетаданных + " усечён limit=" + Лимит + ".");
			Прервать;
		КонецЕсли;
		Checked = Checked + 1;
		Сводка = ПаспортУниверсальногоРегистра(Рег.full_name, IncludeOrganizations,
			Organizations, OrganizationKeys, Warnings);
		Если Сводка.has_data Тогда
			WithData.Добавить(Рег.name);
		Иначе
			Empty.Добавить(Рег.name);
		КонецЕсли;
		Если IncludeEmptyRegisters ИЛИ Сводка.has_data Тогда
			Detail.Добавить(Сводка);
		КонецЕсли;
	КонецЦикла;

	Short = Новый Структура;
	Short.Вставить("cache_hit", Ложь);
	Short.Вставить("cache_age_seconds", 0);
	Short.Вставить("checked", Checked);
	Short.Вставить("with_data", WithData);
	Short.Вставить("empty", Empty);
	Результат.Вставить(ИмяПоля, Short);
	Результат.Вставить(ИмяПоля + "_detail", Detail);

КонецПроцедуры

Функция ПаспортУниверсальногоРегистра(ПолноеИмяРегистра, IncludeOrganizations, Organizations, OrganizationKeys, Warnings)

	Результат = Новый Структура;
	Результат.Вставить("register", ПолноеИмяРегистра);
	Результат.Вставить("name", ПоследнийСегментПолногоИмени(ПолноеИмяРегистра));
	Результат.Вставить("has_data", Ложь);
	Результат.Вставить("first_entry", Null);
	Результат.Вставить("last_entry", Null);
	Результат.Вставить("total_entries", Null);

	Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмяРегистра) Тогда
		Результат.Вставить("error", "unsafe_metadata_name");
		Возврат Результат;
	КонецЕсли;

	СтруктураРегистра = СтруктураМетаданныхДляПаспорта(ПолноеИмяРегистра);
	ИмеетПериод = СтруктураСодержитПоле(СтруктураРегистра, "Период");
	ПолеОрганизации = НайтиПолеОрганизацииВСтруктуре(СтруктураРегистра);
	ИмеетОрганизацию = НЕ ПустаяСтрока(ПолеОрганизации);
	Результат.Вставить("has_period_field", ИмеетПериод);
	Результат.Вставить("has_organization_field", ИмеетОрганизацию);
	Если ИмеетОрганизацию Тогда
		Результат.Вставить("organization_source_field", ПолеОрганизации);
	КонецЕсли;

	Попытка
		ТекстЕстьДанные = "ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК ЕстьДанные" + Символы.ПС
			+ МаркерИсключенияОсновнойТаблицыРегистра(
				"проверяется наличие хотя бы одной записи регистра любого вида одной пробой: "
				+ "виртуальные таблицы у разных видов регистров разные, у расчёта могут отсутствовать")
			+ "ИЗ " + ПолноеИмяРегистра + " КАК Регистр";
		ДанныеЕсть = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЕстьДанные, Новый Структура, 1,
			MCP_Config.Лимиты().query_timeout_seconds, "");
		Результат.has_data = ДанныеЕсть.rows.Количество() > 0;
	Исключение
		Результат.Вставить("has_data_error", ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Если ИмеетПериод Тогда
		Попытка
			ТекстПериода = "ВЫБРАТЬ МИНИМУМ(Регистр.Период) КАК first_entry, "
				+ "МАКСИМУМ(Регистр.Период) КАК last_entry, "
				+ "КОЛИЧЕСТВО(*) КАК total_entries" + Символы.ПС
				+ МаркерИсключенияОсновнойТаблицыРегистра(
					"нужно точное число записей регистра любого вида: набор виртуальных таблиц "
					+ "различается по видам регистров, у сведений и расчёта таблицы движений нет вовсе")
				+ "ИЗ " + ПолноеИмяРегистра + " КАК Регистр";
			ДанныеПериода = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстПериода, Новый Структура, 1,
				MCP_Config.Лимиты().query_timeout_seconds, "");
			Если ДанныеПериода.rows.Количество() > 0 Тогда
				СтрокаПериода = ДанныеПериода.rows[0];
				Результат.first_entry = Получить(СтрокаПериода, "first_entry", Null);
				Результат.last_entry = Получить(СтрокаПериода, "last_entry", Null);
				Результат.total_entries = Получить(СтрокаПериода, "total_entries", Null);
			КонецЕсли;
		Исключение
			Результат.Вставить("period_error", ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Если IncludeOrganizations И ИмеетОрганизацию Тогда
		ДобавитьОрганизацииИзРегистра(ПолноеИмяРегистра, ПолеОрганизации, Organizations, OrganizationKeys, Warnings);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ДобавитьОрганизацииИзРегистра(ПолноеИмяРегистра, ПолеОрганизации, Organizations, OrganizationKeys, Warnings)

	ДобавитьОрганизацииИзРегистраСПолем(ПолноеИмяРегистра, ПолеОрганизации, 50,
		Organizations, OrganizationKeys, Warnings, Истина);

КонецПроцедуры

Функция ДобавитьОрганизацииИзРегистраСПолем(ПолноеИмяРегистра, ПолеОрганизации, Лимит,
	Organizations, OrganizationKeys, Warnings, ДобавлятьПредупреждения = Истина)

	Если ПустаяСтрока(ПолеОрганизации)
		ИЛИ НЕ MCP_Security.ИмяБезопасноДляЗапроса(ПолеОрганизации) Тогда
		Возврат 0;
	КонецЕсли;

	КоличествоНайденных = 0;
	Попытка
		ТекстОрганизаций = "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ " + MCP_Query.ЦелоеДляТекстаЗапроса(Лимит) + " "
			+ "Регистр." + ПолеОрганизации + " КАК Организация, "
			+ "Регистр." + ПолеОрганизации + ".Наименование КАК Наименование, "
			+ "Регистр." + ПолеОрганизации + ".ИНН КАК ИНН, "
			+ "Регистр." + ПолеОрганизации + ".КПП КАК КПП, "
			+ "УникальныйИдентификатор(Регистр." + ПолеОрганизации + ") КАК UUID "
			+ "ИЗ " + ПолноеИмяРегистра + " КАК Регистр "
			+ "УПОРЯДОЧИТЬ ПО Наименование";
		ДанныеОрганизаций = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстОрганизаций, Новый Структура,
			Лимит, MCP_Config.Лимиты().query_timeout_seconds, "");
		КоличествоНайденных = ДобавитьСтрокиОрганизаций(
			ДанныеОрганизаций.rows, ПолноеИмяРегистра, ПолеОрганизации, Organizations, OrganizationKeys, Истина);
		Возврат КоличествоНайденных;
	Исключение
		ТекстПервойОшибки = ОписаниеОшибки();
	КонецПопытки;

	Попытка
		ТекстОрганизаций = "ВЫБРАТЬ ПЕРВЫЕ " + MCP_Query.ЦелоеДляТекстаЗапроса(Лимит) + " "
			+ "Регистр." + ПолеОрганизации + " КАК Организация, "
			+ "УникальныйИдентификатор(Регистр." + ПолеОрганизации + ") КАК UUID "
			+ "ИЗ " + ПолноеИмяРегистра + " КАК Регистр "
			+ "СГРУППИРОВАТЬ ПО Регистр." + ПолеОрганизации
			+ ", УникальныйИдентификатор(Регистр." + ПолеОрганизации + ")";
		ДанныеОрганизаций = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстОрганизаций, Новый Структура,
			Лимит, MCP_Config.Лимиты().query_timeout_seconds, "");
		КоличествоНайденных = ДобавитьСтрокиОрганизаций(
			ДанныеОрганизаций.rows, ПолноеИмяРегистра, ПолеОрганизации, Organizations, OrganizationKeys, Ложь);
		Если КоличествоНайденных > 0 И ДобавлятьПредупреждения Тогда
			Warnings.Добавить("Организации из " + ПолноеИмяРегистра + " возвращены без ИНН/КПП: " + ТекстПервойОшибки);
		КонецЕсли;
		Возврат КоличествоНайденных;
	Исключение
		Если ДобавлятьПредупреждения Тогда
			Warnings.Добавить("Не удалось получить организации из " + ПолноеИмяРегистра + ": "
				+ ТекстПервойОшибки + "; fallback: " + ОписаниеОшибки());
		КонецЕсли;
	КонецПопытки;

	Возврат 0;

КонецФункции

Функция ДобавитьСтрокиОрганизаций(СтрокиОрганизаций, ПолноеИмяРегистра, ПолеОрганизации,
	Organizations, OrganizationKeys, IncludeDetails)

	КоличествоНайденных = 0;
	Для Каждого СтрокаОрганизации Из СтрокиОрганизаций Цикл
		Организация = Получить(СтрокаОрганизации, "Организация", Null);
		Ключ = КлючКодированногоЗначения(Организация);
		Если ПустаяСтрока(Ключ) Тогда
			Ключ = Строка(Организация);
		КонецЕсли;
		Если НЕ ПустаяСтрока(Ключ) Тогда
			КоличествоНайденных = КоличествоНайденных + 1;
		КонецЕсли;
		Если НЕ ПустаяСтрока(Ключ) И OrganizationKeys.Получить(Ключ) = Неопределено Тогда
			ЗаписьОрганизации = Новый Структура;
			ЗаписьОрганизации.Вставить("name", Получить(СтрокаОрганизации, "Наименование",
				Получить(Организация, "presentation", Строка(Организация))));
			ЗаписьОрганизации.Вставить("inn", ?(IncludeDetails, Получить(СтрокаОрганизации, "ИНН", Null), Null));
			ЗаписьОрганизации.Вставить("kpp", ?(IncludeDetails, Получить(СтрокаОрганизации, "КПП", Null), Null));
			ЗаписьОрганизации.Вставить("uuid", Получить(СтрокаОрганизации, "UUID", Получить(Организация, "uuid", Null)));
			ЗаписьОрганизации.Вставить("type", Получить(Организация, "type", Null));
			ЗаписьОрганизации.Вставить("ref", Организация);
			ЗаписьОрганизации.Вставить("source_register", ПолноеИмяРегистра);
			ЗаписьОрганизации.Вставить("source_field", ПолеОрганизации);
			Organizations.Добавить(ЗаписьОрганизации);
			OrganizationKeys.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат КоличествоНайденных;

КонецФункции

Функция ЗакрытыеПериоды(Лимит, Warnings)

	Результат = Новый Массив;
	Кандидаты = КандидатыРегистровДатЗапрета();
	Если Кандидаты.Количество() = 0 Тогда
		Warnings.Добавить("Регистры сведений, похожие на даты запрета изменения, не найдены или запрещены allowlist; closed_periods возвращён пустым.");
		Возврат Результат;
	КонецЕсли;

	Для Каждого Рег Из Кандидаты Цикл
		ПолноеИмяРегистра = Рег.full_name;
		Если НЕ MCP_Security.ПолноеИмяБезопасноДляЗапроса(ПолноеИмяРегистра) Тогда
			Продолжить;
		КонецЕсли;

		СтруктураРегистра = СтруктураМетаданныхДляПаспорта(ПолноеИмяРегистра);
		ПолеДата = НайтиПолеПоКлючам(СтруктураРегистра, "ДатаЗапрета,ДатаЗапретаИзменения,Период");
		Если ПустаяСтрока(ПолеДата) Тогда
			Warnings.Добавить("Пропущен " + ПолноеИмяРегистра + ": не найдено поле даты запрета.");
			Продолжить;
		КонецЕсли;

		ПолеОбъект = НайтиПолеПоКлючам(СтруктураРегистра, "Объект,РазделОбъект,Значение");
		ПолеРаздел = НайтиПолеПоКлючам(СтруктураРегистра, "Раздел,ОбластьДанных,Секция");
		ПолеПользователь = НайтиПолеПоКлючам(СтруктураРегистра, "Пользователь,ГруппаПользователей");
		ПолеОписание = НайтиПолеПоКлючам(СтруктураРегистра, "ОписаниеДатыЗапрета,Описание,Комментарий");

		Поля = Новый Массив;
		Поля.Добавить("ДатыЗапрета." + ПолеДата + " КАК ДатаЗапрета");
		Если НЕ ПустаяСтрока(ПолеОбъект) Тогда
			Поля.Добавить("ДатыЗапрета." + ПолеОбъект + " КАК Объект");
		КонецЕсли;
		Если НЕ ПустаяСтрока(ПолеРаздел) Тогда
			Поля.Добавить("ДатыЗапрета." + ПолеРаздел + " КАК Раздел");
		КонецЕсли;
		Если НЕ ПустаяСтрока(ПолеПользователь) Тогда
			Поля.Добавить("ДатыЗапрета." + ПолеПользователь + " КАК Пользователь");
		КонецЕсли;
		Если НЕ ПустаяСтрока(ПолеОписание) Тогда
			Поля.Добавить("ДатыЗапрета." + ПолеОписание + " КАК Описание");
		КонецЕсли;

		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + MCP_Query.ЦелоеДляТекстаЗапроса(Лимит) + " "
			+ СтрСоединить(Поля, ", ")
			+ " ИЗ " + ПолноеИмяРегистра + " КАК ДатыЗапрета";
		Попытка
			Данные = MCP_Query.ВыполнитьЗапросСОграничениями(ТекстЗапроса, Новый Структура, Лимит,
				MCP_Config.Лимиты().query_timeout_seconds, "");
		Исключение
			Warnings.Добавить("Не удалось прочитать " + ПолноеИмяРегистра + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Для Каждого СтрокаПериода Из Данные.rows Цикл
			Объект = Получить(СтрокаПериода, "Объект", Null);
			Запись = Новый Структура;
			Запись.Вставить("source_register", ПолноеИмяРегистра);
			Запись.Вставить("closed_until", Получить(СтрокаПериода, "ДатаЗапрета", Null));
			Запись.Вставить("description", Получить(СтрокаПериода, "Описание", Null));
			Запись.Вставить("division", Получить(СтрокаПериода, "Раздел", Null));
			Запись.Вставить("user", Получить(СтрокаПериода, "Пользователь", Null));
			Запись.Вставить("target", Объект);
			Запись.Вставить("target_type", Получить(Объект, "type", Null));
			Запись.Вставить("target_uuid", Получить(Объект, "uuid", Null));
			ТипОбъекта = Получить(Объект, "type", "");
			Если СтрНайти(ВРег(ТипОбъекта), "ОРГАНИЗАЦ") > 0 Тогда
				Запись.Вставить("organization", Получить(Объект, "presentation", Строка(Объект)));
				Запись.Вставить("organization_uuid", Получить(Объект, "uuid", Null));
			ИначеЕсли Объект <> Null И Объект <> Неопределено Тогда
				Запись.Вставить("section", Получить(Объект, "presentation", Строка(Объект)));
				Запись.Вставить("section_uuid", Получить(Объект, "uuid", Null));
			КонецЕсли;
			Результат.Добавить(Запись);
		КонецЦикла;

		Если Результат.Количество() > 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьПаспортБазыИзКэша(Ключ, ForceRefresh = Ложь)

	// В универсальной поставке не держим состояние в шапке общего модуля:
	// такие переменные ломают компиляцию расширения в некоторых базах.
	Возврат Неопределено;

КонецФункции

Процедура СохранитьПаспортБазыВКэш(Ключ, Значение)

	Значение.Вставить("cache_hit", Ложь);
	Значение.Вставить("cache_age_seconds", 0);
	// no-op: кэш паспорта разрешён только при наличии безопасного внешнего
	// сессионного хранилища, которого универсальная поставка не требует.

КонецПроцедуры

Процедура СкопироватьКэшируемыйРазделПаспорта(Источник, Приемник, ИмяРаздела)

	Кратко = Получить(Источник, ИмяРаздела, Неопределено);
	Детали = Получить(Источник, ИмяРаздела + "_detail", Неопределено);
	Если Кратко = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Приемник.Вставить(ИмяРаздела, Кратко);
	Если Детали <> Неопределено Тогда
		Приемник.Вставить(ИмяРаздела + "_detail", Детали);
	КонецЕсли;
	Если ИмяРаздела = "accumulation_registers" Тогда
		Checked = Получить(Источник, "accumulation_registers_checked", Неопределено);
		Если Checked <> Неопределено Тогда
			Приемник.Вставить("accumulation_registers_checked", Checked);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ДобавитьРазделРегистровИзКэша(Результат, КэшРегистров, ИмяРаздела)

	Если КэшРегистров = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Кратко = Получить(КэшРегистров, ИмяРаздела, Неопределено);
	Если Кратко = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возраст = Получить(КэшРегистров, "_cache_age_seconds", 0);
	Кратко.Вставить("cache_hit", Истина);
	Кратко.Вставить("cache_age_seconds", Возраст);
	Результат.Вставить(ИмяРаздела, Кратко);
	Детали = Получить(КэшРегистров, ИмяРаздела + "_detail", Неопределено);
	Если Детали <> Неопределено Тогда
		Результат.Вставить(ИмяРаздела + "_detail", Детали);
	КонецЕсли;
	Если ИмяРаздела = "accumulation_registers" Тогда
		Checked = Получить(КэшРегистров, "accumulation_registers_checked", Неопределено);
		Если Checked <> Неопределено Тогда
			Результат.Вставить("accumulation_registers_checked", Checked);
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;

КонецФункции

Функция ПоследнийСегментПолногоИмени(ПолноеИмя)

	Части = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат Части[Части.Количество() - 1];

КонецФункции

Функция СтруктураМетаданныхДляПаспорта(ПолноеИмя)

	Опции = MCP_Metadata.ОпцииСтруктурыПоУмолчанию();
	Опции.include_standard_attributes = Истина;
	Опции.include_attributes = Истина;
	Опции.include_tabular_sections = Ложь;
	Опции.include_virtual_tables = Ложь;
	Возврат MCP_Metadata.СтруктураОбъекта(ПолноеИмя, Опции);

КонецФункции

Функция НайтиПолеОрганизацииВСтруктуре(СтруктураОбъекта)

	Если СтруктураОбъекта = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	РегСхема = Получить(СтруктураОбъекта, "register_schema", Неопределено);
	Если РегСхема <> Неопределено Тогда
		Имя = НайтиПолеОрганизацииВКоллекции(РегСхема.dimensions);
		Если НЕ ПустаяСтрока(Имя) Тогда Возврат Имя; КонецЕсли;
		Имя = НайтиПолеОрганизацииВКоллекции(РегСхема.attributes);
		Если НЕ ПустаяСтрока(Имя) Тогда Возврат Имя; КонецЕсли;
	КонецЕсли;

	Имя = НайтиПолеОрганизацииВКоллекции(СтруктураОбъекта.attributes);
	Если НЕ ПустаяСтрока(Имя) Тогда Возврат Имя; КонецЕсли;
	Возврат НайтиПолеОрганизацииВКоллекции(СтруктураОбъекта.standard_attributes);

КонецФункции

Функция НайтиПолеОрганизацииВКоллекции(Коллекция)

	Если ТипЗнч(Коллекция) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;

	Кандидат = "";
	Для Каждого Реквизит Из Коллекция Цикл
		Имя = Получить(Реквизит, "name", "");
		Если ПустаяСтрока(Имя)
			ИЛИ НЕ MCP_Security.ИмяБезопасноДляЗапроса(Имя)
			ИЛИ НЕ Получить(Реквизит, "allowed", Истина)
			ИЛИ НЕ РеквизитСсылочногоТипа(Реквизит) Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(Имя) = "ОРГАНИЗАЦИЯ" Тогда
			Возврат Имя;
		КонецЕсли;
		Если ПустаяСтрока(Кандидат) И РеквизитПохожНаОрганизацию(Реквизит) Тогда
			Кандидат = Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат Кандидат;

КонецФункции

Функция РеквизитПохожНаОрганизацию(Реквизит)

	Имя = ВРег(Получить(Реквизит, "name", ""));
	Синоним = ВРег(Получить(Реквизит, "synonym", ""));
	Тип = ВРег(Получить(Реквизит, "type_description", ""));
	Возврат СтрНайти(Имя, "ОРГАНИЗАЦ") > 0
		ИЛИ СтрНайти(Синоним, "ОРГАНИЗАЦ") > 0
		ИЛИ СтрНайти(Тип, "СПРАВОЧНИКССЫЛКА.ОРГАНИЗАЦ") > 0;

КонецФункции

Функция РеквизитСсылочногоТипа(Реквизит)

	Тип = ВРег(Получить(Реквизит, "type_description", ""));
	Если СтрНайти(Тип, "ССЫЛКА") > 0
		ИЛИ СтрНайти(Тип, "REF") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	ТипыЗначений = Получить(Реквизит, "value_types", Неопределено);
	Если ТипЗнч(ТипыЗначений) = Тип("Массив") Тогда
		Для Каждого ТипЗначения Из ТипыЗначений Цикл
			ТекстТипа = ВРег(Строка(ТипЗначения));
			Если СтрНайти(ТекстТипа, "ССЫЛКА") > 0
				ИЛИ СтрНайти(ТекстТипа, "REF") > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция КандидатыРегистровДатЗапрета()

	Результат = Новый Массив;
	Регистры = ДоступныеОбъектыМетаданныхПоВиду("РегистрСведений");
	Для Каждого Рег Из Регистры Цикл
		Контекст = ВРег(Рег.name + " " + Получить(Рег, "synonym", ""));
		Если СтрНайти(Контекст, "ДАТ") > 0
			И СтрНайти(Контекст, "ЗАПРЕТ") > 0 Тогда
			Результат.Добавить(Рег);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НайтиПолеПоКлючам(СтруктураОбъекта, CSVКлючей)

	Если СтруктураОбъекта = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Ключи = СтрРазделить(CSVКлючей, ",", Ложь);
	РегСхема = Получить(СтруктураОбъекта, "register_schema", Неопределено);
	Если РегСхема <> Неопределено Тогда
		Имя = НайтиПолеВКоллекцииПоКлючам(РегСхема.dimensions, Ключи);
		Если НЕ ПустаяСтрока(Имя) Тогда Возврат Имя; КонецЕсли;
		Имя = НайтиПолеВКоллекцииПоКлючам(РегСхема.resources, Ключи);
		Если НЕ ПустаяСтрока(Имя) Тогда Возврат Имя; КонецЕсли;
		Имя = НайтиПолеВКоллекцииПоКлючам(РегСхема.attributes, Ключи);
		Если НЕ ПустаяСтрока(Имя) Тогда Возврат Имя; КонецЕсли;
	КонецЕсли;
	Имя = НайтиПолеВКоллекцииПоКлючам(СтруктураОбъекта.standard_attributes, Ключи);
	Если НЕ ПустаяСтрока(Имя) Тогда Возврат Имя; КонецЕсли;
	Возврат НайтиПолеВКоллекцииПоКлючам(СтруктураОбъекта.attributes, Ключи);

КонецФункции

Функция НайтиПолеВКоллекцииПоКлючам(Коллекция, Ключи)

	Если ТипЗнч(Коллекция) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Ключ Из Ключи Цикл
		Искомый = ВРег(СокрЛП(Ключ));
		Для Каждого Реквизит Из Коллекция Цикл
			Имя = Получить(Реквизит, "name", "");
			Если ПустаяСтрока(Имя)
				ИЛИ НЕ MCP_Security.ИмяБезопасноДляЗапроса(Имя)
				ИЛИ НЕ Получить(Реквизит, "allowed", Истина) Тогда
				Продолжить;
			КонецЕсли;
			Синоним = Получить(Реквизит, "synonym", "");
			Если ВРег(Имя) = Искомый
				ИЛИ СтрНайти(ВРег(Имя), Искомый) > 0
				ИЛИ СтрНайти(ВРег(Синоним), Искомый) > 0 Тогда
				Возврат Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция СтруктураСодержитПоле(СтруктураОбъекта, ИмяПоля)

	Если СтруктураОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если КоллекцияРеквизитовСодержитПоле(СтруктураОбъекта.standard_attributes, ИмяПоля) Тогда
		Возврат Истина;
	КонецЕсли;
	Если КоллекцияРеквизитовСодержитПоле(СтруктураОбъекта.attributes, ИмяПоля) Тогда
		Возврат Истина;
	КонецЕсли;
	РегСхема = Получить(СтруктураОбъекта, "register_schema", Неопределено);
	Если РегСхема <> Неопределено Тогда
		Если КоллекцияРеквизитовСодержитПоле(РегСхема.dimensions, ИмяПоля) Тогда
			Возврат Истина;
		КонецЕсли;
		Если КоллекцияРеквизитовСодержитПоле(РегСхема.resources, ИмяПоля) Тогда
			Возврат Истина;
		КонецЕсли;
		Если КоллекцияРеквизитовСодержитПоле(РегСхема.attributes, ИмяПоля) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция КоллекцияРеквизитовСодержитПоле(Коллекция, ИмяПоля)

	Если ТипЗнч(Коллекция) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Реквизит Из Коллекция Цикл
		Если ВРег(Получить(Реквизит, "name", "")) = ВРег(ИмяПоля)
			И Получить(Реквизит, "allowed", Истина) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция КлючКодированногоЗначения(Значение)

	Если Значение = Null ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТипЗначения = Получить(Значение, "type", "");
	UUID = Получить(Значение, "uuid", "");
	Если НЕ ПустаяСтрока(ТипЗначения) И НЕ ПустаяСтрока(UUID) Тогда
		Возврат Строка(ТипЗначения) + "|" + Строка(UUID);
	КонецЕсли;
	Возврат Строка(Значение);

