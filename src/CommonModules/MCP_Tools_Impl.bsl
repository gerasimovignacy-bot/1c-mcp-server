Функция ВыбратьБухгалтерскийРегистр(Знач ИмяРегистра)

	Если НЕ ПустаяСтрока(ИмяРегистра) Тогда
		Если СтрНайти(ИмяРегистра, ".") = 0 Тогда
			ИмяРегистра = "РегистрБухгалтерии." + ИмяРегистра;
		КонецЕсли;
		Если НЕ MCP_Security.ТипРазрешен(ИмяРегистра) Тогда
			MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_TypeNotAllowed(), "Бухгалтерский регистр запрещён: " + ИмяРегистра);
		КонецЕсли;
		Возврат ИмяРегистра;
	КонецЕсли;

	Кандидаты = ДоступныеОбъектыМетаданныхПоВиду("РегистрБухгалтерии");
	Если Кандидаты.Количество() = 0 Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_MetadataNotFound(), "В доступных метаданных нет РегистрБухгалтерии.*.");
	КонецЕсли;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ВРег(Кандидат.full_name) = "РЕГИСТРБУХГАЛТЕРИИ.ХОЗРАСЧЕТНЫЙ" Тогда
			Возврат Кандидат.full_name;
		КонецЕсли;
	КонецЦикла;
	Если Кандидаты.Количество() = 1 Тогда
		Возврат Кандидаты[0].full_name;
	КонецЕсли;
	MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
		"Найдено несколько бухгалтерских регистров; укажите accounting_register явно.");

КонецФункции

