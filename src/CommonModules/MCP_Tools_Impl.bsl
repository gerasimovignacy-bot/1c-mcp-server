	// Сервер не валидирует аргументы по inputSchema — диапазоны проверяем явно.
	ПроверитьДиапазонЦелогоАргумента(Аргументы, "limit", 1, 20);
	ПроверитьДиапазонЦелогоАргумента(Аргументы, "days_back", 1, 365);

	ОбъектИмя = СокрЛП(Строка(Получить(Аргументы, "object", "")));
