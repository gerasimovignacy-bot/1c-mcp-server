		ИЛИ СтрНайти(Текст, "БАЛАНС") > 0
		ИЛИ СтрНайти(Текст, "REPORT") > 0
		ИЛИ СтрНайти(Текст, "ANALYSIS") > 0
		ИЛИ СтрНайти(Текст, "TURNOVER") > 0
		ИЛИ СтрНайти(Текст, "BALANCE") > 0
		ИЛИ СтрНайти(Текст, "STATEMENT") > 0;

КонецФункции

Процедура ДобавитьПодсказкуВыбораОтчетаИлиЗапроса(Результат, ТекстКонтекста)

	Если ПустаяСтрока(ТекстКонтекста) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ТекстПохожНаОтчетнуюАналитику(ТекстКонтекста) Тогда
		Возврат;
	КонецЕсли;

	СписокОтчетов = Неопределено;
	Если НЕ Результат.Свойство("reports", СписокОтчетов) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(СписокОтчетов) <> Тип("Массив") И ТипЗнч(СписокОтчетов) <> Тип("ФиксированныйМассив") Тогда
		Возврат;
	КонецЕсли;
	Если СписокОтчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СуществующаяПодсказка = Неопределено;
	Если Результат.Свойство("interaction_hint", СуществующаяПодсказка) Тогда
		Возврат;
	КонецЕсли;

	Кандидаты = Новый Массив;
	Для Индекс = 0 По Мин(СписокОтчетов.Количество(), 5) - 1 Цикл
		ОтчетКандидат = СписокОтчетов[Индекс];
		Кандидат = Новый Структура;
		Кандидат.Вставить("report", Получить(ОтчетКандидат, "type", ""));
		Кандидат.Вставить("name", Получить(ОтчетКандидат, "name", ""));
		Кандидат.Вставить("synonym", Получить(ОтчетКандидат, "synonym", ""));
		Кандидат.Вставить("execution_supported", Получить(ОтчетКандидат, "execution_supported", Неопределено));
		Варианты = Неопределено;
		Если ОтчетКандидат.Свойство("variants", Варианты) Тогда
			Кандидат.Вставить("variants", Варианты);
		КонецЕсли;
		Кандидаты.Добавить(Кандидат);
	КонецЦикла;

	Опции = Новый Массив;
	ОпцияОтчет = Новый Структура;
	ОпцияОтчет.Вставить("id", "use_report");
	ОпцияОтчет.Вставить("label", "Использовать готовый отчет");
	ОпцияОтчет.Вставить("tool_path", "get_report_info -> run_1c_report");
	Опции.Добавить(ОпцияОтчет);
	ОпцияЗапрос = Новый Структура;
	ОпцияЗапрос.Вставить("id", "direct_query");
	ОпцияЗапрос.Вставить("label", "Выполнить прямой read-only запрос");
	ОпцияЗапрос.Вставить("tool_path", "validate_1c_query -> run_1c_query");
	Опции.Добавить(ОпцияЗапрос);

	Подсказка = Новый Структура;
	Подсказка.Вставить("id", "report_or_direct_query_choice");
	Подсказка.Вставить("question", "Я нашел в базе готовый отчет, похожий на задачу. Использовать его или выполнить прямой read-only запрос к данным?");
	Подсказка.Вставить("instruction",
		"Покажите пользователю 1-3 наиболее релевантных кандидата из candidate_reports и спросите выбор, если пользователь заранее не просил именно прямой запрос.");
	Подсказка.Вставить("candidate_reports", Кандидаты);
	Подсказка.Вставить("options", Опции);
	Подсказка.Вставить("blocking", Ложь);
	Результат.Вставить("interaction_hint", Подсказка);

КонецПроцедуры

Функция ПодготовитьПодстановку(Знач Текст, Знач MatchMode)

	Текст = СокрЛП(Текст);
	Если MatchMode = "exact" Тогда
		Возврат Текст;
	ИначеЕсли MatchMode = "prefix" Тогда
		Возврат Текст + "%";
	ИначеЕсли MatchMode = "contains" ИЛИ MatchMode = "auto" Тогда
		Возврат "%" + Текст + "%";
	КонецЕсли;
	Возврат "%" + Текст + "%";

КонецФункции

Функция СформироватьЦелевыеТипы(Типы, Виды)

	Результат = Новый Массив;
	Если ТипЗнч(Типы) = Тип("Массив") И Типы.Количество() > 0 Тогда
		Для Каждого Т Из Типы Цикл
			Если MCP_Security.ТипРазрешен(Т) Тогда
				Результат.Добавить(Т);
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
	Для Каждого Стр Из Все Цикл
		Если НЕ Стр.SupportsRef ИЛИ НЕ MCP_Security.ТипРазрешен(Стр.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Если Стр.Вид = "Перечисление" Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Виды) = Тип("Массив") И Виды.Количество() > 0 Тогда
			Найден = Ложь;
			Для Каждого В Из Виды Цикл
				Если ВРег(В) = ВРег(Стр.Вид) Тогда Найден = Истина; Прервать; КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда Продолжить; КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Стр.ПолноеИмя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтраницаСекцииМетаданных(СтруктураМетаданных, Section, Лимит, Курсор)

	Смещение = ЦелоеИзСтроки(Курсор, 0);
	Если Смещение < 0 Тогда Смещение = 0; КонецЕсли;

	ДанныеСекции = Новый Массив;
	Если Section = "attributes" Тогда
		ДанныеСекции = Получить(СтруктураМетаданных, "attributes", Новый Массив);
	ИначеЕсли Section = "standard_attributes" Тогда
		ДанныеСекции = Получить(СтруктураМетаданных, "standard_attributes", Новый Массив);
	ИначеЕсли Section = "tabular_sections" Тогда
		ДанныеСекции = Получить(СтруктураМетаданных, "tabular_sections", Новый Массив);
	ИначеЕсли Section = "register_schema" Тогда
		РегСхема = Получить(СтруктураМетаданных, "register_schema", Неопределено);
		Если РегСхема <> Неопределено Тогда
			ДанныеСекции.Добавить(РегСхема);
		КонецЕсли;
	ИначеЕсли Section = "virtual_tables" Тогда
		РегСхема = Получить(СтруктураМетаданных, "register_schema", Неопределено);
		Если РегСхема <> Неопределено Тогда
			ДанныеСекции = Получить(РегСхема, "virtual_tables", Новый Массив);
		КонецЕсли;
	Иначе
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(), "Некорректная section: " + Section);
	КонецЕсли;

	Страница = СтраницаМассива(ДанныеСекции, Смещение, Лимит);
	Meta = Новый Структура;
	Meta.Вставить("kind", СтруктураМетаданных.kind);
	Meta.Вставить("name", СтруктураМетаданных.name);
	Meta.Вставить("full_name", СтруктураМетаданных.full_name);
	Meta.Вставить("synonym", СтруктураМетаданных.synonym);

	Результат = Новый Структура;
	Результат.Вставить("metadata", Meta);
	Результат.Вставить("section", Section);
	Результат.Вставить("items", Страница.items);
	Результат.Вставить("item_count", Страница.items.Количество());
	Результат.Вставить("truncated", Страница.truncated);
	Результат.Вставить("next_cursor", Страница.next_cursor);
	Результат.Вставить("total_estimated", ДанныеСекции.Количество());
	Возврат Результат;

КонецФункции

Функция СтраницаМассива(Коллекция, Смещение, Лимит)

	Items = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Коллекция = Новый Массив;
	КонецЕсли;
	Конец = Мин(Смещение + Лимит, Коллекция.Количество());
	Если Смещение < Коллекция.Количество() Тогда
		Для Индекс = Смещение По Конец - 1 Цикл
			Items.Добавить(Коллекция[Индекс]);
		КонецЦикла;
	КонецЕсли;
	NextCursor = Null;
	Если Конец < Коллекция.Количество() Тогда
		NextCursor = Строка(Конец);
	КонецЕсли;
	Возврат Новый Структура("items, truncated, next_cursor", Items, NextCursor <> Null, NextCursor);

КонецФункции

Процедура ПагинироватьПолеМассива(Результат, ИмяПоля, ИмяПейджинга, Смещение, Лимит)

	Значение = Неопределено;
	Если НЕ Результат.Свойство(ИмяПоля, Значение) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") И ТипЗнч(Значение) <> Тип("ФиксированныйМассив") Тогда
		Возврат;
	КонецЕсли;
	Страница = СтраницаМассива(Значение, Смещение, Лимит);
	Результат.Вставить(ИмяПоля, Страница.items);
	Пейджинг = Новый Структура;
	Пейджинг.Вставить("truncated", Страница.truncated);
	Пейджинг.Вставить("next_cursor", Страница.next_cursor);
	Пейджинг.Вставить("total_estimated", Значение.Количество());
	Результат.Вставить(ИмяПейджинга, Пейджинг);

КонецПроцедуры

Процедура УдалитьПолеЕслиЕсть(СтруктураЗначений, ИмяПоля)

	Попытка
		Если СтруктураЗначений.Свойство(ИмяПоля) Тогда
			СтруктураЗначений.Удалить(ИмяПоля);
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура УпроститьКолонки(Результат)

	Колонки = Неопределено;
	Если НЕ Результат.Свойство("columns", Колонки) Тогда
		Возврат;
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) = Тип("Структура") И Колонка.Свойство("name") Тогда
			Имена.Добавить(Колонка.name);
		Иначе
			Имена.Добавить(Колонка);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("columns", Имена);

КонецПроцедуры

Процедура СвернутьДвиженияДокументаДоСводки(Результат)

	Movements = Неопределено;
	Если НЕ Результат.Свойство("movements", Movements) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Movement Из Movements Цикл
		УдалитьПолеЕслиЕсть(Movement, "rows");
	КонецЦикла;

КонецПроцедуры

Процедура ОставитьТолькоКолонки(Результат, ИменаКолонок)

	Если ИменаКолонок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Колонки = Неопределено;
	Если Результат.Свойство("columns", Колонки) Тогда
		НовыеКолонки = Новый Массив;
		Для Каждого Колонка Из Колонки Цикл
			Если ТипЗнч(Колонка) = Тип("Структура") И Колонка.Свойство("name") Тогда
				ИмяКолонки = Колонка.name;
			Иначе
				ИмяКолонки = Строка(Колонка);
			КонецЕсли;
			Если МассивСодержитСтрокуБезРегистра(ИменаКолонок, ИмяКолонки) Тогда
				НовыеКолонки.Добавить(Колонка);
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить("columns", НовыеКолонки);
	КонецЕсли;

	Rows = Неопределено;
	Если НЕ Результат.Свойство("rows", Rows) Тогда
		Возврат;
	КонецЕсли;
	НовыеСтроки = Новый Массив;
	Для Каждого Row Из Rows Цикл
		НоваяСтрока = Новый Структура;
		Для Каждого ИмяКолонки Из ИменаКолонок Цикл
			Значение = Неопределено;
			Попытка
				Если Row.Свойство(ИмяКолонки, Значение) Тогда
					НоваяСтрока.Вставить(ИмяКолонки, Значение);
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
		НовыеСтроки.Добавить(НоваяСтрока);
	КонецЦикла;
	Результат.Вставить("rows", НовыеСтроки);

КонецПроцедуры

Функция МассивСодержитСтрокуБезРегистра(МассивСтрок, Значение)

	Для Каждого Элемент Из МассивСтрок Цикл
		Если ВРег(Строка(Элемент)) = ВРег(Строка(Значение)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПолучитьВсеПодпискиНаСобытия()

	Результат = Новый Массив;
	Попытка
		Коллекция = Метаданные.ПодпискиНаСобытия;
	Исключение
		Возврат Результат;
	КонецПопытки;

	Для Каждого ПодпискаМД Из Коллекция Цикл
		Подписка = КодироватьПодпискуНаСобытие(ПодпискаМД);
		Если ПодпискаРазрешенаПоИсточнику(Подписка) Тогда
			Результат.Добавить(Подписка);
		КонецЕсли;
	КонецЦикла;

	Возврат ОтсортированныеПодпискиНаСобытия(Результат);

КонецФункции

Функция КодироватьПодпискуНаСобытие(ПодпискаМД)

	Источник = ИсточникПодпискиНаСобытие(ПодпискаМД);
	SourceFullName = ПолноеИмяИсточникаПодпискиНаСобытие(Источник);
	SourceName = ИмяИсточникаПодпискиНаСобытие(Источник);
	SourceText = СтрокаИсточникаПодпискиНаСобытие(Источник);
	Handler = СтроковоеСвойствоПодпискиНаСобытие(ПодпискаМД, "Обработчик");

	Подписка = Новый Структура;
	Подписка.Вставить("name", СтроковоеСвойствоПодпискиНаСобытие(ПодпискаМД, "Имя"));
	Подписка.Вставить("synonym", СтроковоеСвойствоПодпискиНаСобытие(ПодпискаМД, "Синоним"));
	Подписка.Вставить("comment", СтроковоеСвойствоПодпискиНаСобытие(ПодпискаМД, "Комментарий"));
	Подписка.Вставить("event", СтроковоеСвойствоПодпискиНаСобытие(ПодпискаМД, "Событие"));
	Подписка.Вставить("handler", Handler);
	Подписка.Вставить("handler_module", МодульИзОбработчикаПодписки(Handler));
	Подписка.Вставить("handler_routine", ПроцедураИзОбработчикаПодписки(Handler));
	Подписка.Вставить("source", ?(ПустаяСтрока(SourceFullName), SourceText, SourceFullName));
	Подписка.Вставить("source_name", SourceName);
	Подписка.Вставить("source_full_name", SourceFullName);
	Возврат Подписка;

КонецФункции

Функция СтроковоеСвойствоПодпискиНаСобытие(ПодпискаМД, ИмяСвойства)

	Значение = Неопределено;
	Попытка
		Если ИмяСвойства = "Имя" Тогда
			Значение = ПодпискаМД.Имя;
		ИначеЕсли ИмяСвойства = "Синоним" Тогда
			Значение = ПодпискаМД.Синоним;
		ИначеЕсли ИмяСвойства = "Комментарий" Тогда
			Значение = ПодпискаМД.Комментарий;
		ИначеЕсли ИмяСвойства = "Событие" Тогда
			Значение = ПодпискаМД.Событие;
		ИначеЕсли ИмяСвойства = "Обработчик" Тогда
			Значение = ПодпискаМД.Обработчик;
		Иначе
			Возврат "";
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ИсточникПодпискиНаСобытие(ПодпискаМД)

	Попытка
		Возврат ПодпискаМД.Источник;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПолноеИмяИсточникаПодпискиНаСобытие(Источник)

	Если Источник = Неопределено ИЛИ Источник = Null Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат СокрЛП(Источник.ПолноеИмя());
	Исключение
	КонецПопытки;
	Попытка
		Возврат СокрЛП(Источник.ПолноеИмя);
	Исключение
	КонецПопытки;
	Возврат "";

