Функция ПодпискаРазрешенаПоИсточнику(Подписка)

	SourceFullName = Получить(Подписка, "source_full_name", "");
	Если ПустаяСтрока(SourceFullName) ИЛИ СтрНайти(SourceFullName, ".") = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат MCP_Security.ТипРазрешен(SourceFullName);

