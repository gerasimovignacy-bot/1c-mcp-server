Процедура ПроверитьДиапазонЦелогоАргумента(Аргументы, Знач ИмяПоля, Знач Мин, Знач Макс)
	Значение = Получить(Аргументы, ИмяПоля, Неопределено);
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ц = 0;
	Знч = 0;
	Попытка
		Знч = Число(Значение);
		Ц = Цел(Знч);
	Исключение
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Аргумент " + ИмяПоля + " должен быть целым числом.");
	КонецПопытки;
	Если Ц <> Знч ИЛИ Ц < Мин ИЛИ Ц > Макс Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Аргумент " + ИмяПоля + " вне диапазона [" + Мин + ".." + Макс + "].");
	КонецЕсли;
КонецПроцедуры

// ----------------------------------------------------------------------
// 20. get_current_user_context
// ----------------------------------------------------------------------
Функция GetCurrentUserContext(Аргументы) Экспорт

	Аргументы = НормализоватьСтруктуру(Аргументы);
	IncludeRoles = Получить(Аргументы, "include_roles", Ложь);
	IncludeLimits = Получить(Аргументы, "include_limits", Ложь);
	IncludeSummary = Получить(Аргументы, "include_allowed_metadata_summary", Ложь);
	IncludeServer = Получить(Аргументы, "include_server_info", Ложь);

	Результат = Новый Структура;
	Результат.Вставить("auth_context", КонтекстАвторизацииТекущегоПользователя());

	// Пользователь. Форма ответа должна быть одинаковой и в норме, и в catch:
	// если клиент попросил include_roles=true, поле roles обязано присутствовать,
	// иначе clients проваливаются в "поле отсутствует => роли неизвестны".
	User = Новый Структура;
	User.Вставить("name", "system");
	User.Вставить("full_name", "");
	Если IncludeRoles Тогда
		User.Вставить("roles", Новый Массив);
	КонецЕсли;
	Попытка
		ТП = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если ТП <> Неопределено Тогда
			User.name = ТП.Имя;
			User.full_name = ТП.ПолноеИмя;
		КонецЕсли;
		Если IncludeRoles И ТП <> Неопределено Тогда
			Для Каждого Р Из ТП.Роли Цикл
				User.roles.Добавить(Р.Имя);
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Поля уже заполнены безопасными значениями выше.
	КонецПопытки;
	Результат.Вставить("user", User);

	// Инфобаза.
	Infobase = Новый Структура;
	Попытка
		Infobase.Вставить("name", Метаданные.Имя);
		Infobase.Вставить("synonym", Метаданные.Синоним);
		Infobase.Вставить("configuration_name", Метаданные.Имя);
		Infobase.Вставить("configuration_version", Метаданные.Версия);
		Infobase.Вставить("platform_version", ВерсияПлатформы());
		Infobase.Вставить("host", ИмяКомпьютера());
	Исключение
	КонецПопытки;
	Результат.Вставить("infobase", Infobase);

	// Сервер.
	Если IncludeServer Тогда
		MCPServer = Новый Структура;
		MCPServer.Вставить("name", MCP_Config.ИмяСервера());
		MCPServer.Вставить("version", MCP_Config.ВерсияСервера());
		MCPServer.Вставить("read_only", MCP_Config.СерверReadOnly());
		Tools = Новый Массив;
		Для Каждого T Из MCP_Tools.СписокTools() Цикл
			Tools.Добавить(T.name);
		КонецЦикла;
		MCPServer.Вставить("tools", Tools);

		// CR-B: self-check целостности сборки. Частичная публикация (например, MCP_Knowledge
		// без перенесённого метода ДобавитьДоменныеПодсказки) иначе проявляется только как
		// непрозрачный рантайм-краш на первом же запросе. BSL не даёт прямой рефлексии,
		// поэтому используем защищённую пробу: пытаемся вызвать критичный экспортный метод
		// и фиксируем результат, не роняя сам контекстный вызов.
		ИнтегритиОК = Истина;
		ПроблемыИнтегрити = Новый Массив;
		Попытка
			Проба = Новый Структура;
			MCP_Knowledge.ДобавитьДоменныеПодсказки(Проба, "self-check");
		Исключение
			ИнтегритиОК = Ложь;
			ПроблемыИнтегрити.Добавить(
				"MCP_Knowledge.ДобавитьДоменныеПодсказки: " + ОписаниеОшибки());
		КонецПопытки;
		ИнтегритиСервера = Новый Структура;
		ИнтегритиСервера.Вставить("ok", ИнтегритиОК);
		ИнтегритиСервера.Вставить("issues", ПроблемыИнтегрити);
		MCPServer.Вставить("server_integrity", ИнтегритиСервера);

		Результат.Вставить("mcp_server", MCPServer);
	КонецЕсли;

	// Лимиты.
	Если IncludeLimits Тогда
		Результат.Вставить("limits", MCP_Config.Лимиты());
	КонецЕсли;

	// Privacy-политика нужна агенту до построения запросов, чтобы он не пытался
	// получить поля, которые сервер всё равно замаскирует.
	Результат.Вставить("privacy", MCP_Config.ИнформацияМаскированияLLM());

	AuthorizationPolicy = Новый Структура;
	AuthorizationPolicy.Вставить("per_1c_session", Истина);
	AuthorizationPolicy.Вставить("rights_are_user_specific", Истина);
	AuthorizationPolicy.Вставить("cacheable", Ложь);
	AuthorizationPolicy.Вставить("revalidate_each_call", Истина);
	AuthorizationPolicy.Вставить("access_denied_retry_policy", "do_not_retry_same_request_without_reauth_or_permission_change");
	AuthorizationPolicy.Вставить("llm_instruction",
		"Права зависят от текущей учетной записи 1С. Не кэшируйте сведения о доступе между перелогинами и не повторяйте тот же запрос после access_denied без смены пользователя или выдачи прав.");
	Результат.Вставить("authorization_policy", AuthorizationPolicy);

	// Summary allowlist.
	Если IncludeSummary Тогда
		Сводка = Новый Структура;
		Все = MCP_Metadata.ПолучитьВсеОбъектыМетаданных();
		ПоВидам = Новый Соответствие;
		Подсчет = 0;
		Для Каждого Стр Из Все Цикл
			Если MCP_Security.ТипРазрешен(Стр.ПолноеИмя) Тогда
				Подсчет = Подсчет + 1;
				ТекущКоличество = ПоВидам.Получить(Стр.Вид);
				Если ТекущКоличество = Неопределено Тогда
					ТекущКоличество = 0;
				КонецЕсли;
				ПоВидам.Вставить(Стр.Вид, ТекущКоличество + 1);
			КонецЕсли;
		КонецЦикла;
		Сводка.Вставить("objects_count", Подсчет);
		Виды = Новый Структура;
		Для Каждого КЗ Из ПоВидам Цикл
			Виды.Вставить(Строка(КЗ.Ключ), КЗ.Значение);
		КонецЦикла;
		Сводка.Вставить("kinds", Виды);
		Результат.Вставить("allowed_metadata_summary", Сводка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Helpers

Функция КонтекстАвторизацииТекущегоПользователя()

	ИмяПользователя = MCP_Security.ИмяТекущегоПользователя();
	ИмяБазы = "";
	ВерсияКонфигурации = "";
	Попытка
		ИмяБазы = Метаданные.Имя;
		ВерсияКонфигурации = Метаданные.Версия;
	Исключение
	КонецПопытки;

	ПолитикаКэша = Новый Структура;
	ПолитикаКэша.Вставить("cacheable", Ложь);
	ПолитикаКэша.Вставить("revalidate_each_call", Истина);

	Контекст = Новый Структура;
	Контекст.Вставить("user_name", ИмяПользователя);
	Контекст.Вставить("infobase_name", ИмяБазы);
	Контекст.Вставить("configuration_version", ВерсияКонфигурации);
	Контекст.Вставить("identity_key", ИмяПользователя + "@" + ИмяБазы + "#" + ВерсияКонфигурации);
	Контекст.Вставить("generated_at", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Контекст.Вставить("cache_policy", ПолитикаКэша);
	Возврат Контекст;

КонецФункции

Функция НормализоватьСтруктуру(Знач Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Новый Структура;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Структура;
		Для Каждого КЗ Из Значение Цикл
			Попытка
				Результат.Вставить(Строка(КЗ.Ключ), КЗ.Значение);
			Исключение
				// Ключ не подходит под идентификатор Структуры — пропускаем,
				// чтобы один невалидный ключ не валил весь tool-вызов.
			КонецПопытки;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Новый Структура;

КонецФункции

Функция Получить(Аргументы, ИмяПоля, ЗначениеПоУмолчанию) Экспорт

	Если Аргументы = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если (ТипЗнч(Аргументы) = Тип("Структура")
		ИЛИ ТипЗнч(Аргументы) = Тип("ФиксированнаяСтруктура"))
		И Аргументы.Свойство(ИмяПоля, Значение) Тогда
		Если Значение = Неопределено ИЛИ Значение = Null Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Аргументы) = Тип("Соответствие")
		ИЛИ ТипЗнч(Аргументы) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Аргументы.Получить(ИмяПоля);
		Если Значение = Неопределено ИЛИ Значение = Null Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ЦелоеИзАргумента(Аргументы, ИмяПоля, ПоУмолчанию, Максимум)

	Значение = Получить(Аргументы, ИмяПоля, ПоУмолчанию);
	Попытка
		Ц = Цел(Число(Значение));
	Исключение
		Ц = ПоУмолчанию;
	КонецПопытки;
	Если Ц < 1 Тогда
		Ц = ПоУмолчанию;
	КонецЕсли;
	Если Ц > Максимум Тогда
		Ц = Максимум;
	КонецЕсли;
	Возврат Ц;

КонецФункции

Функция ЦелоеИзСтроки(Текст, ПоУмолчанию)
	Попытка
		Возврат ?(ПустаяСтрока(Текст), ПоУмолчанию, Цел(Число(Текст)));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

