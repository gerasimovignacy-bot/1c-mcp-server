Функция МодульИзОбработчикаПодписки(Handler)

	Handler = СокрЛП(Строка(Handler));
	Если ПустаяСтрока(Handler) Тогда
		Возврат "";
	КонецЕсли;
	Поз = СтрНайти(Handler, ".");
	Если Поз = 0 Тогда
		Возврат Handler;
	КонецЕсли;
	Возврат Лев(Handler, Поз - 1);

КонецФункции

Функция ПроцедураИзОбработчикаПодписки(Handler)

	Handler = СокрЛП(Строка(Handler));
	Поз = СтрНайти(Handler, ".");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Handler, Поз + 1);

КонецФункции

Функция ОтсортированныеПодпискиНаСобытия(Подписки)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("sort_key");
	Таблица.Колонки.Добавить("row");
	Для Каждого Подписка Из Подписки Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.sort_key = Получить(Подписка, "event", "") + "|"
			+ Получить(Подписка, "name", "") + "|"
			+ Получить(Подписка, "handler", "");
		СтрокаТаблицы.row = Подписка;
	КонецЦикла;
	Таблица.Сортировать("sort_key");

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Результат.Добавить(СтрокаТаблицы.row);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура УвеличитьСчетчикСоответствия(Счетчики, Ключ)

	Значение = Счетчики.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Значение = 0;
	КонецЕсли;
	Счетчики.Вставить(Ключ, Значение + 1);

КонецПроцедуры

Функция ТопМодулейПодписок(СчетчикиМодулей, Лимит)

	Результат = Новый Массив;
	Если СчетчикиМодулей = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("module");
	Таблица.Колонки.Добавить("count");
	Для Каждого КЗ Из СчетчикиМодулей Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.module = КЗ.Ключ;
		СтрокаТаблицы.count = КЗ.Значение;
	КонецЦикла;
	Таблица.Сортировать("count Убыв, module");

	Счетчик = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Счетчик >= Лимит Тогда
			Прервать;
		КонецЕсли;
		СтрокаРезультата = Новый Структура;
		СтрокаРезультата.Вставить("module", СтрокаТаблицы.module);
		СтрокаРезультата.Вставить("count", СтрокаТаблицы.count);
		Результат.Добавить(СтрокаРезультата);
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЦелоеВДиапазонеИзАргумента(Аргументы, ИмяПоля, ПоУмолчанию, Минимум, Максимум)

	Значение = Получить(Аргументы, ИмяПоля, ПоУмолчанию);
	Попытка
		Ц = Цел(Число(Значение));
	Исключение
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Параметр " + ИмяПоля + " должен быть целым числом.");
	КонецПопытки;
	Если Ц < Минимум ИЛИ Ц > Максимум Тогда
		MCP_Errors.ВозбудитьОшибку(MCP_Errors.Код_InvalidArguments(),
			"Параметр " + ИмяПоля + " должен быть в диапазоне " + Строка(Минимум) + ".." + Строка(Максимум) + ".");
	КонецЕсли;
	Возврат Ц;

КонецФункции

Процедура ДобавитьПоляОбъектаМетаданных(Поля, ПолноеИмя, Вид, ОМД, Query, FieldKinds)

	Если ФильтрПолейРазрешает(FieldKinds, "standard_attributes") Тогда
		ДобавитьКоллекциюПолейМетаданных(Поля, ПолноеИмя, Вид, ПолноеИмя, "standard_attributes", ОМД, "СтандартныеРеквизиты", Query);
	КонецЕсли;
	Если ФильтрПолейРазрешает(FieldKinds, "attributes") Тогда
		ДобавитьКоллекциюПолейМетаданных(Поля, ПолноеИмя, Вид, ПолноеИмя, "attributes", ОМД, "Реквизиты", Query);
	КонецЕсли;
	Если ФильтрПолейРазрешает(FieldKinds, "dimensions") Тогда
		ДобавитьКоллекциюПолейМетаданных(Поля, ПолноеИмя, Вид, ПолноеИмя, "dimensions", ОМД, "Измерения", Query);
	КонецЕсли;
	Если ФильтрПолейРазрешает(FieldKinds, "resources") Тогда
		ДобавитьКоллекциюПолейМетаданных(Поля, ПолноеИмя, Вид, ПолноеИмя, "resources", ОМД, "Ресурсы", Query);
	КонецЕсли;
	Если FieldKinds.Количество() > 0 И ФильтрПолейРазрешает(FieldKinds, "register_attributes") Тогда
		ДобавитьКоллекциюПолейМетаданных(Поля, ПолноеИмя, Вид, ПолноеИмя, "register_attributes", ОМД, "Реквизиты", Query);
	КонецЕсли;
	Если ФильтрПолейРазрешает(FieldKinds, "tabular_sections") Тогда
		ДобавитьПоляТабличныхЧастейМетаданных(Поля, ПолноеИмя, Вид, ОМД, Query);
	КонецЕсли;

КонецПроцедуры

Функция ФильтрПолейРазрешает(FieldKinds, FieldKind)

	Если FieldKinds.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат МассивСодержитСтрокуБезРегистра(FieldKinds, FieldKind);

КонецФункции

Процедура ДобавитьКоллекциюПолейМетаданных(Поля, OwnerType, OwnerKind, FieldOwner, FieldKind, ОМД, ИмяКоллекции, Query)

	Попытка
		Если ИмяКоллекции = "СтандартныеРеквизиты" Тогда
			Коллекция = ОМД.СтандартныеРеквизиты;
		ИначеЕсли ИмяКоллекции = "Реквизиты" Тогда
			Коллекция = ОМД.Реквизиты;
		ИначеЕсли ИмяКоллекции = "Измерения" Тогда
			Коллекция = ОМД.Измерения;
		ИначеЕсли ИмяКоллекции = "Ресурсы" Тогда
			Коллекция = ОМД.Ресурсы;
		Иначе
			Возврат;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Реквизит Из Коллекция Цикл
		ДобавитьПолеМетаданныхЕслиПодходит(Поля, OwnerType, OwnerKind, FieldOwner, FieldKind, Реквизит, "", Query);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоляТабличныхЧастейМетаданных(Поля, OwnerType, OwnerKind, ОМД, Query)

	Попытка
		Коллекция = ОМД.ТабличныеЧасти;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого ТЧ Из Коллекция Цикл
		FieldOwner = OwnerType + "." + ТЧ.Имя;
		Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
			ДобавитьПолеМетаданныхЕслиПодходит(Поля, OwnerType, OwnerKind, FieldOwner, "tabular_sections", Реквизит, ТЧ.Имя, Query);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПолеМетаданныхЕслиПодходит(Поля, OwnerType, OwnerKind, FieldOwner, FieldKind, Реквизит, TabularSection, Query)

	Имя = "";
	Синоним = "";
	ТипОписание = "";
	Попытка
		Имя = Реквизит.Имя;
		Синоним = Реквизит.Синоним;
		ТипОписание = Строка(Реквизит.Тип);
	Исключение
		Возврат;
	КонецПопытки;

	Если НЕ MCP_Security.ПолеРазрешено(FieldOwner, Имя) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ПолеМетаданныхПодходитПоПоиску(Имя, Синоним, TabularSection, Query) Тогда
		Возврат;
	КонецЕсли;

	Поле = Новый Структура;
	Поле.Вставить("owner_type", OwnerType);
	Поле.Вставить("owner_kind", OwnerKind);
	Поле.Вставить("field_kind", FieldKind);
	Поле.Вставить("name", Имя);
	Поле.Вставить("path", ?(ПустаяСтрока(TabularSection), Имя, TabularSection + "." + Имя));
	Поле.Вставить("synonym", Синоним);
	Поле.Вставить("type_description", ТипОписание);
	Поля.Добавить(Поле);

КонецПроцедуры

Функция ПолеМетаданныхПодходитПоПоиску(Имя, Синоним, TabularSection, Query)

	Если ПустаяСтрока(Query) Тогда
		Возврат Истина;
	КонецЕсли;
	Q = ВРег(Query);
	Возврат СтрНайти(ВРег(Имя), Q) > 0
		ИЛИ СтрНайти(ВРег(Синоним), Q) > 0
		ИЛИ СтрНайти(ВРег(TabularSection), Q) > 0;

КонецФункции

Функция РегистрИмеетПериодМетаданных(ОМД)

	Попытка
		Для Каждого Реквизит Из ОМД.СтандартныеРеквизиты Цикл
			Если Реквизит.Имя = "Период" Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Ложь;

