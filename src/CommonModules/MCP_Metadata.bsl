// MCP_Metadata.bsl
// ====================================================================
// Работа с метаданными конфигурации 1С.
// Обход видов метаданных, описания структуры объектов, разрешение менеджеров.
// ====================================================================

Функция ПолучитьВсеОбъектыМетаданных() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Вид");
	Таблица.Колонки.Добавить("Имя");
	Таблица.Колонки.Добавить("ПолноеИмя");
	Таблица.Колонки.Добавить("Синоним");
	Таблица.Колонки.Добавить("Комментарий");
	Таблица.Колонки.Добавить("SupportsRef");
	Таблица.Колонки.Добавить("SupportsQuery");

	ДобавитьКоллекцию(Таблица, Метаданные.Справочники, "Справочник", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.Документы, "Документ", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.Константы, "Константа", Ложь, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.Перечисления, "Перечисление", Истина, Истина);

	ДобавитьКоллекцию(Таблица, Метаданные.РегистрыСведений, "РегистрСведений", Ложь, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.РегистрыНакопления, "РегистрНакопления", Ложь, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии", Ложь, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.РегистрыРасчета, "РегистрРасчета", Ложь, Истина);

	ДобавитьКоллекцию(Таблица, Метаданные.ПланыСчетов, "ПланСчетов", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.ПланыВидовРасчета, "ПланВидовРасчета", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.ПланыОбмена, "ПланОбмена", Истина, Истина);

	ДобавитьКоллекцию(Таблица, Метаданные.БизнесПроцессы, "БизнесПроцесс", Истина, Истина);
	ДобавитьКоллекцию(Таблица, Метаданные.Задачи, "Задача", Истина, Истина);

	ДобавитьКоллекцию(Таблица, Метаданные.Отчеты, "Отчет", Ложь, Ложь);
	ДобавитьКоллекцию(Таблица, Метаданные.Обработки, "Обработка", Ложь, Ложь);

	Возврат Таблица;

КонецФункции

Процедура ДобавитьКоллекцию(Таблица, Коллекция, Вид, SupportsRef, SupportsQuery)

	Для Каждого ОМД Из Коллекция Цикл
		Стр = Таблица.Добавить();
		Стр.Вид = Вид;
		Стр.Имя = ОМД.Имя;
		Стр.ПолноеИмя = Вид + "." + ОМД.Имя;
		Стр.Синоним = ОМД.Синоним;
		Попытка
			Стр.Комментарий = ОМД.Комментарий;
		Исключение
			Стр.Комментарий = "";
		КонецПопытки;
		Стр.SupportsRef = SupportsRef;
		Стр.SupportsQuery = SupportsQuery;
	КонецЦикла;

КонецПроцедуры

Функция ОбъектМетаданныхПоПолномуИмени(ПолноеИмя) Экспорт

	Возврат Метаданные.НайтиПоПолномуИмени(ПолноеИмя);

КонецФункции

Функция ВидПоОбъектуМетаданных(ОМД) Экспорт

	Если ОМД = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ПолноеИмя = ПолноеИмяОбъектаМетаданных(ОМД);
	ВидИзИмени = ВидИзПолногоИмени(ПолноеИмя);
	Если НЕ ПустаяСтрока(ВидИзИмени) Тогда
		Возврат ВидИзИмени;
	КонецЕсли;

	ВидИзКоллекции = ВидПоИмениВКоллекциях(ОМД);
	Если НЕ ПустаяСтрока(ВидИзКоллекции) Тогда
		Возврат ВидИзКоллекции;
	КонецЕсли;

	Родитель = ОМД.Родитель();
	Если Родитель = Метаданные.Справочники Тогда
		Возврат "Справочник";
	КонецЕсли;
	Если Родитель = Метаданные.Документы Тогда
		Возврат "Документ";
	КонецЕсли;
	Если Родитель = Метаданные.Перечисления Тогда
		Возврат "Перечисление";
	КонецЕсли;
	Если Родитель = Метаданные.РегистрыСведений Тогда
		Возврат "РегистрСведений";
	КонецЕсли;
	Если Родитель = Метаданные.РегистрыНакопления Тогда
		Возврат "РегистрНакопления";
	КонецЕсли;
	Если Родитель = Метаданные.РегистрыБухгалтерии Тогда
		Возврат "РегистрБухгалтерии";
	КонецЕсли;
	Если Родитель = Метаданные.РегистрыРасчета Тогда
		Возврат "РегистрРасчета";
	КонецЕсли;
	Если Родитель = Метаданные.ПланыСчетов Тогда
		Возврат "ПланСчетов";
	КонецЕсли;
	Если Родитель = Метаданные.ПланыВидовХарактеристик Тогда
		Возврат "ПланВидовХарактеристик";
	КонецЕсли;
	Если Родитель = Метаданные.ПланыВидовРасчета Тогда
		Возврат "ПланВидовРасчета";
	КонецЕсли;
	Если Родитель = Метаданные.ПланыОбмена Тогда
		Возврат "ПланОбмена";
	КонецЕсли;
	Если Родитель = Метаданные.БизнесПроцессы Тогда
		Возврат "БизнесПроцесс";
	КонецЕсли;
	Если Родитель = Метаданные.Задачи Тогда
		Возврат "Задача";
	КонецЕсли;
	Если Родитель = Метаданные.Отчеты Тогда
		Возврат "Отчет";
	КонецЕсли;
	Если Родитель = Метаданные.Обработки Тогда
		Возврат "Обработка";
	КонецЕсли;
	Если Родитель = Метаданные.Константы Тогда
		Возврат "Константа";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ВидПоИмениВКоллекциях(ОМД)

	Попытка
		Имя = ОМД.Имя;
	Исключение
		Возврат "";
	КонецПопытки;

	Если Метаданные.Справочники.Найти(Имя) <> Неопределено Тогда Возврат "Справочник"; КонецЕсли;
	Если Метаданные.Документы.Найти(Имя) <> Неопределено Тогда Возврат "Документ"; КонецЕсли;
	Если Метаданные.Перечисления.Найти(Имя) <> Неопределено Тогда Возврат "Перечисление"; КонецЕсли;
	Если Метаданные.РегистрыСведений.Найти(Имя) <> Неопределено Тогда Возврат "РегистрСведений"; КонецЕсли;
	Если Метаданные.РегистрыНакопления.Найти(Имя) <> Неопределено Тогда Возврат "РегистрНакопления"; КонецЕсли;
	Если Метаданные.РегистрыБухгалтерии.Найти(Имя) <> Неопределено Тогда Возврат "РегистрБухгалтерии"; КонецЕсли;
	Если Метаданные.РегистрыРасчета.Найти(Имя) <> Неопределено Тогда Возврат "РегистрРасчета"; КонецЕсли;
	Если Метаданные.ПланыСчетов.Найти(Имя) <> Неопределено Тогда Возврат "ПланСчетов"; КонецЕсли;
	Если Метаданные.ПланыВидовХарактеристик.Найти(Имя) <> Неопределено Тогда Возврат "ПланВидовХарактеристик"; КонецЕсли;
	Если Метаданные.ПланыВидовРасчета.Найти(Имя) <> Неопределено Тогда Возврат "ПланВидовРасчета"; КонецЕсли;
	Если Метаданные.ПланыОбмена.Найти(Имя) <> Неопределено Тогда Возврат "ПланОбмена"; КонецЕсли;
	Если Метаданные.БизнесПроцессы.Найти(Имя) <> Неопределено Тогда Возврат "БизнесПроцесс"; КонецЕсли;
	Если Метаданные.Задачи.Найти(Имя) <> Неопределено Тогда Возврат "Задача"; КонецЕсли;
	Если Метаданные.Отчеты.Найти(Имя) <> Неопределено Тогда Возврат "Отчет"; КонецЕсли;
	Если Метаданные.Обработки.Найти(Имя) <> Неопределено Тогда Возврат "Обработка"; КонецЕсли;
	Если Метаданные.Константы.Найти(Имя) <> Неопределено Тогда Возврат "Константа"; КонецЕсли;

	Возврат "";

КонецФункции

Функция ПолноеИмяОбъектаМетаданных(ОМД) Экспорт

	Если ОМД = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ОМД.ПолноеИмя();
	Исключение
		// На старых/особых объектах метаданных метода может не быть.
	КонецПопытки;

	Возврат "";

КонецФункции

Функция МенеджерПоТипу(ПолноеИмя) Экспорт

	ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Вид = ВидПоОбъектуМетаданных(ОМД);
	Если ПустаяСтрока(Вид) Тогда
		Вид = ВидИзПолногоИмени(ПолноеИмя);
	КонецЕсли;
	Имя = ОМД.Имя;

	Попытка
		Если Вид = "Справочник" Тогда
			Возврат Справочники[Имя];
		ИначеЕсли Вид = "Документ" Тогда
			Возврат Документы[Имя];
		ИначеЕсли Вид = "Перечисление" Тогда
			Возврат Перечисления[Имя];
		ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
			Возврат ПланыВидовХарактеристик[Имя];
		ИначеЕсли Вид = "ПланСчетов" Тогда
			Возврат ПланыСчетов[Имя];
		ИначеЕсли Вид = "ПланВидовРасчета" Тогда
			Возврат ПланыВидовРасчета[Имя];
		ИначеЕсли Вид = "ПланОбмена" Тогда
			Возврат ПланыОбмена[Имя];
		ИначеЕсли Вид = "БизнесПроцесс" Тогда
			Возврат БизнесПроцессы[Имя];
		ИначеЕсли Вид = "Задача" Тогда
			Возврат Задачи[Имя];
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ВидИзПолногоИмени(ПолноеИмя) Экспорт
	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(ПолноеИмя, Поз - 1);
КонецФункции

Функция ИмяИзПолногоИмени(ПолноеИмя) Экспорт
	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат Сред(ПолноеИмя, Поз + 1);
КонецФункции

// ---- Структура объекта --------------------------------------------

Функция СтруктураОбъекта(ПолноеИмя, Опции) Экспорт

	ОМД = ОбъектМетаданныхПоПолномуИмени(ПолноеИмя);
	Если ОМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Вид = ВидПоОбъектуМетаданных(ОМД);

	Результат = Новый Структура;
	Результат.Вставить("kind", Вид);
	Результат.Вставить("name", ОМД.Имя);
	Результат.Вставить("full_name", ПолноеИмя);
	Результат.Вставить("synonym", ОМД.Синоним);
	Попытка
		Результат.Вставить("comment", ОМД.Комментарий);
	Исключение
		Результат.Вставить("comment", "");
	КонецПопытки;
	Результат.Вставить("query_table", ПолноеИмя);
	Результат.Вставить("supports_ref", ПоддерживаетСсылку(Вид));
	Результат.Вставить("hierarchical", ЯвляетсяИерархическим(ОМД, Вид));

	Атрибуты = Новый Массив;
	СтандартныеАтрибуты = Новый Массив;
	Если Опции.include_standard_attributes Тогда
		ЗаполнитьСтандартныеАтрибуты(ОМД, Вид, СтандартныеАтрибуты);
	КонецЕсли;
	Если Опции.include_attributes Тогда
		ЗаполнитьАтрибуты(ОМД, Вид, Атрибуты, ПолноеИмя, Опции);
	КонецЕсли;

	ТабличныеЧасти = Новый Массив;
	Если Опции.include_tabular_sections Тогда
		ЗаполнитьТабличныеЧасти(ОМД, ТабличныеЧасти, ПолноеИмя, Опции);
	КонецЕсли;

	РегистрСхема = Неопределено;
	Если Вид = "РегистрСведений" ИЛИ Вид = "РегистрНакопления"
		ИЛИ Вид = "РегистрБухгалтерии" ИЛИ Вид = "РегистрРасчета" Тогда
		РегистрСхема = СхемаРегистра(ОМД, Вид, ПолноеИмя, Опции);
	КонецЕсли;

	Результат.Вставить("attributes", Атрибуты);
	Результат.Вставить("standard_attributes", СтандартныеАтрибуты);
	Результат.Вставить("tabular_sections", ТабличныеЧасти);
	Результат.Вставить("register_schema", РегистрСхема);

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьАтрибуты(ОМД, Вид, Атрибуты, ПолноеИмя, Опции)

	Попытка
		КоллекцияРеквизитов = ОМД.Реквизиты;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Р Из КоллекцияРеквизитов Цикл
		Атрибуты.Добавить(КодироватьРеквизит(Р, ПолноеИмя, Опции));
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСтандартныеАтрибуты(ОМД, Вид, Список)

	Попытка
		Коллекция = ОМД.СтандартныеРеквизиты;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Р Из Коллекция Цикл
		Стр = Новый Структура;
		Стр.Вставить("name", Р.Имя);
		Стр.Вставить("synonym", Р.Синоним);
		Стр.Вставить("type_description", Строка(Р.Тип));
		Список.Добавить(Стр);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТабличныеЧасти(ОМД, ТабличныеЧасти, ПолноеИмя, Опции)

	Попытка
		Коллекция = ОМД.ТабличныеЧасти;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого ТЧ Из Коллекция Цикл
		Реквизиты = Новый Массив;
		Для Каждого Р Из ТЧ.Реквизиты Цикл
			Реквизиты.Добавить(КодироватьРеквизит(Р, ПолноеИмя + "." + ТЧ.Имя, Опции));
		КонецЦикла;
		Стр = Новый Структура;
		Стр.Вставить("name", ТЧ.Имя);
		Стр.Вставить("synonym", ТЧ.Синоним);
		Стр.Вставить("attributes", Реквизиты);
		ТабличныеЧасти.Добавить(Стр);
	КонецЦикла;

КонецПроцедуры

Функция КодироватьРеквизит(Р, КонтекстПолноеИмя, Опции)

	Стр = Новый Структура;
	Стр.Вставить("name", Р.Имя);
	Стр.Вставить("synonym", Р.Синоним);
	Стр.Вставить("type_description", Строка(Р.Тип));
	// T-3 п. 2 и 4. `type_description` и `value_types` — ПРЕДСТАВЛЕНИЯ типа:
	// контуры публикуют синоним («Организация»), а не полное имя, поэтому
	// определять ссылочность поиском подстроки «ССЫЛКА»/«REF» нельзя — измерение
	// с синонимом молча признавалось нессылочным. Рядом публикуются машинные
	// признаки: is_reference и полные имена ref_types по метаданным. Расширение
	// аддитивное — прежние ключи остаются с прежним смыслом.
	ТипыЗначений = Новый Массив;
	СсылочныеТипы = Новый Массив;
	ЭтоСсылка = Ложь;
	Для Каждого Т Из Р.Тип.Типы() Цикл
		ТипыЗначений.Добавить(Строка(Т));
		Попытка
			ОМДТипа = Метаданные.НайтиПоТипу(Т);
		Исключение
			ОМДТипа = Неопределено;
		КонецПопытки;
		Если ОМДТипа <> Неопределено Тогда
			ЭтоСсылка = Истина;
			СсылочныеТипы.Добавить(ОМДТипа.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Стр.Вставить("value_types", ТипыЗначений);
	Стр.Вставить("is_reference", ЭтоСсылка);
	Стр.Вставить("ref_types", СсылочныеТипы);

	Разрешено = MCP_Security.ПолеРазрешено(КонтекстПолноеИмя, Р.Имя);
	Стр.Вставить("allowed", Разрешено);
	Стр.Вставить("sensitive", НЕ Разрешено);

	// Searchable: входит ли поле в search_fields allowlist. T-1 п. 4: это
	// признак НАСТРОЙКИ, а не проверка работоспособности поиска — состав
	// считается до сверки с метаданными и до allowlist-фильтров. Оракулом
	// «поиск по этому полю работает» служить не может; фактический вердикт даёт
	// только вызов search_objects, который теперь называет отсеянные поля в
	// warnings.
	ПоляПоиска = MCP_Security.ПоляПоискаПоУмолчанию(КонтекстПолноеИмя);
	Searchable = Ложь;
	Для Каждого П Из ПоляПоиска Цикл
		Если ВРег(П) = ВРег(Р.Имя) Тогда
			Searchable = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Стр.Вставить("searchable", Searchable);
	Стр.Вставить("query_name", Р.Имя);

	Возврат Стр;

КонецФункции

Функция СхемаРегистра(ОМД, Вид, ПолноеИмя, Опции)

	Стр = Новый Структура;
	Стр.Вставить("type", Вид);
	Стр.Вставить("periodicity", ПериодичностьРегистраСведений(ОМД, Вид));

	Измерения = Новый Массив;
	Попытка
		Для Каждого Изм Из ОМД.Измерения Цикл
			Измерения.Добавить(КодироватьРеквизит(Изм, ПолноеИмя + ".Измерения", Опции));
		КонецЦикла;
	Исключение
	КонецПопытки;
	Стр.Вставить("dimensions", Измерения);

	Ресурсы = Новый Массив;
	Попытка
		Для Каждого Рес Из ОМД.Ресурсы Цикл
			Ресурсы.Добавить(КодироватьРеквизит(Рес, ПолноеИмя + ".Ресурсы", Опции));
		КонецЦикла;
	Исключение
	КонецПопытки;
	Стр.Вставить("resources", Ресурсы);
	Если Вид = "РегистрНакопления" Тогда
		Стр.Вставить("resources_by_mode", РесурсыРегистраНакопленияПоРежимам(ОМД));
	КонецЕсли;

	Реквизиты = Новый Массив;
	Попытка
		Для Каждого Р Из ОМД.Реквизиты Цикл
			Реквизиты.Добавить(КодироватьРеквизит(Р, ПолноеИмя, Опции));
		КонецЦикла;
	Исключение
	КонецПопытки;
	Стр.Вставить("attributes", Реквизиты);
	Если Вид = "РегистрРасчета" Тогда
		Стр.Вставить("calculation_register_guidance",
			"РегистрРасчета используется в ЗУП-подобных конфигурациях для расчётных записей. Универсальный режим get_register_records поддерживает records; для сложных виртуальных таблиц сначала исследуйте metadata и get_calculation_types_map для ПланВидовРасчета.*. Не угадывайте поля периода регистрации/действия и вид расчёта.");
		Стр.Вставить("recommended_tools", РекомендуемыеToolsРасчета());
	КонецЕсли;
	Если ПолучитьБулевоОпции(Опции, "include_virtual_tables", Истина) Тогда
		Стр.Вставить("virtual_tables", ВиртуальныеТаблицыРегистра(ОМД, Вид, ПолноеИмя));
	КонецЕсли;

	Возврат Стр;

КонецФункции

Функция РекомендуемыеToolsРасчета()

	Результат = Новый Массив;
	Результат.Добавить("get_calculation_types_map");
	Результат.Добавить("get_register_records(mode=records)");
	Результат.Добавить("run_1c_query");
	Результат.Добавить("run_1c_report");
	Возврат Результат;

КонецФункции

Функция РесурсыРегистраНакопленияПоРежимам(ОМД)

	Records = Новый Массив;
	Turnovers = Новый Массив;
	Balance = Новый Массив;
	BalanceAndTurnovers = Новый Массив;
	Попытка
		Для Каждого Рес Из ОМД.Ресурсы Цикл
			Имя = Рес.Имя;
			Records.Добавить(Имя);
			Turnovers.Добавить(Имя + "Оборот");
			Balance.Добавить(Имя + "Остаток");
			BalanceAndTurnovers.Добавить(Имя + "НачальныйОстаток");
			BalanceAndTurnovers.Добавить(Имя + "Оборот");
			BalanceAndTurnovers.Добавить(Имя + "КонечныйОстаток");
		КонецЦикла;
	Исключение
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("records", Records);
	Результат.Вставить("turnovers", Turnovers);
	Результат.Вставить("balance", Balance);
	Результат.Вставить("balance_and_turnovers", BalanceAndTurnovers);
	Результат.Вставить("guidance", "В виртуальных таблицах имена ресурсов зависят от режима: Оборот для turnovers, Остаток для balance, НачальныйОстаток/Оборот/КонечныйОстаток для balance_and_turnovers.");
	Возврат Результат;

КонецФункции

Функция ВиртуальныеТаблицыРегистра(ОМД, Вид, ПолноеИмя)

	Результат = Новый Массив;
	Если Вид = "РегистрНакопления" Тогда
		Результат.Добавить(ОписаниеВиртуальнойТаблицы(
			"Обороты",
			ПолноеИмя + ".Обороты(&ПериодНачало, &ПериодКонец)",
			"turnovers",
			"Обороты за период с учётом знака движений.",
			ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "Обороты"),
			ПараметрыВиртуальнойТаблицы("ПериодНачало,ПериодКонец")));
		Если РегистрНакопленияХранитОстатки(ОМД) Тогда
			Результат.Добавить(ОписаниеВиртуальнойТаблицы(
				"Остатки",
				ПолноеИмя + ".Остатки(&Период)",
				"balance",
				"Остатки на дату.",
				ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "Остатки"),
				ПараметрыВиртуальнойТаблицы("Период")));
			Результат.Добавить(ОписаниеВиртуальнойТаблицы(
				"ОстаткиИОбороты",
				ПолноеИмя + ".ОстаткиИОбороты(&ПериодНачало, &ПериодКонец)",
				"balance_and_turnovers",
				"Остатки и обороты за период.",
				ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "ОстаткиИОбороты"),
				ПараметрыВиртуальнойТаблицы("ПериодНачало,ПериодКонец")));
		КонецЕсли;
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Результат.Добавить(ОписаниеВиртуальнойТаблицы(
			"Остатки",
			ПолноеИмя + ".Остатки(&Период)",
			"balance",
			"Остатки по счетам и субконто на дату. Значения аналитик доступны в Субконто1/2/3; соответствие позиции и вида аналитики определяется настройками счёта в плане счетов, обычно через табличную часть ПланСчетов.<ИмяПлана>.ВидыСубконто. В сложных JOIN между независимыми подзапросами сопоставляйте субконто через УникальныйИдентификатор(СубконтоN).",
			ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "Остатки"),
			ПараметрыВиртуальнойТаблицы("Период")));

		Результат.Добавить(ОписаниеВиртуальнойТаблицы(
			"Обороты",
			ПолноеИмя + ".Обороты(&ПериодНачало, &ПериодКонец)",
			"turnovers",
			"Обороты по счету и субконто. Для аналитики субконто используйте эту таблицу, а не основную таблицу движений. Значения аналитик доступны в Субконто1/2/3; соответствие позиции и вида аналитики определяется настройками счёта в плане счетов, обычно через табличную часть ПланСчетов.<ИмяПлана>.ВидыСубконто. В сложных JOIN между независимыми подзапросами сопоставляйте субконто через УникальныйИдентификатор(СубконтоN).",
			ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "Обороты"),
			ПараметрыВиртуальнойТаблицы("ПериодНачало,ПериодКонец")));

		Результат.Добавить(ОписаниеВиртуальнойТаблицы(
			"ОборотыДтКт",
			ПолноеИмя + ".ОборотыДтКт(&ПериодНачало, &ПериодКонец)",
			"turnovers_debit_credit",
			"Корреспонденция Дт/Кт с отдельными полями СубконтоДт1..3 и СубконтоКт1..3. Соответствие позиции и вида аналитики определяется настройками счёта Дт/Кт в плане счетов, обычно через табличную часть ПланСчетов.<ИмяПлана>.ВидыСубконто. В сложных JOIN между независимыми подзапросами сопоставляйте субконто через УникальныйИдентификатор(СубконтоДтN/СубконтоКтN).",
			ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "ОборотыДтКт"),
			ПараметрыВиртуальнойТаблицы("ПериодНачало,ПериодКонец")));

		Результат.Добавить(ОписаниеВиртуальнойТаблицы(
			"ОстаткиИОбороты",
			ПолноеИмя + ".ОстаткиИОбороты(&ПериодНачало, &ПериодКонец)",
			"balance_and_turnovers",
			"Начальные/конечные остатки и обороты по счетам и субконто за период. Значения аналитик доступны в Субконто1/2/3; соответствие позиции и вида аналитики определяется настройками счёта в плане счетов, обычно через табличную часть ПланСчетов.<ИмяПлана>.ВидыСубконто. В сложных JOIN между независимыми подзапросами сопоставляйте субконто через УникальныйИдентификатор(СубконтоN).",
			ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "ОстаткиИОбороты"),
			ПараметрыВиртуальнойТаблицы("ПериодНачало,ПериодКонец")));

		// ДвиженияССубконто перечисляется наравне с остальными: генератор состава полей
		// её знает и pre-flight по ней работает, а в списке ВТ её не было — клиент не
		// мог её обнаружить и уходил на основную таблицу движений, которую запрещает
		// правило base_register_table_without_vt_check. Состав полей строится только
		// при доступной схеме: пустой массив означает «схема не верифицирована».
		Если ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "ДвиженияССубконто").Количество() > 0 Тогда
			Результат.Добавить(ОписаниеВиртуальнойТаблицы(
				"ДвиженияССубконто",
				ПолноеИмя + ".ДвиженияССубконто(&НачалоПериода, &КонецПериода)",
				"movements_with_subconto",
				"Расширение таблицы движений: каждая строка — готовая пара дебет+кредит одной проводки, с полями СубконтоДт1..3/СубконтоКт1..3 и видами субконто по сторонам. ЕДИНСТВЕННАЯ виртуальная таблица регистра бухгалтерии, содержащая Регистратор — применяйте, когда нужна детализация до документа вместе с субконто, вместо основной таблицы движений. Счёт здесь всегда раздельный по сторонам (СчетДт/СчетКт), единого поля Счет нет; измерение, не являющееся балансовым, тоже представлено парой <Имя>Дт/<Имя>Кт.",
				ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "ДвиженияССубконто"),
				ПараметрыВиртуальнойТаблицы("НачалоПериода,КонецПериода")));
		КонецЕсли;
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Если РегистрИмеетПериодМД(ОМД) Тогда
			Результат.Добавить(ОписаниеВиртуальнойТаблицы(
				"СрезПервых",
				ПолноеИмя + ".СрезПервых(&Период)",
				"slice_first",
				"Первый срез периодического регистра сведений.",
				ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "СрезПервых"),
				ПараметрыВиртуальнойТаблицы("Период")));
			Результат.Добавить(ОписаниеВиртуальнойТаблицы(
				"СрезПоследних",
				ПолноеИмя + ".СрезПоследних(&Период)",
				"slice_last",
				"Последний срез периодического регистра сведений.",
				ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, "СрезПоследних"),
				ПараметрыВиртуальнойТаблицы("Период")));
		КонецЕсли;
	ИначеЕсли Вид = "РегистрРасчета" Тогда
		Результат.Добавить(ОписаниеНеподдержанныхВиртуальныхТаблиц(
			"Виртуальные таблицы регистров расчёта пока не описываются универсальным MCP-сервером. Используйте records или прямой запрос к таблице, если точная виртуальная таблица известна."));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ОписаниеВиртуальнойТаблицы(Имя, QueryTable, Mode, Описание, Поля = Неопределено, Параметры = Неопределено)

	Стр = Новый Структура;
	Стр.Вставить("name", Имя);
	Стр.Вставить("query_table", QueryTable);
	Стр.Вставить("mode", Mode);
	Стр.Вставить("description", Описание);
	Если Параметры = Неопределено Тогда
		Параметры = Новый Массив;
	КонецЕсли;
	Стр.Вставить("parameters", Параметры);
	Стр.Вставить("common_fields", ?(Поля = Неопределено, Новый Массив, Поля));
	Возврат Стр;

КонецФункции

Функция ОписаниеНеподдержанныхВиртуальныхТаблиц(Описание)

	Стр = Новый Структура;
	Стр.Вставить("name", "unsupported");
	Стр.Вставить("unsupported", Истина);
	Стр.Вставить("description", Описание);
	Стр.Вставить("parameters", Новый Массив);
	Стр.Вставить("common_fields", Новый Массив);
	Возврат Стр;

КонецФункции

Функция ПараметрыВиртуальнойТаблицы(CSV)

	Параметры = Новый Массив;
	ДобавитьСтроки(Параметры, CSV);
	Возврат Параметры;

КонецФункции

Процедура ДобавитьСтроки(Массив, CSV)

	Для Каждого Значение Из СтрРазделить(CSV, ",", Ложь) Цикл
		Значение = СокрЛП(Значение);
		Если НЕ ПустаяСтрока(Значение) Тогда
			Массив.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// ---- Полный набор полей виртуальной таблицы (универсальный генератор) ---------
//
// Возвращает авторитетный НАДмножество полей виртуальной таблицы регистра,
// построенное из реальных Измерения/Ресурсы/Реквизиты/СтандартныеРеквизиты
// + правил суффиксов платформы по виду ВТ. Применяется как для подсказок
// (common_fields в структуре объекта), так и для pre-flight/post-error проверки
// полей в MCP_Query (единый источник истины — F-08 ТЗ).
//
// Контракт надмножества: набор гарантированно содержит все реальные колонки ВТ,
// поэтому отклонять можно только поля, которых в наборе НЕТ (ложные отказы на
// валидных полях исключены — критично против регресса F4). Незнание точной
// платформенной асимметрии трактуется в пользу включения поля (деградация —
// запрос уходит на движок, а не блокируется ошибочно).
//
// Структура результата: { supported: Булево, fields: Массив(Строка), reason: Строка, vt_kind: Строка }.
// Никогда не бросает исключение: при сбое интроспекции supported=Ложь.
// Набор один для обеих ролей — pre-flight и объявление в get_metadata_structure.
// Контракт F-08 требует их совпадения, см. СуммовыеПрефиксыБухгалтерии.
Функция ПолныйНаборПолейВиртуальнойТаблицы(ПолноеИмя, ИмяВТ) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("supported", Ложь);
	Результат.Вставить("fields", Новый Массив);
	Результат.Вставить("reason", "");
	Результат.Вставить("vt_kind", Строка(ИмяВТ));

	Попытка
		ОМД = ОбъектМетаданныхПоПолномуИмени(ПолноеИмя);
		Если ОМД = Неопределено Тогда
			Результат.reason = "object_not_found";
			Возврат Результат;
		КонецЕсли;

		Вид = ВидПоОбъектуМетаданных(ОМД);
		Набор = Новый Соответствие;
		Покрыто = Ложь;

		Если Вид = "РегистрБухгалтерии" Тогда
			Покрыто = ЗаполнитьПоляВТБухгалтерии(Набор, ОМД, ИмяВТ);
		ИначеЕсли Вид = "РегистрНакопления" Тогда
			Покрыто = ЗаполнитьПоляВТНакопления(Набор, ОМД, ИмяВТ);
		ИначеЕсли Вид = "РегистрСведений" Тогда
			Покрыто = ЗаполнитьПоляВТСведений(Набор, ОМД, ИмяВТ);
		Иначе
			Результат.reason = "register_kind_not_covered";
			Возврат Результат;
		КонецЕсли;

		Если НЕ Покрыто Тогда
			Результат.reason = "virtual_table_kind_not_covered";
			Возврат Результат;
		КонецЕсли;

		Для Каждого КЗ Из Набор Цикл
			Результат.fields.Добавить(КЗ.Значение);
		КонецЦикла;
		Результат.supported = Истина;
	Исключение
		Результат.supported = Ложь;
		Результат.fields = Новый Массив;
		Результат.reason = "introspection_error: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Удобная обёртка для описаний ВТ: массив полей или пустой массив при деградации.
//
// Это ОБЪЯВЛЯЕМЫЙ клиенту состав полей (get_metadata_structure). Он строится тем
// же вызовом и тем же набором, что и разрешитель pre-flight: контракт F-08
// требует совпадения available_fields при отказе с common_fields из метаданных,
// иначе подсказка не соответствует объявленной схеме.
Функция ОбщиеПоляВиртуальнойТаблицы(ПолноеИмя, ИмяВТ) Экспорт

	Набор = ПолныйНаборПолейВиртуальнойТаблицы(ПолноеИмя, ИмяВТ);
	Если Набор.supported Тогда
		Возврат Набор.fields;
	КонецЕсли;
	Возврат Новый Массив;

КонецФункции

Процедура ДобавитьПолеВНабор(Набор, Имя)

	Если Имя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Значение = СокрЛП(Строка(Имя));
	Если ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;
	Ключ = ВРег(Значение);
	Если Набор.Получить(Ключ) = Неопределено Тогда
		Набор.Вставить(Ключ, Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьИменаКоллекцииВНабор(Набор, Коллекция)

	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Для Каждого Элемент Из Коллекция Цикл
			ДобавитьПолеВНабор(Набор, Элемент.Имя);
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Служебные стандартные реквизиты бухгалтерского регистра для двусторонней таблицы
// движений: всё из СтандартныеРеквизиты, КРОМЕ позиционной аналитики Субконто<N> и
// ВидСубконто<N>. Коллекция описывает таблицу записей, где аналитика позиционная; в
// двусторонней таблице она представлена парами по сторонам, а голого позиционного
// имени не существует. Добавление таких имён дало бы фантомы в наборе (issue #91).
Процедура ДобавитьСлужебныеСтандартныеРеквизитыБухгалтерии(Набор, ОМД)

	Попытка
		Для Каждого Реквизит Из ОМД.СтандартныеРеквизиты Цикл
			Имя = Реквизит.Имя;
			Если ПозиционнаяАналитикаПоИмени(Имя) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьПолеВНабор(Набор, Имя);
		КонецЦикла;
	Исключение
		// Коллекция недоступна — состав добирается гарантированным минимумом в ветке.
	КонецПопытки;

КонецПроцедуры

// Имя вида Субконто<N> или ВидСубконто<N> — позиционная аналитика таблицы записей.
Функция ПозиционнаяАналитикаПоИмени(Имя)

	Верх = ВРег(Строка(Имя));
	Основы = СтрРазделить("СУБКОНТО,ВИДСУБКОНТО", ",", Ложь);
	Для Каждого Основа Из Основы Цикл
		Если СтрНачинаетсяС(Верх, Основа) Тогда
			Хвост = Сред(Верх, СтрДлина(Основа) + 1);
			Если СтрДлина(Хвост) > 0 И СтрокаЭтоЦелоеЧисло(Хвост) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция СтрокаЭтоЦелоеЧисло(Значение)

	Строка_ = Строка(Значение);
	Если ПустаяСтрока(Строка_) Тогда
		Возврат Ложь;
	КонецЕсли;
	Цифры = "0123456789";
	Для Индекс = 1 По СтрДлина(Строка_) Цикл
		Если СтрНайти(Цифры, Сред(Строка_, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ИменаРесурсовРегистра(ОМД)

	Результат = Новый Массив;
	Попытка
		Для Каждого Ресурс Из ОМД.Ресурсы Цикл
			Результат.Добавить(Ресурс.Имя);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Результат;

КонецФункции

// ---- Регистр накопления -------------------------------------------------------
Функция ЗаполнитьПоляВТНакопления(Набор, ОМД, ИмяВТ)

	ВТ = ВРег(Строка(ИмяВТ));
	ДобавитьИменаКоллекцииВНабор(Набор, ОМД.Измерения);
	ИменаРесурсов = ИменаРесурсовРегистра(ОМД);

	Если ВТ = ВРег("Остатки") Тогда
		Для Каждого Р Из ИменаРесурсов Цикл
			ДобавитьПолеВНабор(Набор, Р + "Остаток");
		КонецЦикла;
		Возврат Истина;
	ИначеЕсли ВТ = ВРег("Обороты") Тогда
		Для Каждого Р Из ИменаРесурсов Цикл
			ДобавитьПолеВНабор(Набор, Р + "Оборот");
			ДобавитьПолеВНабор(Набор, Р + "Приход");
			ДобавитьПолеВНабор(Набор, Р + "Расход");
		КонецЦикла;
		ДобавитьСлужебныеПоляДвиженийНакопления(Набор);
		Возврат Истина;
	ИначеЕсли ВТ = ВРег("ОстаткиИОбороты") Тогда
		Для Каждого Р Из ИменаРесурсов Цикл
			ДобавитьПолеВНабор(Набор, Р + "НачальныйОстаток");
			ДобавитьПолеВНабор(Набор, Р + "КонечныйОстаток");
			ДобавитьПолеВНабор(Набор, Р + "Оборот");
			ДобавитьПолеВНабор(Набор, Р + "Приход");
			ДобавитьПолеВНабор(Набор, Р + "Расход");
		КонецЦикла;
		ДобавитьПолеВНабор(Набор, "Период");
		ДобавитьСлужебныеПоляДвиженийНакопления(Набор);
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьСлужебныеПоляДвиженийНакопления(Набор)

	// Доступны при детализации по регистратору/периоду; добавляем как надмножество.
	ДобавитьПолеВНабор(Набор, "Период");
	ДобавитьПолеВНабор(Набор, "Регистратор");
	ДобавитьПолеВНабор(Набор, "НомерСтроки");
	ДобавитьПолеВНабор(Набор, "Активность");

КонецПроцедуры

// ---- Регистр бухгалтерии ------------------------------------------------------
Функция ЗаполнитьПоляВТБухгалтерии(Набор, ОМД, ИмяВТ)

	ВТ = ВРег(Строка(ИмяВТ));
	МаксСубконто = МаксимумКоличестваСубконто(ОМД);
	ПрефиксыСумм = СуммовыеПрефиксыБухгалтерии(ОМД);
	ПрефиксыБаланс = БалансовыеПрефиксыБухгалтерии(ОМД);
	// Когда свойство Балансовый недоступно, форма поля неизвестна, и обе ветки ниже
	// объявляют оба варианта: отсутствующее имя дало бы ложный отказ на реальном поле.
	БалансовостьИзвестна = БалансовостьРесурсовИзвестна(ОМД);

	// Ресурсы не перечислились — строить состав не из чего. Ложь означает «схема не
	// верифицирована»: вызывающая сторона предупредит и пропустит pre-flight. Это
	// честнее, чем подставить типовые имена: набор без реальных ресурсов дал бы
	// ложный отказ на каждом суммовом поле.
	Если ПрефиксыСумм.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// Измерения добавляются ВНУТРИ веток, а не безусловно в шапке: состав зависит от
	// вида ВТ. Односторонние таблицы (Остатки/Обороты/ОстаткиИОбороты) отдают измерения
	// плоскими именами; двусторонние (ОборотыДтКт, ДвиженияССубконто) — балансовое
	// измерение одним полем, небалансовое парой <Имя>Дт/<Имя>Кт. Плоское имя
	// небалансового измерения в двусторонней таблице не существует, и добавлять его
	// «на всякий случай» нельзя: набор перестаёт быть правдой — валидатор пропускает
	// поле, которое гарантированно упадёт в движке, и предлагает его как замену
	// реальному (issue #81: Валюта проходила validate_1c_query и падала «Поле не
	// найдено», а существующее ВалютаДт отклонялось до движка с подсказкой «Валюта»).

	Если ВТ = ВРег("Остатки") Тогда
		ДобавитьИменаКоллекцииВНабор(Набор, ОМД.Измерения);
		ДобавитьПолеВНабор(Набор, "Счет");
		ДобавитьПозиционныеСубконто(Набор, "Субконто", МаксСубконто);
		Для Каждого П Из ПрефиксыСумм Цикл
			ДобавитьСемействоОстаткаБухгалтерии(Набор, П, "Остаток");
		КонецЦикла;
		Возврат Истина;
	ИначеЕсли ВТ = ВРег("Обороты") Тогда
		ДобавитьИменаКоллекцииВНабор(Набор, ОМД.Измерения);
		ДобавитьПолеВНабор(Набор, "Счет");
		ДобавитьПозиционныеСубконто(Набор, "Субконто", МаксСубконто);
		// Обороты по счёту: общий оборот + дебетовый/кредитовый оборот этого счёта.
		Для Каждого П Из ПрефиксыСумм Цикл
			ДобавитьПолеВНабор(Набор, П + "Оборот");
			ДобавитьПолеВНабор(Набор, П + "ОборотДт");
			ДобавитьПолеВНабор(Набор, П + "ОборотКт");
		КонецЦикла;
		// Корреспондирующая сторона. У таблицы Оборотов регистра с корреспонденцией
		// есть полный разрез по корсчёту: сам счёт, его субконто, небалансовые
		// измерения с суффиксом Кор и обороты в корреспонденции. Ничего этого в
		// наборе не было — двадцать одно РЕАЛЬНОЕ поле отклонялось pre-flight до
		// движка, то есть нарушалась главная гарантия «ноль ложных отказов»
		// (проверено живьём: КорСчет и СуммаКорОборотДт → validation_failed_before_run).
		Если КорреспонденцияНеИсключена(ОМД) Тогда
			ДобавитьПолеВНабор(Набор, "КорСчет");
			ДобавитьПозиционныеСубконто(Набор, "КорСубконто", МаксСубконто);
			ДобавитьКорреспондирующиеИзмеренияБухгалтерии(Набор, ОМД);
			Для Каждого П Из ПрефиксыСумм Цикл
				// У балансового ресурса корреспондирующего оборота нет: сумма
				// корреспонденции и есть его оборот, отдельного КорОборота платформа
				// не заводит (в составе полей есть ВалютнаяСуммаКорОборот и прочие
				// небалансовые, но СуммаКорОборот отсутствует). Тот же принцип уже
				// применён к разрезу Дт/Кт в ОборотыДтКт.
				Если БалансовостьИзвестна И ПрефиксБалансовый(П, ПрефиксыБаланс) Тогда
					Продолжить;
				КонецЕсли;
				ДобавитьПолеВНабор(Набор, П + "КорОборот");
				ДобавитьПолеВНабор(Набор, П + "КорОборотДт");
				ДобавитьПолеВНабор(Набор, П + "КорОборотКт");
			КонецЦикла;
		КонецЕсли;
		Возврат Истина;
	ИначеЕсли ВТ = ВРег("ОборотыДтКт") Тогда
		ДобавитьИзмеренияПоСторонамБухгалтерии(Набор, ОМД);
		ДобавитьПолеВНабор(Набор, "СчетДт");
		ДобавитьПолеВНабор(Набор, "СчетКт");
		ДобавитьПозиционныеСубконто(Набор, "СубконтоДт", МаксСубконто);
		ДобавитьПозиционныеСубконто(Набор, "СубконтоКт", МаксСубконто);
		// Неразвёрнутый оборот в ДтКт существует ТОЛЬКО для балансовых ресурсов
		// (типовое «Сумма»): сумма корреспонденции Дт↔Кт одна, поэтому у балансового
		// ресурса есть общий {П}Оборот и НЕТ {П}ОборотДт/{П}ОборотКт (F5-fix).
		// Признаки учёта (НУ/ПР/ВР), валютная и количественная суммы по сторонам
		// различаются, поэтому доступны только в разрезе Дт/Кт.
		Для Каждого П Из ПрефиксыСумм Цикл
			Если БалансовостьИзвестна И НЕ ПрефиксБалансовый(П, ПрефиксыБаланс) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьПолеВНабор(Набор, П + "Оборот");
		КонецЦикла;
		Для Каждого П Из ПрефиксыСумм Цикл
			// Балансовый ресурс исключаем из Дт/Кт-разреза, иначе в набор попадают
			// фантомные поля (напр. СуммаОборотДт/СуммаОборотКт), которых нет в ВТ.
			Если БалансовостьИзвестна И ПрефиксБалансовый(П, ПрефиксыБаланс) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьПолеВНабор(Набор, П + "ОборотДт");
			ДобавитьПолеВНабор(Набор, П + "ОборотКт");
		КонецЦикла;
		Возврат Истина;
	ИначеЕсли ВТ = ВРег("ОстаткиИОбороты") Тогда
		ДобавитьИменаКоллекцииВНабор(Набор, ОМД.Измерения);
		ДобавитьПолеВНабор(Набор, "Счет");
		ДобавитьПозиционныеСубконто(Набор, "Субконто", МаксСубконто);
		ДобавитьПолеВНабор(Набор, "Период");
		Для Каждого П Из ПрефиксыСумм Цикл
			ДобавитьСемействоОстаткаБухгалтерии(Набор, П, "НачальныйОстаток");
			ДобавитьСемействоОстаткаБухгалтерии(Набор, П, "КонечныйОстаток");
			ДобавитьПолеВНабор(Набор, П + "Оборот");
			ДобавитьПолеВНабор(Набор, П + "ОборотДт");
			ДобавитьПолеВНабор(Набор, П + "ОборотКт");
		КонецЦикла;
		Возврат Истина;
	ИначеЕсли ВТ = ВРег("ДвиженияССубконто") Тогда
		// Единственная ВТ регистра с Регистратором. Раньше ветки не было вовсе:
		// функция возвращала Ложь, pre-flight для этой таблицы не работал, а
		// post-error hint перечислял плоские измерения регистра, из которых для неё
		// верно только балансовое (issue #81, третье следствие).
		//
		// Состав повторяет записи движений: служебные поля, стороны счёта, измерения
		// по сторонам, позиционные субконто и виды субконто по сторонам, ресурсы —
		// балансовый одним полем, небалансовые парой Дт/Кт, реквизиты — плоско.
		Если НЕ РегистрСКорреспонденцией(ОМД) Тогда
			// Регистр без корреспонденции устроен иначе (Счет и ВидДвижения вместо
			// сторон); его состав живой пробой не доказан, и до этого набор для него
			// не строится. Ложь = «схема не верифицирована»: вызывающая сторона даёт
			// предупреждение и пропускает pre-flight — деградация без ложных отказов.
			Возврат Ложь;
		КонецЕсли;
		ДобавитьИзмеренияПоСторонамБухгалтерии(Набор, ОМД);
		// Служебные поля — из СтандартныеРеквизиты, а не ручным перечислением: их состав
		// задаёт платформа, и ручной список оказался неполным. Не хватало
		// УточнениеПериода (пакетная проба ВЫБРАТЬ * на 8.3.27: у ДвиженияССубконто
		// 37 полей, ручной набор давал 36). Для pre-flight недостающее поле — ложный
		// отказ на реальном имени, то есть худший класс ошибки.
		//
		// Позиционные Субконто<N>/ВидСубконто<N> из коллекции исключаются: она описывает
		// таблицу записей, где аналитика позиционная, а в двусторонней ДвиженияССубконто
		// та же аналитика представлена парами по сторонам (СубконтоДт<N>/СубконтоКт<N>).
		// Голых позиционных имён здесь нет, и добавить их значило бы внести фантомы —
		// тот же дефект, что синтетические склейки префиксов (issue #91). Проверено на
		// Хозрасчетном: коллекция отдаёт 11 имён, из них 6 — позиционная аналитика.
		ДобавитьСлужебныеСтандартныеРеквизитыБухгалтерии(Набор, ОМД);
		// Страховка на случай недоступной коллекции — гарантированный минимум.
		ДобавитьПолеВНабор(Набор, "Период");
		ДобавитьПолеВНабор(Набор, "УточнениеПериода");
		ДобавитьПолеВНабор(Набор, "Регистратор");
		ДобавитьПолеВНабор(Набор, "НомерСтроки");
		ДобавитьПолеВНабор(Набор, "Активность");
		ДобавитьПолеВНабор(Набор, "СчетДт");
		ДобавитьПолеВНабор(Набор, "СчетКт");
		ДобавитьПозиционныеСубконто(Набор, "СубконтоДт", МаксСубконто);
		ДобавитьПозиционныеСубконто(Набор, "СубконтоКт", МаксСубконто);
		ДобавитьПозиционныеСубконто(Набор, "ВидСубконтоДт", МаксСубконто);
		ДобавитьПозиционныеСубконто(Набор, "ВидСубконтоКт", МаксСубконто);
		Для Каждого П Из ПрефиксыСумм Цикл
			Если НЕ БалансовостьИзвестна Тогда
				// Форма неизвестна — объявляем все три, чтобы не отклонить реальное поле.
				ДобавитьПолеВНабор(Набор, П);
				ДобавитьПолеВНабор(Набор, П + "Дт");
				ДобавитьПолеВНабор(Набор, П + "Кт");
			ИначеЕсли ПрефиксБалансовый(П, ПрефиксыБаланс) Тогда
				ДобавитьПолеВНабор(Набор, П);
			Иначе
				ДобавитьПолеВНабор(Набор, П + "Дт");
				ДобавитьПолеВНабор(Набор, П + "Кт");
			КонецЕсли;
		КонецЦикла;
		ДобавитьИменаКоллекцииВНабор(Набор, ОМД.Реквизиты);
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Измерения двусторонней таблицы: балансовое — одно поле, небалансовое хранится
// раздельно по сторонам проводки и в двусторонних таблицах называется <Имя>Дт/<Имя>Кт.
// Правило платформенное, поэтому ветвление идёт по свойству метаданных Балансовый,
// а не по именам конкретной конфигурации (Валюта/Подразделение — частный случай БП).
// Свойство подтверждено живой пробой на 8.3.27: у измерений Хозрасчетного печатается
// Да/Нет без исключений.
//
// Деградация: если свойство на какой-то платформе недоступно, добавляются все три
// формы. Это сохраняет контракт надмножества — ложное разрешение допустимо как
// временная потеря точности, ложный отказ на реальном поле запрещён.
Процедура ДобавитьИзмеренияПоСторонамБухгалтерии(Набор, ОМД)

	Попытка
		Коллекция = ОМД.Измерения;
	Исключение
		Возврат;
	КонецПопытки;
	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Измерение Из Коллекция Цикл
		Попытка
			Если Измерение.Балансовый Тогда
				ДобавитьПолеВНабор(Набор, Измерение.Имя);
			Иначе
				ДобавитьПолеВНабор(Набор, Измерение.Имя + "Дт");
				ДобавитьПолеВНабор(Набор, Измерение.Имя + "Кт");
			КонецЕсли;
		Исключение
			ДобавитьПолеВНабор(Набор, Измерение.Имя);
			ДобавитьПолеВНабор(Набор, Измерение.Имя + "Дт");
			ДобавитьПолеВНабор(Набор, Измерение.Имя + "Кт");
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Признак ведения регистра с корреспонденцией. При недоступности свойства — Ложь:
// вызывающая ветка тогда честно объявит схему не верифицированной вместо того,
// чтобы строить состав по недоказанному предположению.
Функция РегистрСКорреспонденцией(ОМД)

	Попытка
		Возврат ОМД.Корреспонденция = Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Та же проверка, но с противоположным поведением при недоступности свойства.
//
// Разница не в стиле, а в цене ошибки, и она зависит от того, что ветка делает с
// ответом. Там, где по ответу СТРОИТСЯ весь состав таблицы (ДвиженияССубконто),
// недоказанное «да» дало бы выдуманную схему — поэтому там Ложь и честная
// деградация. Здесь по ответу состав только ДОПОЛНЯЕТСЯ корреспондирующими
// полями, и недоказанное «нет» отняло бы у набора реальные поля, а недостающее
// поле в наборе — это ложный отказ pre-flight, то есть запрет строгий. Лишние
// поля у регистра без корреспонденции могут лишь не отклонить битое имя.
Функция КорреспонденцияНеИсключена(ОМД)

	Попытка
		Возврат ОМД.Корреспонденция <> Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

// Корреспондирующие измерения таблицы Оборотов: небалансовое измерение имеет
// пару с суффиксом Кор, балансовое — нет, оно общее для проводки. Проверено
// составом полей у платформы: есть ВалютаКор и ПодразделениеКор, но нет
// ОрганизацияКор, потому что Организация — балансовое измерение.
Процедура ДобавитьКорреспондирующиеИзмеренияБухгалтерии(Набор, ОМД)

	Попытка
		Коллекция = ОМД.Измерения;
	Исключение
		Возврат;
	КонецПопытки;
	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Измерение Из Коллекция Цикл
		Попытка
			Если НЕ Измерение.Балансовый Тогда
				ДобавитьПолеВНабор(Набор, Измерение.Имя + "Кор");
			КонецЕсли;
		Исключение
			// Свойство недоступно — добавляем пару как надмножество: лишнее поле
			// безопаснее отсутствующего (ложное разрешение против ложного отказа).
			ДобавитьПолеВНабор(Набор, Измерение.Имя + "Кор");
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Семейство остатковых полей одного ресурса. Состав снят у платформы пакетной
// пробой ВЫБРАТЬ * (8.3.27, БП КОРП): неразвёрнутый остаток в трёх формах —
// общий, Дт и Кт; развёрнутый — ТОЛЬКО по сторонам.
//
// Плоского развёрнутого остатка (Префикс + Развернутый + Корень без стороны) не
// существует: развёрнутое сальдо по определению раздельно по сторонам, сводить
// его в одно число нечем. Раньше оно объявлялось и давало шесть фантомов в
// Остатки и часть фантомов в ОстаткиИОбороты.
//
// Слово «Развернутый» ставится ПЕРЕД словом «Остаток», а не перед корнем целиком:
// платформа называет поле СуммаНачальныйРазвернутыйОстатокДт, а не
// СуммаРазвернутыйНачальныйОстатокДт. Прежний порядок давал для ОстаткиИОбороты
// одновременно фантомы и пропуски — одни и те же поля, записанные не так.
Процедура ДобавитьСемействоОстаткаБухгалтерии(Набор, Префикс, Корень)

	ДобавитьПолеВНабор(Набор, Префикс + Корень);
	ДобавитьПолеВНабор(Набор, Префикс + Корень + "Дт");
	ДобавитьПолеВНабор(Набор, Префикс + Корень + "Кт");

	Развернутый = СтрЗаменить(Корень, "Остаток", "РазвернутыйОстаток");
	ДобавитьПолеВНабор(Набор, Префикс + Развернутый + "Дт");
	ДобавитьПолеВНабор(Набор, Префикс + Развернутый + "Кт");

КонецПроцедуры

Процедура ДобавитьПозиционныеСубконто(Набор, Основа, Максимум)

	Для Номер = 1 По Максимум Цикл
		ДобавитьПолеВНабор(Набор, Основа + Строка(Номер));
	КонецЦикла;

КонецПроцедуры

Функция МаксимумКоличестваСубконто(ОМД)

	Попытка
		Значение = ОМД.МаксКоличествоСубконто;
		Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
			Возврат Мин(Значение, 10);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат 3;

КонецФункции

// Суммовые префиксы бухгалтерского регистра — фактические ресурсы, как они
// объявлены в метаданных (включая кастомные — закрывает R1 ТЗ).
Функция СуммовыеПрефиксыБухгалтерии(ОМД)

	Набор = Новый Соответствие;

	// Только фактические ресурсы регистра (универсально, в т.ч. нестандартные).
	//
	// Синтетическое семейство «базовые суммы × признаки учёта» отсюда убрано.
	// Оно задумывалось надмножеством ради страховки от ложных отказов, но давало
	// склейки, которых в конфигурации нет (ВалютнаяСуммаНУ и подобные), а тот же
	// набор объявляется клиенту в get_metadata_structure как достоверный состав
	// полей — клиент брал оттуда имя и получал от движка «Поле не найдено».
	// Разводить две роли отдельным флагом тоже неверно: контракт F-08 требует,
	// чтобы available_fields из pre-flight и common_fields из метаданных совпадали,
	// иначе подсказка при отказе перестаёт соответствовать объявленной схеме.
	// Набор один и построен по факту; страховка от ложных отказов обеспечивается
	// не выдуманными именами, а честной деградацией: если ресурсы не
	// перечисляются, схема объявляется неверифицированной и pre-flight пропускается.
	Для Каждого Имя Из ИменаРесурсовРегистра(ОМД) Цикл
		ДобавитьПолеВНабор(Набор, Имя);
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого КЗ Из Набор Цикл
		Результат.Добавить(КЗ.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Балансовые префиксы — те, что имеют неразвёрнутый оборот в ОборотыДтКт.
// Балансовый ресурс участвует в Дт и Кт одной проводки, поэтому помимо
// ОборотДт/ОборотКт у него есть общий Оборот.
//
// Первичный источник — свойство метаданных Балансовый у ресурса (подтверждено
// живой пробой на 8.3.27: Сумма -> Да, ВалютнаяСумма/Количество/НУ/ПР/ВР -> Нет).
// Прежняя эвристика «балансовый = ресурс с именем Сумма» остаётся только
// деградацией на случай недоступности свойства: имя — конвенция типовых
// конфигураций, а не правило платформы, и кастомный балансовый ресурс с другим
// именем она теряла.
Функция БалансовыеПрефиксыБухгалтерии(ОМД)

	Результат = Новый Массив;
	Попытка
		Для Каждого Ресурс Из ОМД.Ресурсы Цикл
			Попытка
				Если Ресурс.Балансовый Тогда
					Результат.Добавить(Ресурс.Имя);
				КонецЕсли;
			Исключение
				// Свойство недоступно у этого ресурса — молча пропускаем. Ответ на
				// недоступность даёт не эта функция, а БалансовостьРесурсовИзвестна:
				// ветки состава тогда объявляют обе формы поля сразу.
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;

	// Пустой список — легитимный факт метаданных: у регистра нет балансовых
	// ресурсов. Дописывать сюда типовое имя нельзя, оно конфигурационно-зависимо.
	Возврат Результат;

КонецФункции

// Доступно ли свойство Балансовый хотя бы у одного ресурса.
//
// Прежняя деградация подставляла ресурс с именем «Сумма» — конвенцию типовых
// российских конфигураций, а не правило платформы: на другой конфигурации
// балансовый ресурс называется иначе, и набор получался неверным в обе стороны.
// Теперь недоступность свойства не угадывается по имени, а честно объявляется, и
// ветки состава добавляют обе формы поля — общую и по сторонам. Лишнее имя может
// лишь не отклонить битое поле, тогда как недостающее даёт ложный отказ на
// реальном, что запрещено.
Функция БалансовостьРесурсовИзвестна(ОМД)

	Попытка
		Для Каждого Ресурс Из ОМД.Ресурсы Цикл
			Попытка
				Если Ресурс.Балансовый Или НЕ Ресурс.Балансовый Тогда
					Возврат Истина;
				КонецЕсли;
			Исключение
				Возврат Ложь;
			КонецПопытки;
		КонецЦикла;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	// Ресурсов нет вовсе — вопрос балансовости не возникает.
	Возврат Истина;

КонецФункции

// Истина, если префикс — балансовый (входит в БалансовыеПрефиксыБухгалтерии).
// Универсально, без хардкода имени: список балансовых определяется по ОМД.Ресурсы.
Функция ПрефиксБалансовый(Префикс, ПрефиксыБаланс)

	ВерхПрефикс = ВРег(Строка(Префикс));
	Для Каждого Балансовый Из ПрефиксыБаланс Цикл
		Если ВРег(Строка(Балансовый)) = ВерхПрефикс Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ---- Регистр сведений (срезы) -------------------------------------------------
Функция ЗаполнитьПоляВТСведений(Набор, ОМД, ИмяВТ)

	ВТ = ВРег(Строка(ИмяВТ));
	Если ВТ <> ВРег("СрезПоследних") И ВТ <> ВРег("СрезПервых") Тогда
		Возврат Ложь;
	КонецЕсли;

	ДобавитьИменаКоллекцииВНабор(Набор, ОМД.Измерения);
	ДобавитьИменаКоллекцииВНабор(Набор, ОМД.Ресурсы);
	ДобавитьИменаКоллекцииВНабор(Набор, ОМД.Реквизиты);
	// Срез всегда отдаёт Период; для подчинённых регистратору — служебные поля.
	ДобавитьПолеВНабор(Набор, "Период");
	ДобавитьПолеВНабор(Набор, "Регистратор");
	ДобавитьПолеВНабор(Набор, "Активность");
	ДобавитьПолеВНабор(Набор, "НомерСтроки");
	Возврат Истина;

КонецФункции

Функция РегистрНакопленияХранитОстатки(ОМД)

	Попытка
		Возврат СтрНайти(ВРег(Строка(ОМД.ВидРегистра)), "ОСТАТ") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция РегистрИмеетПериодМД(ОМД)

	Попытка
		Возврат ОМД.СтандартныеРеквизиты.Найти("Период") <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ПериодичностьРегистраСведений(ОМД, Вид)

	Если Вид <> "РегистрСведений" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Если ОМД.Периодичность <> Неопределено Тогда
			Возврат Строка(ОМД.Периодичность);
		КонецЕсли;
	Исключение
		// В некоторых версиях/типах регистра свойство недоступно.
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПоддерживаетСсылку(Вид)
	Возврат Вид = "Справочник" ИЛИ Вид = "Документ" ИЛИ Вид = "Перечисление"
		ИЛИ Вид = "ПланВидовХарактеристик" ИЛИ Вид = "ПланСчетов"
		ИЛИ Вид = "ПланВидовРасчета" ИЛИ Вид = "ПланОбмена"
		ИЛИ Вид = "БизнесПроцесс" ИЛИ Вид = "Задача";
КонецФункции

Функция ЯвляетсяИерархическим(ОМД, Вид)
	Если Вид = "Справочник" Тогда
		Попытка
			Возврат ОМД.Иерархический;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ПолучитьБулевоОпции(Опции, Имя, ПоУмолчанию)

	Если Опции = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если (ТипЗнч(Опции) = Тип("Структура")
		ИЛИ ТипЗнч(Опции) = Тип("ФиксированнаяСтруктура"))
		И Опции.Свойство(Имя, Значение) Тогда
		Возврат ?(ТипЗнч(Значение) = Тип("Булево"), Значение, ПоУмолчанию);
	ИначеЕсли ТипЗнч(Опции) = Тип("Соответствие")
		ИЛИ ТипЗнч(Опции) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Опции.Получить(Имя);
		Возврат ?(ТипЗнч(Значение) = Тип("Булево"), Значение, ПоУмолчанию);
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

// Опции по умолчанию для СтруктураОбъекта.
Функция ОпцииСтруктурыПоУмолчанию() Экспорт

	Стр = Новый Структура;
	Стр.Вставить("include_standard_attributes", Истина);
	Стр.Вставить("include_attributes", Истина);
	Стр.Вставить("include_tabular_sections", Истина);
	Стр.Вставить("include_forms", Ложь);
	Стр.Вставить("include_commands", Ложь);
	Стр.Вставить("include_query_names", Истина);
	Стр.Вставить("include_sensitive_flags", Истина);
	Стр.Вставить("include_virtual_tables", Истина);
	Возврат Стр;

КонецФункции

// ---- Оракул состава обычных (не виртуальных) таблиц запроса --------------
//
// Набор имён полей таблицы запроса для pre-flight проверки существования поля.
// Контракт тот же, что у ПолныйНаборПолейВиртуальнойТаблицы: возвращается
// НАДмножество реальных колонок, поэтому отклонять можно только имя, которого
// в наборе НЕТ. Любое сомнение трактуется в пользу включения имени (проверка
// промахнётся, запрос уйдёт на движок) либо в пользу supported=Ложь (проверка
// не выполняется вовсе). Ложный отказ валидного запроса недопустим.
//
// Два набора возвращаются раздельно и это принципиально:
//   fields        — оракул существования: полный, необрезанный, БЕЗ фильтра
//                   политики доступа. Если фильтровать по allowed, скрытое поле
//                   превратится в field_not_found вместо field_not_allowed;
//                   если обрезать по количеству, «широкий» объект получит
//                   ложный отказ на реальном поле.
//   public_fields — то, что показывается клиенту (available_fields, did_you_mean):
//                   через MCP_Security.ПолеРазрешено и с обрезкой по количеству.
//
// ИмяТабличнойЧасти <> "" — набор строится для таблицы табличной части
// (<Вид>.<Имя>.<ИмяТЧ>), иначе для основной таблицы объекта.
//
// Структура результата: { supported, fields, public_fields, reason, table_kind }.
// Никогда не бросает исключение: при сбое интроспекции supported=Ложь.
Функция ПолныйНаборПолейТаблицыЗапроса(ПолноеИмя, ИмяТабличнойЧасти = "") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("supported", Ложь);
	Результат.Вставить("fields", Новый Массив);
	Результат.Вставить("public_fields", Новый Массив);
	Результат.Вставить("reason", "");
	Результат.Вставить("table_kind", "");

	Попытка
		ОМД = ОбъектМетаданныхПоПолномуИмени(ПолноеИмя);
		Если ОМД = Неопределено Тогда
			Результат.reason = "object_not_found";
			Возврат Результат;
		КонецЕсли;

		Вид = ВидПоОбъектуМетаданных(ОМД);
		Результат.table_kind = Вид;
		// Набор — дедупликация по ВРег(имя), Порядок — порядок метаданных.
		// Обход Соответствие даёт произвольный порядок, поэтому список для показа
		// строится только по Порядку: иначе усечение отбрасывало бы случайные поля.
		Набор = Новый Соответствие;
		Порядок = Новый Массив;
		КонтекстПолей = ПолноеИмя;

		Если НЕ ПустаяСтрока(ИмяТабличнойЧасти) Тогда
			Поиск = НайтиТабличнуюЧастьПоИмени(ОМД, ИмяТабличнойЧасти);
			Если НЕ Поиск.found Тогда
				Результат.reason = "tabular_part_not_found";
				Возврат Результат;
			КонецЕсли;
			Если Поиск.collection = "standard" Тогда
				// Реквизиты стандартных табличных частей (ВидыСубконто, Состав и
				// подобные) платформа через ТЧ.Реквизиты не перечисляет — оракула
				// нет, проверку полей не выполняем.
				Результат.reason = "standard_tabular_part_not_introspectable";
				Возврат Результат;
			КонецЕсли;
			// Реквизиты идут первыми: это содержательные поля, и при усечении списка
			// для показа они должны остаться, а не служебные.
			ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, Поиск.tabular_section.Реквизиты);
			Попытка
				ДобавитьИменаКоллекцииВУпорядоченныйНабор(
					Набор, Порядок, Поиск.tabular_section.СтандартныеРеквизиты);
			Исключение
				// Коллекция недоступна — страховка ниже добавит обязательный минимум.
			КонецПопытки;
			// Есть у таблицы любой табличной части независимо от интроспекции.
			ДобавитьПолеВУпорядоченныйНабор(Набор, Порядок, "Ссылка");
			ДобавитьПолеВУпорядоченныйНабор(Набор, Порядок, "НомерСтроки");
			КонтекстПолей = ПолноеИмя + "." + Поиск.tabular_section.Имя;
		ИначеЕсли Вид = "Константа" Тогда
			// У таблицы константы единственное содержательное поле (основание F-03).
			ДобавитьПолеВУпорядоченныйНабор(Набор, Порядок, "Значение");
			Результат.reason = "constant_single_field";
		ИначеЕсли Вид = "РегистрСведений" ИЛИ Вид = "РегистрНакопления" Тогда
			Если НЕ ЕстьКоллекцияСтандартныхРеквизитов(ОМД) Тогда
				Результат.reason = "standard_attributes_unavailable";
				Возврат Результат;
			КонецЕсли;
			// Псевдополей не добавляем: СтандартныеРеквизиты отдают именно тот
			// набор, который есть у этого регистра (у независимого непериодического
			// регистра сведений нет ни Периода, ни Регистратора).
			ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, ОМД.Измерения);
			ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, ОМД.Ресурсы);
			ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, ОМД.Реквизиты);
			ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, ОМД.СтандартныеРеквизиты);
		ИначеЕсли ВидПоддерживаетТабличныеЧасти(Вид) Тогда
			Если НЕ ЕстьКоллекцияСтандартныхРеквизитов(ОМД) Тогда
				// Без Кода/Наименования/Ссылки набор неполон и даст ложные отказы.
				Результат.reason = "standard_attributes_unavailable";
				Возврат Результат;
			КонецЕсли;
			ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, ОМД.Реквизиты);
			ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, ОМД.СтандартныеРеквизиты);
			ДобавитьИменаТабличныхЧастейВНабор(Набор, Порядок, ОМД);
			ДобавитьПризнакиУчетаВНабор(Набор, Порядок, ОМД);
			ДобавитьПлатформенныеПсевдополяОбъекта(Набор, Порядок);
		Иначе
			// РегистрБухгалтерии (производные СуммаДт/СуммаКт, СчетДт/СчетКт,
			// Субконто* — за них отвечает отдельная диагностика subconto_wrong_table),
			// РегистрРасчета (периоды действия, перерасчёты), Перечисление,
			// неизвестный вид — оракула нет, поля не проверяем.
			Результат.reason = "table_kind_not_covered";
			Возврат Результат;
		КонецЕсли;

		Если Набор.Количество() = 0 Тогда
			// Пустой набор не используем как оракул отклонения.
			Результат.reason = "empty_field_set";
			Возврат Результат;
		КонецЕсли;

		Результат.fields = Порядок;
		// Публичный набор НЕ усекается: он же используется для did_you_mean, а поиск
		// кандидата по усечённому списку не находил реально существующее поле (DEF-02).
		// Усечение для показа — забота места формирования диагностики.
		ЗаполнитьПубличныеПоляНабора(Результат.public_fields, Порядок, КонтекстПолей);
		Результат.supported = Истина;
	Исключение
		Результат.supported = Ложь;
		Результат.fields = Новый Массив;
		Результат.public_fields = Новый Массив;
		Результат.reason = "introspection_error: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Табличные части объекта для pre-flight проверки источника <Вид>.<Имя>.<ИмяТЧ>
// и для детекта коллизии псевдонима с именем табличной части.
//
// supported=Истина только когда коллекция ТабличныеЧасти реально прочитана;
// has_collection говорит о том же явно. names — обычные ТЧ, standard_names —
// стандартные (ВидыСубконто, Состав, *ВидыРасчета): они существуют как источники
// запроса, но перечисляются отдельной коллекцией платформы.
//
// Структура результата: { supported, names, standard_names, has_collection, kind, reason }.
// Никогда не бросает исключение.
Функция ТабличныеЧастиТаблицыЗапроса(ПолноеИмя) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("supported", Ложь);
	Результат.Вставить("names", Новый Массив);
	Результат.Вставить("standard_names", Новый Массив);
	Результат.Вставить("has_collection", Ложь);
	Результат.Вставить("kind", "");
	Результат.Вставить("reason", "");

	Попытка
		ОМД = ОбъектМетаданныхПоПолномуИмени(ПолноеИмя);
		Если ОМД = Неопределено Тогда
			Результат.reason = "object_not_found";
			Возврат Результат;
		КонецЕсли;

		Вид = ВидПоОбъектуМетаданных(ОМД);
		Результат.kind = Вид;
		Если НЕ ВидПоддерживаетТабличныеЧасти(Вид) Тогда
			Результат.reason = "kind_without_tabular_parts";
			Возврат Результат;
		КонецЕсли;

		Попытка
			Для Каждого ТЧ Из ОМД.ТабличныеЧасти Цикл
				Результат.names.Добавить(ТЧ.Имя);
			КонецЦикла;
			Результат.has_collection = Истина;
		Исключение
			Результат.reason = "tabular_parts_unavailable";
			Возврат Результат;
		КонецПопытки;

		Попытка
			Для Каждого ТЧ Из ОМД.СтандартныеТабличныеЧасти Цикл
				Результат.standard_names.Добавить(ТЧ.Имя);
			КонецЦикла;
		Исключение
			// Коллекция недоступна в этой версии платформы — считаем пустой.
		КонецПопытки;

		Результат.supported = Истина;
	Исключение
		Результат.supported = Ложь;
		Результат.reason = "introspection_error: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Виды метаданных, у которых бывают табличные части. Только эти виды участвуют
// в проверке источника <Вид>.<Имя>.<ИмяТЧ>: у регистров третий сегмент — это
// виртуальная таблица или служебная таблица платформы, а не табличная часть.
Функция ВидПоддерживаетТабличныеЧасти(Вид) Экспорт

	Возврат Вид = "Справочник"
		ИЛИ Вид = "Документ"
		ИЛИ Вид = "ПланСчетов"
		ИЛИ Вид = "ПланВидовХарактеристик"
		ИЛИ Вид = "ПланВидовРасчета"
		ИЛИ Вид = "ПланОбмена"
		ИЛИ Вид = "БизнесПроцесс"
		ИЛИ Вид = "Задача";

КонецФункции

// Третьи сегменты имени источника, которые являются таблицами платформы, а не
// табличными частями. Обращение к ним не должно давать tabular_part_not_found.
// Регистровые имена перечислены как бесплатная страховка: виды регистров и так
// не проходят ВидПоддерживаетТабличныеЧасти.
Функция ПлатформенныеПодтаблицыОбъекта() Экспорт

	Результат = Новый Массив;
	Результат.Добавить("Изменения");
	Результат.Добавить("ТочкаМаршрута");
	Результат.Добавить("ВидыСубконто");
	Результат.Добавить("Состав");
	Результат.Добавить("БазовыеВидыРасчета");
	Результат.Добавить("ВедущиеВидыРасчета");
	Результат.Добавить("ВытесняющиеВидыРасчета");
	Результат.Добавить("Субконто");
	Результат.Добавить("ДвиженияССубконто");
	Результат.Добавить("Обороты");
	Результат.Добавить("Остатки");
	Результат.Добавить("ОстаткиИОбороты");
	Результат.Добавить("ОборотыДтКт");
	Результат.Добавить("СрезПоследних");
	Результат.Добавить("СрезПервых");
	Результат.Добавить("ДанныеГрафика");
	Результат.Добавить("ФактическийПериодДействия");
	Результат.Добавить("Границы");
	Результат.Добавить("Перерасчет");
	Возврат Результат;

КонецФункции

// Ищет табличную часть без учёта регистра (идентификаторы языка запросов 1С
// регистронезависимы) сначала в обычных, затем в стандартных табличных частях.
// Возвращает { found, collection: "regular"|"standard", tabular_section }.
Функция НайтиТабличнуюЧастьПоИмени(ОМД, Имя)

	Результат = Новый Структура;
	Результат.Вставить("found", Ложь);
	Результат.Вставить("collection", "");
	Результат.Вставить("tabular_section", Неопределено);

	ИскомоеИмя = ВРег(СокрЛП(Строка(Имя)));
	Если ПустаяСтрока(ИскомоеИмя) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Для Каждого ТЧ Из ОМД.ТабличныеЧасти Цикл
			Если ВРег(ТЧ.Имя) = ИскомоеИмя Тогда
				Результат.found = Истина;
				Результат.collection = "regular";
				Результат.tabular_section = ТЧ;
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Коллекция недоступна — пробуем стандартные табличные части.
	КонецПопытки;

	Попытка
		Для Каждого ТЧ Из ОМД.СтандартныеТабличныеЧасти Цикл
			Если ВРег(ТЧ.Имя) = ИскомоеИмя Тогда
				Результат.found = Истина;
				Результат.collection = "standard";
				Результат.tabular_section = ТЧ;
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Коллекция недоступна в этой версии платформы.
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Имена табличных частей — это поля-вложенные-таблицы объекта-владельца
// (Док.Товары, Док.Товары.(Номенклатура)). Без них любой запрос с вложенной
// таблицей получил бы ложный отказ.
Процедура ДобавитьИменаТабличныхЧастейВНабор(Набор, Порядок, ОМД)

	Попытка
		ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, ОМД.ТабличныеЧасти);
	Исключение
		// Коллекции нет — не страшно, набор остаётся надмножеством меньшего размера.
	КонецПопытки;
	Попытка
		ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, ОМД.СтандартныеТабличныеЧасти);
	Исключение
		// Коллекция недоступна в этой версии платформы.
	КонецПопытки;

КонецПроцедуры

// Упорядоченные варианты: дедупликация в Наборе, порядок метаданных в Порядке.
// Базовые ДобавитьПолеВНабор / ДобавитьИменаКоллекцииВНабор не тронуты —
// их использует генератор полей виртуальных таблиц.
Процедура ДобавитьПолеВУпорядоченныйНабор(Набор, Порядок, Имя)

	Если Имя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Значение = СокрЛП(Строка(Имя));
	Если ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;
	Ключ = ВРег(Значение);
	Если Набор.Получить(Ключ) = Неопределено Тогда
		Набор.Вставить(Ключ, Значение);
		Порядок.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, Коллекция)

	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Для Каждого Элемент Из Коллекция Цикл
			ДобавитьПолеВУпорядоченныйНабор(Набор, Порядок, Элемент.Имя);
		КонецЦикла;
	Исключение
		// Коллекция недоступна или нестандартна — пропускаем.
	КонецПопытки;

КонецПроцедуры

// Признаки учёта плана счетов — реальные поля таблицы (Счета.Валютный,
// Счета.Количественный), которых нет ни в Реквизитах, ни в СтандартныеРеквизиты.
Процедура ДобавитьПризнакиУчетаВНабор(Набор, Порядок, ОМД)

	Попытка
		ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, ОМД.ПризнакиУчета);
	Исключение
		// Вид без признаков учёта.
	КонецПопытки;
	Попытка
		ДобавитьИменаКоллекцииВУпорядоченныйНабор(Набор, Порядок, ОМД.ПризнакиУчетаСубконто);
	Исключение
		// Вид без признаков учёта субконто.
	КонецПопытки;

КонецПроцедуры

// Страховка от различий между версиями платформы: имена, которые доступны у
// объектных таблиц в запросе, но могут не попасть в интроспекцию. Каждое имя —
// реальное платформенное, поэтому детекция опечаток не деградирует.
Процедура ДобавитьПлатформенныеПсевдополяОбъекта(Набор, Порядок)

	ДобавитьПолеВУпорядоченныйНабор(Набор, Порядок, "Ссылка");
	ДобавитьПолеВУпорядоченныйНабор(Набор, Порядок, "Представление");
	ДобавитьПолеВУпорядоченныйНабор(Набор, Порядок, "ПометкаУдаления");
	ДобавитьПолеВУпорядоченныйНабор(Набор, Порядок, "Предопределенный");
	ДобавитьПолеВУпорядоченныйНабор(Набор, Порядок, "ИмяПредопределенныхДанных");

КонецПроцедуры

Функция ЕстьКоллекцияСтандартныхРеквизитов(ОМД)

	Попытка
		Возврат ОМД.СтандартныеРеквизиты.Количество() > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Публичная проекция набора: только разрешённые политикой поля и не более
// Максимум штук. Идёт в available_fields и did_you_mean.
Процедура ЗаполнитьПубличныеПоляНабора(Приемник, Поля, КонтекстПолноеИмя)

	Для Каждого Имя Из Поля Цикл
		Попытка
			Если MCP_Security.ПолеРазрешено(КонтекстПолноеИмя, Имя) Тогда
				Приемник.Добавить(Имя);
			КонецЕсли;
		Исключение
			// Нестандартный контекст политики — поле не показываем.
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры
