// MCP_Security.bsl
// ====================================================================
// Слой безопасности MCP-сервера.
// Проверяет allowlist/denylist типов и полей, права 1С и роль администратора MCP.
// ====================================================================

// ---- Тип / Вид ------------------------------------------------------

Функция ТипРазрешен(ПолноеИмяТипа) Экспорт

	Возврат ДоступКТипу(ПолноеИмяТипа).allowed;

КонецФункции

Функция ДоступКТипу(ПолноеИмяТипа, Операция = "read") Экспорт

	Результат = РезультатДоступа(Ложь, MCP_Errors.Код_TypeNotAllowed(),
		"mcp_type_not_allowed", "Тип запрещён политикой MCP: " + Строка(ПолноеИмяТипа),
		ПолноеИмяТипа, Операция);

	Если НЕ ПолноеИмяБезопасноДляЗапроса(ПолноеИмяТипа) Тогда
		Результат.code = MCP_Errors.Код_InvalidArguments();
		Результат.reason_code = "invalid_type_name";
		Результат.message = "Некорректное имя типа: " + Строка(ПолноеИмяТипа);
		Возврат Результат;
	КонецЕсли;

	Если НЕ ТипРазрешенПолитикойMCP(ПолноеИмяТипа) Тогда
		Возврат Результат;
	КонецЕсли;

	ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТипа);
	Если ОМД = Неопределено Тогда
		Результат.code = MCP_Errors.Код_MetadataNotFound();
		Результат.reason_code = "metadata_not_found";
		Результат.message = "Объект метаданных не найден: " + ПолноеИмяТипа;
		Возврат Результат;
	КонецЕсли;

	Право = ПравоДоступаДляТипа(ПолноеИмяТипа, Операция);
	Если НЕ ПустаяСтрока(Право) Тогда
		Попытка
			Если НЕ ПравоДоступа(Право, ОМД) Тогда
				Результат.code = MCP_Errors.Код_AccessDenied();
				Результат.reason_code = "1c_access_denied";
				Результат.message = "Недостаточно прав 1С на " + Право + ": " + ПолноеИмяТипа;
				Результат.platform_right = Право;
				Возврат Результат;
			КонецЕсли;
		Исключение
			Если MCP_Errors.ЭтоОтказДоступаПлатформы(ОписаниеОшибки()) Тогда
				Результат.code = MCP_Errors.Код_AccessDenied();
				Результат.reason_code = "1c_access_denied";
				Результат.message = "Недостаточно прав 1С на " + Право + ": " + ПолноеИмяТипа;
				Результат.platform_right = Право;
				Результат.platform_message = ОписаниеОшибки();
				Возврат Результат;
			КонецЕсли;
			// Если конкретная платформа/тип метаданных не поддерживает ПравоДоступа,
			// не блокируем discovery: фактическая операция всё равно поймает отказ.
		КонецПопытки;
	КонецЕсли;

	Результат.allowed = Истина;
	Результат.code = "";
	Результат.reason_code = "";
	Результат.message = "";
	Возврат Результат;

КонецФункции

Процедура ПроверитьДоступКТипу(ПолноеИмяТипа, Операция = "read") Экспорт

	Доступ = ДоступКТипу(ПолноеИмяТипа, Операция);
	Если Доступ.allowed Тогда
		Возврат;
	КонецЕсли;

	Если Доступ.code = MCP_Errors.Код_InvalidArguments()
		ИЛИ Доступ.code = MCP_Errors.Код_MetadataNotFound() Тогда
		Детали = Новый Структура;
		Детали.Вставить("type", Доступ.type);
		Детали.Вставить("operation", Доступ.operation);
		MCP_Errors.ВозбудитьОшибку(Доступ.code, Доступ.message, Детали);
	КонецЕсли;

	MCP_Errors.ВозбудитьОшибку(Доступ.code, Доступ.message, ДеталиОтказаДоступа(Доступ));

КонецПроцедуры

Функция ТипРазрешенПолитикойMCP(ПолноеИмяТипа)

	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат Истина;
	КонецЕсли;

	// Denied list.
	Для Каждого ЗапрещенныйТип Из Allowlist.denied_objects Цикл
		Если ВРег(Строка(ЗапрещенныйТип)) = ВРег(ПолноеИмяТипа) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	// Если есть explicit разрешение.
	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа <> Неопределено Тогда
		Возврат ПолучитьБулево(КонфигТипа, "read", Ложь);
	КонецЕсли;

	// Default policy.
	Если ВРег(Allowlist.default_policy) = "ALLOW" Тогда
		// Проверим, что вид метаданных в allowed_kinds.
		Вид = ВидМетаданныхИзПолногоИмени(ПолноеИмяТипа);
		Для Каждого РазрешенныйВид Из Allowlist.allowed_kinds Цикл
			Если ВРег(РазрешенныйВид) = ВРег(Вид) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция РезультатДоступа(Allowed, Код, ReasonCode, Сообщение, ПолноеИмяТипа, Операция)

	Результат = Новый Структура;
	Результат.Вставить("allowed", Allowed);
	Результат.Вставить("code", Код);
	Результат.Вставить("reason_code", ReasonCode);
	Результат.Вставить("message", Сообщение);
	Результат.Вставить("type", Строка(ПолноеИмяТипа));
	Результат.Вставить("operation", Строка(Операция));
	Результат.Вставить("platform_right", "");
	Результат.Вставить("platform_message", "");
	Возврат Результат;

КонецФункции

Функция ДеталиОтказаДоступа(Доступ) Экспорт

	Авторизация = Новый Структура;
	Авторизация.Вставить("reason_code", Доступ.reason_code);
	Авторизация.Вставить("denied_operation", Доступ.operation);
	Авторизация.Вставить("denied_type", Доступ.type);
	Авторизация.Вставить("retry_policy", "do_not_retry_same_request_without_reauth_or_permission_change");
	Если НЕ ПустаяСтрока(Доступ.platform_right) Тогда
		Авторизация.Вставить("platform_right", Доступ.platform_right);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Доступ.platform_message) Тогда
		Авторизация.Вставить("platform_message", Доступ.platform_message);
	КонецЕсли;

	Детали = Новый Структура;
	Детали.Вставить("authorization", Авторизация);
	Детали.Вставить("type", Доступ.type);
	Детали.Вставить("operation", Доступ.operation);
	Возврат Детали;

КонецФункции

Функция ПравоДоступаДляТипа(ПолноеИмяТипа, Операция)

	Вид = ВидМетаданныхИзПолногоИмени(ПолноеИмяТипа);
	Если Вид = "Отчет" ИЛИ Вид = "Обработка" Тогда
		Возврат "Использование";
	КонецЕсли;
	Возврат "Чтение";

КонецФункции

Функция ВидРазрешен(Вид) Экспорт

	Allowlist = MCP_Config.Allowlist();
	Для Каждого Р Из Allowlist.allowed_kinds Цикл
		Если ВРег(Р) = ВРег(Вид) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ---- Поля ----------------------------------------------------------

Функция ПолеРазрешено(ПолноеИмяТипа, ИмяПоля) Экспорт

	ПроверяемыйТип = ПолноеИмяОбъектаИзКонтекста(ПолноеИмяТипа);

	// Privacy здесь ничего не решает: закрытое поле выбирается и возвращается,
	// подмена значения происходит при сборке ответа. Разрешённость поля — это
	// только allowlist и hidden_fields.
	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат ТипРазрешен(ПроверяемыйТип);
	КонецЕсли;

	КонфигТипа = ПолучитьКонфигурациюТипа(ПроверяемыйТип);
	Если КонфигТипа = Неопределено Тогда
		Возврат ТипРазрешен(ПроверяемыйТип);
	КонецЕсли;

	КонтекстныйПуть = "";
	Если ВРег(ПолноеИмяТипа) <> ВРег(ПроверяемыйТип) Тогда
		КонтекстныйПуть = Сред(ПолноеИмяТипа, СтрДлина(ПроверяемыйТип) + 2) + "." + ИмяПоля;
	КонецЕсли;

	HiddenFields = ПолучитьМассив(КонфигТипа, "hidden_fields");
	Для Каждого H Из HiddenFields Цикл
		Если ВРег(H) = ВРег(ИмяПоля)
			ИЛИ (НЕ ПустаяСтрока(КонтекстныйПуть) И ВРег(H) = ВРег(КонтекстныйПуть)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ПоляПоискаПоУмолчанию(ПолноеИмяТипа) Экспорт

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа = Неопределено Тогда
		Возврат ПоляПоискаЗаглушка(ПолноеИмяТипа);
	КонецЕсли;

	Возврат ПолучитьМассив(КонфигТипа, "search_fields");

КонецФункции

Функция ПоляПоискаЗаглушка(ПолноеИмяТипа)

	Массив = Новый Массив;
	Если СтрНачинаетсяС(ПолноеИмяТипа, "Справочник.") Тогда
		Массив.Добавить("Код");
		Массив.Добавить("Наименование");
	ИначеЕсли СтрНачинаетсяС(ПолноеИмяТипа, "Документ.") Тогда
		Массив.Добавить("Номер");
	КонецЕсли;
	Возврат Массив;

КонецФункции

Функция ПоляПоУмолчанию(ПолноеИмяТипа) Экспорт

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат ПолучитьМассив(КонфигТипа, "default_fields");

КонецФункции

Функция СкрытыеПоля(ПолноеИмяТипа) Экспорт

	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяТипа);
	Если КонфигТипа = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат ПолучитьМассив(КонфигТипа, "hidden_fields");

КонецФункции

// ---- Tools ---------------------------------------------------------

Функция ToolРазрешен(ИмяТула, Контекст = Неопределено) Экспорт

	// Все read-only tools по умолчанию доступны, но некоторые опции — только админу MCP.
	Возврат Истина;

КонецФункции

Функция ВариантОтчетаРазрешен(ПолноеИмяОтчета, Вариант) Экспорт

	Если НЕ ТипРазрешен(ПолноеИмяОтчета) Тогда
		Возврат Ложь;
	КонецЕсли;
	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат Истина;
	КонецЕсли;

	КонфигТипа = ПолучитьКонфигурациюТипа(ПолноеИмяОтчета);
	Если КонфигТипа = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	AllowedVariants = ПолучитьМассив(КонфигТипа, "allowed_variants");
	Если AllowedVariants.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ИмяВарианта = "";
	Если Вариант <> Неопределено И Вариант <> Null Тогда
		ИмяВарианта = Строка(Вариант);
	КонецЕсли;
	Если ПустаяСтрока(ИмяВарианта) Тогда
		ИмяВарианта = "Основной";
	КонецЕсли;

	Для Каждого РазрешенныйВариант Из AllowedVariants Цикл
		Если Строка(РазрешенныйВариант) = "*"
			ИЛИ ВРег(Строка(РазрешенныйВариант)) = ВРег(ИмяВарианта) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЯвляетсяАдминомMCP() Экспорт

	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат Истина;
	КонецЕсли;

	Имя = ИмяТекущегоПользователя();
	Для Каждого A Из Allowlist.admin_users Цикл
		Если ВРег(A) = ВРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ---- BaseURL ------------------------------------------------------

Функция BaseURLРазрешен(BaseURL) Экспорт

	Если ПустаяСтрока(BaseURL) Тогда
		Возврат Истина;
	КонецЕсли;

	НормСхема = НРег(СокрЛП(Строка(BaseURL)));
	Если НЕ СтрНачинаетсяС(НормСхема, "https://")
		И НЕ СтрНачинаетсяС(НормСхема, "http://") Тогда
		Возврат Ложь;
	КонецЕсли;

	Allowlist = MCP_Config.Allowlist();
	Если ОграниченияДанныхОтключены(Allowlist) Тогда
		Возврат Истина;
	КонецЕсли;

	НормBaseURL = ВРег(НормализоватьURLДляСравнения(BaseURL));
	Для Каждого ДопустимыйURL Из Allowlist.allowed_base_urls Цикл
		НормДопустимыйURL = ВРег(НормализоватьURLДляСравнения(ДопустимыйURL));
		Если ПустаяСтрока(НормДопустимыйURL) Тогда
			Продолжить;
		КонецЕсли;
		Если НормBaseURL = НормДопустимыйURL
			ИЛИ СтрНачинаетсяС(НормBaseURL, НормДопустимыйURL + "/") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// ---- Маскирование данных для LLM -----------------------------------

Функция МаскироватьПоляДляLLM(Значение) Экспорт

	Поля = MCP_Config.ПоляМаскированияLLM();
	ПсевдонимыОрганизаций = MCP_Config.ПсевдонимыОрганизацийLLM();
	ПсевдонимыПерсон = MCP_Config.ПсевдонимыПерсонLLM();
	ПсевдонимыТипов = MCP_Config.ПсевдонимыТиповLLM();
	МаскиТипов = MCP_Config.МаскиПолейТиповLLM();

	// Аварийный режим: секцию политики прочитать не удалось. Флаг сводится в
	// маски типов — решение по полю принимает ПолеНужноМаскироватьПоТипуLLM, и
	// другого входа с составом типов у него нет.
	Если ПсевдонимыТипов.emergency Тогда
		МаскиТипов.emergency = Истина;
	КонецЕсли;

	Индекс = ИндексПоляМаскированияLLM(Поля);
	Если Индекс.Количество() = 0
		И НЕ МаскиТипов.emergency
		И НЕ ПсевдонимыОрганизаций.enabled
		И НЕ ПсевдонимыПерсон.enabled
		И НЕ ПсевдонимыТипов.enabled
		И НЕ МаскиТипов.enabled Тогда
		Возврат Значение;
	КонецЕсли;

	Настройки = Новый Структура;
	Настройки.Вставить("индекс", Индекс);
	Настройки.Вставить("организации", ПсевдонимыОрганизаций);
	Настройки.Вставить("персоны", ПсевдонимыПерсон);
	Настройки.Вставить("типы", ПсевдонимыТипов);
	Настройки.Вставить("маски_типов", МаскиТипов);
	// Префиксы собираются один раз на вызов: проверка «значение уже подменено»
	// идёт на каждое поле каждой строки, и сборка массива внутри неё стоила бы
	// столько же обходов политики, сколько в ответе полей.
	Настройки.Вставить("префиксы_подстановок", Новый Массив);
	ЗаполнитьПрефиксыПодстановокPrivacy(Настройки);
	// R-12: кэш ответов «подчинён ли тип справочнику персон» на один вызов —
	// интроспекция метаданных на каждую ячейку стоила бы дороже маскирования.
	Настройки.Вставить("подчиненные_персонам", Новый Соответствие);

	Возврат МаскироватьПоляДляLLMРекурсивно(
		Значение, Настройки, "", КонтекстМаскированияLLM("", "", "", ""));

КонецФункции

// Значение уже подменено при сборке строк результата (M-03.4) — трогать его
// нельзя. Форма проверяется строго: «начинается с префикса» недостаточно, иначе
// под защиту попало бы настоящее наименование, начинающееся так же. Код
// псевдонима — 8 разрядов base36 у типов и 6 цифр у легаси-псевдонимов персон и
// организаций; кроме кодов подстановками являются hidden_alias и обычные маски.
Функция ЗначениеУжеПодмененоPrivacy(Значение, Настройки) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Значение = "XXXXXXX" ИЛИ Значение = "1900-01-01T00:00:00" Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Префикс Из Настройки.префиксы_подстановок Цикл
		Если ПустаяСтрока(Префикс) ИЛИ Лев(Значение, СтрДлина(Префикс)) <> Префикс Тогда
			Продолжить;
		КонецЕсли;
		Остаток = Сред(Значение, СтрДлина(Префикс) + 1);
		Если Остаток = "скрыто" Тогда
			Возврат Истина;
		КонецЕсли;
		Если (СтрДлина(Остаток) = 8 ИЛИ СтрДлина(Остаток) = 6)
			И ЭтоКодПсевдонимаPrivacy(Остаток) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Префиксы всех включённых секций подстановок — один раз на вызов.
Процедура ЗаполнитьПрефиксыПодстановокPrivacy(Настройки)

	Результат = Настройки.префиксы_подстановок;

	Если Настройки.типы.enabled Тогда
		Для Каждого КЗ Из Настройки.типы.entries Цикл
			Результат.Добавить(КЗ.Значение.prefix);
		КонецЦикла;
	КонецЕсли;
	Если Настройки.персоны.enabled Тогда
		Результат.Добавить(Настройки.персоны.physical_person_prefix);
		Результат.Добавить(Настройки.персоны.employee_prefix);
		Результат.Добавить(Настройки.персоны.user_prefix);
	КонецЕсли;
	Если Настройки.организации.enabled Тогда
		Результат.Добавить(Настройки.организации.prefix);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоКодПсевдонимаPrivacy(Текст)

	Алфавит = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти(Алфавит, Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрДлина(Текст) > 0;

КонецФункции

Функция ИндексПоляМаскированияLLM(Поля)

	Индекс = Новый Соответствие;
	Для Каждого Поле Из Поля Цикл
		НормИмя = НормализоватьИмяПоляДляМаскированияLLM(Поле);
		Если НЕ ПустаяСтрока(НормИмя) Тогда
			Индекс.Вставить(НормИмя, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Индекс;

КонецФункции

Функция МаскироватьПоляДляLLMРекурсивно(Значение, Настройки, Путь, Контекст)

	Если Значение = Null ИЛИ Значение = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Массив") ИЛИ ТипЗначения = Тип("ФиксированныйМассив") Тогда
		РезультатМассив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			РезультатМассив.Добавить(МаскироватьПоляДляLLMРекурсивно(
				Элемент, Настройки, Путь, Контекст));
		КонецЦикла;
		Возврат РезультатМассив;
	КонецЕсли;

	ЭтоСтруктура = (ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура"));
	ЭтоСоответствие = (ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие"));
	Если НЕ ЭтоСтруктура И НЕ ЭтоСоответствие Тогда
		Возврат Значение;
	КонецЕсли;

	Если ЭтоСтруктура Тогда
		Результат = Новый Структура;
	Иначе
		Результат = Новый Соответствие;
	КонецЕсли;

	// Контекст объекта: псевдонимы организации/персоны, полное имя типа и
	// псевдоним этого типа. Ссылка другого типа контекст родителя сбрасывает,
	// иначе поля вложенного объекта получили бы чужой псевдоним.
	КонтекстОбъекта = КонтекстОбъектаМаскированияLLM(Значение, Настройки, Контекст, Путь);
	ЭтоСсылкаОрганизации = Настройки.организации.enabled И СтруктураЭтоСсылкаОрганизации(Значение);
	ЭтоСсылкаПерсоны = Настройки.персоны.enabled И СтруктураЭтоСсылкаПерсоны(Значение, Настройки);
	ЭтоСсылкаТипаПсевдонима = СтруктураЭтоСсылкаТипаПсевдонимаLLM(Значение, Настройки.типы);
	// Порча (P-2 п. 6): значение ПЕРЕЧИСЛЕНИЯ опознаётся по собственному type и
	// считается один раз на контейнер — ключей в нём несколько, а тип один.
	ЭтоЗначениеПеречисления = ЭтоЗначениеПеречисленияPrivacy(Значение);

	Для Каждого КЗ Из Значение Цикл
		Ключ = Строка(КЗ.Ключ);
		НовыйПуть = НовыйПутьМаскированияLLM(Путь, Ключ);
		Если НормализоватьИмяПоляДляМаскированияLLM(Ключ) = "privacycolumndecisions" Тогда
			// R-10: карта решений первого эшелона — служебная, клиенту не уходит.
			Продолжить;
		ИначеЕсли ЭлементСхемыИлиПеречисленияPrivacy(Ключ, НовыйПуть, ЭтоЗначениеПеречисления) Тогда
			// Порча (P-2 п. 6). Это НЕ имя объекта закрытого типа, а элемент
			// собственного контракта: имя колонки схемы табличной части и
			// name/presentation значения перечисления. Замер П15 на синтетике,
			// три контура: подменялись 5 листьев из 17 — перечисление становилось
			// нечитаемым, а все колонки схемы получали одно и то же значение, то
			// есть разные сущности склеивались под одним кодом. Не утечка, но
			// контракт разрушен.
			Результат.Вставить(Ключ, КЗ.Значение);
		ИначеЕсли ПолеТехническихМетаданныхLLM(Ключ, НовыйПуть, КЗ.Значение)
			И ЗначениеСкалярноеДляМаскиPrivacy(КЗ.Значение) Тогда
			// P-2 п. 1: пропуск без рекурсии допустим ТОЛЬКО для скаляра. Ключ
			// белого списка, под которым лежит контейнер (Вид, kind, report,
			// documentType), отдавал вложенный объект целиком — 14 открытых
			// листьев на трёх контурах при закрытом Наименование рядом.
			// Предикат тот же, что ввёл фикс b00ad89.
			Результат.Вставить(Ключ, КЗ.Значение);
		ИначеЕсли КолонкаОткрытаПервымЭшелономLLM(КЗ.Значение, Ключ, НовыйПуть, КонтекстОбъекта) Тогда
			// R-10: первый эшелон разобрал запрос и признал колонку открытой —
			// решение принято по паре «тип источника + имя реквизита», и
			// пересматривать его по имени ключа, которое назначил клиент, нельзя.
			Результат.Вставить(Ключ, КЗ.Значение);
		ИначеЕсли ЗначениеУжеПодмененоPrivacy(КЗ.Значение, Настройки) Тогда
			// Значение уже подменено при сборке строк запроса (M-03.4), и код в нём
			// принадлежит владельцу поля. Здесь контекст строки берётся первой
			// найденной ссылкой настроенного типа и может быть ДРУГИМ объектом:
			// маскировщики ниже перезаписали бы код чужим, и клиент соединил бы
			// разные объекты в один. Проверка стоит до всего ветвления — маска по
			// типу и маска по имени поля идут выше псевдонимов и затирают код так же.
			Результат.Вставить(Ключ, КЗ.Значение);
		ИначеЕсли ПолеНужноМаскироватьLLM(Ключ, НовыйПуть, Настройки.индекс)
			ИЛИ ПолеНужноМаскироватьПерсональныеДанныеLLM(
				Ключ, НовыйПуть, Настройки.персоны, КонтекстОбъекта.персона) Тогда
			Результат.Вставить(Ключ, МаскаПоляДляLLM(Ключ, КЗ.Значение));
		ИначеЕсли ПолеНужноМаскироватьПоТипуLLM(
			Ключ, НовыйПуть, КонтекстОбъекта.тип, Настройки, КЗ.Значение) Тогда
			Результат.Вставить(Ключ,
				МаскаПоляТипаДляLLM(Ключ, КЗ.Значение, КонтекстОбъекта, НовыйПуть));
		Иначе
			ЗначениеПоля = МаскироватьПоляДляLLMРекурсивно(
				КЗ.Значение, Настройки, НовыйПуть, КонтекстОбъекта);
			// Маска по имени типа идёт первой, псевдонимы ниже её перекрывают:
			// код информативнее XXXXXXX, а порядок делает результат
			// идемпотентным (повторное маскирование не меняет значение).
			ЗначениеПоля = МаскироватьПоИмениТипаМаскиLLM(
				Ключ, НовыйПуть, ЗначениеПоля, Настройки.маски_типов);
			ЗначениеПоля = МаскироватьОрганизациюДляLLM(
				Ключ, НовыйПуть, ЗначениеПоля, КонтекстОбъекта.организация,
				ЭтоСсылкаОрганизации, Настройки.организации);
			ЗначениеПоля = МаскироватьПерсонуДляLLM(
				Ключ, НовыйПуть, ЗначениеПоля, КонтекстОбъекта.персона,
				ЭтоСсылкаПерсоны, Настройки.персоны);
			ЗначениеПоля = МаскироватьПоПсевдонимуТипаLLM(
				Ключ, НовыйПуть, ЗначениеПоля, КонтекстОбъекта.псевдоним_типа,
				ЭтоСсылкаТипаПсевдонима, Настройки.типы,
				ПодстановкаНейтральнаPrivacy(Ключ, НовыйПуть, КонтекстОбъекта));
			Результат.Вставить(Ключ, ЗначениеПоля);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КонтекстМаскированияLLM(ПсевдонимОрганизации, ПсевдонимПерсоны, ТипОбъекта, ПсевдонимТипа,
	РешенияКолонок = Неопределено, ТипЗаимствован = Ложь)

	Контекст = Новый Структура;
	// R-10: вердикт первого эшелона по колонкам результата запроса. Неопределено
	// — вердикта нет (не run_1c_query либо разбор неполон), решает второй эшелон.
	Контекст.Вставить("решения_колонок", РешенияКолонок);
	// P-0c: тип получен шагом 4 — заимствован у ссылки, лежащей рядом в той же
	// строке, а не принадлежит этому значению. Второе условие режима страховки.
	Контекст.Вставить("тип_заимствован", ТипЗаимствован);
	Контекст.Вставить("организация", ПсевдонимОрганизации);
	Контекст.Вставить("персона", ПсевдонимПерсоны);
	Контекст.Вставить("тип", ТипОбъекта);
	Контекст.Вставить("псевдоним_типа", ПсевдонимТипа);
	Возврат Контекст;

КонецФункции

Функция КонтекстОбъектаМаскированияLLM(Значение, Настройки, Контекст, Путь = "")

	// R-18: строка табличной части — не «чужой объект», от которого гейт R-8
	// защищал. Для неё заимствование типа и псевдонима у ссылки владельца
	// законно, и гейт такую строку пропускает: и когда родитель — табличный
	// путь (форма А), и когда рекурсия идёт по данным табличных частей
	// настроенного типа (get_object_by_ref с include_tabular_sections).
	ВнутриТабличнойЧасти = ПутьВнутриТабличнойЧастиLLM(Путь)
		ИЛИ ЭтоТабличнаяЧастьПоИмениPrivacy(Контекст.тип);

	// P-0c: признак «тип заимствован» вычисляется вместе с типом и наследуется по
	// рекурсии тем же путём — через ЗаимствованРодителя. Вычислять его отдельным
	// вызовом нельзя: он обязан отвечать про ТОТ ЖЕ проход по шагам, иначе два
	// ответа разойдутся на первой же правке шагов.
	ТипЗаимствован = Ложь;
	ТипОбъекта = ТипОбъектаДляМаскированияLLM(Значение, Настройки, Контекст.тип,
		ВнутриТабличнойЧасти, Контекст.тип_заимствован, ТипЗаимствован);

	Возврат КонтекстМаскированияLLM(
		ПсевдонимОрганизацииДляОбъекта(Значение, Настройки.организации, Контекст.организация),
		ПсевдонимПерсоныДляОбъекта(Значение, Настройки, Контекст.персона),
		ТипОбъекта,
		ПсевдонимТипаДляОбъекта(Значение, Настройки.типы, Контекст.псевдоним_типа,
			Контекст.тип, Настройки, ВнутриТабличнойЧасти),
		РешенияКолонокДляОбъектаLLM(Значение, Контекст.решения_колонок),
		ТипЗаимствован);

КонецФункции

// R-10: вердикт первого эшелона объявляется в том же объекте, где лежат строки
// результата, и наследуется вниз по рекурсии. Ключ служебный: в ответ он не
// переносится (см. цикл МаскироватьПоляДляLLMРекурсивно).
Функция РешенияКолонокДляОбъектаLLM(Значение, РешенияРодителя)

	Объявленные = ПолеОбъекта(Значение, "privacy_column_decisions");
	Если ЭтоJSONОбъект(Объявленные) Тогда
		Возврат Объявленные;
	КонецЕсли;
	Возврат РешенияРодителя;

КонецФункции

// R-10. Второй эшелон обязан применить вердикт первого, а не выносить свой по
// имени ключа: имя колонки назначает клиент, и на одном и том же поле «КАК З»
// давало открыто, а «КАК Наименование» — закрыто (замер A/B 06.08.2026).
// Возвращает Истина, если для этого ключа вердикт есть и он «открыто», то есть
// маскировщики по имени применять нельзя.
//
// Ограничение обязательно: правило действует только на ПЛОСКИЕ значения строки
// результата. Ссылку первый эшелон намеренно не метит (M-03.1) — её закрывает
// псевдонимизация по собственным type/uuid, и подавить её здесь значило бы
// открыть представление ссылки, которое сегодня закрыто.
// Путь — ПОЛНЫЙ путь до поля (`НовыйПуть` вызывающей стороны), а не путь
// контейнера. Рекурсия по массиву путь не удлиняет, поэтому у строки результата
// он равен «rows», и сравнение контейнерного пути с «rows.<Ключ>» не сходилось
// бы никогда: вся открывающая половина R-10 была бы мертва, а второй эшелон
// продолжал бы решать по имени ключа. Найдено ревью PR #121.
Функция КолонкаОткрытаПервымЭшелономLLM(Значение, Ключ, Путь, Контекст)

	Решения = Контекст.решения_колонок;
	Если Решения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЭтоJSONОбъект(Значение) ИЛИ ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	// Только поля строки результата: privacy_column_decisions.rows_key называет
	// ключ, под которым лежат строки, и путь до поля — ровно «<rows_key>.<ключ>».
	КлючСтрок = СтроковоеПоле(Решения, "rows_key");
	Если ПустаяСтрока(КлючСтрок)
		ИЛИ НормализоватьИмяПоляДляМаскированияLLM(Путь)
			<> НормализоватьИмяПоляДляМаскированияLLM(КлючСтрок + "." + Ключ) Тогда
		Возврат Ложь;
	КонецЕсли;

	Колонки = ПолеОбъекта(Решения, "columns");
	Если НЕ ЭтоJSONОбъект(Колонки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Вердикт = ПолеОбъекта(Колонки, ВРег(СокрЛП(Строка(Ключ))));
	// Вердикта по колонке нет — карта неполна, и подавлять страховку нельзя.
	Возврат Вердикт = Ложь;

КонецФункции

// Путь рекурсии проходит по данным табличных частей объекта (ключ
// tabular_sections ответов get_object_by_ref). Метаданные исключены: в
// структуре метаданных tabular_sections — схема, а не данные.
Функция ПутьВнутриТабличнойЧастиLLM(Путь)

	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Возврат СтрНайти(НормПуть, "tabularsections") > 0
		И СтрНайти(НормПуть, "metadata") = 0;

КонецФункции

Функция МаскироватьОрганизациюДляLLM(Ключ, Путь, Значение, ПсевдонимОрганизации, ЭтоСсылкаОрганизации, ПсевдонимыОрганизаций)

	Если НЕ ПсевдонимыОрганизаций.enabled Тогда
		Возврат Значение;
	КонецЕсли;

	// P-1: было буквальное "presentation" — русский ключ `Представление` ссылки
	// организации уходил открытым, и это половина измеренного дефекта двуязычия.
	Если ЭтоСсылкаОрганизации И MCP_Config.КанонПоляPrivacy(Ключ) = "представление" Тогда
		Возврат ПсевдонимОрганизации;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ПсевдонимОрганизации)
		И ПолеПохожеНаНазваниеОрганизацииLLM(Ключ, Путь, Истина) Тогда
		Возврат ПсевдонимОрганизации;
	КонецЕсли;

	Если ПустаяСтрока(ПсевдонимОрганизации)
		И ПолеПохожеНаНазваниеОрганизацииLLM(Ключ, Путь, Ложь) Тогда
		Возврат ПсевдонимыОрганизаций.hidden_alias;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция МаскироватьПерсонуДляLLM(Ключ, Путь, Значение, ПсевдонимПерсоны, ЭтоСсылкаПерсоны, ПсевдонимыПерсон)

	Если НЕ ПсевдонимыПерсон.enabled Тогда
		Возврат Значение;
	КонецЕсли;

	// P-1: то же для персон — вторая половина того же дефекта.
	Если ЭтоСсылкаПерсоны И MCP_Config.КанонПоляPrivacy(Ключ) = "представление" Тогда
		Возврат ПсевдонимПерсоны;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ПсевдонимПерсоны)
		И ПолеПохожеНаИмяПерсоныLLM(Ключ, Путь, Истина) Тогда
		Возврат ПсевдонимПерсоны;
	КонецЕсли;

	Если ПустаяСтрока(ПсевдонимПерсоны)
		И ПолеПохожеНаИмяПерсоныLLM(Ключ, Путь, Ложь) Тогда
		Возврат ПсевдонимыПерсон.hidden_alias;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ПсевдонимОрганизацииДляОбъекта(Значение, ПсевдонимыОрганизаций, ПсевдонимОрганизации)

	Если НЕ ПсевдонимыОрганизаций.enabled Тогда
		Возврат "";
	КонецЕсли;

	Если СтруктураЭтоСсылкаДругогоТипа(Значение) Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Если ЭтоТипОрганизацииLLM(ТипСсылки) И НЕ ПустаяСтрока(UUID) Тогда
		Возврат ПсевдонимОрганизацииLLM(ТипСсылки, UUID, ПсевдонимыОрганизаций.prefix);
	КонецЕсли;

	ПсевдонимИзСсылки = ПсевдонимОрганизацииИзПоля(Значение, "ref", ПсевдонимыОрганизаций);
	Если НЕ ПустаяСтрока(ПсевдонимИзСсылки) Тогда
		Возврат ПсевдонимИзСсылки;
	КонецЕсли;

	ПсевдонимИзСсылки = ПсевдонимОрганизацииИзПоля(Значение, "Организация", ПсевдонимыОрганизаций);
	Если НЕ ПустаяСтрока(ПсевдонимИзСсылки) Тогда
		Возврат ПсевдонимИзСсылки;
	КонецЕсли;

	ПсевдонимИзСсылки = ПсевдонимОрганизацииИзПоля(Значение, "organization", ПсевдонимыОрганизаций);
	Если НЕ ПустаяСтрока(ПсевдонимИзСсылки) Тогда
		Возврат ПсевдонимИзСсылки;
	КонецЕсли;

	Возврат ПсевдонимОрганизации;

КонецФункции

Функция ПсевдонимПерсоныДляОбъекта(Значение, Настройки, ПсевдонимПерсоны)

	ПсевдонимыПерсон = Настройки.персоны;
	Если НЕ ПсевдонимыПерсон.enabled Тогда
		Возврат "";
	КонецЕсли;

	Если СтруктураЭтоСсылкаДругогоТипаПерсоны(Значение, Настройки) Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Если ЭтоТипПерсональногоНабораLLM(ТипСсылки, КэшПодчиненныхPrivacy(Настройки))
		И НЕ ПустаяСтрока(UUID) Тогда
		Возврат ПсевдонимПерсоныLLM(ТипСсылки, UUID, ПсевдонимыПерсон);
	КонецЕсли;

	ПсевдонимИзСсылки = ПсевдонимПерсоныИзПоля(Значение, "ref", Настройки);
	Если НЕ ПустаяСтрока(ПсевдонимИзСсылки) Тогда
		Возврат ПсевдонимИзСсылки;
	КонецЕсли;

	ПоляСсылок = Новый Массив;
	ПоляСсылок.Добавить("ФизическоеЛицо");
	ПоляСсылок.Добавить("ФизЛицо");
	ПоляСсылок.Добавить("ФизическиеЛица");
	ПоляСсылок.Добавить("Сотрудник");
	ПоляСсылок.Добавить("employee");
	ПоляСсылок.Добавить("person");
	ПоляСсылок.Добавить("physical_person");
	Для Каждого ИмяПоля Из ПоляСсылок Цикл
		ПсевдонимИзСсылки = ПсевдонимПерсоныИзПоля(Значение, ИмяПоля, Настройки);
		Если НЕ ПустаяСтрока(ПсевдонимИзСсылки) Тогда
			Возврат ПсевдонимИзСсылки;
		КонецЕсли;
	КонецЦикла;

	Возврат ПсевдонимПерсоны;

КонецФункции

// ---- Privacy по типам (privacy.type_aliases / privacy.type_field_masks) ----

// Полное имя типа текущего объекта. Порядок источников: сам объект — ссылка,
// объект содержит ссылку в "ref", объект — результат по регистру ("register").
// Если ничего не нашлось, наследуется тип родителя: поля и строки объекта
// принадлежат тому же типу, что и сам объект.
// P-0c. Заимствован (выходной) — КАК получен тип: Истина только для шага 4, то есть
// когда тип взят у первой ссылки настроенного типа среди ПРОИЗВОЛЬНЫХ ключей
// значения. Признак пишется в КАЖДОЙ точке выхода намеренно: пропущенная точка даёт
// не ошибку компиляции, а молча Ложь — то есть код псевдонима там, где требуется
// нейтральная маска, и вернувшуюся ложную связь.
//
// ЗаимствованРодителя — признак родителя. Тип, унаследованный от родителя,
// наследует и происхождение: неопределённость того, чей это тип, никуда не
// делась от того, что мы спустились на уровень вложенности. Сброс здесь дал бы
// гейт, поставленный в одном месте из двух — на этом горели R-8 и R-18.
Функция ТипОбъектаДляМаскированияLLM(Значение, Настройки, ТипРодителя, ВнутриТабличнойЧасти = Ложь,
	ЗаимствованРодителя = Ложь, Заимствован = Неопределено)

	Заимствован = Ложь;

	// В аварийном режиме применённых записей нет ни одной, а тип объекта нужен:
	// именно по нему решается, что перед нами ссылочный тип с закрытым именем.
	Если НЕ Настройки.маски_типов.emergency
		И НЕ Настройки.типы.enabled И НЕ Настройки.маски_типов.enabled Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Если НЕ ПустаяСтрока(ТипСсылки) И НЕ ПустаяСтрока(UUID) Тогда
		Возврат ТипСсылки;
	КонецЕсли;

	// Ключи-носители контекста — из собственного JSON-контракта сервера, а не из
	// конкретной конфигурации: register у get_register_records и
	// get_document_movements, accounting_register у бухгалтерских инструментов,
	// ref/target/item у объектных.
	ИменаРегистра = Новый Массив;
	ИменаРегистра.Добавить("register");
	ИменаРегистра.Добавить("accounting_register");
	Для Каждого ИмяПоля Из ИменаРегистра Цикл
		ИмяРегистра = СтроковоеПоле(Значение, ИмяПоля);
		Если СтрНайти(ИмяРегистра, ".") > 0 Тогда
			Возврат СокрЛП(ИмяРегистра);
		КонецЕсли;
	КонецЦикла;

	ИменаСсылки = Новый Массив;
	ИменаСсылки.Добавить("ref");
	ИменаСсылки.Добавить("target");
	ИменаСсылки.Добавить("item");
	Для Каждого ИмяПоля Из ИменаСсылки Цикл
		Реф = ПолеОбъекта(Значение, ИмяПоля);
		Если НЕ ЭтоJSONОбъект(Реф) Тогда
			Продолжить;
		КонецЕсли;
		ТипРеф = СтроковоеПоле(Реф, "type");
		UUIDРеф = СтроковоеПоле(Реф, "uuid");
		Если НЕ ПустаяСтрока(ТипРеф) И НЕ ПустаяСтрока(UUIDРеф) Тогда
			Возврат ТипРеф;
		КонецЕсли;
	КонецЦикла;

	// Строка результата run_1c_query: имя колонки со ссылкой задаёт автор
	// запроса («ВЫБРАТЬ К.Ссылка КАК Ссылка»), ключей контракта в ней нет.
	// Проверено на контуре: без этого шага маски по типу и псевдонимы к плоским
	// колонкам строки не применялись вообще, работал только ref/target/item.
	//
	// R-8 (Д-3). Ссылка, найденная внутри строки, не должна переопределять тип
	// строки, У КОТОРОГО ЕСТЬ СВОЯ ЗАПИСЬ В ПОЛИТИКЕ: у строки паспортного
	// регистра ссылка измерения подменяла тип справочником физлиц, вместе с типом
	// подменялся НАБОР масок — и паспортные поля уходили открытыми, причём ровно
	// на том контуре, где физлицо закрыто.
	//
	// Условие сужено против буквы ТЗ («шаг только при пустом ТипРодителя»)
	// намеренно. ТЗ обосновывает правило тем, что «ничего не теряется», — модель
	// второго эшелона это опровергла: при пустом-или-нет условии родитель БЕЗ
	// записи в политике переставал заимствовать маски у типа, на который
	// ссылается, и своя колонка строки (ИНН, Наименование) уходила открытой.
	// Кейс E3 в scripts/privacy_mask_marking_port.mjs держит обе половины:
	// родитель с записью — свой набор (цель Д-3), родитель без записи — прежнее
	// поведение. Цель ТЗ достигнута, потери нет.
	//
	// Псевдоним самой ссылки от этого не зависит: его выдаёт рекурсивный обход
	// её объекта по собственным type/uuid (шаг 1). У строк run_1c_query тип
	// родителя пуст — для них шаг 4 и вводился, он продолжает работать.
	//
	// R-18: строку табличной части гейт пропускает — ссылка владельца в строке
	// его же ТЧ не «чужой объект», и заимствование у неё типа законно.
	Если ПустаяСтрока(ТипРодителя)
		ИЛИ ВнутриТабличнойЧасти
		ИЛИ НЕ ТипНастроенВПолитикеPrivacy(ТипРодителя, Настройки) Тогда
		РефПоля = СсылкаИзЛюбогоПоляPrivacy(Значение,
			Настройки.маски_типов.entries, Настройки.типы.entries);
		Если РефПоля <> Неопределено Тогда
			// Единственная точка, где тип ЗАИМСТВОВАН: он принадлежит не этому
			// значению, а ссылке, лежащей рядом в той же строке (P-0c).
			//
			// Строка табличной части — исключение, и оно содержательное, а не
			// уступка: ссылка владельца в строке его же ТЧ указывает на объект,
			// которому строка ПРИНАДЛЕЖИТ, поэтому код владельца в ней — не ложная
			// связь, а верная. На нём стоит R-18 («Контр-скрыто» у
			// КонтактнаяИнформация.Представление), и ТЗ P-0c п. 4 выводит строки ТЧ
			// из объёма прямо. Без этой оговорки правка откатывала бы R-18 молча —
			// поймано кейсом E3″ порта, не рассуждением.
			Заимствован = НЕ ВнутриТабличнойЧасти;
			Возврат РефПоля.type;
		КонецЕсли;
	КонецЕсли;

	Заимствован = ЗаимствованРодителя;
	Возврат ТипРодителя;

КонецФункции

// Есть ли у типа собственная запись в политике — в псевдонимах либо в масках
// полей. Отвечает на вопрос «известен ли нам набор масок ИМЕННО этого типа»:
// если да, подменять его набором чужого типа нельзя ни при каких условиях.
Функция ТипНастроенВПолитикеPrivacy(ПолноеИмяТипа, Настройки)

	Если Настройки = Неопределено ИЛИ ПустаяСтрока(ПолноеИмяТипа) Тогда
		Возврат Ложь;
	КонецЕсли;
	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);
	Возврат Настройки.маски_типов.entries.Получить(НормТип) <> Неопределено
		ИЛИ Настройки.типы.entries.Получить(НормТип) <> Неопределено;

КонецФункции

Функция ПсевдонимТипаДляОбъекта(Значение, ПсевдонимыТипов, ПсевдонимРодителя,
	ТипРодителя = "", Настройки = Неопределено, ВнутриТабличнойЧасти = Ложь)

	Если НЕ ПсевдонимыТипов.enabled Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Если НЕ ПустаяСтрока(ТипСсылки) И НЕ ПустаяСтрока(UUID) Тогда
		// Ссылка настроенного типа даёт свой псевдоним, ссылка любого другого
		// типа сбрасывает унаследованный.
		Возврат ПсевдонимТипаLLM(ТипСсылки, UUID, ПсевдонимыТипов);
	КонецЕсли;

	ИменаСсылки = Новый Массив;
	ИменаСсылки.Добавить("ref");
	ИменаСсылки.Добавить("target");
	ИменаСсылки.Добавить("item");
	Для Каждого ИмяПоля Из ИменаСсылки Цикл
		Реф = ПолеОбъекта(Значение, ИмяПоля);
		Если НЕ ЭтоJSONОбъект(Реф) Тогда
			Продолжить;
		КонецЕсли;
		ТипРеф = СтроковоеПоле(Реф, "type");
		UUIDРеф = СтроковоеПоле(Реф, "uuid");
		Если НЕ ПустаяСтрока(ТипРеф) И НЕ ПустаяСтрока(UUIDРеф) Тогда
			Возврат ПсевдонимТипаLLM(ТипРеф, UUIDРеф, ПсевдонимыТипов);
		КонецЕсли;
	КонецЦикла;

	// Ключи контракта покрывают объектные ответы, но в строке run_1c_query
	// колонка со ссылкой называется так, как её назвал автор запроса (обычно
	// Ссылка). Без разбора произвольных ключей строка выборки оставалась без
	// псевдонима, и поля названия рядом со ссылкой уходили открытыми.
	//
	// Тот же гейт, что в ТипОбъектаДляМаскированияLLM (R-8), и по той же причине.
	// Без него у строки типа, настроенного в политике, псевдоним брался бы из
	// ссылки-измерения — и МаскаПоляТипаДляLLM подставила бы в имя-подобное поле
	// строки КОД ЧУЖОГО ОБЪЕКТА вместо маски. Это не утечка, а класс «молча
	// неверные данные»: клиент соединит строки, которых в данных нет. На этом
	// классе проект уже горел (uuid чужого объекта, Д-2 первой приёмки).
	// Сейчас случай недостижим — у паспортного регистра ссылки в type_aliases не
	// лежат, — но конструкция его допускает, и страховка стоит одного условия.
	//
	// R-18: строку табличной части гейт пропускает. У строки ТЧ настроенного
	// типа собственных type/uuid нет, и без заимствования у ссылки владельца
	// псевдоним ей взять неоткуда — «Контр-скрыто» подставлять некому.
	Если ПустаяСтрока(ТипРодителя)
		ИЛИ ВнутриТабличнойЧасти
		ИЛИ НЕ ТипНастроенВПолитикеPrivacy(ТипРодителя, Настройки) Тогда
		РефПоля = СсылкаИзЛюбогоПоляPrivacy(Значение, ПсевдонимыТипов.entries, Неопределено);
		Если РефПоля <> Неопределено Тогда
			Возврат ПсевдонимТипаLLM(РефПоля.type, РефПоля.uuid, ПсевдонимыТипов);
		КонецЕсли;
	КонецЕсли;

	Возврат ПсевдонимРодителя;

КонецФункции

// Первая ссылка НАСТРОЕННОГО в политике типа среди значений произвольных
// ключей. Ссылка незакрытого типа осознанно игнорируется: строка регистра
// содержит ссылки-измерения (например Физлицо), и если бы контекст доставался
// им, строка теряла бы унаследованный от ответа тип регистра — маски полей
// регистра переставали работать. Проверено на контуре: именно так и вышло,
// когда функция возвращала первую попавшуюся ссылку.
//
// Неоднозначность при нескольких закрытых типах решается порядком обхода
// ключей — как и для ключей контракта.
Функция СсылкаИзЛюбогоПоляPrivacy(Значение, Ключи1, Ключи2)

	Для Каждого КЗ Из Значение Цикл
		Если НЕ ЭтоJSONОбъект(КЗ.Значение) Тогда
			Продолжить;
		КонецЕсли;
		ТипРеф = СтроковоеПоле(КЗ.Значение, "type");
		UUIDРеф = СтроковоеПоле(КЗ.Значение, "uuid");
		Если ПустаяСтрока(ТипРеф) ИЛИ ПустаяСтрока(UUIDРеф) Тогда
			Продолжить;
		КонецЕсли;

		Ключ = MCP_Config.НормализоватьКлючPrivacy(ТипРеф);
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		Настроен = (Ключи1 <> Неопределено И Ключи1.Получить(Ключ) <> Неопределено)
			ИЛИ (Ключи2 <> Неопределено И Ключи2.Получить(Ключ) <> Неопределено);
		Если НЕ Настроен Тогда
			Продолжить;
		КонецЕсли;

		Ссылка = Новый Структура;
		Ссылка.Вставить("type", ТипРеф);
		Ссылка.Вставить("uuid", UUIDРеф);
		Возврат Ссылка;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПсевдонимТипаLLM(ТипСсылки, UUID, ПсевдонимыТипов)

	Запись = ЗаписьПсевдонимаТипаLLM(ТипСсылки, ПсевдонимыТипов);
	Если Запись = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Запись.prefix + КодПсевдонимаТипаLLM(ТипСсылки, UUID);

КонецФункции

// Код псевдонима типа: 8 символов base36 от хеша "тип|uuid". Шесть
// десятичных цифр давали бы коллизию с вероятностью ~50% уже на ~1200
// объектах одного типа. Функция отдельная: легаси-коды организаций и
// персон (6 цифр) менять нельзя — они уже выданы клиентам.
Функция КодПсевдонимаТипаLLM(ТипСсылки, UUID)

	Текст = ВРег(СокрЛП(Строка(ТипСсылки))) + "|" + ВРег(СокрЛП(Строка(UUID)));
	Модуль = 2821109907456; // 36^8
	Хеш = 0;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Хеш = Хеш * 33 + КодСимвола(Сред(Текст, Позиция, 1));
		Хеш = Хеш - Цел(Хеш / Модуль) * Модуль;
	КонецЦикла;

	Алфавит = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Код = "";
	Для Разряд = 1 По 8 Цикл
		Остаток = Хеш - Цел(Хеш / 36) * 36;
		Код = Сред(Алфавит, Остаток + 1, 1) + Код;
		Хеш = Цел(Хеш / 36);
	КонецЦикла;

	Возврат Код;

КонецФункции

Функция ЗаписьПсевдонимаТипаLLM(ТипСсылки, ПсевдонимыТипов)

	Если НЕ ПсевдонимыТипов.enabled Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ключ = MCP_Config.НормализоватьКлючPrivacy(ТипСсылки);
	Если ПустаяСтрока(Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПсевдонимыТипов.entries.Получить(Ключ);

КонецФункции

Функция СтруктураЭтоСсылкаТипаПсевдонимаLLM(Значение, ПсевдонимыТипов)

	Если НЕ ПсевдонимыТипов.enabled Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Если ПустаяСтрока(ТипСсылки) ИЛИ ПустаяСтрока(UUID) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗаписьПсевдонимаТипаLLM(ТипСсылки, ПсевдонимыТипов) <> Неопределено;

КонецФункции

// НейтральнаяПодстановка (P-0c) — режим страховки для этого ключа: код псевдонима
// заменяется нейтральной маской. Признак приходит извне, а не вычисляется здесь:
// функция не видит контекста, а условие конъюнктивное.
//
// Гейтить эту линию обязательно, хотя ТЗ называет координатой МаскаПоляТипаДляLLM:
// код подставляется ДВУМЯ линиями, и вторая — здесь (имя-подобный ключ получает
// КонтекстОбъекта.псевдоним_типа). Псевдоним заимствуется тем же шагом 4
// (ПсевдонимТипаДляОбъекта, гейт слово в слово), поэтому ложная связь без этой
// правки уходила бы через Л3 в точности так же.
Функция МаскироватьПоПсевдонимуТипаLLM(Ключ, Путь, Значение, ПсевдонимТипа, ЭтоСсылкаТипа, ПсевдонимыТипов,
	НейтральнаяПодстановка = Ложь)

	Если НЕ ПсевдонимыТипов.enabled Тогда
		Возврат Значение;
	КонецЕсли;

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Если ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть) Тогда
		Возврат Значение;
	КонецЕсли;
	Если ПолеПохожеНаТехническийКлючОрганизацииLLM(НормКлюч) Тогда
		Возврат Значение;
	КонецЕсли;

	Если ЭтоСсылкаТипа И НормКлюч = "presentation" И НЕ ПустаяСтрока(ПсевдонимТипа) Тогда
		Возврат ПсевдонимТипа;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	КлючПоля = MCP_Config.НормализоватьКлючPrivacy(Ключ);
	Если НЕ ПустаяСтрока(ПсевдонимТипа)
		И MCP_Config.ПолеИмениОбъектаPrivacy(КлючПоля) Тогда
		// P-0c: значение закрыть надо, но кодом заимствованного объекта — нельзя.
		Если НейтральнаяПодстановка Тогда
			Возврат МаскаПоляДляLLM(Ключ, Значение);
		КонецЕсли;
		Возврат ПсевдонимТипа;
	КонецЕсли;

	// Запрос вернул только строку с названием, без ссылки (частый случай:
	// в выборке рядом с Субконто1 лежит плоская колонка Контрагент). Стабильный
	// код построить не из чего, но отдавать название нельзя.
	Запись = ЗаписьТипаПоИмениПоляLLM(Ключ, Путь, ПсевдонимыТипов);
	Если Запись <> Неопределено Тогда
		Возврат Запись.hidden_alias;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Тот же случай для конфигурации без псевдонимов: если у типа скрыто
// имя-подобное поле, плоская строка с названием этого типа тоже не должна
// уходить клиенту, иначе маска обходится одним переименованием колонки.
Функция МаскироватьПоИмениТипаМаскиLLM(Ключ, Путь, Значение, МаскиТипов)

	Если НЕ МаскиТипов.enabled Тогда
		Возврат Значение;
	КонецЕсли;

	// Правило рассчитано на плоскую строку с названием. Ссылку целиком прятать
	// нельзя: вместе с ней исчезли бы uuid и navigation_url для расшифровки.
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Если ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть) Тогда
		Возврат Значение;
	КонецЕсли;
	Если ПолеПохожеНаТехническийКлючОрганизацииLLM(НормКлюч) Тогда
		Возврат Значение;
	КонецЕсли;

	Запись = ЗаписьМаскиПоИмениПоляLLM(Ключ, Путь, МаскиТипов);
	Если Запись = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат МаскаПоляДляLLM(Ключ, Значение);

КонецФункции

Функция ЗаписьМаскиПоИмениПоляLLM(Ключ, Путь, МаскиТипов)

	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Если СтрНайти(НормПуть, "metadata") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КлючПоля = MCP_Config.НормализоватьКлючPrivacy(Ключ);
	Для Каждого Запись Из МаскиТипов.list Цикл
		Если НЕ Запись.mask_presentation Тогда
			// Имя объекта скрывают только те записи, где скрыто имя-подобное поле.
			Продолжить;
		КонецЕсли;
		Если ИмяПоляСоответствуетТипуLLM(КлючПоля, Запись.object_key) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;

	// Имя-подобный ключ с именем типа в сегменте пути (Контрагент.Наименование)
	// закрывается так же, как для псевдонимов: без этого вложенная структура
	// обходила бы маску при конфигурации из одних type_field_masks.
	Если НЕ MCP_Config.ПолеИмениОбъектаPrivacy(КлючПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сегменты = СтрРазделить(Строка(Путь), ".", Ложь);
	Для Каждого Сегмент Из Сегменты Цикл
		КлючСегмента = MCP_Config.НормализоватьКлючPrivacy(Сегмент);
		Для Каждого Запись Из МаскиТипов.list Цикл
			Если НЕ Запись.mask_presentation Тогда
				Продолжить;
			КонецЕсли;
			Если ИмяПоляСоответствуетТипуLLM(КлючСегмента, Запись.object_key) Тогда
				Возврат Запись;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ищет настроенный тип по имени поля: сначала по самому ключу, затем — для
// имя-подобного ключа — по сегментам пути (вложенная структура вида
// Контрагент.Наименование). Схему метаданных не трогаем.
Функция ЗаписьТипаПоИмениПоляLLM(Ключ, Путь, ПсевдонимыТипов)

	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Если СтрНайти(НормПуть, "metadata") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КлючПоля = MCP_Config.НормализоватьКлючPrivacy(Ключ);
	Для Каждого Запись Из ПсевдонимыТипов.list Цикл
		Если ИмяПоляСоответствуетТипуLLM(КлючПоля, Запись.object_key) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;

	Если НЕ MCP_Config.ПолеИмениОбъектаPrivacy(КлючПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сегменты = СтрРазделить(Строка(Путь), ".", Ложь);
	Для Каждого Сегмент Из Сегменты Цикл
		КлючСегмента = MCP_Config.НормализоватьКлючPrivacy(Сегмент);
		Для Каждого Запись Из ПсевдонимыТипов.list Цикл
			Если ИмяПоляСоответствуетТипуLLM(КлючСегмента, Запись.object_key) Тогда
				Возврат Запись;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Имя поля считается названием объекта настроенного типа, если совпадает с
// именем объекта из конфига по достаточно длинному общему началу: колонка
// «Контрагент» относится к «Контрагенты», «КонтрагентНаименование» — тоже,
// а «Контр» уже нет. Правило работает на любой конфигурации: имя объекта
// берётся из самой privacy-настройки, а не из зашитого списка.
Функция ИмяПоляСоответствуетТипуLLM(КлючПоля, ИмяОбъекта)

	Если ПустаяСтрока(КлючПоля) ИЛИ ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(ИмяОбъекта) < 5 Тогда
		// Короткое имя объекта дало бы слишком много ложных совпадений.
		Возврат Ложь;
	КонецЕсли;

	Порог = СтрДлина(ИмяОбъекта) - 3;
	Если Порог < 5 Тогда
		Порог = 5;
	КонецЕсли;
	Возврат ДлинаОбщегоНачалаLLM(КлючПоля, ИмяОбъекта) >= Порог;

КонецФункции

Функция ДлинаОбщегоНачалаLLM(Первая, Вторая)

	Предел = Мин(СтрДлина(Первая), СтрДлина(Вторая));
	Длина = 0;
	Для Позиция = 1 По Предел Цикл
		Если Сред(Первая, Позиция, 1) <> Сред(Вторая, Позиция, 1) Тогда
			Прервать;
		КонецЕсли;
		Длина = Длина + 1;
	КонецЦикла;
	Возврат Длина;

КонецФункции

Функция ПолеНужноМаскироватьПоТипуLLM(Ключ, Путь, ТипОбъекта, Настройки, Значение = Неопределено)

	Если ПустаяСтрока(ТипОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	МаскиТипов = Настройки.маски_типов;

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Если ПустаяСтрока(НормКлюч)
		ИЛИ ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	КлючПоля = MCP_Config.НормализоватьКлючPrivacy(Ключ);

	// Аварийный режим: перечня закрытых типов нет, поэтому имя-подобные поля и
	// представление закрываются у КАЖДОГО ссылочного типа. Прочие поля остаются
	// открытыми — иначе ответ превратился бы в сплошные XXXXXXX и инструменты
	// стали бы бесполезны, что равнозначно отказу, от которого мы и уходим.
	// P-1: перечень «имя-подобных» ключей был здесь свой, третий по счёту, и
	// русское «представление» в нём держалось отдельной веткой. Теперь роль.
	Если МаскиТипов.emergency И ЭтоСсылочныйТипPrivacy(ТипОбъекта)
		И MCP_Config.ПолеИмениОбъектаPrivacy(КлючПоля) Тогда
		Возврат Истина;
	КонецЕсли;

	// R-11, второй эшелон: поле строки табличной части закрытого типа (путь
	// данных через tabular_sections либо унаследованный табличный тип). Ссылки
	// не трогаем — их закрывает псевдонимизация по собственным type/uuid, а
	// маска стёрла бы uuid и navigation_url. Классификаторы строки открыты.
	Если ЗначениеСкалярноеДляМаскиPrivacy(Значение) И НЕ КлассификаторСтрокиТЧPrivacy(КлючПоля) Тогда
		Если ЭтоТабличнаяЧастьПоИмениPrivacy(ТипОбъекта) Тогда
			Если ТипВЗакрытомНабореPrivacy(
				ВладелецТабличнойЧастиПоИмениPrivacy(ТипОбъекта), Настройки) Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли ПутьВнутриТабличнойЧастиLLM(Путь)
			И ТипВЗакрытомНабореPrivacy(ТипОбъекта, Настройки) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	// R-13, вторая линия: ядро идентифицирующих полей — то же правило, каким
	// разбор запроса метит колонки; объектный путь (get_object_by_ref) не
	// должен отдавать то, что закрыто в запросном.
	Если ЗначениеСкалярноеДляМаскиPrivacy(Значение)
		И ПолеВЯдреИдентификацииPrivacy(ТипОбъекта, Ключ, Настройки) Тогда
		Возврат Истина;
	КонецЕсли;

	Если НЕ МаскиТипов.enabled Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись = МаскиТипов.entries.Получить(MCP_Config.НормализоватьКлючPrivacy(ТипОбъекта));
	Если Запись = Неопределено Тогда
		// R-12: подчинённый типу персон наследует набор масок владельца.
		Запись = ЗаписьМасокВладельцаПерсоныLLM(ТипОбъекта, Настройки);
	КонецЕсли;
	Если Запись = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// Явно перечисленное поле маскируется без дополнительных эвристик:
	// список полей задал администратор, угадывать за него нечего.
	Если ПолеЕстьВЗаписиМасокPrivacy(Запись, КлючПоля) Тогда
		Возврат Истина;
	КонецЕсли;

	// R-9: представление наследует закрытость от любого закрытого реквизита.
	Возврат (Запись.mask_presentation ИЛИ Запись.presentation_inherited)
		И MCP_Config.КанонПоляPrivacy(КлючПоля) = "представление";

КонецФункции

// P-1. Перечислено ли поле в записи политики — сверка по ПОНЯТИЮ, а не по строке.
// Администратор пишет записи по-русски («ИНН», «Представление»), а ключи ответа
// приходят и по-английски: `inn` при закрытом `ИНН` уходил открытым, и это был не
// пробел в политике, а несовпадение словарей. Прямая сверка идёт первой — она
// дешевле и покрывает подавляющую часть ключей.
Функция ПолеЕстьВЗаписиМасокPrivacy(Запись, КлючПоля)

	Если Запись.fields.Получить(КлючПоля) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Канон = MCP_Config.КанонПоляPrivacy(КлючПоля);
	Если Канон = КлючПоля Тогда
		// Понятия у ключа нет — синонима искать негде, и перебор был бы пустым.
		Возврат Ложь;
	КонецЕсли;
	Для Каждого КЗ Из Запись.fields Цикл
		Если MCP_Config.КанонПоляPrivacy(КЗ.Ключ) = Канон Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// R-12: запись масок владельца-персоны для подчинённого справочника — набор
// масок наследуется от владельца, пока у подчинённого нет своей записи.
Функция ЗаписьМасокВладельцаПерсоныLLM(ПолноеИмяТипа, Настройки)

	Если НЕ ЭтоПодчиненныйТипуПерсонPrivacy(ПолноеИмяТипа, КэшПодчиненныхPrivacy(Настройки)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Владелец Из ВладельцыПерсоныPrivacy(ПолноеИмяТипа) Цикл
		Запись = Настройки.маски_типов.entries.Получить(
			MCP_Config.НормализоватьКлючPrivacy(Владелец));
		Если Запись <> Неопределено Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция МаскаПоляТипаДляLLM(Ключ, Значение, КонтекстОбъекта, Путь = "")

	// P-0c: в режиме страховки код псевдонима не выдаётся — см.
	// ПодстановкаНейтральнаPrivacy. Проверка стоит ПЕРВОЙ: ниже код возвращается
	// для любого имя-подобного ключа, и добавить условие туда значило бы повторить
	// его во всех будущих ветках.
	Если ПодстановкаНейтральнаPrivacy(Ключ, Путь, КонтекстОбъекта) Тогда
		Возврат МаскаПоляДляLLM(Ключ, Значение);
	КонецЕсли;

	// Если для типа настроен и псевдоним, отдаём его вместо XXXXXXX: код
	// информативнее и позволяет сопоставлять строки между ответами.
	Если НЕ ПустаяСтрока(КонтекстОбъекта.псевдоним_типа)
		И MCP_Config.ПолеИмениОбъектаPrivacy(MCP_Config.НормализоватьКлючPrivacy(Ключ)) Тогда
		Возврат КонтекстОбъекта.псевдоним_типа;
	КонецЕсли;

	Возврат МаскаПоляДляLLM(Ключ, Значение);

КонецФункции

// P-0c. Режим страховки для ЭТОГО ключа: подстановка обязана быть нейтральной
// маской, а не кодом псевдонима. Конъюнкция двух условий, и оба обязательны.
//
// (а) вердикта по колонке в карте первого эшелона НЕТ — разбор её не осматривал;
// (б) тип объекта ЗАИМСТВОВАН шагом 4 — принадлежит ссылке, лежащей рядом в той
//     же строке, а не этому значению.
//
// Почему конъюнкция, а не одно условие (б): у обычной строки run_1c_query тип
// тоже приходит шагом 4, и код там законен и нужен — на нём стоит различимость
// журнала (2259 ссылок закрытых типов, сверено 16↔16 и 24↔24). Условие (а)
// отсекает этот случай: осмотренная колонка либо уже подменена первым эшелоном,
// либо имеет вердикт, и сюда не доходит.
//
// Почему не одно условие (а): вне run_1c_query карты нет вовсе, и (а) истинно для
// всего объектного пути. Там тип берётся из собственных type+uuid, код принадлежит
// самому объекту и ложной связи не создаёт.
//
// Замер, из которого выведено требование (приёмка 10.08, декартово произведение
// 5×5 на BUH): 25 из 25 строк, где колонка ОТКРЫТОГО типа равна коду закрытой
// ссылки ИЗ ЭТОЙ ЖЕ СТРОКИ. Наименование банка приходило идентификатором
// контрагента, стоящего рядом. Вред не «закрыто лишнее», а ложная связь: потеря
// значения обратима, связь «банк = контрагент» выглядит как данные.
Функция ПодстановкаНейтральнаPrivacy(Ключ, Путь, КонтекстОбъекта)

	Если КонтекстОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ КонтекстОбъекта.Свойство("тип_заимствован")
		ИЛИ НЕ КонтекстОбъекта.тип_заимствован Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ ВердиктПоКолонкеЕстьLLM(КонтекстОбъекта.решения_колонок, Ключ, Путь);

КонецФункции

// Есть ли в карте первого эшелона вердикт ИМЕННО по этой колонке. Карты нет вовсе
// (не run_1c_query либо разбор неполон) — вердикта нет: это и есть страховка.
//
// Значение вердикта здесь не важно, важно его НАЛИЧИЕ: «закрыто» означает, что
// первый эшелон колонку осмотрел и подменил сам, «открыто» — что осмотрел и
// признал открытой. В обоих случаях решение принято по паре «тип источника + имя
// реквизита», и заимствованный тип его не пересматривает.
//
// Путь обязателен по той же причине, по какой он обязателен в
// КолонкаОткрытаПервымЭшелономLLM: карта описывает КОЛОНКИ СТРОКИ РЕЗУЛЬТАТА, и
// вердикт есть только у поля, лежащего прямо под ключом строк. У вложенного
// значения вердикта нет по построению — первый эшелон о нём не решал, — и ключ,
// случайно совпавший с именем колонки, не имеет права унести код заимствованного
// объекта на уровень ниже.
Функция ВердиктПоКолонкеЕстьLLM(Решения, Ключ, Путь)

	Если Решения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	КлючСтрок = СтроковоеПоле(Решения, "rows_key");
	Если ПустаяСтрока(КлючСтрок)
		ИЛИ НормализоватьИмяПоляДляМаскированияLLM(Путь)
			<> НормализоватьИмяПоляДляМаскированияLLM(КлючСтрок + "." + Ключ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Колонки = ПолеОбъекта(Решения, "columns");
	Если НЕ ЭтоJSONОбъект(Колонки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПолеОбъекта(Колонки, ВРег(СокрЛП(Строка(Ключ)))) <> Неопределено;

КонецФункции

Функция ПсевдонимОрганизацииИзПоля(Объект, ИмяПоля, ПсевдонимыОрганизаций)

	ЗначениеПоля = ПолеОбъекта(Объект, ИмяПоля);
	Если НЕ ЭтоJSONОбъект(ЗначениеПоля) Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(ЗначениеПоля, "type");
	UUID = СтроковоеПоле(ЗначениеПоля, "uuid");
	Если ЭтоТипОрганизацииLLM(ТипСсылки) И НЕ ПустаяСтрока(UUID) Тогда
		Возврат ПсевдонимОрганизацииLLM(ТипСсылки, UUID, ПсевдонимыОрганизаций.prefix);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПсевдонимПерсоныИзПоля(Объект, ИмяПоля, Настройки)

	ЗначениеПоля = ПолеОбъекта(Объект, ИмяПоля);
	Если НЕ ЭтоJSONОбъект(ЗначениеПоля) Тогда
		Возврат "";
	КонецЕсли;

	ТипСсылки = СтроковоеПоле(ЗначениеПоля, "type");
	UUID = СтроковоеПоле(ЗначениеПоля, "uuid");
	Если ЭтоТипПерсональногоНабораLLM(ТипСсылки, КэшПодчиненныхPrivacy(Настройки))
		И НЕ ПустаяСтрока(UUID) Тогда
		Возврат ПсевдонимПерсоныLLM(ТипСсылки, UUID, Настройки.персоны);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция СтруктураЭтоСсылкаОрганизации(Значение)

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Возврат ЭтоТипОрганизацииLLM(ТипСсылки) И НЕ ПустаяСтрока(UUID);

КонецФункции

Функция СтруктураЭтоСсылкаПерсоны(Значение, Настройки = Неопределено)

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Возврат ЭтоТипПерсональногоНабораLLM(ТипСсылки, КэшПодчиненныхPrivacy(Настройки))
		И НЕ ПустаяСтрока(UUID);

КонецФункции

Функция СтруктураЭтоСсылкаДругогоТипа(Значение)

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Возврат НЕ ПустаяСтрока(ТипСсылки)
		И НЕ ПустаяСтрока(UUID)
		И НЕ ЭтоТипОрганизацииLLM(ТипСсылки);

КонецФункции

Функция СтруктураЭтоСсылкаДругогоТипаПерсоны(Значение, Настройки = Неопределено)

	ТипСсылки = СтроковоеПоле(Значение, "type");
	UUID = СтроковоеПоле(Значение, "uuid");
	Возврат НЕ ПустаяСтрока(ТипСсылки)
		И НЕ ПустаяСтрока(UUID)
		И НЕ ЭтоТипПерсональногоНабораLLM(ТипСсылки, КэшПодчиненныхPrivacy(Настройки));

КонецФункции

Функция ЭтоТипОрганизацииLLM(ТипСсылки)

	Возврат ВРег(СокрЛП(Строка(ТипСсылки))) = "СПРАВОЧНИК.ОРГАНИЗАЦИИ";

КонецФункции

Функция ЭтоТипПерсоныLLM(ТипСсылки)

	Возврат ЭтоТипФизическогоЛицаLLM(ТипСсылки)
		ИЛИ ЭтоТипСотрудникаLLM(ТипСсылки)
		ИЛИ ЭтоТипПользователяLLM(ТипСсылки);

КонецФункции

Функция ЭтоТипФизическогоЛицаLLM(ТипСсылки)

	НормТип = НормализоватьИмяПоляДляМаскированияLLM(ТипСсылки);
	Возврат НормТип = "справочникфизическиелица"
		ИЛИ НормТип = "справочникфизлица"
		ИЛИ СтрНайти(НормТип, "справочникфизическиелица") = 1;

КонецФункции

Функция ЭтоТипСотрудникаLLM(ТипСсылки)

	НормТип = НормализоватьИмяПоляДляМаскированияLLM(ТипСсылки);
	Возврат НормТип = "справочниксотрудники"
		ИЛИ СтрНайти(НормТип, "справочниксотрудник") = 1
		ИЛИ СтрНайти(НормТип, "справочниксотрудники") = 1;

КонецФункции

Функция ЭтоТипПользователяLLM(ТипСсылки)

	НормТип = НормализоватьИмяПоляДляМаскированияLLM(ТипСсылки);
	Возврат НормТип = "справочникпользователи"
		ИЛИ СтрНайти(НормТип, "справочникпользовател") = 1;

КонецФункции

// R-12: тип обслуживается механизмом персон — сам тип персоны либо подчинённый
// ему справочник. Подчинённые закрываются по факту подчинённости, а не по
// вхождению в политику: их строки несут собственные ПДн третьих лиц
// (родственники, включая несовершеннолетних), и пока типа нет в политике,
// только это правило вводит его в закрытый набор.
Функция ЭтоТипПерсональногоНабораLLM(ТипСсылки, Кэш = Неопределено)

	Возврат ЭтоТипПерсоныLLM(ТипСсылки)
		ИЛИ ЭтоПодчиненныйТипуПерсонPrivacy(ТипСсылки, Кэш);

КонецФункции

// Справочник подчинён типу персон (среди владельцев есть физлица, сотрудники
// или пользователи). Подчинённые НЕ-персонам (номенклатура контрагентов, виды
// цен, терминалы) под правило не подпадают — решение заказчика 06.08.2026;
// единственное их исключение (КонтактныеЛицаПартнеров) закрывается поимённо
// записью политики, а не правилом. Ответ кэшируется: решение спрашивается на
// каждую колонку и на каждую строку, а интроспекция метаданных не бесплатна.
Функция ЭтоПодчиненныйТипуПерсонPrivacy(ПолноеИмяТипа, Кэш = Неопределено)

	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);
	Если ПустаяСтрока(НормТип) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Кэш <> Неопределено Тогда
		Известно = Кэш.Получить(НормТип);
		Если Известно <> Неопределено Тогда
			Возврат Известно;
		КонецЕсли;
	КонецЕсли;

	Результат = Ложь;
	Если СтрНайти(ВРег(СокрЛП(Строка(ПолноеИмяТипа))), "СПРАВОЧНИК.") = 1
		И НЕ ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа)
		И НЕ ЭтоТипПерсоныLLM(ПолноеИмяТипа) Тогда
		Результат = ВладельцыПерсоныPrivacy(ПолноеИмяТипа).Количество() > 0;
	КонецЕсли;

	Если Кэш <> Неопределено Тогда
		Кэш.Вставить(НормТип, Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Полные имена владельцев-персон подчинённого справочника. Пустой массив —
// не справочник, владельцев нет или все владельцы не персоны. Интроспекция
// гасится Попыткой: вид метаданных без свойства Владельцы не роняет решение.
Функция ВладельцыПерсоныPrivacy(ПолноеИмяТипа)

	Результат = Новый Массив;
	Попытка
		ОМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяТипа);
		Если ОМД = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		Для Каждого Владелец Из ОМД.Владельцы Цикл
			Если ЭтоТипПерсоныLLM(Владелец.ПолноеИмя()) Тогда
				Результат.Добавить(Владелец.ПолноеИмя());
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Новый Массив;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Кэш подчинённости из снимка политики либо настроек второго эшелона. Старший
// вызов без снимка обходится без кэша — решение остаётся верным, только дороже.
Функция КэшПодчиненныхPrivacy(Настройки)

	Кэш = Неопределено;
	Если Настройки <> Неопределено И Настройки.Свойство("подчиненные_персонам", Кэш) Тогда
		Возврат Кэш;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// ---- Закрытость типов и полей: единственное решение privacy ----

// Поля типа, которые подменяются в ответе. Поле mode записи на решение не
// влияет: состояний два — подмена включена или выключена.
// Возвращает Массив имён полей.
Функция ЗакрытыеПоляТипаPrivacy(ПолноеИмяТипа, Снимок = Неопределено) Экспорт

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);
	Индекс = Новый Соответствие;
	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);

	// Аварийный режим: состав закрытых типов неизвестен, поэтому у КАЖДОГО
	// ссылочного типа закрыты имя-подобные поля и представление. Данные при этом
	// возвращаются — отказ был бы потерей строк, а не защитой.
	Если Политика.авария И ЭтоСсылочныйТипPrivacy(ПолноеИмяТипа) Тогда
		ДобавитьИмяПодобныеПоляPrivacy(Индекс);
	КонецЕсли;

	Запись = Политика.маски_типов.entries.Получить(НормТип);
	Если Запись <> Неопределено Тогда
		Для Каждого ИмяПоля Из Запись.field_names Цикл
			Индекс.Вставить(ИмяПоля, Истина);
		КонецЦикла;
		Если Запись.mask_presentation Тогда
			ДобавитьИмяПодобныеПоляPrivacy(Индекс);
		ИначеЕсли Запись.presentation_inherited Тогда
			// R-9: наследуется ТОЛЬКО Представление, без имя-подобного набора —
			// иначе тип с одной строковой маской лишился бы имени и кода.
			Индекс.Вставить("Представление", Истина);
		КонецЕсли;
	КонецЕсли;

	Если Политика.типы.entries.Получить(НормТип) <> Неопределено Тогда
		// Псевдоним типа закрывает имена объекта: сама ссылка остаётся, её
		// заменяет стабильный код.
		ДобавитьИмяПодобныеПоляPrivacy(Индекс);
	КонецЕсли;

	// R-12: подчинённый типу персон наследует набор масок владельца. Пока у
	// подчинённого нет своей записи, только запись владельца знает, какие
	// реквизиты закрыты (НаименованиеСлужебное, ИНН).
	Если Политика.маски_типов.enabled
		И ЭтоПодчиненныйТипуПерсонPrivacy(ПолноеИмяТипа, КэшПодчиненныхPrivacy(Политика)) Тогда
		Для Каждого Владелец Из ВладельцыПерсоныPrivacy(ПолноеИмяТипа) Цикл
			ЗаписьВладельца = Политика.маски_типов.entries.Получить(
				MCP_Config.НормализоватьКлючPrivacy(Владелец));
			Если ЗаписьВладельца = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ИмяПоля Из ЗаписьВладельца.field_names Цикл
				Индекс.Вставить(ИмяПоля, Истина);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого КЗ Из Индекс Цикл
		Поля.Добавить(КЗ.Ключ);
	КонецЦикла;
	Возврат Поля;

КонецФункции

// Полное имя указывает на табличную часть, а не на объект. Проверка обязательна
// перед легаси-правилами: типы персон опознаются по ПРЕФИКСУ нормализованного
// имени, и «Справочник.ФизическиеЛица.ТабличнаяЧасть.КонтактнаяИнформация» иначе
// сошёл бы за сам справочник — представление контактной информации маскировалось
// бы как ФИО владельца.
Функция ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа)

	Возврат СтрНайти(ВРег(СокрЛП(Строка(ПолноеИмяТипа))), ".ТАБЛИЧНАЯЧАСТЬ.") > 0;

КонецФункции

// Тип, объекты которого адресуются ссылкой с uuid. Нужен только аварийному
// режиму: закрывать имена там надо у всех таких типов сразу, а перечня закрытых
// типов в этот момент нет. Вид определяется по полному имени, без обращения к
// метаданным, — решение принимается на каждую колонку.
Функция ЭтоСсылочныйТипPrivacy(ПолноеИмяТипа)

	Если ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат MCP_Config.ЭтоСсылочныйВидТипаPrivacy(ПолноеИмяТипа);

КонецФункции

// Безопасная маска значения на случай сбоя подмены: строка → XXXXXXX, дата →
// 1900-01-01T00:00:00, число и булево возвращаются как есть (см. МаскаПоляДляLLM).
// Вызывающая сторона обязана применять её вместо открытого значения, если
// подстановку вычислить не удалось.
Функция МаскаЗначенияPrivacy(ИмяПоля, Значение) Экспорт

	Возврат МаскаПоляДляLLM(ИмяПоля, Значение);

КонецФункции

// Подменяется ли представление объекта этого типа.
Функция ПредставлениеЗакрытоPrivacy(ПолноеИмяТипа, Снимок = Неопределено) Экспорт

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);

	// R-11: представление строки табличной части закрытого типа несёт её
	// содержимое целиком (адрес одной строкой) и закрыто вместе с полями строки.
	Если ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа) Тогда
		Возврат ТипВЗакрытомНабореPrivacy(
			ВладелецТабличнойЧастиПоИмениPrivacy(ПолноеИмяТипа), Политика);
	КонецЕсли;

	Если ТипЗакрытЛегасиПсевдонимамиPrivacy(ПолноеИмяТипа, Политика) Тогда
		Возврат Истина;
	КонецЕсли;

	// Аварийный режим — представление закрыто у всех ссылочных типов.
	Если Политика.авария И ЭтоСсылочныйТипPrivacy(ПолноеИмяТипа) Тогда
		Возврат Истина;
	КонецЕсли;

	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);

	Если Политика.типы.entries.Получить(НормТип) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	ЗаписьМаски = Политика.маски_типов.entries.Получить(НормТип);
	// R-9: представление наследует закрытость от любого закрытого реквизита —
	// оно собирается из реквизитов, и иначе одна строка представления отдаёт
	// всё, что закрыто масками по отдельности (паспортный регистр, Д-4).
	Возврат ЗаписьМаски <> Неопределено
		И (ЗаписьМаски.mask_presentation ИЛИ ЗаписьМаски.presentation_inherited);

КонецФункции

// Поле типа подменяется в ответе (режим не важен).
Функция ПолеЗакрытоPrivacy(ПолноеИмяТипа, ИмяПоля, Снимок = Неопределено) Экспорт

	ВерхИмя = ВРег(СокрЛП(Строка(ИмяПоля)));
	Если ПустаяСтрока(ВерхИмя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);
	// P-4: предикат сверяется ПОНЯТИЕМ, тем же словарём, что и маскирование
	// (P-1). Сверка строкой давала расхождение в обе стороны: до P-1 предикат
	// отвечал «Да» про `Представление`, которое уходило открытым, а после P-1
	// маскирование закрыло бы `inn`, про который предикат отвечал «Нет».
	// Экспортный предикат — это обещание о поведении; расхождение с ним есть
	// дефект независимо от направления.
	КанонИскомого = MCP_Config.КанонПоляPrivacy(ИмяПоля);
	Для Каждого ЗакрытоеПоле Из ЗакрытыеПоляТипаPrivacy(ПолноеИмяТипа, Политика) Цикл
		Если ВРег(ЗакрытоеПоле) = ВерхИмя
			ИЛИ MCP_Config.КанонПоляPrivacy(ЗакрытоеПоле) = КанонИскомого Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	// R-11: поля табличной части закрытого типа.
	Если ПолеТабличнойЧастиЗакрытоPrivacy(ПолноеИмяТипа, ИмяПоля, Политика) Тогда
		Возврат Истина;
	КонецЕсли;

	// R-13: ядро идентифицирующих полей у любого типа из закрытого набора.
	Если ПолеВЯдреИдентификацииPrivacy(ПолноеИмяТипа, ИмяПоля, Политика) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПолеЗакрытоЛегасиПсевдонимомPrivacy(ПолноеИмяТипа, ИмяПоля, Политика);

КонецФункции

// R-13. Ядро идентифицирующих полей: у любого типа из закрытого набора без
// записи в политике закрываются поля, чьи имена содержат «Наименование» или
// «Представление» как часть (включая точное «Наименование»). Перечень имён как
// механизм обходится по построению — четыре независимых обхода одного класса за
// две недели (§4.15); ядро закрывает класс правилом по СТРУКТУРНЫМ именам 1С.
//
// «Номер» в ядро НЕ входит — решение 07.08.2026: он гасил ДоговорыКонтрагентов.Номер
// и ОбразованиеФизическихЛиц.Номер вопреки §6.6; регистрационные номера
// закрываются записями политики, телефоны — правилом R-11.
//
// Точное «Представление» ядром не закрывается: его судьбу решает
// ПредставлениеЗакрытоPrivacy (mask_presentation и наследование R-9), иначе
// признак стал бы константой «любой тип из закрытого набора» — ровно то, от
// чего R-9 сужен ревью (тип с одной строковой маской лишился бы имени и кода).
Функция ПолеВЯдреИдентификацииPrivacy(ПолноеИмяТипа, ИмяПоля, Политика)

	НормПоле = MCP_Config.НормализоватьКлючPrivacy(ИмяПоля);
	Если ПустаяСтрока(НормПоле) ИЛИ НормПоле = "представление" Тогда
		Возврат Ложь;
	КонецЕсли;
	// P-1: подстрочная сверка по-русски ловит производные формы
	// (НаименованиеСлужебное, РасширенноеПредставлениеИНН) и остаётся, а
	// английские ключи она не видела вовсе — `name` уходил открытым (класс К-1).
	// Проверка по понятию добавлена рядом, а не вместо: расширение строго
	// монотонно, ничто ранее закрытое не открывается.
	РольПоля = MCP_Config.РольКлючаPrivacy(НормПоле);
	Если СтрНайти(НормПоле, "наименование") = 0
		И СтрНайти(НормПоле, "представление") = 0
		И РольПоля <> "имя_объекта" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПолеВБеломСпискеЯдраPrivacy(НормПоле, ПолноеИмяТипа, Политика) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТипВЗакрытомНабореPrivacy(ПолноеИмяТипа, Политика);

КонецФункции

// R-13, ограничитель 4. Белый список — три разных класса плюс согласование с
// §6.6, и различать их обязательно: сведённые в один перечень, они пополнялись
// бы не по тому признаку. 4a фиксирован; 4b и 4c пополняются администратором
// по типу — раздельно, ключами core_whitelist_foreign / core_whitelist_classifiers
// записи type_field_masks (аддитивное расширение формата, §3).
Функция ПолеВБеломСпискеЯдраPrivacy(НормПоле, ПолноеИмяТипа, Политика)

	// 4a. Служебные поля объекта. Список фиксирован.
	Если НормПоле = "код" ИЛИ НормПоле = "тип" ИЛИ НормПоле = "вид"
		ИЛИ НормПоле = "виддлясписка" ИЛИ НормПоле = "номерстроки"
		ИЛИ НормПоле = "пометкаудаления" ИЛИ НормПоле = "этогруппа"
		ИЛИ НормПоле = "предопределенный" ИЛИ НормПоле = "имяпредопределенныхданных" Тогда
		Возврат Истина;
	КонецЕсли;

	// 4b. Чужой субъект: поле называет не владельца записи, а другое лицо или
	// орган — банк, налоговую, терр. орган фонда, регистрирующий орган. Признак:
	// подставив XXXXXXX, скрываешь данные о том, кто закрытым типом не является.
	Если НормПоле = "наименованиебанка"
		ИЛИ НормПоле = "наименованиебанкадлярасчетов"
		ИЛИ НормПоле = "наименованиебанкамеждународное"
		ИЛИ НормПоле = "наименованиебанкадлярасчетовмеждународное"
		ИЛИ НормПоле = "наименованиеоператораперевода"
		ИЛИ НормПоле = "наименованиеналоговогооргана"
		ИЛИ НормПоле = "крупнейшийналогоплательщикнаименованиеналоговогооргана"
		ИЛИ НормПоле = "наименованиетерриториальногоорганапфр"
		ИЛИ НормПоле = "наименованиетерриториальногоорганафсс"
		ИЛИ НормПоле = "наименованиерегистрирующегооргана"
		ИЛИ НормПоле = "свидетельствонаименованиеоргана" Тогда
		Возврат Истина;
	КонецЕсли;

	// 4c. Классификаторы: имя парно к коду из списка 4a, по открытому коду
	// восстанавливается однозначно из общедоступного справочника.
	Если НормПоле = "наименованиеоквэд"
		ИЛИ НормПоле = "наименованиеоквэд2"
		ИЛИ НормПоле = "наименованиеокопф"
		ИЛИ НормПоле = "наименованиеокфс"
		ИЛИ НормПоле = "наименованиеосновноговидадеятельностинфо"
		ИЛИ НормПоле = "наименованиеиныхвидовдеятельностинфо"
		ИЛИ НормПоле = "наименованиеидентификаторавстранерегистрации" Тогда
		Возврат Истина;
	КонецЕсли;

	// 4d. Согласование с §6.6: МестоРождения оставлено открытым решением
	// заказчика, и закрывать один его дубль-представление бессмысленно — защиты
	// нет, расхождение внутри одного решения есть. Пересматривать — только оба
	// поля вместе.
	Если НормПоле = "месторожденияпредставление" Тогда
		Возврат Истина;
	КонецЕсли;

	// Пополнение администратора по типу, раздельно по классам 4b и 4c.
	Запись = Политика.маски_типов.entries.Получить(
		MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа));
	СписокИсключений = Неопределено;
	Если Запись <> Неопределено И Запись.Свойство("core_whitelist", СписокИсключений)
		И СписокИсключений <> Неопределено Тогда
		Возврат СписокИсключений.Получить(НормПоле) <> Неопределено;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Тип входит в закрытый набор: собственная запись в политике, легаси-механизм
// персон или организаций либо подчинённость типу персон (R-12). Табличная
// часть типом набора не является — её поля закрывает правило R-11.
Функция ТипВЗакрытомНабореPrivacy(ПолноеИмяТипа, Политика)

	Если ПустаяСтрока(ПолноеИмяТипа) ИЛИ ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа) Тогда
		Возврат Ложь;
	КонецЕсли;

	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);
	Если Политика.маски_типов.enabled
		И Политика.маски_типов.entries.Получить(НормТип) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Политика.типы.enabled
		И Политика.типы.entries.Получить(НормТип) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ТипЗакрытЛегасиПсевдонимамиPrivacy(ПолноеИмяТипа, Политика);

КонецФункции

// R-11. Поля табличной части закрытого типа получают строковую маску: адрес
// лежит в пяти полях строки сразу (Представление, Значение, ЗначенияПолей,
// Страна, Регион), телефоны и почта — там же, и владелец их не наследует.
// Настройкой это не берётся: имена ТЧ у объектов разные и меняются между
// конфигурациями, а неполнота перечня означает открытый адрес (§4.13).
// Классификаторы строки остаются открытыми — иначе телефон не отличить от
// адреса. Явная запись политики на саму ТЧ выигрывает раньше (ЗакрытыеПоляТипа).
Функция ПолеТабличнойЧастиЗакрытоPrivacy(ПолноеИмяТипа, ИмяПоля, Политика)

	Если НЕ ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа) Тогда
		Возврат Ложь;
	КонецЕсли;
	НормПоле = MCP_Config.НормализоватьКлючPrivacy(ИмяПоля);
	Если ПустаяСтрока(НормПоле) ИЛИ КлассификаторСтрокиТЧPrivacy(НормПоле) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТипВЗакрытомНабореPrivacy(
		ВладелецТабличнойЧастиПоИмениPrivacy(ПолноеИмяТипа), Политика);

КонецФункции

// Классификаторы строки табличной части — ограничитель цены R-11 (§4.13, §6.6).
Функция КлассификаторСтрокиТЧPrivacy(НормПоле)

	Возврат НормПоле = "тип"
		ИЛИ НормПоле = "вид"
		ИЛИ НормПоле = "виддлясписка"
		ИЛИ НормПоле = "номерстроки";

КонецФункции

// Владелец табличной части из её полного имени: отсечение суффикса
// «.ТабличнаяЧасть.<Имя>» по последнему вхождению.
Функция ВладелецТабличнойЧастиПоИмениPrivacy(ПолноеИмяТЧ)

	Текст = СокрЛП(Строка(ПолноеИмяТЧ));
	Позиция = СтрНайти(ВРег(Текст), ".ТАБЛИЧНАЯЧАСТЬ.", НаправлениеПоиска.СКонца);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Текст, Позиция - 1);

КонецФункции

// Снимок политики на один вызов инструмента (M-05). НастройкиСервера() читает
// константу и парсит JSON при каждом обращении — межвызовного кеша в проекте нет
// осознанно. Предикаты закрытости вызываются на каждую колонку и на каждую
// ячейку, поэтому без снимка тысяча строк на три помеченных колонки давала бы
// три тысячи разборов JSON на один запрос.
Функция СнимокПолитикиPrivacy() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("типы", MCP_Config.ПсевдонимыТиповLLM());
	Результат.Вставить("маски_типов", MCP_Config.МаскиПолейТиповLLM());
	// Легаси-секции обязаны быть в снимке: решение по персонам принимается на
	// каждой ячейке зарплатного контура, и без снимка каждая читала бы константу
	// заново — тот самый разбор JSON на ячейку, ради которого снимок и вводится.
	Результат.Вставить("персоны", MCP_Config.ПсевдонимыПерсонLLM());
	Результат.Вставить("организации", MCP_Config.ПсевдонимыОрганизацийLLM());
	// Нечитаемая секция политики: состав закрытых типов неизвестен, поэтому
	// действует максимальная маска. Флаг кладётся в снимок, а не спрашивается
	// у конфигурации на каждую ячейку — ради этого снимок и существует.
	Результат.Вставить("авария",
		Результат.типы.emergency ИЛИ Результат.маски_типов.emergency);
	// R-12: кэш подчинённости типам персон живёт со снимком — то же время жизни,
	// что у остальных решений политики, и та же причина (вызовы на каждую ячейку).
	Результат.Вставить("подчиненные_персонам", Новый Соответствие);
	Возврат Результат;

КонецФункции

// Есть ли в политике хоть один закрытый тип. Дешёвый ранний выход: без политики
// разбирать запрос ради пометки колонок не нужно вовсе. Легаси-псевдонимы персон
// и организаций учтены — они закрывают типы без записи в политике. Аварийный
// режим закрывает всё, поэтому раннего выхода в нём быть не может.
Функция ЕстьЗакрытыеТипыPrivacy(Снимок = Неопределено) Экспорт

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);
	Возврат Политика.авария
		ИЛИ Политика.типы.enabled
		ИЛИ Политика.маски_типов.enabled
		ИЛИ Политика.персоны.enabled
		ИЛИ Политика.организации.enabled;

КонецФункции

// Тип анонимизируют легаси-псевдонимы персон и организаций. Перечислить их поля
// списком нельзя: у этого механизма нет записи в политике, состав закрытых полей
// он определяет по именам (ФИО, паспорт, ИНН, СНИЛС, дата рождения), поэтому
// решение принимается парой «тип + имя поля», а не через ЗакрытыеПоляТипаPrivacy.
Функция ТипЗакрытЛегасиПсевдонимамиPrivacy(ПолноеИмяТипа, Снимок = Неопределено)

	Если ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа) Тогда
		Возврат Ложь;
	КонецЕсли;

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);

	// R-12: подчинённые справочники персон закрыты тем же механизмом, что их
	// владельцы, — по факту подчинённости, а не по вхождению в политику.
	Если ЭтоТипПерсональногоНабораLLM(ПолноеИмяТипа, КэшПодчиненныхPrivacy(Политика)) Тогда
		Возврат Политика.персоны.enabled;
	КонецЕсли;
	Если ЭтоТипОрганизацииLLM(ПолноеИмяТипа) Тогда
		Возврат Политика.организации.enabled;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Поле закрыто легаси-псевдонимом: те же правила по именам, что применяет
// маскирование готового ответа, — иначе плоская выборка ФИО остаётся открытой
// при любой политике, потому что физлиц и сотрудников в type_aliases класть
// запрещено (ТипПокрытЛегасиПсевдонимамиLLM).
Функция ПолеЗакрытоЛегасиПсевдонимомPrivacy(ПолноеИмяТипа, ИмяПоля, Снимок = Неопределено)

	Если ЭтоТабличнаяЧастьПоИмениPrivacy(ПолноеИмяТипа) Тогда
		Возврат Ложь;
	КонецЕсли;

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);

	// R-12: подчинённые справочники персон наследуют правила владельца.
	Если ЭтоТипПерсональногоНабораLLM(ПолноеИмяТипа, КэшПодчиненныхPrivacy(Политика)) Тогда
		Если НЕ Политика.персоны.enabled Тогда
			Возврат Ложь;
		КонецЕсли;
		// R-15: набор ФИО закрывается правилом эшелона разбора запроса, а не
		// перечнем — перечень обходился четырежды за две недели, и решение по
		// имени ключа ответа снимается псевдонимом колонки (§4.12).
		Если ПолеИзНабораФИОPrivacy(ИмяПоля) Тогда
			Возврат Истина;
		КонецЕсли;
		// Владелец поля — сам тип персоны, поэтому общее Наименование тоже её имя.
		Возврат ПолеПохожеНаИмяПерсоныLLM(ИмяПоля, "", Истина)
			ИЛИ ПолеНужноМаскироватьПерсональныеДанныеLLM(ИмяПоля, "", Политика.персоны, "");
	КонецЕсли;

	Если ЭтоТипОрганизацииLLM(ПолноеИмяТипа) Тогда
		Возврат Политика.организации.enabled
			И ПолеПохожеНаНазваниеОрганизацииLLM(ИмяПоля, "", Истина);
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// R-15. Набор ФИО у типов персон и подчинённых им справочников (R-12). Это тот
// же набор, который закрывает второй эшелон по имени ключа, — требование
// переносит решение туда, где оно переживает псевдоним колонки. МестоРождения
// и МестоРожденияПредставление в набор НЕ входят — решение заказчика 06.08.2026
// (§6.6), риск F-3 принят и называется приёмкой открытым по решению.
Функция ПолеИзНабораФИОPrivacy(ИмяПоля)

	НормПоле = MCP_Config.НормализоватьКлючPrivacy(ИмяПоля);
	Возврат НормПоле = "фамилия"
		ИЛИ НормПоле = "имя"
		ИЛИ НормПоле = "отчество"
		ИЛИ НормПоле = "фио"
		ИЛИ НормПоле = "инициалы"
		ИЛИ НормПоле = "наименованиеслужебное"
		ИЛИ НормПоле = "уточнениенаименования";

КонецФункции

// Значение подмены для колонки закрытого типа. Ссылка объекта в строке известна
// → стабильный код от uuid, тот же, что у ссылочных значений, поэтому строки
// сопоставимы между собой и между ответами. Ссылки нет → <Префикс>скрыто.
// Нет и псевдонима у типа (тип только в масках полей) → строковая маска.
// ЗначениеПроизводное — колонка несёт результат выражения над закрытым полем
// (R-3), а не само поле. Код псевдонима означает «это тот самый объект» и служит
// для сопоставления строк между собой и между ответами; ПОДСТРОКА(имя, 1, 20)
// объектом не является, и код в такой колонке склеил бы строки, которых в данных
// нет. Поэтому производное значение получает обычную маску по виду значения.
Функция ПодменаЗначенияPrivacy(ПолноеИмяТипа, UUID, ИмяПоля, Значение, Снимок = Неопределено,
	ЗначениеПроизводное = Ложь) Экспорт

	Если ЗначениеПроизводное Тогда
		Возврат МаскаПоляДляLLM(ИмяПоля, Значение);
	КонецЕсли;

	Политика = ?(Снимок = Неопределено, СнимокПолитикиPrivacy(), Снимок);

	Если ТипЗакрытЛегасиПсевдонимамиPrivacy(ПолноеИмяТипа, Политика) Тогда
		Возврат ПодменаЛегасиПсевдонимаPrivacy(ПолноеИмяТипа, UUID, ИмяПоля, Значение, Политика);
	КонецЕсли;
	НормТип = MCP_Config.НормализоватьКлючPrivacy(ПолноеИмяТипа);
	Запись = Политика.типы.entries.Получить(НормТип);
	// Код псевдонима подставляется вместо ИМЕНИ объекта. Прочие закрытые поля —
	// номер документа, идентификатор, дата — именем не являются: строка в
	// колонке-дате и в числовой ломает типизацию у клиента, поэтому им положена
	// обычная маска. Тот же принцип уже соблюдён в МаскаПоляТипаДляLLM.
	Если Запись = Неопределено ИЛИ НЕ ПолеИмениОбъектаДляПодменыPrivacy(ИмяПоля) Тогда
		Возврат МаскаПоляДляLLM(ИмяПоля, Значение);
	КонецЕсли;

	Если НЕ ПустаяСтрока(UUID) Тогда
		Возврат Запись.prefix + КодПсевдонимаТипаLLM(ПолноеИмяТипа, UUID);
	КонецЕсли;

	Возврат Запись.hidden_alias;

КонецФункции

// Подменяется имя объекта, а не прочее закрытое поле. Пустое имя означает
// представление объекта — это тоже его имя.
Функция ПолеИмениОбъектаДляПодменыPrivacy(ИмяПоля)

	НормПоле = MCP_Config.НормализоватьКлючPrivacy(ИмяПоля);
	Возврат ПустаяСтрока(НормПоле) ИЛИ MCP_Config.ПолеИмениОбъектаPrivacy(НормПоле);

КонецФункции

// Подстановка для типа, закрытого легаси-псевдонимами. Псевдоним заменяет только
// имя объекта и его представление — как в МаскироватьПерсонуДляLLM; паспорт,
// СНИЛС и дата рождения именем не являются и получают обычную маску, иначе в
// колонке даты оказалась бы строка вида «ФЛ-123456».
Функция ПодменаЛегасиПсевдонимаPrivacy(ПолноеИмяТипа, UUID, ИмяПоля, Значение, Политика)

	ЭтоИмя = ПустаяСтрока(СокрЛП(Строка(ИмяПоля)));

	Если ЭтоТипПерсональногоНабораLLM(ПолноеИмяТипа, КэшПодчиненныхPrivacy(Политика)) Тогда
		ПсевдонимыПерсон = Политика.персоны;
		Если НЕ ЭтоИмя И НЕ ПолеПохожеНаИмяПерсоныLLM(ИмяПоля, "", Истина) Тогда
			Возврат МаскаПоляДляLLM(ИмяПоля, Значение);
		КонецЕсли;
		Если ПустаяСтрока(UUID) Тогда
			Возврат ПсевдонимыПерсон.hidden_alias;
		КонецЕсли;
		Возврат ПсевдонимПерсоныLLM(ПолноеИмяТипа, UUID, ПсевдонимыПерсон);
	КонецЕсли;

	ПсевдонимыОрганизаций = Политика.организации;
	Если НЕ ЭтоИмя И НЕ ПолеПохожеНаНазваниеОрганизацииLLM(ИмяПоля, "", Истина) Тогда
		Возврат МаскаПоляДляLLM(ИмяПоля, Значение);
	КонецЕсли;
	Если ПустаяСтрока(UUID) Тогда
		Возврат ПсевдонимыОрганизаций.hidden_alias;
	КонецЕсли;
	Возврат ПсевдонимОрганизацииLLM(ПолноеИмяТипа, UUID, ПсевдонимыОрганизаций.prefix);

КонецФункции

// Платформенные имя-подобные поля для жёсткого запрета. Представление —
// не поле метаданных, но слово ПРЕДСТАВЛЕНИЕ в тексте закрывает и функцию
// ПРЕДСТАВЛЕНИЕ() над закрытым источником (грубое приближение HR-04).
Процедура ДобавитьИмяПодобныеПоляPrivacy(Индекс)

	Индекс.Вставить("Наименование", Истина);
	Индекс.Вставить("НаименованиеПолное", Истина);
	Индекс.Вставить("ПолноеНаименование", Истина);
	Индекс.Вставить("КраткоеНаименование", Истина);
	Индекс.Вставить("Код", Истина);
	Индекс.Вставить("Представление", Истина);

КонецПроцедуры

// Типы, которые анонимизирует легаси-механизм организаций и персон.
// privacy.type_aliases для них отклоняется: второй псевдоним перезатирал
// бы уже выданный легаси-код, нарушая стабильность кодов между ответами.
// R-12: подчинённые типам персон покрыты тем же механизмом — и по той же
// причине не должны получать второй псевдоним записью type_aliases.
Функция ТипПокрытЛегасиПсевдонимамиLLM(ПолноеИмяТипа) Экспорт

	Возврат ЭтоТипОрганизацииLLM(ПолноеИмяТипа)
		ИЛИ ЭтоТипПерсональногоНабораLLM(ПолноеИмяТипа);

КонецФункции

Функция ПсевдонимОрганизацииLLM(ТипСсылки, UUID, Prefix)

	Возврат Prefix + КодПсевдонимаLLM(ТипСсылки, UUID);

КонецФункции

Функция КодПсевдонимаLLM(ТипСсылки, UUID)

	Текст = ВРег(СокрЛП(Строка(ТипСсылки))) + "|" + ВРег(СокрЛП(Строка(UUID)));
	Хеш = 0;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Хеш = Хеш * 33 + КодСимвола(Сред(Текст, Позиция, 1));
		Хеш = Хеш - Цел(Хеш / 1000000) * 1000000;
	КонецЦикла;

	Код = Строка(Хеш);
	Пока СтрДлина(Код) < 6 Цикл
		Код = "0" + Код;
	КонецЦикла;

	Возврат Код;

КонецФункции

Функция ПсевдонимПерсоныLLM(ТипСсылки, UUID, ПсевдонимыПерсон)

	Если ЭтоТипСотрудникаLLM(ТипСсылки) Тогда
		Prefix = ПсевдонимыПерсон.employee_prefix;
	ИначеЕсли ЭтоТипПользователяLLM(ТипСсылки) Тогда
		Prefix = ПсевдонимыПерсон.user_prefix;
	Иначе
		Prefix = ПсевдонимыПерсон.physical_person_prefix;
	КонецЕсли;
	Возврат Prefix + КодПсевдонимаLLM(ТипСсылки, UUID);

КонецФункции

Функция ПолеПохожеНаНазваниеОрганизацииLLM(Ключ, Путь, РазрешитьОбщееНаименование)

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);

	Если ПолеПохожеНаТехническийКлючОрганизацииLLM(НормКлюч)
		ИЛИ ПолеПохожеНаТехническийКлючОрганизацииLLM(НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если РазрешитьОбщееНаименование
		И (НормКлюч = "name"
			ИЛИ НормКлюч = "presentation"
			ИЛИ СтрНайти(НормКлюч, "наименование") > 0
			ИЛИ СтрНайти(НормКлюч, "fullname") > 0
			ИЛИ СтрНайти(НормКлюч, "fulltitle") > 0) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНайти(НормКлюч, "organization") > 0
		ИЛИ СтрНайти(НормКлюч, "организац") > 0
		ИЛИ СтрНайти(НормПуть, "organizationname") > 0
		ИЛИ СтрНайти(НормПуть, "организациянаименование") > 0
		ИЛИ СтрНайти(НормПуть, "наименованиеорганизац") > 0;

КонецФункции

Функция ПолеПохожеНаТехническийКлючОрганизацииLLM(НормИмя)

	Возврат СтрНайти(НормИмя, "uuid") > 0
		ИЛИ СтрНайти(НормИмя, "идентификатор") > 0
		ИЛИ СтрНайти(НормИмя, "navigationurl") > 0
		ИЛИ СтрНайти(НормИмя, "url") > 0
		ИЛИ СтрНайти(НормИмя, "ref") > 0
		ИЛИ СтрНайти(НормИмя, "ссылка") > 0
		ИЛИ СтрНайти(НормИмя, "type") > 0
		ИЛИ СтрНайти(НормИмя, "тип") > 0
		ИЛИ СтрНайти(НормИмя, "inn") > 0
		ИЛИ СтрНайти(НормИмя, "инн") > 0
		ИЛИ СтрНайти(НормИмя, "kpp") > 0
		ИЛИ СтрНайти(НормИмя, "кпп") > 0;

КонецФункции

Функция ПолеНужноМаскироватьПерсональныеДанныеLLM(Ключ, Путь, ПсевдонимыПерсон, ПсевдонимПерсоны)

	Если НЕ ПсевдонимыПерсон.enabled Тогда
		Возврат Ложь;
	КонецЕсли;

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);

	Если ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ПсевдонимПерсоны)
		И ПолеПохожеНаИмяПерсоныLLM(Ключ, Путь, Истина) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПолеПохожеНаПаспортныеДанныеLLM(НормКлюч)
		ИЛИ ПолеПохожеНаПаспортныеДанныеLLM(НормПуть) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ПолеПохожеНаПерсональныйНомерLLM(НормКлюч)
		ИЛИ ПолеПохожеНаПерсональныйНомерLLM(НормПуть) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ПолеПохожеНаСтраховойНомерLLM(НормКлюч)
		ИЛИ ПолеПохожеНаСтраховойНомерLLM(НормПуть) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ПолеПохожеНаДатуРожденияLLM(НормКлюч)
		ИЛИ ПолеПохожеНаДатуРожденияLLM(НормПуть) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПолеПохожеНаИмяПерсоныLLM(Ключ, Путь, РазрешитьОбщееИмя)

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);

	Если ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПолеПохожеНаТехническийКлючОрганизацииLLM(НормКлюч)
		ИЛИ ПолеПохожеНаТехническийКлючОрганизацииLLM(НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НормКлюч = "фио"
		ИЛИ НормКлюч = "fullname"
		ИЛИ НормКлюч = "fulltitle"
		ИЛИ НормКлюч = "фамилия"
		ИЛИ НормКлюч = "surname"
		ИЛИ НормКлюч = "lastname"
		ИЛИ НормКлюч = "отчество"
		ИЛИ НормКлюч = "отчетство"
		ИЛИ НормКлюч = "patronymic"
		ИЛИ НормКлюч = "middlename" Тогда
		Возврат Истина;
	КонецЕсли;

	// P-1: четвёртый словарь имён был здесь. «Имя» остаётся отдельной веткой —
	// это имя ЧЕЛОВЕКА, а не объекта, и в общий словарь оно не входит.
	РольКлюча = MCP_Config.РольКлючаPrivacy(НормКлюч);
	Если РазрешитьОбщееИмя
		И (РольКлюча = "имя_объекта" ИЛИ РольКлюча = "представление"
			ИЛИ НормКлюч = "имя") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНайти(НормКлюч, "физлиц") > 0
		ИЛИ СтрНайти(НормКлюч, "физическоелиц") > 0
		ИЛИ СтрНайти(НормКлюч, "сотрудник") > 0
		ИЛИ СтрНайти(НормКлюч, "employee") > 0
		ИЛИ СтрНайти(НормКлюч, "person") > 0
		ИЛИ СтрНайти(НормПуть, "физлиц") > 0
		ИЛИ СтрНайти(НормПуть, "физическоелиц") > 0
		ИЛИ СтрНайти(НормПуть, "сотрудник") > 0
		ИЛИ СтрНайти(НормПуть, "employee") > 0
		ИЛИ СтрНайти(НормПуть, "person") > 0;

КонецФункции

// P-3. Подавитель служебных настроек privacy АНКЕРИТСЯ ПУТЁМ.
//
// Он существует ради одного: не маскировать саму опубликованную политику — иначе
// клиент увидит `privacy.type_aliases.entries[].prefix` = XXXXXXX и не поймёт, чем
// закрыты значения. Это описание МЕХАНИЗМА, и живёт оно в privacy-секциях ответа.
//
// Сверка подстрокой в произвольном ключе выключала Л3 и Л4 для любой колонки, чьё
// имя клиент назвал `…Prefix` или `…Alias`: замер П13 — три таких ключа открыты на
// трёх контурах при закрытом `Наименование` рядом. Колонка данных, названная
// `ПрефиксНоменклатуры`, к описанию политики отношения не имеет.
//
// Анкеровка именно НАЧАЛОМ пути, а не вхождением: `privacy` где-то в середине пути
// означает данные, лежащие под ключом с таким именем, а не нашу секцию.
Функция ПолеПохожеНаСлужебнуюPrivacyНастройкуLLM(НормКлюч, НормПуть)

	Если НЕ ПутьВнутриСекцииPrivacyLLM(НормПуть) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НормКлюч = "personaliases"
		ИЛИ НормКлюч = "organizationaliases"
		ИЛИ СтрНайти(НормКлюч, "prefix") > 0
		ИЛИ СтрНайти(НормКлюч, "alias") > 0
		ИЛИ СтрНайти(НормПуть, "privacy") > 0
		ИЛИ СтрНайти(НормПуть, "personaliases") > 0
		ИЛИ СтрНайти(НормПуть, "organizationaliases") > 0;

КонецФункции

// Путь начинается с privacy-секции ответа. Секции три, и все три — собственный
// контракт сервера: `privacy` (get_current_user_context, guidance инструментов),
// `person_aliases` и `organization_aliases` (легаси-разделы той же политики).
Функция ПутьВнутриСекцииPrivacyLLM(НормПуть)

	Для Каждого Секция Из СтрРазделить("privacy,personaliases,organizationaliases", ",", Ложь) Цикл
		Если НормПуть = Секция ИЛИ СтрНачинаетсяС(НормПуть, Секция + ".") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПолеПохожеНаПаспортныеДанныеLLM(НормИмя)

	Возврат СтрНайти(НормИмя, "паспорт") > 0
		ИЛИ СтрНайти(НормИмя, "passport") > 0;

КонецФункции

Функция ПолеПохожеНаПерсональныйНомерLLM(НормИмя)

	Возврат СтрНайти(НормИмя, "индивидуальныйномер") > 0
		ИЛИ СтрНайти(НормИмя, "идентификационныйномер") > 0
		ИЛИ СтрНайти(НормИмя, "персональныйномер") > 0
		ИЛИ СтрНайти(НормИмя, "personalnumber") > 0
		ИЛИ СтрНайти(НормИмя, "individualnumber") > 0
		ИЛИ СтрНайти(НормИмя, "identificationnumber") > 0
		ИЛИ СтрНайти(НормИмя, "иннфиз") > 0;

КонецФункции

Функция ПолеПохожеНаСтраховойНомерLLM(НормИмя)

	Возврат СтрНайти(НормИмя, "страховойномер") > 0
		ИЛИ СтрНайти(НормИмя, "снилс") > 0
		ИЛИ СтрНайти(НормИмя, "snils") > 0
		ИЛИ СтрНайти(НормИмя, "insurancenumber") > 0;

КонецФункции

Функция ПолеПохожеНаДатуРожденияLLM(НормИмя)

	Возврат СтрНайти(НормИмя, "датарождения") > 0
		ИЛИ СтрНайти(НормИмя, "birthday") > 0
		ИЛИ СтрНайти(НормИмя, "birthdate") > 0
		ИЛИ СтрНайти(НормИмя, "dateofbirth") > 0;

КонецФункции

// Значение, которое вообще можно заменить маской: скаляр, а не контейнер.
// Массив обязателен в проверке наравне со структурой — на нём проект уже
// ошибся: ветка R-11 проверяла только «не объект», и КОЛЛЕКЦИЯ строк
// табличной части (ключ tabular_sections у get_object_by_ref) целиком
// заменялась одной строкой XXXXXXX. Утечки это не давало, но разрушало ответ:
// пропадали и классификаторы строки, которые обязаны оставаться открытыми
// (парная проба G2″), — то есть «закрыто лишнее», что по правилу пробы Ав4
// считается провалом наравне с утечкой. Контейнер нужно отдать рекурсии: она
// дойдёт до полей строк и закроет их поимённо.
Функция ЗначениеСкалярноеДляМаскиPrivacy(Значение)

	Возврат НЕ ЭтоJSONОбъект(Значение)
		И ТипЗнч(Значение) <> Тип("Массив")
		И ТипЗнч(Значение) <> Тип("ФиксированныйМассив");

КонецФункции

Функция ЭтоJSONОбъект(Значение)

	Возврат ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие");

КонецФункции

Функция ПолеОбъекта(Объект, Имя)

	Значение = Неопределено;
	Если ТипЗнч(Объект) = Тип("Структура")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Если Объект.Свойство(Имя, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Для Каждого КЗ Из Объект Цикл
			Если ВРег(Строка(КЗ.Ключ)) = ВРег(Имя) Тогда
				Возврат КЗ.Значение;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие")
		ИЛИ ТипЗнч(Объект) = Тип("ФиксированноеСоответствие") Тогда
		Значение = Объект.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Для Каждого КЗ Из Объект Цикл
			Если ВРег(Строка(КЗ.Ключ)) = ВРег(Имя) Тогда
				Возврат КЗ.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолеТехническихМетаданныхLLM(Ключ, Путь, Значение = Неопределено)

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);

	// P-2 п. 3: `fullname` из технического списка убран — это роль «имя объекта»
	// (P-1), и здесь он открывал `full_name` на всех трёх контурах. Полные имена
	// метаданных публикуются под `full_name` в путях с `metadata`, и их закрывает
	// анкеровка ниже — то есть покрытие не потеряно.
	//
	// P-2 п. 2: РУССКИЕ `тип`/`вид` анкерятся путём метаданных. Английские имена —
	// ключи собственного контракта сервера и в данных не встречаются, а `Вид`
	// внутри строки данных техническим не является: это вид контактной информации,
	// а не описание схемы. Классификаторы строк ТЧ при этом остаются открытыми
	// своим правилом (КлассификаторСтрокиТЧPrivacy, R-11) — не этим.
	Если (НормКлюч = "тип" ИЛИ НормКлюч = "вид")
		И СтрНайти(НормПуть, "metadata") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Если НормКлюч = "type"
		ИЛИ НормКлюч = "kind"
		ИЛИ НормКлюч = "qualifiedname"
		ИЛИ НормКлюч = "typedescription"
		ИЛИ НормКлюч = "valuetypes"
		ИЛИ НормКлюч = "querytable"
		ИЛИ НормКлюч = "resourceuri"
		ИЛИ НормКлюч = "register"
		ИЛИ НормКлюч = "registertype"
		ИЛИ НормКлюч = "accountingregister"
		ИЛИ НормКлюч = "chart"
		ИЛИ НормКлюч = "plan"
		ИЛИ НормКлюч = "report"
		ИЛИ НормКлюч = "sourcetype"
		ИЛИ НормКлюч = "documenttype"
		ИЛИ НормКлюч = "itemtype"
		ИЛИ НормКлюч = "targettype" Тогда
		Возврат Истина;
	КонецЕсли;

	// `fullname` здесь ОБЯЗАТЕЛЕН, и это парная половина п. 3: из безусловного
	// списка он убран (там он открывал `full_name` данных на трёх контурах), но в
	// путях с `metadata` под этим ключом лежит ПОЛНОЕ ИМЯ МЕТАДАННЫХ
	// («Справочник.Контрагенты») — имя типа, а не имя объекта. Убрать из одного
	// списка и не добавить в другой значило закрыть `metadata.full_name`, то есть
	// разменять утечку на разрушенный контракт: клиент перестаёт видеть, о каком
	// объекте метаданных идёт речь. Проба П15 держит это числом — восемнадцатый лист.
	// АНКЕРОВКА ПУТЁМ ЗДЕСЬ НЕДОСТАТОЧНА, и это выяснила приёмка, а не рассуждение.
	// Полное имя метаданных публикуется не только под путём `metadata`: discovery
	// отдаёт его в `objects[].full_name` (list_metadata_objects) и
	// `registers[].full_name` (list_registers), где слова `metadata` в пути нет.
	// Замер на ревизии .3: BUH 30/30 и 20/20, ZUP 30/30 и 20/20 — вместо
	// «Справочник.Контрагенты» клиент получал `ФЛ-скрыто`. Данные при этом не
	// текли, но контракт discovery был разрушен: LLM не может узнать имена
	// объектов и не строит ни одного запроса.
	//
	// Различитель механизма: на ERP person_aliases выключены, и там имена целы
	// (0/30) — закрывала линия персон по роли «имя объекта» (P-1).
	//
	// Поэтому решаем ПО СУЩЕСТВУ ЗНАЧЕНИЯ, а не по месту в ответе: полное имя
	// метаданных имеет форму «<Вид>.<Имя>» с видом из закрытого перечня, и такое
	// значение не является ни именем человека, ни именем объекта данных. ФИО
	// оператора в `user.full_name` этой формы не имеет и закрывается по-прежнему.
	//
	// Список путей был бы хрупким по построению: сегодня забыли `objects[]` и
	// `registers[]`, завтра появится третья коллекция — и регресс вернётся молча.
	Если НормКлюч = "fullname" И ЭтоПолноеИмяМетаданныхPrivacy(Значение) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНайти(НормПуть, "metadata") > 0
		И (НормКлюч = "name"
			ИЛИ НормКлюч = "fullname"
			ИЛИ НормКлюч = "synonym"
			ИЛИ НормКлюч = "description"
			ИЛИ НормКлюч = "comment"
			ИЛИ НормКлюч = "presentation"
			ИЛИ НормКлюч = "category");

КонецФункции

// Значение — ПОЛНОЕ ИМЯ ОБЪЕКТА МЕТАДАННЫХ («Справочник.Контрагенты»), то есть
// элемент собственного контракта сервера, а не данные информационной базы.
//
// Проверяется форма «<Вид>.<Имя>» с видом из закрытого перечня видов метаданных
// платформы, русским или английским. Перечень закрытый намеренно: свободное
// правило «есть точка» открыло бы любую строку с точкой, включая доменные имена
// и адреса, а они бывают персональными данными.
//
// Имя человека такой формы не имеет: «Иванов Иван Иванович» не начинается видом
// метаданных, поэтому линия персон продолжает закрывать ФИО в user.full_name.
Функция ЭтоПолноеИмяМетаданныхPrivacy(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Текст = СокрЛП(Значение);
	Позиция = СтрНайти(Текст, ".");
	Если Позиция < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Вид = НРег(Лев(Текст, Позиция - 1));
	// Имя после вида обязано быть непустым: «Справочник.» именем типа не является.
	Если ПустаяСтрока(Сред(Текст, Позиция + 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Виды = "справочник,документ,перечисление,отчет,отчёт,обработка,константа,"
		+ "регистрсведений,регистрнакопления,регистрбухгалтерии,регистррасчета,регистррасчёта,"
		+ "плансчетов,планвидовхарактеристик,планвидоврасчета,планвидоврасчёта,планобмена,"
		+ "бизнеспроцесс,задача,журналдокументов,последовательность,критерийотбора,"
		+ "определяемыйтип,общийреквизит,catalog,document,enum,report,dataprocessor,constant,"
		+ "informationregister,accumulationregister,accountingregister,calculationregister,"
		+ "chartofaccounts,chartofcharacteristictypes,chartofcalculationtypes,exchangeplan,"
		+ "businessprocess,task,documentjournal,sequence,filtercriterion";
	Для Каждого ИзвестныйВид Из СтрРазделить(Виды, ",", Ложь) Цикл
		Если Вид = ИзвестныйВид Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Порча (P-2 п. 6). Элемент СОБСТВЕННОГО контракта, который подменять нельзя:
//   • имя колонки схемы табличной части — путь содержит `columns`;
//   • name/presentation значения перечисления — у контейнера type начинается с
//     «Перечисление.» (в английской публикации — «Enum.»).
// Оба случая проходили как «имя объекта закрытого типа» и получали код псевдонима
// строки. Образец анкеровки уже был в коде — путь с `metadata`; здесь тот же приём.
//
// Ключ сверяется РОЛЬЮ (P-1), а не буквой: закрывать надо оба языка сразу.
Функция ЭлементСхемыИлиПеречисленияPrivacy(Ключ, Путь, ЭтоЗначениеПеречисления)

	Роль = MCP_Config.РольКлючаPrivacy(Ключ);
	Если Роль <> "имя_объекта" И Роль <> "представление" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЭтоЗначениеПеречисления Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНайти(НормализоватьИмяПоляДляМаскированияLLM(Путь), "columns") > 0;

КонецФункции

// Значение перечисления в ответе: собственный type вида «Перечисление.<Имя>» без
// uuid — перечисления объектами не являются, псевдонимизировать их нечем и незачем.
// ИМЯ ПЕРЕМЕННОЙ ЗДЕСЬ НЕ КОСМЕТИКА: `ТипЗначенияJSON` — СИСТЕМНОЕ перечисление
// платформы (глобальное свойство контекста), и присваивание ему даёт «Поле
// объекта недоступно для записи» — ошибку ВЫПОЛНЕНИЯ, не компиляции. Функция
// зовётся на каждый контейнер ответа, поэтому падали все 37 инструментов при
// живом tools/list; ревизия 2026-08-10.2 была отозвана публикацией .1.
Функция ЭтоЗначениеПеречисленияPrivacy(Значение)

	ТипИзОтвета = СтроковоеПоле(Значение, "type");
	Если ПустаяСтрока(ТипИзОтвета) Тогда
		Возврат Ложь;
	КонецЕсли;
	НормТип = НРег(СокрЛП(ТипИзОтвета));
	Возврат СтрНачинаетсяС(НормТип, "перечисление.") ИЛИ СтрНачинаетсяС(НормТип, "enum.");

КонецФункции

Функция СтроковоеПоле(Объект, Имя)

	Значение = ПолеОбъекта(Объект, Имя);
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ПолеНужноМаскироватьLLM(Ключ, Путь, Индекс)

	НормКлюч = НормализоватьИмяПоляДляМаскированияLLM(Ключ);
	Если НЕ ПустаяСтрока(НормКлюч) И Индекс.Получить(НормКлюч) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	НормПуть = НормализоватьИмяПоляДляМаскированияLLM(Путь);
	Возврат НЕ ПустаяСтрока(НормПуть) И Индекс.Получить(НормПуть) <> Неопределено;

КонецФункции

Функция МаскаПоляДляLLM(Ключ, Значение)

	// Пустое значение остаётся пустым: маскировать нечего, а повторное
	// маскирование не должно превращать уже выданный null в XXXXXXX.
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата")
		ИЛИ ИмяПоляПохожеНаДатуLLM(Ключ)
		ИЛИ СтрокаПохожаНаДатуLLM(Значение) Тогда
		Возврат "1900-01-01T00:00:00";
	КонецЕсли;

	// Числа и булево не закрываются вовсе (решение 05.08.2026). Подмены, которая
	// не искажает, для них не существует: строка ломает типизацию у клиента, а
	// null — это стирание значения, а не псевдоним. Стирать нечего: сумма и
	// количество личными данными не являются, а маска по числовому полю только
	// создавала бы ложное ощущение защиты. Парсер политики предупреждает, что
	// числовое или булево поле в type_field_masks не действует.
	Если ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат "XXXXXXX";

КонецФункции

Функция НовыйПутьМаскированияLLM(Путь, Ключ)

	Если ПустаяСтрока(Путь) Тогда
		Возврат Ключ;
	КонецЕсли;
	Возврат Путь + "." + Ключ;

КонецФункции

Функция НормализоватьИмяПоляДляМаскированияLLM(Имя)

	Текст = НРег(СокрЛП(Строка(Имя)));
	ПозДубликата = СтрНайти(Текст, "#");
	Если ПозДубликата > 1 Тогда
		Текст = Лев(Текст, ПозДубликата - 1);
	КонецЕсли;

	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символы.Таб, "");
	Текст = СтрЗаменить(Текст, "_", "");
	Текст = СтрЗаменить(Текст, "-", "");
	Текст = СтрЗаменить(Текст, ".", "");
	Возврат Текст;

КонецФункции

Функция ИмяПоляПохожеНаДатуLLM(Ключ)

	Текст = НРег(Строка(Ключ));
	Возврат СтрНайти(Текст, "дата") > 0
		ИЛИ СтрНайти(Текст, "date") > 0
		ИЛИ СтрНайти(Текст, "birth") > 0
		ИЛИ СтрНайти(Текст, "рожд") > 0;

КонецФункции

Функция СтрокаПохожаНаДатуLLM(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = СокрЛП(Значение);
	Если СтрДлина(Текст) < 10 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат (Сред(Текст, 5, 1) = "-" И Сред(Текст, 8, 1) = "-")
		ИЛИ (Сред(Текст, 3, 1) = "." И Сред(Текст, 6, 1) = ".");

КонецФункции

// ---- Безопасность динамических запросов ---------------------------

Функция ИмяБезопасноДляЗапроса(Имя) Экспорт

	Имя = Строка(Имя);
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Идентификатор не может начинаться с цифры.
	Первый = Лев(Имя, 1);
	КодПервого = КодСимвола(Первый);
	Если КодПервого >= КодСимвола("0") И КодПервого <= КодСимвола("9") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Имя) Цикл
		С = Сред(Имя, Позиция, 1);
		Если НЕ ЯвляетсяСимволомИдентификатора(С) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ПолноеИмяБезопасноДляЗапроса(ПолноеИмя) Экспорт

	ПолноеИмя = Строка(ПолноеИмя);
	Поз = СтрНайти(ПолноеИмя, ".");
	Если Поз <= 1 ИЛИ Поз = СтрДлина(ПолноеИмя) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрНайти(Сред(ПолноеИмя, Поз + 1), ".") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ИмяБезопасноДляЗапроса(Лев(ПолноеИмя, Поз - 1))
		И ИмяБезопасноДляЗапроса(Сред(ПолноеИмя, Поз + 1));

КонецФункции

Функция ЯвляетсяСимволомИдентификатора(С)

	Если С = "_" ИЛИ С = "Ё" ИЛИ С = "ё" Тогда
		Возврат Истина;
	КонецЕсли;

	Код = КодСимвола(С);
	Возврат (Код >= КодСимвола("0") И Код <= КодСимвола("9"))
		ИЛИ (Код >= КодСимвола("A") И Код <= КодСимвола("Z"))
		ИЛИ (Код >= КодСимвола("a") И Код <= КодСимвола("z"))
		ИЛИ (Код >= КодСимвола("А") И Код <= КодСимвола("я"));

КонецФункции

