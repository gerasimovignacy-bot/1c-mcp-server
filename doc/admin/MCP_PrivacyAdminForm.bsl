// ============================================================================
// МОДУЛЬ ФОРМЫ ВНЕШНЕЙ ОБРАБОТКИ: управление privacy-политикой MCP + пробы
// приёмки. Ревизия движка, под которую написан модуль: 2026-08-05.2 (после #116
// и #118).
//
// РЕКВИЗИТЫ ФОРМЫ: используется единственный уже существующий реквизит
//   значениеКонст  (Строка, неограниченной длины)
// Новых реквизитов создавать не нужно.
//
// Один буфер на две константы — источник реальной аварии: прочитав allowlist и
// нажав запись server-config, можно затереть всю серверную настройку. Поэтому
// перед записью проверяется, что содержимое буфера ПОХОЖЕ на целевую константу:
// у них не пересекаются ключи верхнего уровня (allowlist — default_policy,
// allowed_kinds, denied_objects…; server_config — http, privacy, limits…).
//
// ОБЩИЕ МОДУЛИ РАСШИРЕНИЯ ИЗ ВНЕШНЕЙ ОБРАБОТКИ НЕ ВИДНЫ на этапе компиляции,
// поэтому MCP_Config вызывается через Вычислить(). Прямой вызов
// MCP_Config.ИнформацияМаскированияLLM() даёт «Переменная не определена
// (MCP_Config)». Константы расширения при этом доступны, но берутся индексом —
// Константы["Имя"], а не точкой, чтобы не зависеть от видимости имени.
//
// ОБРАБОТЧИКИ КОМАНД (имена ровно те, что уже созданы в форме; суффикс 1 у трёх
// из них поставил конфигуратор, когда генерировал обработчик под занятое имя —
// поэтому здесь они с суффиксом, и в форме менять ничего не нужно):
//   ПолучитьЗначение, ЗаписатьЗначение              — константа MCP_Allowlist
//   ПолучитьЗначениеServ, ЗаписатьЗначениеServ1     — константа MCP_ServerConfig
//   ВключитьМаскирование, ВыключитьМаскирование
//   ПробаСнятияОтказов, ПробаЧисловогоПоля1, ПробаАварийногоРежима1
//   ДиагностикаПолитики1
//   Тест                                            — балансовость регистра
//
// ЧТО ИЗМЕНЕНО ПРОТИВ ПРЕЖНЕЙ ВЕРСИИ:
//   1. Кнопка «Жёсткий режим (deny)» убрана. После #116 deny из контракта
//      удалён: mode принимается и ИГНОРИРУЕТСЯ, запись применяется как маска,
//      отказов не бывает. Прежняя кнопка обещала отказы, которых нет, и
//      предупреждала о неработающем поиске — оба утверждения неверны. На её
//      месте диагностическая проба, которая это ПРОВЕРЯЕТ.
//   2. Убрано «инструменты заблокированы до исправления» про config_errors:
//      нечитаемая секция переводит движок в аварийный режим — данные
//      возвращаются с максимальной маской, отказа нет.
//   3. Убрано «число и булево → null»: числа и булево не закрываются вовсе,
//      значение возвращается как есть, а парсер предупреждает, что маска на
//      такое поле не действует.
//   4. Шаблон политики стал переносимым: перечислены кандидаты для БП, ERP и
//      ЗУП, а в политику пишутся только типы, существующие в этой базе. Иначе
//      запись с чужим именем молча отбрасывается, и данные остаются открытыми
//      (так на ERP был открыт номер счёта контрагента).
//   5. Кнопка выключения перестала дублировать чтение, запись и проверку прав.
//   6. Добавлены три пробы приёмки, которые иначе выполняются руками.
// ============================================================================

#Область КнопкиКонстант

&НаСервере
Процедура ПолучитьЗначениеНаСервере()
	значениеКонст = МаскВклПрочитатьКонстанту("MCP_Allowlist");
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьЗначение(Команда)
	значениеКонст = "";
	ПолучитьЗначениеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЗначениеНаСервере()

	Если НЕ ЗначениеЗаполнено(значениеКонст) Тогда
		Сообщить("Буфер пуст: запись не выполнена.");
		Возврат;
	КонецЕсли;

	Если НЕ МаскВклПравоАдминистратора() Тогда
		Сообщить("Недостаточно прав: изменение настроек доступно администратору.");
		Возврат;
	КонецЕсли;

	// Защита от записи не той константы: в буфере может лежать server-config,
	// прочитанный соседней кнопкой.
	Разобранное = МаскВклПопыткаРазбора(значениеКонст);
	Если Разобранное <> Неопределено И МаскВклПохожеНаServerConfig(Разобранное) Тогда
		Сообщить("В буфере похоже на MCP_ServerConfig (есть ключи http/privacy/limits)."
			+ " Запись в MCP_Allowlist отменена.");
		Возврат;
	КонецЕсли;

	Попытка
		Константы["MCP_Allowlist"].Установить(значениеКонст);
	Исключение
		Сообщить("Не удалось записать MCP_Allowlist: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Сообщить("MCP_Allowlist записан.");

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЗначение(Команда)
	ЗаписатьЗначениеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПолучитьЗначениеНаСервереServ()
	значениеКонст = МаскВклПрочитатьКонстанту("MCP_ServerConfig");
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьЗначениеServ(Команда)
	значениеКонст = "";
	ПолучитьЗначениеНаСервереServ();
КонецПроцедуры

// Этой же кнопкой восстанавливают настройку после пробы аварийного режима,
// поэтому она проверяет содержимое буфера строже остальных.
&НаСервере
Процедура ЗаписатьЗначениеServ1НаСервере()

	Если НЕ ЗначениеЗаполнено(значениеКонст) Тогда
		Сообщить("Буфер пуст: запись не выполнена.");
		Возврат;
	КонецЕсли;

	Если НЕ МаскВклПравоАдминистратора() Тогда
		Сообщить("Недостаточно прав: изменение настроек доступно администратору.");
		Возврат;
	КонецЕсли;

	Разобранное = МаскВклПопыткаРазбора(значениеКонст);
	Если Разобранное = Неопределено Тогда
		Сообщить("В буфере не JSON: запись в MCP_ServerConfig отменена."
			+ " Для пробы аварийного режима есть отдельная кнопка.");
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Разобранное) <> Тип("Соответствие") Тогда
		Сообщить("В буфере не JSON-объект: запись отменена.");
		Возврат;
	КонецЕсли;

	Если МаскВклПохожеНаAllowlist(Разобранное) И НЕ МаскВклПохожеНаServerConfig(Разобранное) Тогда
		Сообщить("В буфере похоже на MCP_Allowlist (есть ключи default_policy/allowed_kinds)."
			+ " Запись в MCP_ServerConfig отменена — иначе серверная настройка была бы затёрта.");
		Возврат;
	КонецЕсли;

	Попытка
		Константы["MCP_ServerConfig"].Установить(значениеКонст);
	Исключение
		Сообщить("Не удалось записать MCP_ServerConfig: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Сообщить("MCP_ServerConfig записан.");
	МаскВклПоказатьДиагностику();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЗначениеServ1(Команда)
	ЗаписатьЗначениеServ1НаСервере();
КонецПроцедуры

#КонецОбласти

#Область PrivacyОсновныеКнопки

&НаСервере
Процедура ВключитьМаскированиеНаСервере()
	МаскВклПрименитьПолитику("mask", Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВключитьМаскирование(Команда)
	ВключитьМаскированиеНаСервере();
КонецПроцедуры

// Опустошает type_aliases и type_field_masks. Остальные разделы (http, limits,
// allowlist, response, masked_fields, organization_aliases, person_aliases)
// читаются и записываются без изменений.
&НаСервере
Процедура ВыключитьМаскированиеНаСервере()

	Если НЕ МаскВклПравоАдминистратора() Тогда
		Сообщить("Недостаточно прав: изменение privacy-политики доступно администратору.");
		Возврат;
	КонецЕсли;

	Попытка
		Настройки = МаскВклПрочитатьНастройки();
		Privacy = МаскВклСекцияPrivacy(Настройки);

		// Пустые массивы, а не удаление ключей: при пустых секциях сервер ведёт
		// себя как до внедрения политики, и в ответе видно, что механизм на
		// месте и просто не задействован.
		Privacy.Вставить("type_aliases", Новый Массив);
		Privacy.Вставить("type_field_masks", Новый Массив);

		Настройки.Вставить("privacy", Privacy);
		МаскВклЗаписатьНастройки(Настройки);
	Исключение
		Сообщить("Не удалось выключить маскирование: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Сообщить("Privacy-политика выключена: секции type_aliases и type_field_masks пусты.");

	Информация = МаскВклИнформация();
	Если Информация <> Неопределено Тогда
		Попытка
			ОсталосьВключено = Информация.enabled;
		Исключение
			ОсталосьВключено = Ложь;
		КонецПопытки;
		Если ОсталосьВключено Тогда
			Сообщить("Остались активными legacy-механизмы: masked_fields,"
				+ " organization_aliases или person_aliases — эта кнопка их не трогает.");
		КонецЕсли;
	КонецЕсли;

	МаскВклПоказатьДиагностику();

КонецПроцедуры

&НаКлиенте
Процедура ВыключитьМаскирование(Команда)
	ВыключитьМаскированиеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДиагностикаПолитикиНаСервере()
	МаскВклПоказатьДиагностику();
КонецПроцедуры

&НаКлиенте
Процедура ДиагностикаПолитики1(Команда)
	ДиагностикаПолитикиНаСервере();
КонецПроцедуры

#КонецОбласти

#Область PrivacyПробыПриёмки

// ПРОБА 1. Числовое поле в type_field_masks.
//
// Цель — НЕ маскировать число, а убедиться, что попытка его закрыть
// игнорируется с предупреждением, а значение приходит как есть. Это проверка от
// регрессии «поле закрыли → в колонке null», то есть стирание вместо подмены.
//
// Ожидается:
//   1. в предупреждениях — «числовое или булево … маска не действует» для Сумма;
//   2. запрос Сумма у закрытого типа возвращает ЧИСЛО;
//   3. не null и не XXXXXXX — это был бы провал.
// Возврат к обычной политике — кнопка «Включить маскирование».
&НаСервере
Процедура ПробаЧисловогоПоляНаСервере()

	Сообщить("ПРОБА: числовое поле в маске. Ожидается предупреждение «маска не"
		+ " действует» и ЧИСЛО в ответе (не null, не XXXXXXX).");
	МаскВклПрименитьПолитику("mask", Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПробаЧисловогоПоля1(Команда)
	ПробаЧисловогоПоляНаСервере();
КонецПроцедуры

// ПРОБА 2. mode: deny больше не действует.
//
// После #116 deny из контракта удалён. Раньше здесь была кнопка «жёсткий
// режим», обещавшая отказ до выполнения запроса; теперь проба проверяет
// ОБРАТНОЕ — что deny тихо игнорируется и защита не меняется.
//
// Ожидается:
//   1. запись ПРИМЕНЕНА как маска — тип продолжает закрываться;
//   2. в предупреждениях — что deny не поддерживается / применена как маска;
//   3. config_errors пуст: в аварийный режим политика не уходит;
//   4. ни один инструмент не возвращает privacy_denied_field,
//      privacy_denied_autoorder, privacy_config_error — этих кодов больше нет.
&НаСервере
Процедура ПробаСнятияОтказовНаСервере()

	Сообщить("ПРОБА: mode = deny. Ожидается, что запись применена КАК МАСКА,"
		+ " в предупреждениях сказано, что deny не поддерживается, а config_errors пуст."
		+ " Отказов быть не должно.");
	МаскВклПрименитьПолитику("deny", Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПробаСнятияОтказов(Команда)
	ПробаСнятияОтказовНаСервере();
КонецПроцедуры

// ПРОБА 3. Аварийный режим.
//
// ВАЖНО про способ включения. Аварийный режим включается ТОЛЬКО синтаксически
// битым JSON константы: разбор настроек в MCP_Config.ПрочитатьJSONИзСтроки не
// обёрнут в Попытку, и именно брошенное исключение переводит секции политики в
// аварию. Подмена ТИПА значения (строка вместо массива) НЕ годится — секция
// тогда молча считается пустой, аварийный режим не включается, и проба даёт
// ложный результат.
//
// Побочный эффект: пока JSON битый, разделы http, limits и response читаются со
// значениями по умолчанию (все их чтения обёрнуты в Попытку, поэтому сервис не
// падает). Константа MCP_Allowlist — отдельная, её это не затрагивает.
//
// Ожидается — ОБЕ половины обязательны:
//   1. инструменты работают, строки приходят, отказа нет;
//   2. в config_errors — «секция не прочитана … максимальная маска»;
//   3. enabled = true, guidance объясняет аварийный режим, применённых записей нет;
//   4. имя-подобные поля и представление закрыты у ЛЮБОГО ссылочного типа,
//      включая тот, которого в политике нет и никогда не было;
//   5. числа по-прежнему числа;
//   6. ПАРНАЯ ПОЛОВИНА: прочие поля остаются ОТКРЫТЫМИ. Сплошные XXXXXXX —
//      провал: ответ, в котором закрыто всё, равнозначен отказу.
&НаСервере
Процедура ПробаАварийногоРежимаНаСервере()

	Если НЕ МаскВклПравоАдминистратора() Тогда
		Сообщить("Недостаточно прав: изменение privacy-политики доступно администратору.");
		Возврат;
	КонецЕсли;

	Текст = МаскВклПрочитатьКонстанту("MCP_ServerConfig");
	Если ПустаяСтрока(Текст) Тогда
		Сообщить("Константа MCP_ServerConfig пуста: портить нечего.");
		Возврат;
	КонецЕсли;

	// Целый текст кладём в буфер ДО порчи: восстановление — кнопка записи
	// server-config. Форму до восстановления не закрывать, иначе буфер уйдёт
	// вместе с ней и настройку придётся собирать заново.
	значениеКонст = Текст;

	Попытка
		// Обрезаем последний символ (закрывающую скобку): JSON становится
		// синтаксически неполным, разбор бросает исключение — ровно то, что
		// включает аварийный режим.
		Битый = Лев(Текст, СтрДлина(Текст) - 1);
		Константы["MCP_ServerConfig"].Установить(Битый);
	Исключение
		Сообщить("Не удалось выполнить пробу: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Сообщить("ПРОБА: аварийный режим включён порчей JSON.");
	Сообщить("ИСХОДНЫЙ ТЕКСТ НАСТРОЙКИ ЛЕЖИТ В БУФЕРЕ. Форму не закрывать."
		+ " Восстановление — кнопка записи server-config.");
	Сообщить("Проверять ОБЕ половины: данные вернулись И лишнее не закрылось."
		+ " Сплошные XXXXXXX — это провал, а не успех.");
	МаскВклПоказатьДиагностику();

КонецПроцедуры

&НаКлиенте
Процедура ПробаАварийногоРежима1(Команда)
	ПробаАварийногоРежимаНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ШаблонПолитики

// ---- Единственное место, которое нужно править при смене состава защиты -----

// Псевдонимы: вместо названия клиент получает стабильный код <prefix> + 8 символов.
// Только ссылочные виды. Организации, физические лица, сотрудники и пользователи
// здесь будут отклонены — они закрываются секциями organization_aliases и
// person_aliases.
//
// Перечислены кандидаты для ТРЁХ конфигураций. В политику попадут только те,
// что есть в этой базе: имя из чужой конфигурации иначе молча отбрасывается
// движком, и данные остаются открытыми. Префиксы у всех разные — движок
// отвергает не только совпадение, но и вложенность префиксов.
&НаСервереБезКонтекста
Функция МаскВклШаблонПсевдонимов(Режим)

	Записи = Новый Массив;

	МаскВклДобавитьПсевдоним(Записи, "Справочник.Контрагенты", "Контр-", Режим);

	// Подчинённые справочники закрываются вместе с владельцем: их наименования
	// обычно содержат название контрагента («Договор №12 с ООО …»).
	МаскВклДобавитьПсевдоним(Записи, "Справочник.ДоговорыКонтрагентов", "Дог-", Режим);

	// Банковские счета: в БП один справочник, в ERP — два отдельных.
	МаскВклДобавитьПсевдоним(Записи, "Справочник.БанковскиеСчета", "Счет-", Режим);
	МаскВклДобавитьПсевдоним(Записи, "Справочник.БанковскиеСчетаКонтрагентов", "СчетКонтр-", Режим);
	МаскВклДобавитьПсевдоним(Записи, "Справочник.БанковскиеСчетаОрганизаций", "СчетОрг-", Режим);

	// Специфика ERP: партнёр контрагенту НЕ подчинён, поэтому предупреждение о
	// подчинённых справочниках его не ловит, а название партнёра совпадает с
	// названием контрагента — закрытие контрагента без партнёра обходится.
	МаскВклДобавитьПсевдоним(Записи, "Справочник.Партнеры", "Партн-", Режим);

	Возврат Записи;

КонецФункции

// Маски полей: строка → XXXXXXX, дата → 1900-01-01T00:00:00. Числа и булево
// НЕ закрываются — значение возвращается как есть, а движок предупреждает, что
// маска на такое поле не действует (null в числовой колонке — это стирание, а
// не подмена, и решением 05.08.2026 запрещён).
// Вид типа любой, включая регистры.
&НаСервереБезКонтекста
Функция МаскВклШаблонМасок(Режим, ДобавитьЧисловоеПоле, ПерсоныЗакрытыЛегаси)

	Записи = Новый Массив;

	// ИНН и КПП закрыты намеренно: псевдонимизация без них обратима через
	// публичные реестры, а у индивидуального предпринимателя ИНН — персональные
	// данные физического лица.
	МаскВклДобавитьМаску(Записи, "Справочник.Контрагенты",
		"НаименованиеПолное, Комментарий, ДополнительнаяИнформация, ИНН, КПП", Режим);

	ПоляДоговоров = "Комментарий, НаименованиеДляСчетаФактурыНаАванс";
	Если ДобавитьЧисловоеПоле Тогда
		// Только для пробы: Сумма — число, и маска на него действовать не
		// должна. Носителем взяты договоры, потому что у контрагентов числовых
		// реквизитов нет ни в БП, ни в ERP.
		ПоляДоговоров = ПоляДоговоров + ", Сумма";
	КонецЕсли;
	МаскВклДобавитьМаску(Записи, "Справочник.ДоговорыКонтрагентов", ПоляДоговоров, Режим);

	ПоляСчетов = "НомерСчета, ТекстКорреспондента, ТекстНазначения";
	МаскВклДобавитьМаску(Записи, "Справочник.БанковскиеСчета", ПоляСчетов, Режим);
	МаскВклДобавитьМаску(Записи, "Справочник.БанковскиеСчетаКонтрагентов", ПоляСчетов, Режим);
	МаскВклДобавитьМаску(Записи, "Справочник.БанковскиеСчетаОрганизаций", ПоляСчетов, Режим);

	МаскВклДобавитьМаску(Записи, "Справочник.Партнеры", "НаименованиеПолное", Режим);

	// ФизическиеЛица — единственная запись под условием, и вот почему.
	//
	// НаименованиеСлужебное отдаёт ФИО открытым (правило имя-подобности задано
	// точным перечнем, и это поле в него не входит), ИНН физлица — 12 цифр,
	// прямо идентифицирующие данные. Закрыть их хочется.
	//
	// НО: движок определяет тип строки для маскирования по ссылке ВНУТРИ строки,
	// а не по самому источнику. Как только у ФизическиеЛица появляется запись в
	// type_field_masks, к строкам РегистрСведений.ДокументыФизическихЛиц
	// применяются маски физлица (НаименованиеСлужебное, ИНН), а собственные маски регистра
	// регистра — Серия, Номер, КемВыдан, КодПодразделения — выпадают. Проверено
	// живьём 05.08.2026: на ERP паспортные поля были закрыты, после добавления
	// этой записи открылись.
	//
	// Поэтому добавляем её ТОЛЬКО там, где паспортные маски и так не работают —
	// то есть где физлицо уже закрыто легаси-механизмом person_aliases (BUH, ZUP).
	// Там терять нечего, а ФИО и ИНН закрываются. Где person_aliases выключены
	// (ERP), запись пропускаем: паспортные данные важнее НаименованиеСлужебного.
	//
	// Условие конфигурационно-независимое: смотрим на саму настройку, а не на имя
	// конфигурации. Снять его можно будет после правки движка.
	Если ПерсоныЗакрытыЛегаси Тогда
		МаскВклДобавитьМаску(Записи, "Справочник.ФизическиеЛица",
			"НаименованиеСлужебное, ИНН", Режим);
	КонецЕсли;

	// Имена полей регистра сверены с фактическим составом: измерение называется
	// Физлицо, паспортные реквизиты — Серия, Номер, КемВыдан.
	МаскВклДобавитьМаску(Записи, "РегистрСведений.ДокументыФизическихЛиц",
		"Серия, Номер, КемВыдан, КодПодразделения, ФамилияЛатиницей, ИмяЛатиницей", Режим);

	Возврат Записи;

КонецФункции

#КонецОбласти

#Область Служебное

// Общее тело кнопок, меняющих политику. Режим и числовое поле — параметры,
// поэтому шаблон состава защиты остаётся один на все кнопки и пробы.
&НаСервереБезКонтекста
Процедура МаскВклПрименитьПолитику(Режим, ДобавитьЧисловоеПоле)

	Если НЕ МаскВклПравоАдминистратора() Тогда
		Сообщить("Недостаточно прав: изменение privacy-политики доступно администратору.");
		Возврат;
	КонецЕсли;

	Попытка
		Настройки = МаскВклПрочитатьНастройки();
		Privacy = МаскВклСекцияPrivacy(Настройки);

		// Признак читаем ИЗ ДЕЙСТВУЮЩЕЙ настройки, до перезаписи секций: от него
		// зависит, добавлять ли запись ФизическиеЛица (см. МаскВклШаблонМасок).
		ПерсоныЛегаси = МаскВклПерсоныЗакрытыЛегаси(Privacy);

		Privacy.Вставить("type_aliases", МаскВклШаблонПсевдонимов(Режим));
		Privacy.Вставить("type_field_masks",
			МаскВклШаблонМасок(Режим, ДобавитьЧисловоеПоле, ПерсоныЛегаси));
		Privacy.Вставить("publish_details", Истина);

		Настройки.Вставить("privacy", Privacy);
		МаскВклЗаписатьНастройки(Настройки);
	Исключение
		Сообщить("Не удалось применить политику: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Сообщить("Privacy-политика записана (mode в записях: " + Режим + ").");
	Если Режим = "deny" Тогда
		// Прежняя версия модуля обещала здесь отказ до выполнения запроса. После
		// #116 это неверно: deny из контракта удалён.
		Сообщить("Напоминание: deny больше не поддерживается — записи применяются"
			+ " как маска, отказов не будет.");
	КонецЕсли;

	МаскВклПоказатьДиагностику();

КонецПроцедуры

// Тип из чужой конфигурации в политике бесполезен и вреден: движок отбросит
// запись, а панель скажет «маскирование активно».
&НаСервереБезКонтекста
Процедура МаскВклДобавитьПсевдоним(Записи, ИмяТипа, Префикс, Режим)

	Если Метаданные.НайтиПоПолномуИмени(ИмяТипа) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый Соответствие;
	Запись.Вставить("type", ИмяТипа);
	Запись.Вставить("prefix", Префикс);
	Запись.Вставить("mode", Режим);
	Записи.Добавить(Запись);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура МаскВклДобавитьМаску(Записи, ИмяТипа, ПоляСтрокой, Режим)

	Если Метаданные.НайтиПоПолномуИмени(ИмяТипа) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого Поле Из СтрРазделить(ПоляСтрокой, ",", Ложь) Цикл
		ИмяПоля = СокрЛП(Поле);
		Если НЕ ПустаяСтрока(ИмяПоля) Тогда
			Поля.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Если Поля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый Соответствие;
	Запись.Вставить("type", ИмяТипа);
	Запись.Вставить("fields", Поля);
	Запись.Вставить("mode", Режим);
	Записи.Добавить(Запись);

	// Имена ПОЛЕЙ намеренно не фильтруем: отсутствие поля — обычно опечатка
	// администратора, и предупреждение движка об этом нужнее, чем тишина.

КонецПроцедуры

&НаСервереБезКонтекста
Функция МаскВклПрочитатьКонстанту(ИмяКонстанты)

	Если Метаданные.Константы.Найти(ИмяКонстанты) = Неопределено Тогда
		Сообщить("В конфигурации нет константы " + ИмяКонстанты + ".");
		Возврат "";
	КонецЕсли;

	Возврат Константы[ИмяКонстанты].Получить();

КонецФункции

// JSON читаем в Соответствие, а не в Структуру: в настройке есть ключи, которые
// в имя свойства структуры не превращаются (например mcp-protocol-version).
&НаСервереБезКонтекста
Функция МаскВклРазобратьJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Неопределено — если текст не разбирается. Нужна там, где невалидный JSON это
// ожидаемый случай, а не ошибка.
&НаСервереБезКонтекста
Функция МаскВклПопыткаРазбора(Текст)

	Попытка
		Возврат МаскВклРазобратьJSON(Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Различаем константы по ключам верхнего уровня: они не пересекаются.
&НаСервереБезКонтекста
Функция МаскВклПохожеНаServerConfig(Разобранное)

	Если ТипЗнч(Разобранное) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Ключи = "http,privacy,limits,response,web_client,compatibility,query_examples";
	Для Каждого Ключ Из СтрРазделить(Ключи, ",", Ложь) Цикл
		Если Разобранное.Получить(Ключ) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция МаскВклПохожеНаAllowlist(Разобранное)

	Если ТипЗнч(Разобранное) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Ключи = "default_policy,allowed_kinds,denied_objects,allowed_metadata,restrict_data_access,admin_users,allowed_base_urls";
	Для Каждого Ключ Из СтрРазделить(Ключи, ",", Ложь) Цикл
		Если Разобранное.Получить(Ключ) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция МаскВклПрочитатьНастройки()

	Текст = "";
	Если Метаданные.Константы.Найти("MCP_ServerConfig") <> Неопределено Тогда
		Текст = Константы["MCP_ServerConfig"].Получить();
	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Результат = МаскВклРазобратьJSON(Текст);

	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		// Не JSON-объект: перезаписывать нельзя, иначе потеряем содержимое.
		ВызватьИсключение "Константа MCP_ServerConfig не содержит JSON-объект.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура МаскВклЗаписатьНастройки(Настройки)

	Если Метаданные.Константы.Найти("MCP_ServerConfig") = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет константы MCP_ServerConfig.";
	КонецЕсли;

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Настройки);
	Константы["MCP_ServerConfig"].Установить(Запись.Закрыть());

КонецПроцедуры

// Закрыты ли физлица легаси-механизмом person_aliases. Кнопка эту секцию не
// правит, поэтому признак берётся из действующей настройки как есть.
&НаСервереБезКонтекста
Функция МаскВклПерсоныЗакрытыЛегаси(Privacy)

	Персоны = Privacy.Получить("person_aliases");
	Если ТипЗнч(Персоны) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Персоны.Получить("enabled") = Истина;

КонецФункции

&НаСервереБезКонтекста
Функция МаскВклСекцияPrivacy(Настройки)

	Privacy = Настройки.Получить("privacy");
	Если ТипЗнч(Privacy) = Тип("Соответствие") Тогда
		Возврат Privacy;
	КонецЕсли;
	Возврат Новый Соответствие;

КонецФункции

// Общий модуль расширения из внешней обработки на этапе компиляции не виден,
// поэтому вызов косвенный. Строка фиксированная, пользовательского ввода в ней
// нет.
&НаСервереБезКонтекста
Функция МаскВклИнформация()

	Попытка
		Возврат Вычислить("MCP_Config.ИнформацияМаскированияLLM()");
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Массив строк: что сервер фактически думает о текущей политике. Показываем
// сразу после любой правки — иначе об отклонённой записи или опечатке в имени
// поля стало бы известно только по поведению инструментов.
&НаСервереБезКонтекста
Процедура МаскВклПоказатьДиагностику()

	Информация = МаскВклИнформация();
	Если Информация = Неопределено Тогда
		Сообщить("Проверить политику не удалось: общий модуль MCP_Config не ответил."
			+ " Расширение подключено?");
		Возврат;
	КонецЕсли;

	Попытка
		Сообщить("Маскирование активно: " + ?(Информация.enabled, "да", "нет") + ".");
	Исключение
		Сообщить("Ответ движка не содержит признака enabled: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// Ревизия privacy-движка: по ней видно, какая сборка расширения фактически
	// отвечает. Пусто — сборка старее 2026-08-03.2.
	Попытка
		Ревизия = Информация.engine_revision;
	Исключение
		Ревизия = "";
	КонецПопытки;
	Если НЕ ПустаяСтрока(Ревизия) Тогда
		Сообщить("Ревизия privacy-движка: " + Ревизия + ".");
	КонецЕсли;

	Ошибки = МаскВклСписокИзОтвета(Информация, "config_errors");
	Если Ошибки.Количество() > 0 Тогда
		// Раньше здесь было «инструменты заблокированы до исправления». После
		// #116 это неверно: нечитаемая секция включает аварийный режим, данные
		// возвращаются с максимальной маской, отказа нет.
		Сообщить("АВАРИЙНЫЙ РЕЖИМ: секция политики не прочитана, действует"
			+ " максимальная маска. Данные возвращаются, отказов нет:");
		Для Каждого Ошибка Из Ошибки Цикл
			Сообщить(" • " + Ошибка);
		КонецЦикла;
	КонецЕсли;

	Предупреждения = МаскВклСписокИзОтвета(Информация, "config_warnings");
	Если Предупреждения.Количество() > 0 Тогда
		Сообщить("Предупреждения — записи или поля не применены:");
		Для Каждого Предупреждение Из Предупреждения Цикл
			Сообщить(" • " + Предупреждение);
		КонецЦикла;
	КонецЕсли;

	Если Ошибки.Количество() = 0 И Предупреждения.Количество() = 0 Тогда
		Сообщить("Замечаний нет: все записи приняты.");
	КонецЕсли;

КонецПроцедуры

// Ответ движка приходит структурой, состав которой задан контрактом сервера, а
// не этой обработкой: отсутствующий ключ не должен ронять диагностику.
&НаСервереБезКонтекста
Функция МаскВклСписокИзОтвета(Информация, ИмяКлюча)

	Попытка
		Значение = Информация[ИмяКлюча];
	Исключение
		Возврат Новый Массив;
	КонецПопытки;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// ПравоДоступа принимает ДВА параметра: право и объект метаданных. Права
// «Администрирование» и «АдминистрированиеДанных» относятся к конфигурации
// целиком, поэтому вторым аргументом передаётся Метаданные.
&НаСервереБезКонтекста
Функция МаскВклПравоАдминистратора()

	Попытка
		Возврат ПравоДоступа("Администрирование", Метаданные)
			ИЛИ ПравоДоступа("АдминистрированиеДанных", Метаданные);
	Исключение
		// Если проверка недоступна, доступ решают роли на самом объекте.
		Возврат Истина;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ПрямаяДиагностикаДвижка

// Эти три кнопки вызывают функции движка НАПРЯМУЮ, минуя HTTP-слой. Смысл: снаружи
// сбой виден только как `-32603 Internal error` со stage jsonrpc_route, а изнутри
// видно, какая именно функция падает и с каким текстом. Все три read-only:
// политику не меняют, контур не роняют, нажимать можно в любой момент.
//
// Через Вычислить, потому что общие модули расширения внешней обработке на этапе
// компиляции не видны. Строки выражений собираются из зашитых имён — данных
// пользователя в них нет.

// КНОПКА: «Диагностика аварии».
//
// Вызывает по одной все экспортные точки на пути сборки privacy-ответа. ПЕРВАЯ
// упавшая в этом списке и есть причина отказа: порядок повторяет фактическую
// цепочку вызовов. Полезна и в нормальном режиме — тогда всё отвечает, и это
// baseline, с которым сравнивают показания в аварии.
&НаСервере
Процедура ДиагностикаАварииНаСервере()

	Сообщить("=== Прямая диагностика: экспортные точки движка ===");
	Сообщить("Порядок повторяет цепочку вызовов. Первая упавшая — причина.");

	ДиагВызовДвижка("MCP_Config.РевизияPrivacyДвижка()", "ревизия (константа в коде)");
	ДиагВызовДвижка("MCP_Config.PrivacyPublishDetails()", "publish_details — читает настройку БЕЗ Попытки");
	ДиагВызовДвижка("MCP_Config.ПсевдонимыТиповLLM()", "секция type_aliases");
	ДиагВызовДвижка("MCP_Config.МаскиПолейТиповLLM()", "секция type_field_masks");
	ДиагВызовДвижка("MCP_Config.ОписаниеМаскированияLLM()", "guidance");
	ДиагВызовДвижка("MCP_Config.ИнформацияМаскированияLLM()", "весь блок privacy для ответа");
	ДиагВызовДвижка("MCP_Security.СнимокПолитикиPrivacy()", "снимок политики (второй эшелон)");
	ДиагВызовДвижка("MCP_Security.ЕстьЗакрытыеТипыPrivacy()", "признак наличия закрытых типов");

	Сообщить("=== Конец диагностики ===");

КонецПроцедуры

&НаКлиенте
Процедура ДиагностикаАварии(Команда)
	ДиагностикаАварииНаСервере();
КонецПроцедуры

// КНОПКА: «Карта закрытости типа».
//
// Отвечает на вопрос, который снаружи неразличим: считает ли САМА ПОЛИТИКА поле
// закрытым. Если считает, а в ответе поле приходит открытым — дефект не в разборе
// политики, а в определении типа строки при маскировании. Именно так разводятся
// две гипотезы по паспортному регистру.
&НаСервере
Процедура КартаЗакрытостиТипаНаСервере()

	Сообщить("=== Карта закрытости: что думает политика, а не что пришло в ответе ===");

	КартаЗакрытостиОдногоТипа("РегистрСведений.ДокументыФизическихЛиц",
		"Серия, Номер, КемВыдан, КодПодразделения, ФамилияЛатиницей, Представление, Физлицо");
	КартаЗакрытостиОдногоТипа("Справочник.ФизическиеЛица",
		"Наименование, НаименованиеСлужебное, ИНН, СтраховойНомерПФР, ДатаРождения");
	КартаЗакрытостиОдногоТипа("Справочник.Контрагенты",
		"Наименование, НаименованиеПолное, ИНН, КПП, Код");

	Сообщить("=== Конец карты ===");

КонецПроцедуры

&НаКлиенте
Процедура КартаЗакрытостиТипа(Команда)
	КартаЗакрытостиТипаНаСервере();
КонецПроцедуры

// КНОПКА: «Маскировать образец».
//
// Прогоняет через маскирование искусственную строку — без обращения к данным
// вообще. Позволяет увидеть механизм: что решает состав полей, а что — ссылка
// внутри строки. Две половины: строка со ссылкой на физлицо и та же строка без
// ссылки. Если паспортные поля закрываются только во второй — подтверждается, что
// тип строки определяется по ссылке, а не по источнику.
&НаСервере
Процедура МаскироватьОбразецНаСервере()

	Сообщить("=== Маскирование образца: строка регистра, собранная вручную ===");

	СсылкаФизлица = Неопределено;
	Если Метаданные.Справочники.Найти("ФизическиеЛица") <> Неопределено Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Р ИЗ Справочник.ФизическиеЛица КАК Т");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СсылкаФизлица = Выборка.Р;
		КонецЕсли;
	КонецЕсли;
	Сообщить("Ссылка на физлицо для образца: " + ?(СсылкаФизлица = Неопределено, "НЕТ", "есть"));

	МаскироватьОдинОбразец("без ссылки на физлицо", Неопределено);
	Если СсылкаФизлица <> Неопределено Тогда
		МаскироватьОдинОбразец("со ссылкой на физлицо в строке", СсылкаФизлица);
	КонецЕсли;

	Сообщить("=== Конец образца ===");

КонецПроцедуры

&НаКлиенте
Процедура МаскироватьОбразец(Команда)
	МаскироватьОбразецНаСервере();
КонецПроцедуры

// ---- Служебное для прямой диагностики --------------------------------------

// Печатает ok или точный текст исключения. Именно текст, а не «не ответил»:
// наружу через HTTP он не доходит, здесь — единственное место, где его видно.
&НаСервереБезКонтекста
Процедура ДиагВызовДвижка(Выражение, Пояснение)

	Попытка
		Результат = Вычислить(Выражение);
		Сообщить("  ok      " + Пояснение + " → " + ДиагКраткоОЗначении(Результат));
	Исключение
		Сообщить("  ПАДАЕТ  " + Пояснение);
		Сообщить("          " + Выражение);
		Сообщить("          " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Значения контура не печатаем: только тип и структурные признаки, чтобы вывод
// можно было безопасно скопировать в задачу.
&НаСервереБезКонтекста
Функция ДиагКраткоОЗначении(Значение)

	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Число") Тогда
		Возврат Строка(Значение);
	КонецЕсли;

	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "строка, символов " + СтрДлина(Значение);
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		Возврат "массив, элементов " + Значение.Количество();
	КонецЕсли;

	Если ТипЗначения = Тип("Соответствие") Тогда
		Возврат "соответствие, элементов " + Значение.Количество();
	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Тогда
		Части = Новый Массив;
		Части.Добавить("структура");
		// Признаки, по которым и различают аварию: emergency и наполнение списков.
		ДиагДобавитьПризнак(Части, Значение, "emergency");
		ДиагДобавитьПризнак(Части, Значение, "enabled");
		ДиагДобавитьПризнакКоличества(Части, Значение, "list");
		ДиагДобавитьПризнакКоличества(Части, Значение, "errors");
		ДиагДобавитьПризнакКоличества(Части, Значение, "warnings");
		ДиагДобавитьПризнакКоличества(Части, Значение, "config_errors");
		ДиагДобавитьПризнакКоличества(Части, Значение, "config_warnings");
		Возврат СтрСоединить(Части, ", ");
	КонецЕсли;

	Возврат Строка(ТипЗначения);

КонецФункции

&НаСервереБезКонтекста
Процедура ДиагДобавитьПризнак(Части, Структура, ИмяКлюча)

	Значение = Неопределено;
	Если Структура.Свойство(ИмяКлюча, Значение) Тогда
		Части.Добавить(ИмяКлюча + "=" + Строка(Значение));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДиагДобавитьПризнакКоличества(Части, Структура, ИмяКлюча)

	Значение = Неопределено;
	Если НЕ Структура.Свойство(ИмяКлюча, Значение) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") ИЛИ ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Части.Добавить(ИмяКлюча + ": " + Значение.Количество());
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура КартаЗакрытостиОдногоТипа(ИмяТипа, ПоляСтрокой)

	Сообщить("--- " + ИмяТипа);

	Если Метаданные.НайтиПоПолномуИмени(ИмяТипа) = Неопределено Тогда
		Сообщить("    в этой конфигурации типа нет — пропущено");
		Возврат;
	КонецЕсли;

	ДиагВызовДвижка("MCP_Security.ЗакрытыеПоляТипаPrivacy(""" + ИмяТипа + """)",
		"ЗакрытыеПоляТипаPrivacy");
	ДиагВызовДвижка("MCP_Security.ПредставлениеЗакрытоPrivacy(""" + ИмяТипа + """)",
		"ПредставлениеЗакрытоPrivacy");
	ДиагВызовДвижка("MCP_Security.ТипПокрытЛегасиПсевдонимамиLLM(""" + ИмяТипа + """)",
		"ТипПокрытЛегасиПсевдонимамиLLM");

	Для Каждого Поле Из СтрРазделить(ПоляСтрокой, ",", Ложь) Цикл
		ИмяПоля = СокрЛП(Поле);
		Если ПустаяСтрока(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		ДиагВызовДвижка("MCP_Security.ПолеЗакрытоPrivacy(""" + ИмяТипа + """, """ + ИмяПоля + """)",
			"ПолеЗакрытоPrivacy: " + ИмяПоля);
	КонецЦикла;

КонецПроцедуры

// Образец — плоская структура с ключами, как в строке ответа инструмента.
// Вычислить видит локальные переменные метода, поэтому Образец передаётся по имени.
&НаСервереБезКонтекста
Процедура МаскироватьОдинОбразец(Пояснение, СсылкаВСтроке)

	Сообщить("--- образец: " + Пояснение);

	Образец = Новый Структура;
	Образец.Вставить("Серия", "ОБРАЗЕЦ-СЕРИЯ");
	Образец.Вставить("Номер", "ОБРАЗЕЦ-НОМЕР");
	Образец.Вставить("КемВыдан", "ОБРАЗЕЦ-КЕМ-ВЫДАН");
	Образец.Вставить("Наименование", "ОБРАЗЕЦ-НАИМЕНОВАНИЕ");
	Образец.Вставить("НаименованиеСлужебное", "ОБРАЗЕЦ-СЛУЖЕБНОЕ");
	Образец.Вставить("ИНН", "000000000000");
	// Число: обязано вернуться как есть — числа не закрываются.
	Образец.Вставить("Сумма", 12345);
	Если СсылкаВСтроке <> Неопределено Тогда
		Образец.Вставить("Физлицо", СсылкаВСтроке);
	КонецЕсли;

	Попытка
		Результат = Вычислить("MCP_Security.МаскироватьПоляДляLLM(Образец)");
	Исключение
		Сообщить("    ПАДАЕТ: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Сообщить("    вернулось не структурой: " + ДиагКраткоОЗначении(Результат));
		Возврат;
	КонецЕсли;

	Для Каждого КЗ Из Образец Цикл
		Было = КЗ.Значение;
		Стало = Неопределено;
		Если НЕ Результат.Свойство(КЗ.Ключ, Стало) Тогда
			Сообщить("    " + КЗ.Ключ + ": ключ пропал из ответа");
			Продолжить;
		КонецЕсли;
		Сообщить("    " + КЗ.Ключ + ": " + ОбразецВердикт(Было, Стало));
	КонецЦикла;

КонецПроцедуры

// Сравниваем ДО и ПОСЛЕ по факту изменения, а не по совпадению с маской: так
// вердикт не зависит от того, какая именно подстановка настроена.
&НаСервереБезКонтекста
Функция ОбразецВердикт(Было, Стало)

	Если ТипЗнч(Было) = Тип("Число") Тогда
		Если ТипЗнч(Стало) <> Тип("Число") Тогда
			Возврат "ЧИСЛО ИСПОРЧЕНО (стало " + Строка(ТипЗнч(Стало)) + ") — провал";
		КонецЕсли;
		Возврат ?(Было = Стало, "число не тронуто — ok", "ЧИСЛО ИЗМЕНЕНО — провал");
	КонецЕсли;

	Если ТипЗнч(Было) <> Тип("Строка") Тогда
		Возврат "не строка, сравнение не применимо";
	КонецЕсли;

	Если ТипЗнч(Стало) <> Тип("Строка") Тогда
		Возврат "строка стала " + Строка(ТипЗнч(Стало));
	КонецЕсли;

	Возврат ?(Было = Стало, "ОТКРЫТО (значение не изменилось)", "закрыто (значение подменено)");

КонецФункции

#КонецОбласти

#Область ДиагностикаМетаданных

// Балансовость ресурсов и измерений регистра бухгалтерии: по ней видно, у каких
// ресурсов в ВТ ОборотыДтКт есть форма без стороны, а у каких только ОборотДт /
// ОборотКт.
&НаСервере
Процедура ТестНаСервере()

	Если Метаданные.РегистрыБухгалтерии.Найти("Хозрасчетный") = Неопределено Тогда
		Сообщить("В конфигурации нет регистра бухгалтерии Хозрасчетный.");
		Возврат;
	КонецЕсли;

	Регистр = Метаданные.РегистрыБухгалтерии.Хозрасчетный;
	Сообщить("Регистр: " + Регистр.Имя + ", корреспонденция: " + Регистр.Корреспонденция);
	Сообщить("Измерений: " + Регистр.Измерения.Количество()
		+ ", ресурсов: " + Регистр.Ресурсы.Количество());

	Для Каждого Измерение Из Регистр.Измерения Цикл
		Сообщить("  измерение " + Измерение.Имя + " -> Балансовый = "
			+ МаскВклСвойствоБалансовый(Измерение));
	КонецЦикла;

	Для Каждого Ресурс Из Регистр.Ресурсы Цикл
		Сообщить("  ресурс " + Ресурс.Имя + " -> Балансовый = "
			+ МаскВклСвойствоБалансовый(Ресурс));
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция МаскВклСвойствоБалансовый(ОбъектМетаданных)

	Попытка
		Возврат Строка(ОбъектМетаданных.Балансовый);
	Исключение
		Возврат "СВОЙСТВА НЕТ (" + ОписаниеОшибки() + ")";
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура Тест(Команда)
	ТестНаСервере();
КонецПроцедуры

#КонецОбласти
