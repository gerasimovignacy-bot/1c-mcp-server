// Админский модуль: включение и выключение адресной privacy-политики по типам.
//
// НЕ входит в комплект публикации src/ (scripts/required_modules.manifest.json):
// MCP-сервер read-only и константу не пишет. Это отдельный инструмент
// администратора. Разместить можно двумя способами:
//   1) общий модуль расширения MCP_PrivacyToggle (Сервер, Вызов сервера) —
//      тогда обработчики формы вызывают его напрямую;
//   2) модуль формы обработки — тогда «Экспорт» у функций не нужен.
//
// Обе кнопки правят ТОЛЬКО секции type_aliases и type_field_masks. Остальные
// разделы MCP_ServerConfig (http, limits, allowlist, response, masked_fields,
// organization_aliases, person_aliases) сохраняются как есть: константа читается,
// изменяются две секции, результат пишется обратно.

#Область ПрограммныйИнтерфейс

// Включает политику из ШаблонПолитики(). Возврат: текст результата для показа
// пользователю, включая предупреждения сервера о непринятых записях.
Функция ВключитьПолитику() Экспорт

	Если НЕ ДоступАдминистратора() Тогда
		Возврат "Недостаточно прав: изменение privacy-политики доступно администратору.";
	КонецЕсли;

	Попытка
		Настройки = ПрочитатьНастройкиСервера();
		Privacy = СекцияPrivacy(Настройки);

		Privacy.Вставить("type_aliases", ШаблонПсевдонимовТипов());
		Privacy.Вставить("type_field_masks", ШаблонМасокПолей());
		Privacy.Вставить("publish_details", Истина);

		Настройки.Вставить("privacy", Privacy);
		ЗаписатьНастройкиСервера(Настройки);
	Исключение
		Возврат "Не удалось включить политику: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат "Privacy-политика включена." + Символы.ПС + ДиагностикаПолитики();

КонецФункции

// Выключает политику: обе секции опустошаются, остальные настройки не тронуты.
// Поведение сервера возвращается к состоянию до включения.
Функция ВыключитьПолитику() Экспорт

	Если НЕ ДоступАдминистратора() Тогда
		Возврат "Недостаточно прав: изменение privacy-политики доступно администратору.";
	КонецЕсли;

	Попытка
		Настройки = ПрочитатьНастройкиСервера();
		Privacy = СекцияPrivacy(Настройки);

		Privacy.Вставить("type_aliases", Новый Массив);
		Privacy.Вставить("type_field_masks", Новый Массив);

		Настройки.Вставить("privacy", Privacy);
		ЗаписатьНастройкиСервера(Настройки);
	Исключение
		Возврат "Не удалось выключить политику: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат "Privacy-политика выключена: секции type_aliases и type_field_masks пусты."
		+ Символы.ПС + ДиагностикаПолитики();

КонецФункции

#КонецОбласти

#Область ШаблонПолитики

// Режим для всех записей шаблона:
//   "mask" — значения маскируются в ответах (обратимых потерь функциональности нет);
//   "deny" — плюс отказ до выполнения запроса. Закрывает оракул через отбор,
//            сортировку и поиск, но у закрытого типа перестаёт работать поиск
//            по названию: search_objects без параметра types начнёт отказывать
//            целиком, потому что в область поиска попадают закрытые типы.
Функция РежимПолитики()

	Возврат "mask";

КонецФункции

// Псевдонимы: вместо названия объекта клиент получает стабильный код
// <prefix> + 8 символов. Только ссылочные виды. Организации, физические лица,
// сотрудники и пользователи здесь будут отклонены — они закрываются секциями
// organization_aliases и person_aliases.
Функция ШаблонПсевдонимовТипов()

	Записи = Новый Массив;
	Записи.Добавить(ЗаписьПсевдонима("Справочник.Контрагенты", "Контр-"));
	// Подчинённые справочники закрываются вместе с владельцем: их наименования
	// обычно содержат название контрагента («Договор №12 с ООО …»).
	Записи.Добавить(ЗаписьПсевдонима("Справочник.ДоговорыКонтрагентов", "Дог-"));
	Записи.Добавить(ЗаписьПсевдонима("Справочник.БанковскиеСчета", "Счет-"));
	Возврат Записи;

КонецФункции

// Маски полей: значение заменяется на XXXXXXX, даты на 1900-01-01T00:00:00,
// числа и булево на null. Вид типа любой, включая регистры.
Функция ШаблонМасокПолей()

	Записи = Новый Массив;
	Записи.Добавить(ЗаписьМаски("Справочник.Контрагенты",
		"НаименованиеПолное, Комментарий, ДополнительнаяИнформация"));
	Записи.Добавить(ЗаписьМаски("Справочник.ДоговорыКонтрагентов",
		"Комментарий, НаименованиеДляСчетаФактурыНаАванс"));
	Записи.Добавить(ЗаписьМаски("Справочник.БанковскиеСчета",
		"НомерСчета, ТекстКорреспондента, ТекстНазначения"));
	// Имена полей регистра проверены по фактическому составу: измерение
	// называется Физлицо, паспортные реквизиты — Серия, Номер, КемВыдан.
	Записи.Добавить(ЗаписьМаски("РегистрСведений.ДокументыФизическихЛиц",
		"Серия, Номер, КемВыдан, КодПодразделения, ФамилияЛатиницей, ИмяЛатиницей"));
	Возврат Записи;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписьПсевдонима(ИмяТипа, Префикс)

	Запись = Новый Соответствие;
	Запись.Вставить("type", ИмяТипа);
	Запись.Вставить("prefix", Префикс);
	Запись.Вставить("mode", РежимПолитики());
	Возврат Запись;

КонецФункции

Функция ЗаписьМаски(ИмяТипа, ПоляСтрокой)

	Поля = Новый Массив;
	Для Каждого Поле Из СтрРазделить(ПоляСтрокой, ",", Ложь) Цикл
		ИмяПоля = СокрЛП(Поле);
		Если НЕ ПустаяСтрока(ИмяПоля) Тогда
			Поля.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Запись = Новый Соответствие;
	Запись.Вставить("type", ИмяТипа);
	Запись.Вставить("fields", Поля);
	Запись.Вставить("mode", РежимПолитики());
	Возврат Запись;

КонецФункции

// Соответствие, а не Структура: ключи JSON могут содержать символы,
// недопустимые в имени свойства структуры, и тогда Вставить упадёт.
Функция ПрочитатьНастройкиСервера()

	Текст = "";
	Если Метаданные.Константы.Найти(ИмяКонстанты()) <> Неопределено Тогда
		Текст = Константы[ИмяКонстанты()].Получить();
	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		// Настройка не является JSON-объектом: перезаписывать её содержимое
		// нельзя, иначе потеряем то, что администратор туда положил.
		ВызватьИсключение "Константа " + ИмяКонстанты() + " не содержит JSON-объект.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьНастройкиСервера(Настройки)

	Если Метаданные.Константы.Найти(ИмяКонстанты()) = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет константы " + ИмяКонстанты() + ".";
	КонецЕсли;

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Настройки);
	Константы[ИмяКонстанты()].Установить(Запись.Закрыть());

КонецПроцедуры

Функция СекцияPrivacy(Настройки)

	Privacy = Настройки.Получить("privacy");
	Если ТипЗнч(Privacy) = Тип("Соответствие") Тогда
		Возврат Privacy;
	КонецЕсли;
	Возврат Новый Соответствие;

КонецФункции

// Сразу после записи спрашиваем сервер, что он думает о новой политике:
// какие записи отклонены и не переведена ли политика в config_error.
// Без этого администратор узнал бы об опечатке только по отказам инструментов.
Функция ДиагностикаПолитики()

	Попытка
		Информация = MCP_Config.ИнформацияМаскированияLLM();
	Исключение
		Возврат "Проверить политику не удалось: " + ОписаниеОшибки();
	КонецПопытки;

	Части = Новый Массив;
	Части.Добавить("Маскирование активно: " + ?(Информация.enabled, "да", "нет") + ".");

	Ошибки = Информация.config_errors;
	Если Ошибки.Количество() > 0 Тогда
		Части.Добавить("ОШИБКИ ПОЛИТИКИ (инструменты заблокированы до исправления):");
		Для Каждого Ошибка Из Ошибки Цикл
			Части.Добавить(" • " + Ошибка);
		КонецЦикла;
	КонецЕсли;

	Предупреждения = Информация.config_warnings;
	Если Предупреждения.Количество() > 0 Тогда
		Части.Добавить("Предупреждения (записи не применены):");
		Для Каждого Предупреждение Из Предупреждения Цикл
			Части.Добавить(" • " + Предупреждение);
		КонецЦикла;
	КонецЕсли;

	Если Ошибки.Количество() = 0 И Предупреждения.Количество() = 0 Тогда
		Части.Добавить("Замечаний нет: все записи приняты.");
	КонецЕсли;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Функция ДоступАдминистратора()

	Попытка
		Возврат ПравоДоступа("Администрирование")
			ИЛИ ПравоДоступа("АдминистрированиеДанных");
	Исключение
		// Если проверка прав недоступна, решение принимают роли на объекте.
		Возврат Истина;
	КонецПопытки;

КонецФункции

Функция ИмяКонстанты()

	Возврат "MCP_ServerConfig";

КонецФункции

#КонецОбласти
