// КНОПКА 1 — «Включить маскирование».
//
// Вставить целиком в модуль управляемой формы. Команду формы связать с
// процедурой ВключитьМаскирование.
//
// Правит ТОЛЬКО секции type_aliases и type_field_masks константы
// MCP_ServerConfig. Остальные разделы (http, limits, allowlist, response,
// masked_fields, organization_aliases, person_aliases) читаются и записываются
// без изменений.

&НаСервере
Процедура ВключитьМаскированиеНаСервере()

	Если НЕ МаскВклПравоАдминистратора() Тогда
		Сообщить("Недостаточно прав: изменение privacy-политики доступно администратору.");
		Возврат;
	КонецЕсли;

	Попытка
		Настройки = МаскВклПрочитатьНастройки();
		Privacy = МаскВклСекцияPrivacy(Настройки);

		Privacy.Вставить("type_aliases", МаскВклШаблонПсевдонимов());
		Privacy.Вставить("type_field_masks", МаскВклШаблонМасок());
		Privacy.Вставить("publish_details", Истина);

		Настройки.Вставить("privacy", Privacy);
		МаскВклЗаписатьНастройки(Настройки);
	Исключение
		Сообщить("Не удалось включить маскирование: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// Диагностику показываем сразу: иначе об отклонённой записи или опечатке в
	// имени поля стало бы известно только по отказам инструментов.
	Сообщить("Privacy-политика включена.");
	Для Каждого Строка Из МаскВклДиагностика() Цикл
		Сообщить(Строка);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВключитьМаскирование(Команда)
	ВключитьМаскированиеНаСервере();
КонецПроцедуры

// ---- Шаблон политики: единственное место, которое нужно править ------------

// Поле mode записи политики С PR #116 НЕ ДЕЙСТВУЕТ: отказов в контракте нет ни
// в одной форме, любая запись применяется как маска. Значение "deny" сервер
// принимает и игнорирует с предупреждением «запись применена как маска» в
// config_warnings — отказа до выполнения запроса больше НЕ существует, и
// восстановление названия перебором (отбор, сортировка, поиск) режимом не
// закрывается: это принятый остаточный риск (§9 ТЗ).
// Поле оставлено в шаблоне только ради совместимости уже записанных политик.
&НаСервереБезКонтекста
Функция МаскВклРежим()

	Возврат "mask";

КонецФункции

// Псевдонимы: вместо названия клиент получает стабильный код <prefix> + 8 символов.
// Только ссылочные виды. Организации, физические лица, сотрудники и пользователи
// здесь будут отклонены — они закрываются секциями organization_aliases и
// person_aliases.
&НаСервереБезКонтекста
Функция МаскВклШаблонПсевдонимов()

	Записи = Новый Массив;
	Записи.Добавить(МаскВклЗаписьПсевдонима("Справочник.Контрагенты", "Контр-"));
	// Подчинённые справочники закрываются вместе с владельцем: их наименования
	// обычно содержат название контрагента («Договор №12 с ООО …»).
	Записи.Добавить(МаскВклЗаписьПсевдонима("Справочник.ДоговорыКонтрагентов", "Дог-"));
	Записи.Добавить(МаскВклЗаписьПсевдонима("Справочник.БанковскиеСчета", "Счет-"));
	Возврат Записи;

КонецФункции

// Маски полей: строка → XXXXXXX, дата → 1900-01-01T00:00:00, число и булево → null.
// Вид типа любой, включая регистры.
&НаСервереБезКонтекста
Функция МаскВклШаблонМасок()

	Записи = Новый Массив;
	Записи.Добавить(МаскВклЗаписьМаски("Справочник.Контрагенты",
		"НаименованиеПолное, Комментарий, ДополнительнаяИнформация"));
	Записи.Добавить(МаскВклЗаписьМаски("Справочник.ДоговорыКонтрагентов",
		"Комментарий, НаименованиеДляСчетаФактурыНаАванс"));
	Записи.Добавить(МаскВклЗаписьМаски("Справочник.БанковскиеСчета",
		"НомерСчета, ТекстКорреспондента, ТекстНазначения"));
	// Имена полей регистра сверены с фактическим составом: измерение называется
	// Физлицо, паспортные реквизиты — Серия, Номер, КемВыдан.
	Записи.Добавить(МаскВклЗаписьМаски("РегистрСведений.ДокументыФизическихЛиц",
		"Серия, Номер, КемВыдан, КодПодразделения, ФамилияЛатиницей, ИмяЛатиницей"));
	Возврат Записи;

КонецФункции

// ---- Служебное -------------------------------------------------------------

&НаСервереБезКонтекста
Функция МаскВклЗаписьПсевдонима(ИмяТипа, Префикс)

	Запись = Новый Соответствие;
	Запись.Вставить("type", ИмяТипа);
	Запись.Вставить("prefix", Префикс);
	Запись.Вставить("mode", МаскВклРежим());
	Возврат Запись;

КонецФункции

&НаСервереБезКонтекста
Функция МаскВклЗаписьМаски(ИмяТипа, ПоляСтрокой)

	Поля = Новый Массив;
	Для Каждого Поле Из СтрРазделить(ПоляСтрокой, ",", Ложь) Цикл
		ИмяПоля = СокрЛП(Поле);
		Если НЕ ПустаяСтрока(ИмяПоля) Тогда
			Поля.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Запись = Новый Соответствие;
	Запись.Вставить("type", ИмяТипа);
	Запись.Вставить("fields", Поля);
	Запись.Вставить("mode", МаскВклРежим());
	Возврат Запись;

КонецФункции

// JSON читаем в Соответствие, а не в Структуру: в настройке есть ключи, которые
// в имя свойства структуры не превращаются (например mcp-protocol-version).
&НаСервереБезКонтекста
Функция МаскВклПрочитатьНастройки()

	Текст = "";
	Если Метаданные.Константы.Найти("MCP_ServerConfig") <> Неопределено Тогда
		Текст = Константы["MCP_ServerConfig"].Получить();
	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		// Не JSON-объект: перезаписывать нельзя, иначе потеряем содержимое.
		ВызватьИсключение "Константа MCP_ServerConfig не содержит JSON-объект.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура МаскВклЗаписатьНастройки(Настройки)

	Если Метаданные.Константы.Найти("MCP_ServerConfig") = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет константы MCP_ServerConfig.";
	КонецЕсли;

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Настройки);
	Константы["MCP_ServerConfig"].Установить(Запись.Закрыть());

КонецПроцедуры

&НаСервереБезКонтекста
Функция МаскВклСекцияPrivacy(Настройки)

	Privacy = Настройки.Получить("privacy");
	Если ТипЗнч(Privacy) = Тип("Соответствие") Тогда
		Возврат Privacy;
	КонецЕсли;
	Возврат Новый Соответствие;

КонецФункции

// Массив строк для показа через Сообщить: что сервер думает о новой политике.
&НаСервереБезКонтекста
Функция МаскВклДиагностика()

	Части = Новый Массив;

	Попытка
		Информация = MCP_Config.ИнформацияМаскированияLLM();
	Исключение
		Части.Добавить("Проверить политику не удалось: " + ОписаниеОшибки());
		Возврат Части;
	КонецПопытки;

	Части.Добавить("Маскирование активно: " + ?(Информация.enabled, "да", "нет") + ".");

	Если Информация.config_errors.Количество() > 0 Тогда
		Части.Добавить("ОШИБКИ ПОЛИТИКИ — инструменты заблокированы до исправления:");
		Для Каждого Ошибка Из Информация.config_errors Цикл
			Части.Добавить(" • " + Ошибка);
		КонецЦикла;
	КонецЕсли;

	Если Информация.config_warnings.Количество() > 0 Тогда
		Части.Добавить("Предупреждения — записи не применены:");
		Для Каждого Предупреждение Из Информация.config_warnings Цикл
			Части.Добавить(" • " + Предупреждение);
		КонецЦикла;
	КонецЕсли;

	Если Информация.config_errors.Количество() = 0
		И Информация.config_warnings.Количество() = 0 Тогда
		Части.Добавить("Замечаний нет: все записи приняты.");
	КонецЕсли;

	Возврат Части;

КонецФункции

// ПравоДоступа принимает ДВА параметра: право и объект метаданных. Права
// «Администрирование» и «АдминистрированиеДанных» относятся к конфигурации
// целиком, поэтому вторым аргументом передаётся Метаданные.
&НаСервереБезКонтекста
Функция МаскВклПравоАдминистратора()

	Попытка
		Возврат ПравоДоступа("Администрирование", Метаданные)
			ИЛИ ПравоДоступа("АдминистрированиеДанных", Метаданные);
	Исключение
		// Если проверка недоступна, доступ решают роли на самом объекте.
		Возврат Истина;
	КонецПопытки;

КонецФункции
