// КНОПКА 2 — «Выключить маскирование». Вся логика внутри обработчика,
// вспомогательных функций нет: код вставляется в модуль формы как есть.
//
// Опустошает секции type_aliases и type_field_masks константы MCP_ServerConfig.
// Остальные разделы (http, limits, allowlist, response, masked_fields,
// organization_aliases, person_aliases) читаются и записываются без изменений.

&НаСервере
Процедура ВыключитьМаскированиеНаСервере()

	ИмяКонстанты = "MCP_ServerConfig";

	// Кнопка снимает защиту, поэтому право проверяем до всего остального.
	// ПравоДоступа принимает ДВА параметра: право и объект метаданных. Права
	// «Администрирование» и «АдминистрированиеДанных» относятся к конфигурации
	// целиком, поэтому вторым аргументом передаётся Метаданные.
	Попытка
		ЕстьПраво = ПравоДоступа("Администрирование", Метаданные)
			ИЛИ ПравоДоступа("АдминистрированиеДанных", Метаданные);
	Исключение
		// Если проверка прав недоступна, доступ решают роли на самом объекте.
		ЕстьПраво = Истина;
	КонецПопытки;

	Если НЕ ЕстьПраво Тогда
		Сообщить("Недостаточно прав: изменение privacy-политики доступно администратору.");
		Возврат;
	КонецЕсли;

	Если Метаданные.Константы.Найти(ИмяКонстанты) = Неопределено Тогда
		Сообщить("В конфигурации нет константы " + ИмяКонстанты + ".");
		Возврат;
	КонецЕсли;

	Попытка
		// Читаем настройку целиком и правим только две секции: остальное
		// (http, limits, allowlist, legacy-privacy) должно уцелеть.
		Настройки = Новый Соответствие;
		Текст = Константы[ИмяКонстанты].Получить();

		Если НЕ ПустаяСтрока(Текст) Тогда
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Текст);
			// Истина — читать в Соответствие: в настройке есть ключи, которые в
			// имя свойства структуры не превращаются (например mcp-protocol-version).
			Прочитанное = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();

			Если ТипЗнч(Прочитанное) <> Тип("Соответствие") Тогда
				Сообщить("Константа " + ИмяКонстанты
					+ " не содержит JSON-объект: настройка оставлена без изменений.");
				Возврат;
			КонецЕсли;

			Настройки = Прочитанное;
		КонецЕсли;

		Privacy = Настройки.Получить("privacy");
		Если ТипЗнч(Privacy) <> Тип("Соответствие") Тогда
			Privacy = Новый Соответствие;
		КонецЕсли;

		// Пустые массивы, а не удаление ключей: при пустых секциях сервер
		// гарантированно ведёт себя как до внедрения политики, и в ответе видно,
		// что механизм на месте и просто не задействован.
		Privacy.Вставить("type_aliases", Новый Массив);
		Privacy.Вставить("type_field_masks", Новый Массив);
		Настройки.Вставить("privacy", Privacy);

		ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку(ПараметрыЗаписи);
		ЗаписатьJSON(Запись, Настройки);
		Константы[ИмяКонстанты].Установить(Запись.Закрыть());
	Исключение
		Сообщить("Не удалось выключить маскирование: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Сообщить("Privacy-политика выключена: секции type_aliases и type_field_masks пусты.");

	// Спрашиваем сервер о фактическом состоянии: маскирование обязано стать
	// неактивным, а config_errors — опустеть.
	Попытка
		Информация = MCP_Config.ИнформацияМаскированияLLM();

		Сообщить("Маскирование активно: " + ?(Информация.enabled, "да", "нет") + ".");

		Если Информация.enabled Тогда
			Сообщить("Остались активными legacy-механизмы: masked_fields,"
				+ " organization_aliases или person_aliases — эта кнопка их не трогает.");
		КонецЕсли;

		Для Каждого Ошибка Из Информация.config_errors Цикл
			Сообщить("ОШИБКА ПОЛИТИКИ (инструменты заблокированы): " + Ошибка);
		КонецЦикла;

		Для Каждого Предупреждение Из Информация.config_warnings Цикл
			Сообщить("Предупреждение: " + Предупреждение);
		КонецЦикла;
	Исключение
		Сообщить("Проверить состояние политики не удалось: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВыключитьМаскирование(Команда)
	ВыключитьМаскированиеНаСервере();
КонецПроцедуры
